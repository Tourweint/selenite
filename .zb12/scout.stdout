ENABLED: \"false\" },\napps/server/src/persona-ask.test.ts:222:\tassert.equal(personaAskEnabled({ PERSONA_MEMORY_ENABLED: \"off\" }), false);\napps/server/src/persona-ask.ts:21:export const PERSONA_ASK_TIMEOUT_MS = 15_000;\napps/server/src/persona-ask.ts:34:export const PERSONA_GROUP_ORDER: readonly PersonaGroup[] = [\napps/server/src/persona-ask.ts:100: * 显式关闭开关（`PERSONA_MEMORY_ENABLED`，默认开）。\napps/server/src/persona-ask.ts:102: * 与 `PERSONA_MEMORY_ASK` 的关系：ASK 配置 = 启用；ENABLED=false = 显式关。\napps/server/src/persona-ask.ts:106:\tconst raw = env.PERSONA_MEMORY_ENABLED?.trim().toLowerCase();\napps/server/src/persona-ask.ts:113:\tconst script = env.PERSONA_MEMORY_ASK?.trim();\n\nStderr: (empty)\nExit Code: 0\nSignal: (none)"
