2→/** 总管身份化总开关：false/0 = 不播种、persona 常量直读，回到改动前形态（D1 回滚开关）。 */\n  83→export function chiefPartnerEnabled(): boolean {\n  84→\tconst raw = process.env.CHIEF_PARTNER?.trim().toLowerCase();\n  85→\tif (!raw) return true;\n  86→\treturn raw !== \"false\" && raw !== \"0\";\n  87→}\n  88→\n  89→/** 总管技能目录（纯路径，不打开 DB）；与 store.skillsDirOf(\"chief\") 同址。 */\n  90→export function chiefSkillsDir(): string {\n  91→\tconst homesRoot = process.env.PARTNER_HOMES_ROOT?.trim() || DEFAULT_HOMES_ROOT;\n  92→\treturn join(homesRoot, CHIEF_PARTNER_ID, \"skills\");\n  93→}\n  94→\n  95→export type PartnerStatus = \"active\" | \"paused\" | \"archived\";\n  96→\n  97→export interface PartnerRow {\n  98→\tid: string;\n  99→\tname: string;\n 100→\tstatus: PartnerStatus;\n 101→\t/** 当前身份快照版本号；还没建过版本 = null */\n 102→\tcurrentVersion: number | null;\n 103→\tcreatedAt: string;\n 104→\tupdatedAt: string;\n 105→\t/** 执事的领域名（批次D D2）；普通执事为 null。小写 ASCII，同 chancellor DOMAIN_PATTERN。 */\n 106→\tdomain: string | null;\n 107→\t/**\n 108→\t * 头像（2026-11-06 侧栏调整 B1）：有界 PNG data URL，或 null（未设置 → 前端用名字首字）。\n 109→\t * 只供 `<img>` 渲染；服务端不存路径、不收外部 URL、不收 SVG（理由见 shared 的 PartnerAvatarSchema）。\n 110→\t */\n 111→\tavatar: string | null;\n 112→\t/**\n 113→\t * 派发权（2026-11-06 执事派发权开关）：带 domain 的执事是否作为分管负责人接单。\n 114→\t * 默认关。只对带 domain 的执事有意义。\n 115→\t */\n 116→\tdispatchAuthority: boolean;\n 117→\t/**\n 118→\t * 当前目标（2026-11-08 员工人格化刀二 E4）：这一阵子在奔什么，用户 / 总管可改。\n 119→\t * **不版本化**（不是身份，是现取现用的状态），只进 detail 端点与 PATCH，\n 120→",
