      "text": " 360→\t\tconst now = new Date().toISOString();\n 361→\t\tconst domain = opts?.domain ?? null;\n 362→\t\tthis.db\n 363→\t\t\t.prepare(\n 364→\t\t\t\t\"INSERT INTO partners (id, name, status, current_version, created_at, updated_at, domain) VALUES (?, ?, 'active', NULL, ?, ?, ?)\",\n 365→\t\t\t)\n 366→\t\t\t.run(id, name, now, now, domain);\n 367→\t\t// 建档案即建家 + 首个身份版本：执事生下来就有身份。\n 368→\t\t// 执事用「一句话版本」SOUL 播种（批次D D2），普通执事用默认模板。\n 369→\t\tthis.ensureHome(id, name, opts?.soulSeed);\n 370→\t\tconst soul = this.readSoulFromHome(id) ?? defaultSoul(name);\n 371→\t\t// 岗位契约（2026-11-08 E1）：**只在新建时**播种空模板；存量执事不自动补文件\n 372→\t\t// （不越权——它没见过这份契约，凭空出现一个文件比没有更让人困惑）。\n 373→\t\tthis.seedContract(id);\n 374→\t\tthis.pushVersion(id, soul, null, this.readContractFromHome(id));\n 375→\t\tthis.ensureHome(id, name, opts?.soulSeed);\n 376→\t\t// 执事：在链接表登记领域路由（role 枚举扩一型 'delegation'）。\n 377→\t\t// 既有 UNIQUE (partner_id, role, route_key) 已覆盖这个组合，无需改约束。\n 378→\t\tif (domain) this.linkDelegation(id, domain);\n 379→\t\treturn this.get(id) as PartnerRow;\n 380→\t}\n 381→\n 382→\t/**\n 383→\t * 总管专用播种（批次D D1）：固定 id `\"chief\"`，首次启动建档案 + 家 + v1 身份快照。\n 384→\t * **幂等**：档案 / SOUL.md / 版本任一已存在都不动——二次启动绝不覆盖用户改过的 SOUL\n 385→"
