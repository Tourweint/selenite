mpt: number): Promise<void> {\n670:\t\tif (doc.attempt !== attempt || doc.status !== \"pending\") return;\n671:\t\tdoc.status = \"failed\";\n=== greeting module ===\n./agent/session.ts:653:\t * 同一段内的重试（attempt 变化）**不重置**：重试是从头再生成同一段，仍按增量发。\n./index.ts:363:  if (redeemRateLimited(ip)) return c.json({ error: \"too_many_attempts\" }, 429);\n./pairing.ts:31:\tattempts: number;\n./pairing.ts:53:\t| \"too_many_attempts\";\n./pairing.ts:100:\t\tthis.store.code = { hash: sha256(code), expiresAt, attempts: 0 };\n./pairing.ts:108:\t\treturn !!code && !code.usedAt && code.expiresAt > now && code.attempts < MAX_CODE_ATTEMPTS;\n./pairing.ts:117:\t\tif (current.attempts >= MAX_CODE_ATTEMPTS) return \"too_many_attempts\";\n./pairing.ts:120:\t\t\tcurrent.attempts += 1;\n./pairing.ts:122:\t\t\treturn current.attempts >= MAX_CODE_ATTEMPTS ? \"too_many_attempts\" : \"unknown_code\";\n./relay-client.ts:69:\tprivate attempts = 0;\n./relay-client.ts:213:\t\t\t\tthis.attempts = stableFor >= STABLE_RESET_MS ? 0 : Math.max(0, this.attempts - 1);\n./relay-client.ts:267:\t\t\tthis.attempts += 1;\n./relay-client.ts:268:\t\t\tconst delay = Math.min(BACKOFF_BASE_MS * 2 ** (this.attempts - 1), BACKOFF_MAX_MS);"
