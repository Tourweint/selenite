      "type": "text",
      "text": "   1→import { existsSync, readFileSync } from \"node:fs\";\n   2→import { join } from \"node:path\";\n   3→import { listManagers } from \"../../../../../../chancellor/src/manager/registry.ts\";\n   4→import { Store } from \"../../../../../../chancellor/src/store.ts\";\n   5→import type { Ticket } from \"../../../../../../chancellor/src/types.ts\";\n   6→import { approvalStore } from \"../approvals.ts\";\n   7→import { INJECTION_GUARD, injectionGuardEnabled } from \"./injection-guard.ts\";\n   8→import {\n   9→\tATTENTION_REPLY_GUIDANCE,\n  10→\tWORK_REVIEW_GUIDANCE,\n  11→\tchancellorWorkRoot,\n  12→} from \"../delegation.ts\";\n  13→import {\n  14→\tPARTNER_CONTRACT_SECTIONS,\n  15→\tpartnerContractEnabled,\n  16→\tpartnersStore,\n  17→\ttype PartnersStore,\n  18→} from \"../partners.ts\";\n  19→\n  20→/**\n  21→ * 执事轮上下文装配（2026-11-08 员工人格化刀一 E1 + E5）。\n  22→ *\n  23→ * 为什么单独一个模块：`lifecycle.ts` 的 beforeRequest 与 `group-runtime.ts` 的成员轮\n  24→ * 需要同一份「岗位契约 + 当前在办」。放在 agent/ 子模块是为了两边都能 import，\n  25→ * 同时保持 `partners.ts`（只做存储）不 import agent（8b 的装配方向）。\n  26→ *\n  27→ * 三段各归各的家（**别合并成一份文本存起来**）：\n  28→ *   1. **SOUL**：身份提示词（`renderPartnerIdentity` → configure instructions），\n  29→ *      按身份版本冻结，改完下一轮生效。\n  30→ *   2. **岗位契约**：同样是身份版本的一部分（`partner_versions.contract_source`），\n  31→ *      但**每轮现取**当前版本快照 —— 改契约 bump 版本，下一轮读到新的，当场不变身。\n  32→ *   3. **当前在办**：派活单 / 待审批 / 最近一单，**全部现查现拼、零新存储**。\n  33→ *      每次请求都重新算，不写进 transcript（system 消息，与记忆注入同一条通道）。\n  34→ *\n  35→ * 回滚：`PARTNER_CONTRACT=false` 只关第 2 段；第 3 段是纯装配，没有独立开关\n  36→ * （关掉执事能力时整个 hook 不跑）。\n  37→ */\n  38→\n  39→// ── 岗位契约 ─────────────────────────────────────────────\n  40→\n  41→/**\n  42→ * 把契约正文按固定四节切开。**只认四个二级标题**（`## 职责范围` …），\n  43→ * 标题之间直到下一个二级标题的内容算正文；文件里其它内容一律忽略。\n  44→ * 返回 Map 而非对象：节名就是键，缺节 = 没有键。\n  45→ */\n  46→export function splitContractSections(source: string): Map<string, string> {\n  47→\tconst sections = new Map<string, string>();\n  48→\tconst known = new Set<string>(PARTNER_CONTRACT_SECTIONS);\n  49→\tlet current: string | null = null;\n  50→\tlet buffer: string[] = [];\n  51→\tconst flush = (): void => {\n  52→\t\tif (!current) return;\n  53→\t\tsections.set(current, buffer.join(\"\\n\").trim());\n  54→\t\tbuffer = [];\n  55→\t};\n  56→\tfor (const line of source.split(/\\r?\\n/)) {\n  57→\t\tconst heading = /^##\\s+(.+?)\\s*$/.exec(line);\n  58→\t\tif (heading) {\n  59→\t\t\tflush();\n  60→\t\t\tconst name = heading[1] ?? \"\";\n  61→\t\t\tcurrent = known.has(name) ? name : null;\n  62→\t\t\tcontinue;\n  63→\t\t}\n  64→\t\tif (current) buffer.push(line);\n  65→\t}\n  66→\tflush();\n  67→\treturn sections;\n  68→}\n  69→\n  70→/**\n  71→ * 契约段：四节全文，**空节连标题一起省略**；四节全空 / 没有文件 → undefined\n  72→ * （整段消失，不留一个空壳标题）。开关关着也不渲染。\n  73→ */\n  74→export function renderContractSection(contractSource: string | null | undefined): string | undefined {\n  75→\tif (!partnerContractEnabled()) return undefined;\n  76→\tif (!contractSource?.trim()) return undefined;\n  77→\tconst sections = splitContractSections(contractSource);\n  78→\tconst blocks: string[] = [];\n  79→\tfor (const name of PARTNER_CONTRACT_SECTIONS) {\n  80→\t\tconst body = sections.get(name)?.trim();\n  81→\t\tif (body) blocks.push(`## ${name}\\n${body}`);\n  82→\t}\n  83→\tif (blocks.length === 0) return undefined;\n  84→\treturn [\"【岗位契约】\", ...blocks].join(\"\\n\\n\");\n  85→}\n  86→\n  87→// ── 当前在办 ─────────────────────────────────────────────\n  88→\n  89→/**\n  90→ * 终态口径：与 `delegation-api.ts` / `delegation-receipts.ts` 的\n  91→ * `TERMINAL_TICKET_STATUS` 同一套（done / needs_you / failed / idle / aborted）。\n  92→ * 刻意不导出成共享常量：那两处各自是接口投影与回执判定的私有语义，\n  93→ * 为一个只读展示去改它们的形状不划算；三处一致由这里的注释与测试守着。\n  94→ */\n  95→const TERMINAL_TICKET_STATUS = new Set([\"done\", \"needs_you\", \"failed\", \"idle\", \"aborted\"]);\n  96→\n  97→const STATUS_LABEL: Record<string, string> = {\n  98→\treceived: \"已受理\",\n  99→\tplanning: \"规划中\",\n 100→\tplanned: \"拆解完成\",\n 101→\tdispatching: \"进行中\",\n 102→\treviewing: \"核对中\",\n 103→\tdone: \"已完成\",\n 104→\tneeds_you: \"等你回答\",\n 105→\tidle: \"等子单\",\n 106→\tfailed: \"失败\",\n 107→\taborted: \"已中止\",\n 108→};\n 109→\n 110→/** 明细条数上限：超过就只报\"另有 N 条\"，别让一段状态吃掉半个上下文。 */\n 111→const DETAIL_LIMIT = 3;\n 112→\n 113→/** 该执事发起的一张派活单（只留展示需要的字段，不把 prompt 全文带进提示词）。 */\n 114→interface PartnerTicket {\n 115→\tid: string;\n 116→\tstatus: string;\n 117→\tupdatedAt: string;\n 118→\tlastAction: string;\n 119→\twaitingOn: string | null;\n 120→}\n 121→\n 122→/**\n 123→ * 装配用的注入缝。生产不传（走 partnersStore / approvalStore / chancellorWorkRoot）；\n 124→ * 单测注入临时库与临时 workRoot，不碰真实 `.data/`。\n 125→ */\n 126→export interface PartnerContextDeps {\n 127→\tstore?: PartnersStore;\n 128→\tapprovals?: { pendingOf(conversationId: number): Array<{ tool: string; args: string }> };\n 129→\tworkRoot?: string;\n 130→\t/** 每次扫描每类 runs 目录取多少张单（默认 200；够覆盖\"在办 + 最近一单\"）。 */\n 131→\tticketLimit?: number;\n 132→\t/**\n 133→\t * 该执事近 N 单 work 履历聚合（2026-11-08 刀二 E2）。\n 134→\t * 由装配层（lifecycle）注入 `workSummaryFor`；不传 = 不加履历摘要行\n 135→\t * （单测零副作用，也不去开真实记忆库）。结构化查询，不走语义召回。\n 136→\t */\n 137→\tworkSummary?: (partnerId: string) => {\n 138→\t\tdone: number;\n 139→\t\tfailed: number;\n 140→\t\tstopped: number;\n 141→\t\ttotal: number;\n 142→\t} | null;\n 143→}\n 144→\n 145→function readTicketJson(runsDir: string, ticketId: string): Ticket | null {\n 146→\ttry {\n 147→\t\treturn JSON.parse(\n 148→\t\t\treadFileSync(join(runsDir, ticketId, \"ticket.json\"), \"utf8\"),\n 149→\t\t) as Ticket;\n 150→\t} catch {\n 151→\t\treturn null;\n 152→\t}\n 153→}\n 154→\n 155→/**\n 156→ * 扫出\"该执事发起\"的单：`ticket.json` 的 `originConversationId` 落在他的会话 id 集合里。\n 157→ *\n 158→ * 数据源与任务中心同源（chancellor `runs/`，含各领域 `managers/<domain>/runs/`），\n 159→ * 不新增索引、不新增存储 —— 一张单原来的派单记账本来就带着发起会话。\n 160→ * 老单没有 `originConversationId` 就看不到（回执反查是任务中心为了历史单做的，\n 161→ * 这里不重复一遍：状态感只需要\"最近的、我在办的\"，不需要全量归档）。\n 162→ */\n 163→function ticketsOfPartner(\n 164→\tworkRoot: string,\n 165→\tsessionIds: Set<number>,\n 166→\tlimit: number,\n 167→): PartnerTicket[] {\n 168→\tconst dirs: string[] = [];\n 169→\ttry {\n 170→\t\t// 只扫**已经存在**的目录：没有 runs/ 时开 Store 会顺手建库，一个纯读的状态段\n 171→\t\t// 不该在磁盘上留下东西（chancellor 从未跑过的机器上尤其明显）。\n 172→\t\tif (existsSync(workRoot)) {\n 173→\t\t\tdirs.push(workRoot);\n 174→\t\t\tfor (const entry of listManagers(workRoot)) {\n 175→\t\t\t\tconst runsDir = entry.meta?.runs_dir;\n 176→\t\t\t\tif (runsDir && existsSync(runsDir)) dirs.push(runsDir);\n 177→\t\t\t}\n 178→\t\t}\n 179→\t} catch {\n 180→\t\t// 领域清单读不出来就只看顶层：状态感不能因为一个目录读失败而整段消失\n 181→\t}\n 182→\n 183→\tconst byId = new Map<string, PartnerTicket>();\n 184→\tfor (const dir of dirs) {\n 185→\t\tlet store: Store | null = null;\n 186→\t\ttry {\n 187→\t\t\tstore = new Store(dir);\n 188→\t\t\tfor (const row of store.listTickets(limit)) {\n 189→\t\t\t\tconst ticket = readTicketJson(dir, row.id);\n 190→\t\t\t\tif (!ticket) continue;\n 191→\t\t\t\tconst origin = Number(String(ticket.originConversationId ?? \"\").trim());\n 192→\t\t\t\tif (!Number.isInteger(origin) || !sessionIds.has(origin)) continue;\n 193→\t\t\t\tconst id = String(ticket.id);\n 194→\t\t\t\tif (byId.has(id)) continue;\n 195→\t\t\t\tbyId.set(id, {\n 196→\t\t\t\t\tid,\n 197→\t\t\t\t\tstatus: String(ticket.status ?? \"\"),\n 198→\t\t\t\t\tupdatedAt: String(ticket.updated_at ?? ticket.created_at ?? \"\"),\n 199→\t\t\t\t\tlastAction: String(ticket.lastAction ?? \"\").trim(),\n 200→\t\t\t\t\twaitingOn: ticket.waitingOn ? String(ticket.waitingOn) : null,\n 201→\t\t\t\t});\n 202→\t\t\t}\n 203→\t\t} catch {\n 204→\t\t\t// 单个 runs 目录坏了不挡其它目录\n 205→\t\t} finally {\n 206→\t\t\tstore?.close();\n 207→\t\t}\n 208→\t}\n 209→\treturn [...byId.values()].sort((a, b) => (a.updatedAt < b.updatedAt ? 1 : -1));\n 210→}\n 211→\n 212→function oneLine(text: string, max: number): string {\n 213→\tconst flat = text.replace(/\\s+/g, \" \").trim();\n 214→\treturn flat.length <= max ? flat : `${flat.slice(0, max - 1)}…`;\n 215→}\n 216→\n 217→function ticketDetail(ticket: PartnerTicket): string {\n 218→\tconst label = STATUS_LABEL[ticket.status] ?? ticket.status;\n 219→\tconst extra = ticket.lastAction ? `：${oneLine(ticket.lastAction, 60)}` : \"\";\n 220→\tconst waiting = ticket.waitingOn ? `（等 ${oneLine(ticket.waitingOn, 20)}）` : \"\";\n 221→\treturn `- ${ticket.id}（${label}${waiting}）${extra}`;\n 222→}\n 223→\n 224→function approvalDetail(record: { tool: string; args: string }): string {\n 225→\tconst args = oneLine(record.args, 60);\n 226→\treturn `- ${record.tool}${args ? `：${args}` : \"\"}`;\n 227→}\n 228→\n 229→/**\n 230→ * 「当前在办」段（E5）：①未终态的派活单 ②本会话待审批 ③最近一单结果。\n 231→ * 三项皆空 → undefined（整段省略）。明细 ≤3 条，超出只报条数。\n 232→ */\n 233→export function buildPartnerStatusSection(\n 234→\tpartnerId: string,\n 235→\tconversationId: number,\n 236→\tdeps: PartnerContextDeps = {},\n 237→): string | undefined {\n 238→\tconst store = deps.store ?? partnersStore();\n 239→\tconst sessionIds = new Set(store.sessionIdsOf(partnerId));\n 240→\tconst tickets = sessionIds.size\n 241→\t\t? ticketsOfPartner(deps.workRoot ?? chancellorWorkRoot(), sessionIds, deps.ticketLimit ?? 200)\n 242→\t\t: [];\n 243→\tconst active = tickets.filter((ticket) => !TERMINAL_TICKET_STATUS.has(ticket.status));\n 244→\tconst last = tickets.find((ticket) => TERMINAL_TICKET_STATUS.has(ticket.status));\n 245→\n 246→\tlet approvals: Array<{ tool: string; args: string }> = [];\n 247→\ttry {\n 248→\t\tconst sink = deps.approvals ?? approvalStore();\n 249→\t\tapprovals = sink.pendingOf(conversationId);\n 250→\t} catch {\n 251→\t\t// 审批库读不出来不影响其它两项\n 252→\t\tapprovals = [];\n 253→\t}\n 254→\n 255→\t// 履历摘要（**过去时**）与在办（**现在时**）两层互补别混：\n 256→\t// 在办来自 runs 扫描（刀一），履历来自 work 记录的结构化查询（刀二）。\n 257→\t// 零记录不加（workSummary 返回 null 或 total=0）。\n 258→\tconst summary = deps.workSummary?.(partnerId) ?? null;\n 259→\tconst workLine =\n 260→\t\tsummary && summary.total > 0\n 261→\t\t\t? `近 10 单：完成 ${summary.done}、失败 ${summary.failed}、中止 ${summary.stopped}`\n 262→\t\t\t: null;\n 263→\n 264→\tif (active.length === 0 && approvals.length === 0 && !last && !workLine) return undefined;\n 265→\n 266→\tconst lines: string[] = [\"【当前在办】\"];\n 267→\tif (active.length > 0) {\n 268→\t\tlines.push(\"在办的单：\");\n 269→\t\tfor (const ticket of active.slice(0, DETAIL_LIMIT)) lines.push(ticketDetail(ticket));\n 270→\t\tif (active.length > DETAIL_LIMIT) lines.push(`（另有 ${active.length - DETAIL_LIMIT} 单在办）`);\n 271→\t}\n 272→\tif (approvals.length > 0) {\n 273→\t\tlines.push(\"等你批的：\");\n 274→\t\tfor (const record of approvals.slice(0, DETAIL_LIMIT)) lines.push(approvalDetail(record));\n 275→\t\tif (approvals.length > DETAIL_LIMIT) {\n 276→\t\t\tlines.push(`（另有 ${approvals.length - DETAIL_LIMIT} 条待批）`);\n 277→\t\t}\n 278→\t}\n 279→\tif (last) {\n 280→\t\tconst label = STATUS_LABEL[last.status] ?? last.status;\n 281→\t\tconst detail = last.lastAction ? `：${oneLine(last.lastAction, 80)}` : \"\";\n 282→\t\tlines.push(`最近一单：${last.id}（${label}）${detail}`);\n 283→\t}\n 284→\t// 有在办/待批时把「答不了怎么办」的口径带上（B2）：模型只在真有工人等它时才需要它。\n 285→\tlines.push(\"\", ATTENTION_REPLY_GUIDANCE);\n 286→\t// 段末尾挂一行履历摘要 + 周期盘点口径（刀二 E2/E4）：有履历才出现。\n 287→\tif (workLine) {\n 288→\t\tlines.push(\"\", workLine, \"\", WORK_REVIEW_GUIDANCE);\n 289→\t}\n 290→\treturn lines.join(\"\\n\");\n 291→}\n 292→\n 293→// ── 当前目标 ─────────────────────────────────────────────\n 294→\n 295→/**\n 296→ * 【当前目标】段（2026-11-08 刀二 E4）：有目标才出现，一行。\n 297→ *\n 298→ * 目标**不版本化**（不是身份，是\"现在在奔什么\"），现取现用：改完下一轮读到新的。\n 299→ * 与契约（低频、版本化、下一轮生效）刻意分开；空 / 全空白 = 整段省略。\n 300→ */\n 301→export function buildPartnerGoalSection(\n 302→\tpartnerId: string,\n 303→\tstore: PartnersStore = partnersStore(),\n 304→): string | undefined {\n 305→\tconst goal = store.get(partnerId)?.currentGoal?.trim();\n 306→\treturn goal ? `【当前目标】${goal}` : undefined;\n 307→}\n 308→\n 309→// ── 整体装配 ─────────────────────────────────────────────\n 310→\n 311→export interface PartnerTurnContext {\n 312→\t/** 身份正文（当前版本快照）。调用方放进 instructions；这里带出来是为了整体断言。 */\n 313→\tsoul: string;\n 314→\t/** 岗位契约段（开关关 / 空 → null） */\n 315→\tcontract: string | null;\n 316→\t/** 当前目标段（E4，无目标 → null） */\n 317→\tgoal: string | null;\n 318→\t/** 当前在办段（三项皆空 + 无履历 → null） */\n 319→\tstatus: string | null;\n 320→\t/** 注入防线段（开关关 → null；固定字节，不随轮次变化） */\n 321→\tguard: string | null;\n 322→\t/** 注入模型请求的附加段：契约 + 目标 + 在办 + 防线（都空 → undefined） */\n 323→\ttext: string | undefined;\n 324→}\n 325→\n 326→/**\n 327→ * 执事轮输入的单一装配点（E1 + E5）。\n 328→ *\n 329→ * 顺序固定：**SOUL（身份）→ 岗位契约 → 当前目标 → 当前在办**。前两段来自同一个身份版本，\n 330→ * 后两段现查现拼。`text` 只含后三段：SOUL 在 instructions 里，重复一遍等于每轮\n 331→ * 白付一份 token，还会让模型看到两个版本的身份。\n 332→ *\n 333→ * 刀二只在同一装配点加两段（目标 / 履历摘要），**没有第二条注入通道**。\n 334→ */\n 335→export function buildPartnerTurnContext(\n 336→\tpartnerId: string,\n 337→\tconversationId: number,\n 338→\tdeps: PartnerContextDeps = {},\n 339→): PartnerTurnContext {\n 340→\tconst store = deps.store ?? partnersStore();\n 341→\tconst current = store.currentVersion(partnerId);\n 342→\tconst soul = current?.soulSource ?? store.readSoulFromHome(partnerId) ?? \"\";\n 343→\t// 契约取\"当前版本快照\"；老库/手工放了文件但没快照的，退磁盘当前值。\n 344→\tconst contract = renderContractSection(\n 345→\t\tcurrent?.contractSource ?? store.readContractFromHome(partnerId),\n 346→\t) ?? null;\n 347→\tconst goal = buildPartnerGoalSection(partnerId, store) ?? null;\n 348→\tconst status = buildPartnerStatusSection(partnerId, conversationId, { ...deps, store }) ?? null;\n 349→\t// 注入防线（2026-11-09 T2）：放在执事轮输入尾部；固定字节，开关只决定注不注。\n 350→\tconst guard = injectionGuardEnabled() ? INJECTION_GUARD : null;\n 351→\tconst text = [contract, goal, status, guard]\n 352→\t\t.filter((part): part is string => Boolean(part))\n 353→\t\t.join(\"\\n\\n\");\n 354→\treturn { soul, contract, goal, status, guard, text: text || undefined };\n 355→}\n 356→"
    },
