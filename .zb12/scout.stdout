      "text": "   1→import { createHash } from \"node:crypto\";\n   2→\n   3→/**\n   4→ * 工具防打转守卫（2026-11-05 批次A A1）。\n   5→ *\n   6→ * 参考实现：cindy `agents/shared/loop-guard.ts`（阈值是那边踩坑调出来的，照抄不改；\n   7→ * \"辅助模型复核\"属 v1 明确不做，见批次A细化方案 §一）。与本仓回合上限（AGENT_MAX_TURNS）\n   8→ * 正交：上限管\"总量\"，这里管\"同质重复\"——模型陷在\"读文件 → 又读同一个文件\"的循环里时，\n   9→ * 回合数可能远没到上限，但 token 一直在烧。\n  10→ *\n  11→ * 判据（两级）：\n  12→ *   铁证 → beforeTool 直接拦下（block），模型必须用已有信息回答；\n  13→ *   疑似 → 只打日志（v1 不对外发帧，客户端无消费场景；要放行时按\"纯增量事件\"口径加）。\n  14→ *\n  15→ * 指纹两级：`name+args`（call 指纹，pingpong/轮转用）与 `name+args+结果摘要`\n  16→ * （full 指纹，\"完全相同\"判据用）。豁免：距上次调用 ≥30s 的节奏轮询不计入\n  17→ * （等任务、看日志是合法行为，不能误杀）；只统计顶层调用（嵌套调用不喂，防放大误判）。\n  18→ *\n  19→ * 纯类零 IO：状态全在实例里，注册表（loopGuardFor）也只在内存——一轮一个实例，\n  20→ * 新一轮由 beforeRequest 的 used===1 分支重置。崩溃丢状态无所谓：守卫是护栏不是账本。\n  21→ */\n  22→\n  23→/** 铁证 1：同一指纹（含结果）连续这么多次 → 拦 */\n  24→const IDENTICAL_INTERRUPT = 30;\n  25→/** 铁证 2：同一指纹持续这么久还在重复 → 拦（cindy：同结果持续 60 分钟） */\n  26→const STALE_MS = 60 * 60_000;\n  27→/** 铁证 3：读类窗口（本仓读类工具只有 read，128 窗口对它是\"128 次读\"） */\n  28→const READ_WINDOW = 128;\n  29→const READ_DISTINCT_LIMIT = 32;\n  30→const READ_MAX_REPEAT = 4;\n  31→/** 疑似 1：同一指纹连续这么多次（4）→ 告警 */\n  32→const STREAK_WARN = 4;\n  33→/** 疑似 2：12 次滑窗 distinct ≤2（pingpong） */\n  34→const PINGPONG_WINDOW = 12;\n  35→const PINGPONG_DISTINCT = 2;\n  36→/** 疑似 3：16 次滑窗 distinct ≤4（轮转） */\n  37→const ROTATION_WINDOW = 16;\n  38→const ROTATION_DISTINCT = 4;\n  39→/** 节奏轮询豁免：距上次调用 ≥30s 不计入重复判据 */\n  40→const RHYTHM_GAP_MS = 30_000;\n  41→/** 读类工具（pi-durable CodingTools 里唯一的只读工具；自有工具全是写/派生，不在此列） */\n  42→const READ_TOOLS = new Set([\"read\"]);\n  43→/** 结果摘要截断：结果太长时只取头部做指纹（内容不同摘要大概率不同，足够判重） */\n  44→const OUTPUT_DIGEST_LIMIT = 200;\n  45→\n  46→export type LoopGuardPattern = \"repeat\" | \"stale\" | \"read-rotation\" | \"pingpong\" | \"rotation\";\n  47→\n  48→export interface LoopGuardHit {\n  49→\tpattern: LoopGuardPattern;\n  50→\t/** 命中时的关键计数（连续次数 / 窗口 distinct） */\n  51→\tcount: number;\n  52→}\n  53→\n  54→/** beforeTool 喂进来；返回 interrupt 表示铁证，调用方应当 block 这次调用。 */\n  55→export type LoopGuardBefore = \"ok\" | ({ verdict: \"interrupt\" } & LoopGuardHit);\n  56→/** afterTool 喂进来；返回 warn 表示疑似，调用方只记日志。 */\n  57→export type LoopGuardAfter = \"ok\" | ({ verdict: \"warn\" } & LoopGuardHit);\n  58→\n  59→export class LoopGuard {\n  60→\t/** 最近一次 full 指纹（连续相同判据的锚点） */\n  61→\tprivate lastFullFp = \"\";\n  62→\tprivate streak = 0;\n  63→\tprivate streakFirstAt = 0;\n  64→\t/** 最近一次 call 指纹（判断\"这次调用是不是还在重复同一件事\"） */\n  65→\tprivate lastCallFp = \"\";\n  66→\t/** call 指纹滑窗（pingpong / 轮转判据） */\n  67→\tprivate callWindow: string[] = [];\n  68→\t/** 读类调用的 full 指纹窗（长读轮转判据） */\n  69→\tprivate readWindow: string[] = [];\n  70→\tprivate lastCallAt = 0;\n  71→\t/** 每种疑似只在实例生命周期内告警一次，不然日志会被刷爆 */\n  72→\tprivate warned = new Set<LoopGuardPattern>();\n  73→\n  74→\t/** 一次节奏豁免（≥30s 间隔）把窗口清空重来：慢节奏的重复是合法轮询 */\n  75→\tprivate rhythmReset(): void {\n  76→\t\tthis.callWindow = [];\n  77→\t\tthis.readWindow = [];\n  78→\t\tthis.streak = 0;\n  79→\t\tthis.lastFullFp = \"\";\n  80→\t\tthis.lastCallFp = \"\";\n  81→\t\tthis.warned.clear();\n  82→\t}\n  83→\n  84→\tbefore(name: string, args: unknown): LoopGuardBefore {\n  85→\t\tconst now = Date.now();\n  86→\t\tif (this.lastCallAt && now - this.lastCallAt >= RHYTHM_GAP_MS) this.rhythmReset();\n  87→\t\tthis.lastCallAt = now;\n  88→\n  89→\t\tconst callFp = callFingerprint(name, args);\n  90→\t\tif (this.streak >= IDENTICAL_INTERRUPT) {\n  91→\t\t\treturn { verdict: \"interrupt\", pattern: \"repeat\", count: this.streak };\n  92→\t\t}\n  93→\t\tif (\n  94→\t\t\tthis.streak >= 2 &&\n  95→\t\t\tthis.lastCallFp === callFp &&\n  96→\t\t\tnow - this.streakFirstAt >= STALE_MS\n  97→\t\t) {\n  98→\t\t\treturn { verdict: \"interrupt\", pattern: \"stale\", count: this.streak };\n  99→\t\t}\n 100→\t\tif (READ_TOOLS.has(name) && this.readWindow.length >= 32) {\n 101→\t\t\tconst distinct = new Set(this.readWindow).size;\n 102→\t\t\tconst maxRepeat = Math.max(...tally(this.readWindow).values());\n 103→\t\t\tif (distinct <= READ_DISTINCT_LIMIT && maxRepeat >= READ_MAX_REPEAT) {\n 104→\t\t\t\treturn {\n 105→\t\t\t\t\tverdict: \"interrupt\",\n 106→\t\t\t\t\tpattern: \"read-rotation\",\n 107→\t\t\t\t\tcount: distinct,\n 108→\t\t\t\t};\n 109→\t\t\t}\n 110→\t\t}\n 111→\t\treturn \"ok\";\n 112→\t}\n 113→\n 114→\tafter(\n 115→\t\tname: string,\n 116→\t\targs: unknown,\n 117→\t\tresult: { isError?: boolean; output?: unknown },\n 118→\t): LoopGuardAfter {\n 119→\t\tconst callFp = callFingerprint(name, args);\n 120→\t\tconst fullFp = `${callFp}|${resultDigest(result)}`;\n 121→\n 122→\t\tif (fullFp === this.lastFullFp) {\n 123→\t\t\tthis.streak += 1;\n 124→\t\t} else {\n 125→\t\t\tthis.streak = 1;\n 126→\t\t\tthis.streakFirstAt = Date.now();\n 127→\t\t}\n 128→\t\tthis.lastFullFp = fullFp;\n 129→\t\tthis.lastCallFp = callFp;\n 130→\n 131→\t\tthis.callWindow.push(callFp);\n 132→\t\tif (this.callWindow.length > ROTATION_WINDOW) this.callWindow.shift();\n 133→\t\tif (READ_TOOLS.has(name)) {\n 134→\t\t\tthis.readWindow.push(fullFp);\n 135→\t\t\tif (this.readWindow.length > READ_WINDOW) this.readWindow.shift();\n 136→"
