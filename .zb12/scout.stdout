      "text": "Stdout: ./apps/server/src/agent/lifecycle.ts:48:\tresolvePersona,\n./apps/server/src/agent/lifecycle.ts:419:\t\t\t\t\t\treturn resolvePersona(partnersStore, PERSONA);\n./apps/server/src/chief.test.ts:21:\tresolvePersona,\n./apps/server/src/chief.test.ts:90:\t\t\tresolvePersona(\n./apps/server/src/chief.test.ts:104:\t\t\tassert.equal(resolvePersona(() => store, PERSONA_FALLBACK), PERSONA_FALLBACK);\n./apps/server/src/chief.test.ts:109:\t\t\tassert.equal(resolvePersona(() => store, PERSONA_FALLBACK), CHIEF_SEED);\n./apps/server/src/chief.test.ts:114:\t\t\tassert.equal(resolvePersona(() => store, PERSONA_FALLBACK), \"新版总管身份\");\n./apps/server/src/chief.test.ts:172:\t\t\tassert.equal(resolvePersona(() => store, PERSONA_FALLBACK), PERSONA_FALLBACK, \"常量直读\");\n./apps/server/src/partners.ts:1212:export function resolvePersona(getStore: () => PartnersStore, fallback: string): string {\n=== PERSONA const ===\napps/server/src/agent/assist.ts:24:export const PERSONA = [\napps/server/src/agent/assist.ts:47:export const WORKER_PERSONA = [\napps/server/src/agent/assist.ts:148: * 播种失败只 warn：主对话的 persona 会回落 PERSONA 常量，绝不会被弄哑。\napps/server/src/agent/assist.ts:152:\t\tensureChiefPartner(PERSONA);\napps/server/src/agent/assist.ts:155:\t\tconsole.warn(`[chief] 总管播种失败（主对话回落 PERSONA）: ${detail}`);\napps/server/src/agent/lifecycle.ts:103:\tPERSONA,\napps/server/src/agent/lifecycle.ts:104:\tWORKER_PERSONA,\napps/server/src/agent/lifecycle.ts:389:\t\t// `PERSONA_MEMORY_ASK` 配置 = 启用（默认未配置 = 工具不上架）；`PERSONA_MEMORY_ENABLED=false`\napps/server/src/agent/lifecycle.ts:405:\t\t\t\t//  - chief / 无记录旧会话 → 总管 SOUL 当前版本快照，读不到回落原 PERSONA 常量。\napps/server/src/agent/lifecycle.ts:418:\t\t\t\t\t\tif (kinds?.byInternal?.[String(input.conversationId)] === \"worker\") return WORKER_PERSONA;\napps/server/src/agent/lifecycle.ts:419:\t\t\t\t\t\treturn resolvePersona(partnersStore, PERSONA);\napps/server/src/chief.test.ts:30:const PERSONA_FALLBACK = \"原始 PERSONA 正文（回落用）\";\napps/server/src/chief.