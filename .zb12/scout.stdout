      "type": "text",
      "text": " 230→\t}\n 231→}\n 232→\n 233→/** 压成一行再按字数截断；派活汇报与恢复回灌共用（2026-11-04）。 */\n 234→export function truncate(text: string, max: number): string {\n 235→\tconst oneLine = text.replace(/\\s+/g, \" \").trim();\n 236→\treturn oneLine.length <= max ? oneLine : `${oneLine.slice(0, max - 1)}…`;\n 237→}\n 238→\n 239→/** 计划附件的上限（2026-11-09 §2.1）：≤12 条，每条 ≤200 字。 */\n 240→export const DELEGATION_STEPS_MAX = 12;\n 241→export const DELEGATION_STEP_MAX_CHARS = 200;\n 242→\n 243→/**\n 244→ * 校验 `delegate` 的 steps 参数（纯函数，单测直接断言）。\n 245→ *\n 246→ * 语义 = \"这条要求拆成的可核对动作序列\"。不传 / 空数组 = 旧行为（ticket 不带 steps 字段）；\n 247→ * 超限直接报错，**不建单**——宁可让模型改一次参数，也不要在详情里显示半截步骤。\n 248→ */\n 249→export function normalizeDelegationSteps(\n 250→\traw: unknown,\n 251→): { ok: true; steps?: string[] } | { ok: false; message: string } {\n 252→\tif (raw === undefined || raw === null) return { ok: true };\n 253→\tif (!Array.isArray(raw)) return { ok: false, message: \"steps 必须是字符串数组\" };\n 254→\tif (raw.length === 0) return { ok: true };\n 255→\tif (raw.length > DELEGATION_STEPS_MAX) {\n 256→\t\treturn { ok: false, message: `steps 最多 ${DELEGATION_STEPS_MAX} 条（当前 ${raw.length}）` };\n 257→\t}\n 258→\tconst steps: string[] = [];\n 259→\tfor (const item of raw) {\n 260→\t\tif (typeof item !== \"string\") return { ok: false, message: \"steps 每一项都必须是字符串\" };\n 261→\t\tconst text = item.trim();\n 262→\t\tif (!text) return { ok: false, message: \"steps 里不能有空步骤\" };\n 263→\t\tif (text.length > DELEGATION_STEP_MAX_CHARS) {\n 264→\t\t\treturn {\n 265→\t\t\t\tok: false,\n 266→\t\t\t\tmessage: `每条步骤最多 ${DELEGATION_STEP_MAX_CHARS} 字（当前 ${text.length}）`,\n 267→\t\t\t};\n 268→\t\t}\n 269→\t\tsteps.push(text);\n 270→\t}\n 271→\treturn { ok: true, steps };\n 272→}\n 273→\n 274→/**\n 275→ * 收到工人「需要你」时的应答口径（2026-11-08 员工人格化刀一 §4 B2，提示词层）。\n 276→ *\n 277→ * 为什么要有这一条：attention 三种（need_input / need_decision / need_action）是\n 278→ * **工人卡住等你**，不是\"出错了\"。执事答得了就该直接答；一时答不了（缺信息 / 要问主人 /\n 279→ * 需要用户拍板），也必须明确让工人**跳过该项继续其余部分**——否则整单停在一件小事上，\n 280→ * 用户看到的是\"活干到一半没了\"。审批侧已有同款\"先做不需要批准的部分\"（批 8c turn-gate），\n 281→ * 这里只补 attention 这一侧，两处互不替代。\n 282→ *\n 283→ * 落点：由 `agent/partner-context.ts` 拼进执事轮的「当前在办」段（只在有在办事项时出现）。\n 284→ */\n 285→export const ATTENTION_REPLY_GUIDANCE = [\n 286→\t\"工人回报「需要你」（need_input / need_decision / need_action）时：\",\n 287→\t\"- 答得了就直接答（缺什么信息就补什么，要主人拍板的就明确说是哪一项）。\",\n 288→\t\"- 一时答不了，就明确告诉工人：「这一项先跳过，继续其余部分，这项回头再补」——不要让整单停在这一项上，也不要自己猜一个答案糊过去。\",\n 289→].join(\"\\n\");\n 290→\n 291→/**\n 292→ * 周期盘点口径（2026-11-08 员工人格化刀二 E4，方案 §五.5：不打分、不搞 KPI 数字）。\n 293→ *\n 294→ * 提示词层，两处消费：`tools.ts` 的 `routine_manage` 工具描述、\n 295→ * `agent/partner-context.ts` 的装配段。执事按周期盘点时：读自己 work 履历 →\n 296→ * 一段自然语言总结（几单、成几单、什么教训）→ 总结落一条 episode 记忆 → 向主人汇报。\n 297→ * 刻意**不**要求自动建周回顾规则（静默的自动轮 = 意外 token 账单）：规则由主人配，\n 298→ * 或主人说一句\"你每周五自己盘点\"后由执事经 routine_manage 自建（人点头过一次）。\n 299→ */\n 300→export const WORK_REVIEW_GUIDANCE = [\n 301→\t\"按周期盘点自己干过的活时：读自己的 work 工作履历，用一段自然语言说清这一阵子\",\n 302→\t\"接了几单、成了几单、哪一单卡过、有什么该记取的教训（不打分、不列 KPI 数字）；\",\n 303→\t\"把这段总结用 remember 落一条 kind=episode 的记忆，再向主人汇报。\",\n 304→\t\"不要自己悄悄创建回顾规则——要主人配，或主人说一句你再用 routine_manage 建。\",\n 305→].join(\"\\n\");\n 306→\n 307→/** 注入给 chancellor 的宰相身份正文上限（批次D D2）：宿主侧按 UTF-8 字节截断，chancellor 只透传。 */\n 308→export const MANAGER_SOUL_LIMIT_BYTES = 4 * 1024;\n 309→\n 310→/**\n 311→ * 纯函数：把按 domain 命中的执事组装成 ChancellorRequest.managerIdentity。\n 312→ * 没命中（旧领域 / 执事库不可用）返回 undefined —— 请求不带身份，行为与改动前一致。\n 313→ * soul 取调用方给的**当前版本快照正文**（不读磁盘当前值），按字节截到 ≤4KB、不切坏多字节字符。\n 314→ * 抽成导出的纯函数是为了单测能直接断言组装结果，不必起服务。\n 315→ */\n 316→export function buildManagerIdentity(\n 317→\thit: { name: string; soul: string } | null | undefined,\n 318→): { name: string; soul: string } | undefined {\n 319→\tif (!hit) return undefined;\n 320→\treturn { name: hit.name, soul: truncateUtf8(hit.soul, MANAGER_SOUL_LIMIT_BYTES) };\n 321→}\n 322→\n 323→function truncateUtf8(text: string, maxBytes: number): string {\n 324→\tconst buf = Buffer.from(text, \"utf8\");\n 325→\tif (buf.length <= maxBytes) return text;\n 326→\tlet end = maxBytes;\n 327→\t// 回退到不切断 UTF-8 多字节序列的边界（续字节 10xxxxxx 一律往回让）。\n 328→\twhile (end > 0 && ((buf[end] ?? 0) & 0xc0) === 0x80) end -= 1;\n 329→\treturn buf.subarray(0, end).toString(\"utf8\");\n 330→}\n 331→\n 332→/** 结论怎么写成会话里那一行。80 字上限是方案里定的。 */\n 333→export function formatReport(\n 334→\tresult: TicketResult,\n 335→\tdomain: string,\n 336→): DelegationReport {\n 337→\tconst phase: DelegationPhase =\n 338→\t\tresult.status === \"done\"\n 339→\t\t\t? \"done\"\n 340→\t\t\t: result.status === \"needs_you\"\n 341→\t\t\t\t? \"needs_you\"\n 342→\t\t\t\t: result.status === \"aborted\"\n 343→\t\t\t\t\t? \"aborted\"\n 344→\t\t\t\t\t: \"failed\";\n 345→\tconst head = `【任务 ${result.ticketId}${domain ? ` · ${domain}` : \"\"}】`;\n 346→\tconst body =\n 347→\t\tphase === \"done\"\n 348→\t\t\t? `已完成：${result.line}`\n 349→\t\t\t: phase === \"needs_you\"\n 350→"
    },
