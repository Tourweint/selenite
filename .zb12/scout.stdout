      "text": " 300→\t\tconst result = this.db\n 301→\t\t\t.prepare(\n 302→\t\t\t\t`INSERT OR IGNORE INTO delegation_cancellations\n 303→\t\t\t\t (ticket_id, canceled_at, conversation_id) VALUES (?, ?, ?)`,\n 304→\t\t\t)\n 305→\t\t\t.run(ticketId, new Date().toISOString(), conversationId);\n 306→\t\treturn Number(result.changes) > 0;\n 307→\t}\n 308→\n 309→\tisCanceled(ticketId: string): boolean {\n 310→\t\tconst row = this.db\n 311→\t\t\t.prepare(\"SELECT 1 FROM delegation_cancellations WHERE ticket_id = ?\")\n 312→\t\t\t.get(ticketId);\n 313→\t\treturn row !== undefined;\n 314→\t}\n 315→\n 316→\t/** 投影用：一次取出所有已作废单号，避免逐行查库。 */\n 317→\tcanceledTicketIds(): Set<string> {\n 318→\t\tconst rows = this.db\n 319→\t\t\t.prepare(\"SELECT ticket_id FROM delegation_cancellations\")\n 320→\t\t\t.all() as Array<Record<string, unknown>>;\n 321→\t\treturn new Set(rows.map((row) => text(row.ticket_id)));\n 322→\t}\n 323→\n 324→\tcancelInfo(ticketId: string): { canceledAt: string; conversationId: number | null } | null {\n 325→\t\tconst row = this.db\n 326→\t\t\t.prepare(\"SELECT * FROM delegation_cancellations WHERE ticket_id = ?\")\n 327→\t\t\t.get(ticketId) as Record<string, unknown> | undefined;\n 328→\t\tif (!row) return null;\n 329→\t\treturn {\n 330→\t\t\tcanceledAt: text(row.canceled_at),\n 331→\t\t\tconversationId:\n 332→\t\t\t\trow.conversation_id === null || row.conversation_id === undefined\n 333→\t\t\t\t\t? null\n 334→\t\t\t\t\t: Number(row.conversation_id),\n 335→\t\t};\n 336→\t}\n 337→\n 338→\t/**\n 339→\t * 这张单已经重派过几次（requestId = `retry:<原单id>:<次数>`）。\n 340→\t * 用 substr 前缀精确匹配而不是 LIKE，免得单号里的 % / _ 被当成通配符。\n 341→\t */\n 342→\tcountRetries(ticketId: string): number {\n 343→\t\tconst prefix = `retry:${ticketId}:`;\n 344→\t\tconst row = this.db\n 345→\t\t\t.prepare(\n 346→\t\t\t\t\"SELECT COUNT(*) AS n FROM delegation_receipts WHERE substr(request_id, 1, ?) = ?\",\n 347→\t\t\t)\n 348→\t\t\t.get(prefix.length, prefix) as { n?: unknown } | undefined;\n 349→\t\treturn Number(row?.n ?? 0);\n 350→\t}\n 351→\n 352→\t/**\n 353→\t * 续跑回执（2026-11-08 扫尾批 7a）：resume 不产新单，但要把这张单映射到\n 354→\t * **这次发起 resume 的会话**——完成/重启恢复都按回执里的 ticket→conversation 回灌，\n 355→\t * 不写这一行就永远落到最初派单的那条对话。\n 356→\t *\n 357→\t * 写法与重试同构：`resume:<原单id>:<次数>`，ticket_id 仍是原单号，一行一次 resume。\n 358→\t * 次数递增保证幂等键不撞（同单连续 resume 各留一行），恢复端 `lookupByTicket`\n 359→\t * 按 `updated_at DESC, rowid DESC` 取最新 —— 天然取到最近一次 resume 那行，不用改。\n 360→\t *\n 361→\t * `DELEGATION_MAP_PERSIST=false` 时**整行不写**（不是写一行空映射）：这条回执的唯一\n 362→\t * 用途就是会话映射，写空映射反而会盖掉原单那行，比不写更差；回滚后应与改动前逐字节一致。\n 363→\t *\n 364→\t * 返回落下的 requestId；没落（开关关 / 单号为空）返回 null。\n 365→\t */\n 366→\trecordResume(ticketId: string, conversationId: number): string | null {\n 367→\t\tif (!ticketId || !mapPersistEnabled()) return null;\n 368→\t\tconst count = this.countResumes(ticketId) + 1;\n 369→\t\tconst requestId = `resume:${ticketId}:${count}`;\n 370→\t\tconst fingerprint = fingerprintOf({ kind: \"resume\", ticketId, count });\n 371→\t\t// 同一 requestId 并发撞车时 begin 返回 existing：那行已经指向\"先到的那个会话\"，\n 372→\t\t// 不再覆盖 —— 不去抢，也不报错。\n 373→\t\tif (this.begin(requestId, fingerprint, { explicit: true }).kind !== \"new\") return requestId;\n 374→\t\tthis.accept(requestId, ticketId, conversationId);\n 375→\t\treturn requestId;\n 376→\t}\n 377→\n 378→\t/** 这张单被 resume 过几次（前缀口径同 `countRetries`：substr 精确匹配，不用 LIKE）。 */\n 379→\tcountResumes(ticketId: string): number {\n 380→\t\tconst prefix = `resume:${ticketId}:`;\n 381→\t\tconst row = this.db\n 382→\t\t\t.prepare(\n 383→\t\t\t\t\"SELECT COUNT(*) AS n FROM delegation_receipts WHERE substr(request_id, 1, ?) = ?\",\n 384→\t\t\t)\n 385→\t\t\t.get(prefix.length, prefix) as { n?: unknown } | undefined;\n 386→\t\treturn Number(row?.n ?? 0);\n 387→\t}\n 388→}\n 389→\n 390→function toReceipt(row: Record<string, unknown>): DelegationReceipt {\n 391→\treturn {\n 392→\t\trequestId: text(row.request_id),\n 393→\t\tticketId: text(row.ticket_id),\n 394→\t\tfingerprint: text(row.fingerprint),\n 395→\t\tconversationId:\n 396→\t\t\trow.conversation_id === null || row.conversation_id === undefined\n 397→\t\t\t\t? null\n 398→\t\t\t\t: Number(row.conversation_id),\n 399→\t\tbootId: row.boot_id === null || row.boot_id === undefined ? null : text(row.boot_id) || null,\n 400→"
    },
