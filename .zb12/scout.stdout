      "type": "text",
      "text": "1195→export function ensureChiefPartner(seedSoul: string): void {\n1196→\tif (!chiefPartnerEnabled() || !COMPANIONS_ENABLED) return;\n1197→\tpartnersStore().ensureChief(seedSoul);\n1198→}\n1199→\n1200→/** 总管 SOUL 当前身份正文：当前版本快照优先（版本冻结口径），磁盘当前值兜底；不可读返回 null。 */\n1201→export function chiefSoul(store: PartnersStore): string | null {\n1202→\tif (!store.get(CHIEF_PARTNER_ID)) return null;\n1203→\tconst snapshot = store.currentVersion(CHIEF_PARTNER_ID)?.soulSource;\n1204→\tconst soul = snapshot?.trim() ? snapshot : store.readSoulFromHome(CHIEF_PARTNER_ID);\n1205→\treturn soul?.trim() ? soul : null;\n1206→}\n1207→\n1208→/**\n1209→ * persona 正文：总管存在且 SOUL 可读时用 SOUL 当前版本快照，否则回落 fallback(=PERSONA)。\n1210→ * 兜底存在的原因：执事库初始化失败 / 查询抛错时**主对话不能哑**，必须还有人格。\n1211→ */\n1212→export function resolvePersona(getStore: () => PartnersStore, fallback: string): string {\n1213→\tif (!chiefPartnerEnabled()) return fallback;\n1214→\ttry {\n1215→\t\treturn chiefSoul(getStore()) ?? fallback;\n1216→\t} catch {\n1217→\t\treturn fallback;\n1218→\t}\n1219→}\n1220→\n1221→/**\n1222→ * 会话 → 有效执事 id（含总管）。\n1223→ * 行为零变化要点：**不复用 / 不修改 partnerIdOfSession**——autonomy / routines 靠\n1224→ * \"partnerIdOfSession === null 就是主人会话\" 做防自环，它们继续用原始函数。\n1225→ * CHIEF 开时，没挂链接表的主人会话解析为固定 id `\"chief\"`；执事会话返回真实 uuid。\n1226→ */\n1227→export function effectivePartnerIdOfSession(store: PartnersStore, sessionId: number): string | null {\n1228→\tconst linked = store.partnerIdOfSession(sessionId);\n1229→\tif (linked !== null) return linked;\n1230→\treturn chiefPartnerEnabled() ? CHIEF_PARTNER_ID : null;\n1231→}\n1232→\n1233→/**\n1234→ * 执事记忆 scope：总管（chief）刻意返回 null —— 他继续读写 `global + session`，\n1235→ * 不吃 `partner:<id>` 键空间（系统架构将记 D15）。其余执事照旧返回 partner scope。\n1236→ * 这是与普通执事的**刻意差异**，别\"修\"成一致。\n1237→ */\n1238→export function resolvePartnerScope(store: PartnersStore, sessionId: number): MemoryScope | null {\n1239→\tconst id = effectivePartnerIdOfSession(store, sessionId);\n1240→"
    },
