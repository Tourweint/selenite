      "text": "   1→import { existsSync, readdirSync } from \"node:fs\";\n   2→import { join } from \"node:path\";\n   3→import { randomUUID } from \"node:crypto\";\n   4→import { BACKGROUND_CONTEXT } from \"@earendil-works/chord/context\";\n   5→import { InboxDoc, defineDoc, type ConversationId, type Cursor, type EntryDraft, type JsonObject, type Tx } from \"@earendil-works/pi-durable\";\n   6→import {\n   7→\tCHIEF_PARTNER_ID,\n   8→\tCOMPANIONS_ENABLED,\n   9→\tpartnersStore,\n  10→\ttype PartnerRow,\n  11→} from \"./partners.ts\";\n  12→import { markAutonomyTurn, unmarkAutonomyTurn } from \"./autonomy-state.ts\";\n  13→import {\n  14→\tassessRoutineOutput,\n  15→\tROUTINE_QUIET_INSTRUCTION,\n  16→\troutineQuietEnabled,\n  17→} from \"./routine-quiet.ts\";\n  18→import { nextChainCandidate } from \"./model-chain.ts\";\n  19→import type { SettledSubmissionRecord } from \"@earendil-works/pi-durable\";\n  20→import {\n  21→\tchatStream,\n  22→\tconfigureTaskChat,\n  23→\topenOrCreateChat,\n  24→\ttype ResolvedChat,\n  25→} from \"./agent.ts\";\n  26→\n  27→/** 与 agent.ts 同一背景上下文：跑在后台、不绑任何请求 */\n  28→const CTX = BACKGROUND_CONTEXT;\n  29→\n  30→/**\n  31→ * 执事的**会话运行时**（2026-11-05 批次B B2）。\n  32→ *\n  33→ * 单独成文件的原因：它要 import agent.ts（openOrCreateChat / chatStream），\n  34→ * 而 agent.ts 不能反向 import 它（装配方向 partners ← agent ← partner-runtime，\n  35→ * 反过来就成环）。storage 在 partners.ts，\"怎么跑\"在这里。\n  36→ *\n  37→ * 身份契约（照 cindy，双层）：每轮开跑前对一次版本——\n  38→ *   会话链接上记 `appliedVersion`（最近一次配进会话的身份版本），\n  39→ *   档案上记 `currentVersion`（最新快照）；两者不等 = SOUL 改过还没生效 →\n  40→ *   开跑前 configure 一次。**改完 SOUL 下一轮生效**，这是设计出来的不一致。\n  41→ */\n  42→\n  43→/** 执事主会话的对外 id 约定。它是一条真会话：历史可回读、出现在会话列表里。 */\n  44→export function partnerCanonicalExternalId(partnerId: string): string {\n  45→\treturn `partner-${partnerId}`;\n  46→}\n  47→\n  48→/** 执事身份提示词：SOUL 快照（认版本号）+ USER.md 摘要 + 技能索引。 */\n  49→export function renderPartnerIdentity(partner: PartnerRow, soulSource: string): string {\n  50→\tconst store = partnersStore();\n  51→\tconst sections: string[] = [soulSource.trim()];\n  52→\n  53→\tconst userMd = store.readUserMd(partner.id);\n  54→\tif (userMd && userMd.trim()) {\n  55→\t\tsections.push(\n  56→\t\t\t[\"# 主人画像（memories/USER.md）\", userMd.trim()].join(\"\\n\\n\"),\n  57→\t\t);\n  58→\t}\n  59→\n  60→\tconst skills = partnerSkillsIndex(partner.id);\n  61→\tif (skills) sections.push(skills);\n  62→\n  63→\tsections.push(\n  64→\t\t[\n  65→\t\t\t\"# 运行边界\",\n  66→\t\t\t\"- 你的记忆与技能独立于主人的助手；写文件默认落在你的 workspace/。\",\n  67→\t\t\t\"- 需要长期记住的事用 remember（会自动记到你的键空间）；把流程沉淀成技能用 partner_skill_write。\",\n  68→\t\t].join(\"\\n\"),\n  69→\t);\n  70→\treturn sections.join(\"\\n\\n\");\n  71→}\n  72→\n  73→/** 执事技能索引：目录约定与全局 skills/ 相同（*.md，第 1 行 = 索引摘要）。 */\n  74→function partnerSkillsIndex(partnerId: string): string | undefined {\n  75→\tconst dir = partnersStore().skillsDirOf(partnerId);\n  76→\tif (!existsSync(dir)) return undefined;\n  77→\tconst names = readdirSync(dir)\n  78→\t\t.filter((f) => f.endsWith(\".md\"))\n  79→\t\t.sort();\n  80→\tif (names.length === 0) return undefined;\n  81→\tconst lines = names.map((file) => {\n  82→\t\tconst raw = partnersStore().readHomeFile(partnerId, join(\"skills\", file)) ?? \"\";\n  83→\t\tconst summary = raw.split(\"\\n\", 1)[0]?.trim() || file.replace(/\\.md$/, \"\");\n  84→\t\treturn `- ${file.replace(/\\.md$/, \"\")}：${summary.slice(0, 72)}`;\n  85→\t});\n  86→\treturn [\"# 技能索引（完整手册用 partner 技能名取，直接读 skills/<名>.md）\", ...lines].join(\n  87→\t\t\"\\n\",\n  88→\t);\n  89→}\n  90→\n  91→/**\n  92→ * 同 partner 的 canonical 创建单飞（2026-11-06 侧栏调整 B3）。\n  93→ *\n  94→ * `openOrCreateChat` 是 check-then-create：两个并发的 open（双击 / 多标签页）都会看到\n  95→ * \"还没有\"，各建一条 `partner-<id>` 会话，链接表只记住后写的一条，前一条就成了孤儿。\n  96→ * 这不是全局调度，只收敛同一 partner 的创建窗口（窗口结束立刻出表）。\n  97→ */\n  98→const sessionOpenings = new Map<string, Promise<ResolvedChat | null>>();\n  99→\n 100→export function ensurePartnerSession(partnerId: string): Promise<ResolvedChat | null> {\n 101→\tconst inflight = sessionOpenings.get(partnerId);\n 102→\tif (inflight) return inflight;\n 103→\tconst opening = openPartnerSession(partnerId).finally(() => {\n 104→\t\tsessionOpenings.delete(partnerId);\n 105→\t});\n 106→\tsessionOpenings.set(partnerId, opening);\n 107→\treturn opening;\n 108→}\n 109→\n 110→/**\n 111→"
