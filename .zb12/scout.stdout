      "text": " 630→\t\t\tthrow error;\n 631→\t\t}\n 632→\t}\n 633→\n 634→\treadSoulFromHome(partnerId: string): string | null {\n 635→\t\treturn this.readHomeFile(partnerId, \"SOUL.md\");\n 636→\t}\n 637→\n 638→\t/**\n 639→\t * 岗位契约当前值（磁盘）。缺失 = null（旧执事没有这个文件，读取方按\"四节全空\"处理）。\n 640→\t * 与 SOUL 同址同权限：64KB 单槽、原子写。\n 641→\t */\n 642→\treadContractFromHome(partnerId: string): string | null {\n 643→\t\treturn this.readHomeFile(partnerId, \"CONTRACT.md\");\n 644→\t}\n 645→\n 646→\t/**\n 647→\t * 播种空契约模板（只在新建执事时调用；幂等，已有内容绝不覆盖）。\n 648→\t * 开关关着 = 一个字节都不写（回滚后与改动前逐字节一致）。\n 649→\t */\n 650→\tseedContract(partnerId: string): void {\n 651→\t\tif (!partnerContractEnabled()) return;\n 652→\t\tconst path = join(this.homeOf(partnerId), \"CONTRACT.md\");\n 653→\t\tif (existsSync(path)) return;\n 654→\t\tthis.atomicWrite(path, partnerContractTemplate());\n 655→\t}\n 656→\n 657→\treadUserMd(partnerId: string): string | null {\n 658→\t\treturn this.readHomeFile(partnerId, join(\"memories\", \"USER.md\"));\n 659→\t}\n 660→\n 661→\treadHomeFile(partnerId: string, relative: string): string | null {\n 662→\t\tconst path = join(this.homeOf(partnerId), relative);\n 663→\t\tif (!existsSync(path)) return null;\n 664→\t\ttry {\n 665→\t\t\treturn readFileSync(path, \"utf8\");\n 666→\t\t} catch {\n 667→\t\t\treturn null;\n 668→\t\t}\n 669→\t}\n 670→\n 671→\t/**\n 672→\t * 改 SOUL.md（磁盘当前值）+ 落新版本快照，返回新版本号。能力（候选链）随版本延续，不被冲掉。\n 673→\t * 2026-11-08 E1：契约快照同时落一份（身份版本 = SOUL + CONTRACT 对），\n 674→\t * 取磁盘当前值（它是\"当前值\"的家），取不到再退当前快照。\n 675→\t */\n 676→\tbumpSoul(partnerId: string, soulSource: string): number {\n 677→\t\tif (!this.get(partnerId)) throw new Error(`执事不存在：${partnerId}`);\n 678→\t\tthis.atomicWrite(join(this.homeOf(partnerId), \"SOUL.md\"), soulSource);\n 679→\t\tconst current = this.currentVersion(partnerId);\n 680→\t\tconst contract = this.readContractFromHome(partnerId) ?? current?.contractSource ?? null;\n 681→\t\treturn this.pushVersion(partnerId, soulSource, current?.capabilities ?? null, contract);\n 682→\t}\n 683→\n 684→\t/**\n 685→\t * 改 CONTRACT.md（磁盘当前值）+ 落新版本快照，返回新版本号（2026-11-08 E1）。\n 686→\t *\n 687→\t * 与 bumpSoul 完全同构：调岗是低频慎重的事，但\"下一轮生效\"的口径与 SOUL 一致——\n 688→\t * 改完不当场变身。SOUL 侧取磁盘当前值（同上），能力随版本延续。\n 689→\t */\n 690→"
