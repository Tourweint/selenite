    "status": "completed",
    "output": {
      "type": "text",
      "text": "   1→/**\n   2→ * 派活的进度与「需要你」事件（2026-11-02；2026-11-03 补异步任务单字段）。\n   3→ *\n   4→ * 为什么单独一个模块：发事件的是工具（`tools.ts` 里的 `delegate`），\n   5→ * 收事件的是对话流（`agent.ts` 的 `chatStream`）。这两个文件本来就互相引用，\n   6→ * 再把通道塞进其中一边就会成环。放中间，两边都只依赖它。\n   7→ *\n   8→ * 2026-11-03：派单改成\"立即受理、后台执行\"。`startDelegation` 是这一段的最小骨架：\n   9→ * 同步返回任务单号，后台跑完再发事件 / 写汇报。真正的进程管理仍然在 chancellor 里。\n  10→ *\n  11→ * 2026-11-04：审批事件**借道本通道**（`type: \"approval\"`），因为它与派活同样是\n  12→ * \"工具钩子写、对话流读\"的一对多通道。只是借传输，与派活语义无关。\n  13→ */\n  14→\n  15→import path from \"node:path\";\n  16→import type { DelegationPhase } from \"@lifediary/shared\";\n  17→import type {\n  18→\tChancellorEvent,\n  19→\tChancellorRequest,\n  20→\tTicketResult,\n  21→} from \"../../../../../chancellor/src/index.ts\";\n  22→import type { ProjectRef } from \"./projects.ts\";\n  23→import {\n  24→\tdelegationMessages,\n  25→\ttype DelegationSenderKind,\n  26→} from \"./delegation-messages.ts\";\n  27→import type { WorkSettlementInput, WorkStatus } from \"./work-record.ts\";\n  28→\n  29→export type DelegationEvent =\n  30→\t/** 进度：这张单在哪个阶段、办到第几件、共几件、这件叫什么 */\n  31→\t| {\n  32→\t\t\ttype: \"delegate\";\n  33→\t\t\tticketId: string;\n  34→\t\t\tdomain: string;\n  35→\t\t\tphase: DelegationPhase;\n  36→\t\t\tdone: number;\n  37→\t\t\ttotal: number;\n  38→\t\t\tcurrent: string;\n  39→\t\t\tmessage?: string;\n  40→\t\t\t/** 项目名；没有项目的旧链路为空。 */\n  41→\t\t\tproject?: string;\n  42→\t\t\t/** 最近一次动作，和 current 同源，但读接口按这个口径展示。 */\n  43→\t\t\tlastAction?: string;\n  44→\t\t\t/** 发事件这一刻的心跳；客户端据此判断「还活着」。 */\n  45→\t\t\tlastHeartbeat?: string;\n  46→\t\t\t/** 等文件租约时被谁卡住。 */\n  47→\t\t\twaitingOn?: string;\n  48→\t  }\n  49→\t/** 需要人：一个问题，不是一句「出错了」 */\n  50→\t| {\n  51→\t\t\ttype: \"attention\";\n  52→\t\t\tticketId: string;\n  53→\t\t\tdomain: string;\n  54→\t\t\tkind: \"need_input\" | \"need_decision\" | \"need_action\";\n  55→\t\t\tquestion: string;\n  56→\t  }\n  57→\t/** 写类工具要人确认（2026-11-04 批次二）；借本通道传输，与派活无关 */\n  58→\t| {\n  59→\t\t\ttype: \"approval\";\n  60→\t\t\tcallId: string;\n  61→\t\t\ttool: string;\n  62→\t\t\targs: string;\n  63→\t\t\tdeadlineAt: string;\n  64→\t\t\t/** 自主轮标记（批次C C2）：例行轮的审批卡，纯增量字段 */\n  65→\t\t\torigin?: \"autonomous\";\n  66→\t  };\n  67→\n  68→export interface DelegationReport {\n  69→\tticketId: string;\n  70→\tdomain: string;\n  71→\tphase: DelegationPhase;\n  72→\t/** 写回会话的一行话，已截断到 80 字 */\n  73→\ttext: string;\n  74→}\n  75→\n  76→/**\n  77→ * 任务专线会话的镜像条目（2026-11-08 扫尾批 8g）。\n  78→ *\n  79→ * 只描述\"往会话里追加一行什么\"，怎么落（pi.assistant 条目、队列、幂等）由\n  80→ * `task-conversation.ts` 决定。`kind` 目前只用于日志与测试断言：\n  81→"
    },
