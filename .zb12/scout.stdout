      "text": " 330→}\n 331→\n 332→/** 结论怎么写成会话里那一行。80 字上限是方案里定的。 */\n 333→export function formatReport(\n 334→\tresult: TicketResult,\n 335→\tdomain: string,\n 336→): DelegationReport {\n 337→\tconst phase: DelegationPhase =\n 338→\t\tresult.status === \"done\"\n 339→\t\t\t? \"done\"\n 340→\t\t\t: result.status === \"needs_you\"\n 341→\t\t\t\t? \"needs_you\"\n 342→\t\t\t\t: result.status === \"aborted\"\n 343→\t\t\t\t\t? \"aborted\"\n 344→\t\t\t\t\t: \"failed\";\n 345→\tconst head = `【任务 ${result.ticketId}${domain ? ` · ${domain}` : \"\"}】`;\n 346→\tconst body =\n 347→\t\tphase === \"done\"\n 348→\t\t\t? `已完成：${result.line}`\n 349→\t\t\t: phase === \"needs_you\"\n 350→\t\t\t\t? `有一项需要你处理：${result.attention?.question ?? result.line}`\n 351→\t\t\t\t: phase === \"aborted\"\n 352→\t\t\t\t\t? `已中断：${result.line}`\n 353→\t\t\t\t\t: `未完成：${result.line}`;\n 354→\treturn {\n 355→\t\tticketId: result.ticketId,\n 356→\t\tdomain,\n 357→\t\tphase,\n 358→\t\ttext: truncate(`${head}${body}`, 80),\n 359→\t};\n 360→}\n 361→\n 362→/** 进度行的阶段词（专线会话用；终态走 REPORT，不在 `emitProgress` 里）。 */\n 363→const PROGRESS_LABEL: Partial<Record<DelegationPhase, string>> = {\n 364→\taccepted: \"已受理\",\n 365→\tplanning: \"规划中\",\n 366→\trunning: \"进行中\",\n 367→\treviewing: \"核对中\",\n 368→};\n 369→\n 370→/**\n 371→ * 进度事件 → 专线会话里的一行（纯函数，单测直接断言）。\n 372→ *\n 373→ * 刻意不合并、不节流：留言表/事件是逐条发生的，专线也逐条记，\n 374→ * 这样\"专线里的顺序\"才真的等于\"事件发生的顺序\"（方案 §四的验证项）。\n 375→ */\n 376→export function formatProgressLine(input: {\n 377→\tphase: DelegationPhase;\n 378→\tdone: number;\n 379→\ttotal: number;\n 380→\tcurrent: string;\n 381→\twaitingOn?: string;\n 382→}): string {\n 383→\tconst label = PROGRESS_LABEL[input.phase] ?? input.phase;\n 384→\tconst count = input.total > 0 ? `（${input.done}/${input.total}）` : \"\";\n 385→\tconst waiting = input.waitingOn ? `，等 ${input.waitingOn}` : \"\";\n 386→\treturn `【进度】${label}：${input.current || \"…\"}${count}${waiting}`;\n 387→}\n 388→\n 389→/** 留言 → 专线里的一行。 */\n 390→export function formatMessageLine(name: string, body: string): string {\n 391→\treturn `【留言】${name}：${body}`;\n 392→}\n 393→\n 394→/**\n 395→ * 立即受理：同步返回任务单号，后台跑完再发事件/汇报。\n 396→ *\n 397→ * 为什么能同步拿到单号：`runChancellor` 在第一次 `await` 之前就会发出\n 398→ * `ticket`（v0.3 路径）或 `manager`（分管路径）事件，两张都带 `ticketId`。\n 399→ * 所以这里不需要改 chancellor 的契约，也不需要预生成单号。\n 400→ */\n 401→export function startDelegation(\n 402→\tkick: DelegationKickoff,\n 403→\truntime: DelegationRuntime,\n 404→): {\n 405→\tticketId: string;\n 406→\toutcome: Promise<TicketResult>;\n 407→\t/** 续跑被拒、已改派新单（单号对不上，不能当成续跑成功）。 */\n 408→\tfellBack: boolean;\n 409→} {\n 410→"
    },
