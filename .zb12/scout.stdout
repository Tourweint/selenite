    "output": {
      "type": "text",
      "text": "   1→import { createMemoryEngine, scopeKey, type MemoryEngine, type MemoryScope } from \"@lifediary/memory\";\n   2→import { diaryStore } from \"../diary.ts\";\n   3→import { recentDiaryMemories, syncDiaryToMemory } from \"../memory-ingest.ts\";\n   4→import { preferenceExtractor } from \"../memory-extract.ts\";\n   5→import {\n   6→\tCOMPANIONS_ENABLED,\n   7→\tchiefPartnerEnabled,\n   8→\tchiefSkillsDir,\n   9→\tensureChiefPartner,\n  10→\tpartnersStore,\n  11→\tresolvePartnerScope,\n  12→} from \"../partners.ts\";\n  13→import { createSkillStore, resolveSkillsDir, type SkillStore } from \"../skills.ts\";\n  14→import { getSkillState, skillStateEnabled } from \"../skill-state.ts\";\n  15→\n  16→/**\n  17→ * 派活能力（chancellor）是否装。\n  18→ *\n  19→ * 默认装。关掉（`CHANCELLOR_ENABLED=false`）时工具清单回到 8 个，行为与改动前完全一致\n  20→ * ——这是回滚开关，不是功能开关：出问题时不用改代码，改一行环境变量就退回去。\n  21→ */\n  22→export const CHANCELLOR_ENABLED = (process.env.CHANCELLOR_ENABLED?.trim() || \"true\").toLowerCase() !== \"false\";\n  23→\n  24→export const PERSONA = [\n  25→\t\"你是一个个人助手，和一个具体的人长期相处。记录生活是你们最常一起做的事，\",\n  26→\t\"但对方提出别的要求（查东西、整理、动手做事）时也要正常帮忙。\",\n  27→\t// 2026-11-01 需求方：原来\"有温度\"读起来太软——像客服和哄人。\n  28→\t// 口径改成\"直接、克制、就事论事\"：不撒娇、不堆情绪词、不和稀泥，也不说教。\n  29→\t\"说话直接、克制、就事论事，像个熟悉的朋友，不像客服。\",\n  30→\t\"不撒娇、不堆情绪词、不为了安慰而安慰；对方情绪低时接住一句就够，不追问、不铺开。\",\n  31→\t\"不说教、不打气、不总结人生道理。\",\n  32→\t// 2026-10-29 需求方定的硬约束：这条同时是\"该动手时一定动手\"的兜底 ——\n  33→\t// 快档模型若为了省事直接编，用户会拿到假信息，比慢一点更糟。\n  34→\t\"凡是涉及真实文件、真实数据、真实日程或当前时间的事，必须先用工具去看，不许凭印象回答或编造；\",\n  35→\t\"看不到就说看不到，并说明缺什么。闲聊和感受不需要调工具。\",\n  36→\t\"记忆只在确有必要时检索（对方提到过去的事、需要接上以前的话），别每句都查。\",\n  37→\t\"需要长期记住的事用 remember；想不起对方说过什么用 recall；要定时提醒用 set_reminder。\",\n  38→].join(\"\");\n  39→\n  40→/**\n  41→ * 普通 worker 的人格（2026-11-06 侧栏调整 B2）。\n  42→ *\n  43→ * 为什么要单独一段：新建会话以前也走总管 persona——前端只是没把\"总管\"写进按钮，\n  44→ * 模型那边照样自称总管、默认维护执事档案。worker 是**普通任务助手**：\n  45→ * 不读总管 SOUL、不冒称总管、不建立执事身份，但工具闸门 / 工作区边界 / 审批一条不少。\n  46→ */\n  47→export const WORKER_PERSONA = [\n  48→\t\"你是一个普通任务助手，负责把交到你手上的具体事情办完。\",\n  49→\t\"说话直接、克制、就事论事，给结论也给依据；不冒充总管，也不代表任何执事。\",\n  50→\t\"涉及真实文件、真实数据、真实日程或当前时间的事，必须先用工具去看，不许凭印象回答或编造；看不到就说明缺什么。\",\n  51→\t\"没有预设的私人档案，也不主动建立执事身份。\",\n  52→\t\"需要长期记住的事用 remember；想不起对方说过什么用 recall；要定时提醒用 set_reminder。\",\n  53→].join(\"\");\n  54→\n  55→/**\n  56→ * 新会话能不能开成 worker（2026-11-06 B2 回滚开关）：`WORKER_CHAT_ENABLED=false` 只拦**新建**，\n  57→ * 已经落盘的 worker 保持原身份（不把旧 worker 重解释成总管）。默认启用。\n  58→ */\n  59→export function workerChatEnabled(): boolean {\n  60→\tconst raw = process.env.WORKER_CHAT_ENABLED?.trim().toLowerCase();\n  61→\tif (!raw) return true;\n  62→\treturn raw !== \"false\" && raw !== \"0\";\n  63→}\n  64→\n  65→// ── 记忆 ─────────────────────────────────────────────────\n  66→/** 召回候选窗口下限（2026-11-04 批次一 A2-S）：不配 = 200；设 50 = 旧行为。 */\n  67→function memoryCandidateFloor(): number | undefined {\n  68→\tconst raw = Number(process.env.MEMORY_CANDIDATE_FLOOR);\n  69→\treturn Number.isInteger(raw) && raw > 0 ? raw : undefined;\n  70→}\n  71→\n  72→/**\n  73→ * 召回检索器（2026-11-04 批次三 A2-F）：`auto`（默认，FTS5 trigram 候选集） / `js`（批次一窗口路径）。\n  74→ * 只在装配处读 env —— memory 包本身不碰环境变量。\n  75→ */\n  76→function memoryFtsEnabled(): boolean {\n  77→\treturn (process.env.MEMORY_RETRIEVER ?? \"\").trim().toLowerCase() !== \"js\";\n  78→}\n  79→\n  80→/**\n  81→ * 记忆时间衰减（2026-11-08 扫尾批 6 §一）：日衰减系数，默认 0.99；`0` = 关（回滚）。\n  82→ * 空串 / 非数字 / 越界一律回落默认值——衰减是后台机制，不该被一个坏 env 卡死。\n  83→ */\n  84→function memoryDecayDaily(): number {\n  85→\tconst raw = (process.env.MEMORY_DECAY_DAILY ?? \"\").trim();\n  86→\tif (!raw) return 0.99;\n  87→\tconst value = Number(raw);\n  88→\tif (!Number.isFinite(value) || value < 0 || value > 1) return 0.99;\n  89→\treturn value;\n  90→}\n  91→\n  92→export const memoryEngine: MemoryEngine | null = (() => {\n  93→\tif (process.env.MEMORY_ENABLED === \"false\") return null;\n  94→\ttry {\n  95→\t\tconst extractor = preferenceExtractor();\n  96→\t\treturn createMemoryEngine({\n  97→\t\t\tdbPath: process.env.MEMORY_DB_PATH,\n  98→\t\t\tcandidateFloor: memoryCandidateFloor(),\n  99→\t\t\tfts: memoryFtsEnabled(),\n 100→\t\t\tdecayDaily: memoryDecayDaily(),\n 101→\t\t\t// 2026-11-06：不传 = 保持 memory 包的默认（HeuristicExtractor），\n 102→\t\t\t// 即 `MEMORY_EXTRACT=rule` 与\"模型不可用\"这两种情况**逐字节回到旧行为**。\n 103→\t\t\t...(extractor ? { extractor } : {}),\n 104→\t\t});\n 105→\t} catch (error) {\n 106→\t\tconst detail = error instanceof Error ? error.message : String(error);\n 107→\t\tconsole.warn(`记忆库初始化失败，本次以无记忆运行: ${detail}`);\n 108→\t\treturn null;\n 109→\t}\n 110→})();\n 111→\n 112→// ── 技能 ─────────────────────────────────────────────────\n 113→/**\n 114→ * 技能读取链（2026-11-08 批 10-A）：`resolveSkillsDir().dirs` 已经是完整的合并链——\n 115→ * AGENT_SKILLS_DIR 显式 / 用户目录（首访自动建）→ `%USERPROFILE%\\.agents\\skills`（只读）\n 116→ * → 应用目录兜底。主目录排第一，用户目录为空时内置手册仍然可见；同名先到先得。\n 117→ */\n 118→const resolvedSkills = resolveSkillsDir();\n 119→const SKILLS_DIRS: string[] = resolvedSkills.dirs.map((source) => source.dir);\n 120→\n 121→// 技能启停位（2026-11-09 用户拍板：默认全关，界面上开）。SKILL_STATE=false 逃生门 = 回到全进索引。\n 122→// 注意 getSkillState() 在闭包里懒取（别在模块顶层解构）——首次调用发生在请求期，.env 已就绪。\n 123→const skillVisible = (name: string): boolean =>\n 124→\tskillStateEnabled() && getSkillState().isEnabled(name);\n 125→\n 126→export const skillStore: SkillStore | null = (() => {\n 127→\t// 主对话（总管）技能（批次D D1）：总管技能目录优先、全局 skills/ 兜底，同名时总管覆盖全局\n 128→\t// （createSkillStore 对目录数组按先到先得合并）。CHIEF_PARTNER=false 时只留全局目录 = 改动前。\n 129→\tif (chiefPartnerEnabled()) {\n 130→\t\ttry {\n 131→\t\t\treturn createSkillStore([chiefSkillsDir(), ...SKILLS_DIRS], { visible: skillVisible });\n 132→\t\t} catch (error) {\n 133→\t\t\tconst detail = error instanceof Error ? error.message : String(error);\n 134→\t\t\tconsole.warn(`总管技能目录加载失败，回落全局技能: ${detail}`);\n 135→\t\t}\n 136→\t}\n 137→\ttry {\n 138→\t\treturn createSkillStore(SKILLS_DIRS, { visible: skillVisible });\n 139→\t} catch (error) {\n 140→\t\tconst detail = error instanceof Error ? error.message : String(error);\n 141→\t\tconsole.warn(`技能目录加载失败，本次无技能可用: ${detail}`);\n 142→\t\treturn null;\n 143→\t}\n 144→})();\n 145→\n 146→/**\n 147→ * 总管播种（服务启动时调一次）。CHIEF_PARTNER=false / 执事能力关闭时 ensureChiefPartner 内部旁路。\n 148→ * 播种失败只 warn：主对话的 persona 会回落 PERSONA 常量，绝不会被弄哑。\n 149→ */\n 150→export function seedChiefPartner(): void {\n 151→\ttry {\n 152→\t\tensureChiefPartner(PERSONA);\n 153→\t} catch (error) {\n 154→\t\tconst detail = error instanceof Error ? error.message : String(error);\n 155→\t\tconsole.warn(`[chief] 总管播种失败（主对话回落 PERSONA）: ${detail}`);\n 156→\t}\n 157→}\n 158→\n 159→/**\n 160→ * 记忆作用域跟着**内部会话 id** 走。\n 161→ *\n 162→ * 它是存储自己发的、重开进程也不变，所以作用域稳定。\n 163→ * 对外暴露的 conversationId 是另一个东西（下面 Chats 里的 uuid），\n 164→ * 用它会把\"客户端标识\"和\"存储主键\"绑在一起，以后换实现就麻烦了。\n 165→ */\n 166→/**\n 167→ * 执事会话的执事 scope（批次B B1/B2）：会话挂在链接表上 → 它属于某个执事，\n 168→ * 记忆读写落到 `partner:<uuid>` 键空间（与主人记忆隔离）。查失败一律当普通会话，\n 169→ * 记忆永远不能把对话卡住。\n 170→ */\n 171→function partnerScopeOf(conversationId: number): MemoryScope | null {\n 172→\tif (!COMPANIONS_ENABLED) return null;\n 173→\ttry {\n 174→\t\t// D15 刻意差异：主对话就是总管，他继续读写 global + session，不吃 partner: 键空间。\n 175→\t\t// partnerId === \"chief\" → null 的判定在 partners.ts 的 resolvePartnerScope（同名纯函数也供单测），\n 176→\t\t// 别把它\"修\"成和普通执事一致；除总管外的执事会话行为完全不变。\n 177→\t\treturn resolvePartnerScope(partnersStore(), conversationId);\n 178→\t} catch {\n 179→\t\treturn null;\n 180→\t}\n 181→}\n 182→\n 183→export function scopeOf(conversationId: number): MemoryScope {\n 184→\treturn partnerScopeOf(conversationId) ?? { type: \"session\", id: String(conversationId) };\n 185→}\n 186→\n 187→/**\n 188→ * 偏好该落哪个 scope（2026-11-06）。\n 189→ *\n 190→ * - 主对话（总管 / 普通会话 / worker）→ `global`：偏好是**关于这个人**的，\n 191→ *   换个会话照样该生效；\n 192→ * - 执事会话 → `partner:<id>`：执事的记忆键空间与主人隔离（D15），\n 193→ *   偏好也该留在它自己的地盘里，不能写进主人的 global。\n 194→ */\n 195→export function preferenceScopeOf(conversationId: number): MemoryScope {\n 196→\treturn partnerScopeOf(conversationId) ?? { type: \"global\" };\n 197→}\n 198→\n 199→/** 召回失败绝不能让对话失败，所以一律吞掉并降级为空上下文。 */\n 200→export function recallContext(conversationId: number, text: string): string {\n 201→\tif (!memoryEngine || !text.trim()) return \"\";\n 202→\ttry {\n 203→\t\t// 群会话不参与记忆引擎（2026-11-06 群组方案 §2.2）：召回整个跳过，\n 204→\t\t// 群聊不写不读个人记忆防串台；群内连续性靠会话历史 + 群时间线本身。\n 205→\t\tif (partnersStore().isGroupSession(conversationId)) return \"\";\n 206→\t\t// 执事会话（批次B B1）：global + 执事键空间 + 本会话三条都进候选；\n 207→\t\t// 键空间过滤是 store 的硬过滤（scope IN），执事键空间外的记录不会被召回。\n 208→\t\tconst partner = partnerScopeOf(conversationId);\n 209→\t\treturn memoryEngine.buildContext({\n 210→\t\t\ttext,\n 211→\t\t\tscopes: [\n 212→\t\t\t\t\"global\",\n 213→\t\t\t\t...(partner ? [scopeKey(partner)] : []),\n 214→\t\t\t\tscopeKey({ type: \"session\", id: String(conversationId) }),\n 215→\t\t\t],\n 216→\t\t});\n 217→\t} catch (error) {\n 218→\t\tconst detail = error instanceof Error ? error.message : String(error);\n 219→\t\tconsole.warn(`记忆召回失败，本轮不使用记忆: ${detail}`);\n 220→\t\treturn \"\";\n 221→\t}\n 222→}\n 223→\n 224→/**\n 225→ * 任务会话的\"近况记忆\"块（2026-10-31，记忆方案 §3 的 B 路 + §4 注入例外）。\n 226→ *\n 227→ * 给**需要知道最近记了什么**的任务用（目前只有 `question` / `diary_review`）：\n 228→ * 数据源是日记镜像（`diary.sqlite` 近 N 天 `CONFIRMED`），不经过 App——\n 229→ * App 不再拼画像/近况（它是两处真相的源头，见方案 D7）。\n 230→ *\n 231→ * 位置：**拼在 instructions 的尾部**。这样模板那一大段前缀不变，缓存照旧命中，\n 232→ * 只有\"近况\"这一小段是新的（§2.3 实测：尾部追加不破坏前缀）。\n 233→ */\n 234→export function taskMemoryBlock(days = 3, limit = 12): string {\n 235→\ttry {\n 236→\t\t// 2026-10-31 二次收口：**先把镜像里的成稿摄入记忆，再从记忆取**。\n 237→\t\t// 之前这里直接读 diary.sqlite，等于在记忆系统旁边开了条捷径——聊天走记忆、任务读镜像，\n 238→\t\t// 两套并存，才会出现\"记忆库是空的\"这种怪事。现在两边同一个源。\n 239→\t\tsyncDiaryToMemory(days);\n 240→\t\tlet items = recentDiaryMemories(days, limit);\n 241→\t\tif (items.length === 0) {\n 242→\t\t\t// 兜底：记忆库还没就绪（例如 MEMORY_ENABLED=false）时，至少别让提问瞎问\n 243→\t\t\tconst since = new Date(Date.now() - days * 86_400_000).toISOString().slice(0, 10);\n 244→\t\t\titems = diaryStore()\n 245→\t\t\t\t.recent(since, limit)\n 246→\t\t\t\t.filter((entry) => (entry.finalText ?? \"\").trim().length > 0)\n 247→\t\t\t\t.map((entry) => ({\n 248→\t\t\t\t\tdate: entry.entryDate ?? \"\",\n 249→\t\t\t\t\ttext: String(entry.finalText).replace(/\\s+/g, \" \").trim(),\n 250→\t\t\t\t}));\n 251→\t\t}\n 252→\t\tif (items.length === 0) return \"\";\n 253→\t\tconst lines = items.map((item) => `- ${item.date || \"（无日期）\"}：${item.text.slice(0, 120)}`);\n 254→\t\treturn [\n 255→\t\t\t\"<memory>\",\n 256→\t\t\t`最近 ${days} 天你自己记下的（只作参考：可以呼应，不要逐条复述，也不要评价记多记少）：`,\n 257→\t\t\t...lines,\n 258→\t\t\t\"</memory>\",\n 259→\t\t].join(\"\\n\");\n 260→\t} catch (error) {\n 261→\t\t// 记忆读失败绝不能让任务失败（镜像/记忆库可能都还没建）\n 262→\t\tconst detail = error instanceof Error ? error.message : String(error);\n 263→\t\tconsole.warn(`[memory] 近况读取失败，本次不注入: ${detail}`);\n 264→\t\treturn \"\";\n 265→\t}\n 266→}\n 267→"
    },
