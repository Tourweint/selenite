\n 646→\t\t// in 方向（settle 的结论文）由 REPORT 镜像覆盖，这里跳过，避免同一句话两份。\n 647→\t\tif (direction !== \"in\" && !kick.skipMessageMirror) {\n 648→\t\t\truntime.mirror?.(ticket, {\n 649→\t\t\t\tkind: \"message\",\n 650→\t\t\t\ttext: formatMessageLine(sender.name, body),\n 651→\t\t\t});\n 652→\t\t}\n 653→\t};\n 654→\n 655→\tconst projectField = kick.project ? { project: kick.project } : {};\n 656→\tconst idempotency = kick.requestId ? { idempotencyKey: kick.requestId } : {};\n 657→\t// 执事在自己领域内直派（2026-11-07）：managers:false 让 chancellor 不建分管宰相。\n 658→\t// 递归在参数层断掉，不需要改跨仓契约。\n 659→\tconst managerSwitch = kick.managers === false ? { managers: false as const } : {};\n 660→\tconst first = launch(\n 661→\t\tkick.resumeTicketId\n 662→\t\t\t? { resumeTicketId: kick.resumeTicketId, answer: kick.requirement }\n 663→\t\t\t: {\n 664→\t\t\t\trequirement: kick.requirement,\n 665→\t\t\t\t...(kick.domain ? { domain: kick.domain } : {}),\n 666→\t\t\t\t...(managerIdentity ? { managerIdentity } : {}),\n 667→\t\t\t\t...managerSwitch,\n 668→\t\t\t\t...projectField,\n 669→\t\t\t\t...idempotency,\n 670→\t\t\t\t// 计划附件（2026-11-09 §2）：只有新派带；续跑沿用原单，不覆盖。\n 671→\t\t\t\t...(kick.steps && kick.steps.length > 0 ? { steps: kick.steps } : {}),\n 672→\t\t\t\t// 来源对话只透传（2026-11-05 跨仓契约）：chancellor 落 ticket.json，\n 673→\t\t\t\t// 子单从父单继承；这里给内部会话 id 的字符串形式，接口层再换对外 uuid。\n 674→\t\t\t\toriginConversationId: String(kick.conversationId),\n 675→\t\t\t},\n 676→\t);\n 677→\tlet accepted = first;\n 678→\tlet fellBack = false;\n 679→\tlet dispatched = true;\n 680→\tif (kick.resumeTicketId && first.id === \"\") {\n 681→\t\t// 续跑在派活之前就被拒了（单子已完成/找不到）：没有可续的单，按新活派。\n 682→\t\t// 拒跑之前不会动 worker，所以不会和原单抢同一个屏幕。\n 683→\t\tfellBack = true;\n 684→\t\tfirst.promise.catch(() => undefined);\n 685→\t\tif (kick.resumeOnly) {\n 686→\t\t\t// 任务回话（8g）：主人回答的是这张单，被拒就明确失败，绝不悄悄重开一件。\n 687→\t\t\tdispatched = false;\n 688→\t\t} else {\n 689→\t\t\taccepted = launch({\n 690→\t\t\t\trequirement: kick.requirement,\n 691→\t\t\t\t...(kick.domain ? { domain: kick.domain } : {}),\n 692→\t\t\t\t...(managerIdentity ? { managerIdentity } : {}),\n 693→\t\t\t\t...managerSwitch,\n 694→\t\t\t\t...projectField,\n 695→\t\t\t\t...idempotency,\n 696→\t\t\t\t...(kick.steps && kick.steps.length > 0 ? { steps: kick.steps } : {}),\n 697→\t\t\t\toriginConversationId: String(kick.conversationId),\n 698→\t\t\t});\n 699→\t\t}\n 700→\t}\n 701→\n 702→\t// 派活留言（2026-11-07）：单号一确定就落一条\"谁在什么时候说了什么\"。\n 703→\t// 放在 launch 之后而不是之前：ticketId 要等 chancellor 的同步段发出来才有值。\n 704→\tif (kick.sender && !kick.resumeTicketId) {\n 705→\t\trecordMessage(\"out\", kick.requirement, kick.sender, accepted.id || ticketId);\n 706→\t}\n 707→\tif (kick.sender && kick.resumeTicketId) {\n 708→\t\t// 续跑也是一句话：谁在回答、答了什么。方向仍是 out（从发出方看）。\n 709→\t\trecordMessage(\n 710→\t\t\t\"out\",\n 711→\t\t\t`（回答上一轮的提问）${kick.requirement}`,\n 712→\t\t\tkick.sender,\n 713→\t\t\taccepted.id || ticketId,\n 714→\t\t);\n 715→\t}\n 716→\n 717→\t// resumeOnly 且续跑被拒：没有可结算的东西（没建新单，原单也不动），\n 718→\t// 调用方从 `fellBack` 拿到结论自己提示；这里不再走 fail 的\"派单失败\"播报。\n 719→\tif (dispatched) {\n 720→\t\taccepted.promise.then(settle).catch((error: unknown) => fail(error, accepted.id));\n 721→\t}\n 722→\n 723→\treturn { ticketId, outcome: accepted.promise, fellBack };\n 724→}\n 725→"
