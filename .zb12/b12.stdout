      "type": "text",
      "text": "   1→import assert from \"node:assert/strict\";\n   2→import { test } from \"node:test\";\n   3→import { createSseDecoder, encodeSseEvent, type ChatEvent } from \"@lifediary/shared\";\n   4→import { mkdtempSync, rmSync } from \"node:fs\";\n   5→import { tmpdir } from \"node:os\";\n   6→import { join } from \"node:path\";\n   7→import {\n   8→\tformatMessageLine,\n   9→\tformatProgressLine,\n  10→\tformatReport,\n  11→\tstartDelegation,\n  12→\ttype DelegationEvent,\n  13→\ttype DelegationMirrorEntry,\n  14→\ttype DelegationReport,\n  15→} from \"./delegation.ts\";\n  16→import { DelegationMessages } from \"./delegation-messages.ts\";\n  17→import type {\n  18→\tChancellorEvent,\n  19→\tChancellorRequest,\n  20→\tTicketResult,\n  21→} from \"../../../../../chancellor/src/index.ts\";\n  22→\n  23→function result(overrides: Partial<TicketResult> = {}): TicketResult {\n  24→\treturn {\n  25→\t\tticketId: \"T-1\",\n  26→\t\tstatus: \"done\",\n  27→\t\tline: \"改完了\",\n  28→\t\ttasks: [],\n  29→\t\t...overrides,\n  30→\t};\n  31→}\n  32→\n  33→/**\n  34→ * 假 chancellor：`sync` 在返回 Promise 之前先发事件，模拟 `runChancellor`\n  35→ * \"第一次 await 之前就拿到单号\"的行为。\n  36→ */\n  37→function fakeRun(\n  38→\tsync: (emit: (event: ChancellorEvent) => void) => void,\n  39→\tfinish: Promise<TicketResult>,\n  40→): (request: ChancellorRequest, options: { onEvent?: (event: ChancellorEvent) => void }) => Promise<TicketResult> {\n  41→\treturn (_request, options) => {\n  42→\t\tsync((event) => options.onEvent?.(event));\n  43→\t\treturn finish;\n  44→\t};\n  45→}\n  46→\n  47→test(\"立即返回任务单号，并把 domain 传给负责人\", async () => {\n  48→\tconst events: DelegationEvent[] = [];\n  49→\tlet seen: ChancellorRequest | undefined;\n  50→\tlet resolveFinish: (value: TicketResult) => void = () => undefined;\n  51→\tconst finish = new Promise<TicketResult>((resolve) => {\n  52→\t\tresolveFinish = resolve;\n  53→\t});\n  54→\n  55→\tconst { ticketId, outcome } = startDelegation(\n  56→\t\t{ conversationId: 7, domain: \"前端\", requirement: \"把按钮改成蓝色\" },\n  57→\t\t{\n  58→\t\t\trun: (request, options) => {\n  59→\t\t\t\tseen = request;\n  60→\t\t\t\toptions.onEvent?.({ type: \"ticket\", ticketId: \"T-1\", message: \"已受理\" });\n  61→\t\t\t\treturn finish;\n  62→\t\t\t},\n  63→\t\t\temit: (_conversationId, event) => events.push(event),\n  64→\t\t\treport: () => undefined,\n  65→\t\t\tautoReport: false,\n  66→\t\t},\n  67→\t);\n  68→\n  69→\t// 关键：返回的时候单号已经有了，没有等后台跑完。\n  70→\tassert.equal(ticketId, \"T-1\");\n  71→\tassert.equal(seen?.requirement, \"把按钮改成蓝色\");\n  72→\tassert.equal(seen?.domain, \"前端\");\n  73→\tassert.equal(events.length, 1);\n  74→\tassert.deepEqual(\n  75→\t\t{\n  76→\t\t\ttype: events[0]?.type,\n  77→\t\t\tticketId: events[0]?.type === \"delegate\" ? events[0].ticketId : \"\",\n  78→\t\t\tdomain: events[0]?.type === \"delegate\" ? events[0].domain : \"\",\n  79→\t\t\tphase: events[0]?.type === \"delegate\" ? events[0].phase : \"\",\n  80→\t\t\tdone: events[0]?.type === \"delegate\" ? events[0].done : -1,\n  81→\t\t\ttotal: events[0]?.type === \"delegate\" ? events[0].total : -1,\n  82→\t\t\tcurrent: events[0]?.type === \"delegate\" ? events[0].current : \"\",\n  83→\t\t\tlastAction: events[0]?.type === \"delegate\" ? events[0].lastAction : \"\",\n  84→\t\t},\n  85→\t\t{\n  86→\t\t\ttype: \"delegate\",\n  87→\t\t\tticketId: \"T-1\",\n  88→\t\t\tdomain: \"前端\",\n  89→\t\t\tphase: \"accepted\",\n  90→\t\t\tdone: 0,\n  91→\t\t\ttotal: 0,\n  92→\t\t\tcurrent: \"已受理\",\n  93→\t\t\tlastAction: \"已受理\",\n  94→\t\t},\n  95→\t);\n  96→\tassert.match(events[0]?.type === \"delegate\" ? events[0].lastHeartbeat ?? \"\" : \"\", /^\\d{4}-/);\n  97→\n  98→\tresolveFinish(result({ ticketId: \"T-1\" }));\n  99→\tawait outcome;\n 100→});\n 101→\n 102→test(\"执事直派：managers=false 传给 chancellor，且不注入身份\", async () => {\n 103→\t// 2026-11-07 消息即引导与执事直派：执事在自己领域内派活时，\n 104→\t// 不再为该领域起一个分管宰相——请求带 managers:false，managerIdentity 不出现。\n 105→\tlet seen: ChancellorRequest | undefined;\n 106→\tconst { outcome } = startDelegation(\n 107→\t\t{\n 108→\t\t\tconversationId: 11,\n 109→\t\t\tdomain: \"frontend\",\n 110→\t\t\trequirement: \"把登录页的按钮对齐\",\n 111→\t\t\tmanagers: false,\n 112→\t\t},\n 113→\t\t{\n 114→\t\t\trun: (request, options) => {\n 115→\t\t\t\tseen = request;\n 116→\t\t\t\toptions.onEvent?.({ type: \"ticket\", ticketId: \"T-9\", message: \"已受理\" });\n 117→\t\t\t\treturn Promise.resolve(result({ ticketId: \"T-9\" }));\n 118→\t\t\t},\n 119→\t\t\temit: () => undefined,\n 120→\t\t\t// 即使装配层给了身份缝，直派也不该去取（取不到就没有）\n 121→"
    },
