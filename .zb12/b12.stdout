      "text": "   1→import { randomUUID } from \"node:crypto\";\n   2→import {\n   3→\texistsSync,\n   4→\tmkdirSync,\n   5→\treadFileSync,\n   6→\trenameSync,\n   7→\trmSync,\n   8→\twriteFileSync,\n   9→} from \"node:fs\";\n  10→import { dirname, join } from \"node:path\";\n  11→import { DatabaseSync } from \"node:sqlite\";\n  12→import type { MemoryScope } from \"@lifediary/memory\";\n  13→\n  14→/**\n  15→ * 固定 id 例外（2026-11-05 批次D D1）：总管的 partnerId 是固定字面量 `\"chief\"`，**不是 uuid**。\n  16→ * 理由：总管是每台一个的主对话本体，是 SOUL 版本 / 家目录 / 记忆键空间 / 技能落点的内部锚点，\n  17→ * 不是一条可枚举的执事记录，因此不需要（也不该）随机化。这个 id 只在本仓内部使用；\n  18→ * **聊天/会话身份对外仍用会话 uuid**，总管不新增对外端点、不把 \"chief\" 当会话 id 用\n  19→ * （`GET /api/v1/partners` 只是既有管理端点里自然多出一行，不是新身份入口）。\n  20→ * 这是 AGENTS.md「对外 id 一律 uuid」的一处刻意例外，登记在此防止后来者当成疏漏去\"改回 uuid\"。\n  21→ */\n  22→/**\n  23→ * 执事档案：DB 只存索引与版本快照，磁盘才是内容的家（2026-11-05 批次B B2）。\n  24→ *\n  25→ * 参考 cindy 的\"文件=当前值、DB 版本行=冻结快照\"双层契约：\n  26→ *   - `SOUL.md` 在磁盘上是**当前值**，谁都能改（设置页 / 宿主）；\n  27→ *   - `partner_versions` 是**冻结快照**：执事轮次启动认版本号，整轮身份不变；\n  28→ *     改完 SOUL 不当场变身，下一轮生效——这是设计出来的不一致，别\"修\"成即时生效。\n  29→ *\n  30→ * 家目录 `.data/partner-homes/<uuid>/`：\n  31→ *   SOUL.md（身份，播种时最后写 = 家建好的标志）/ memories/USER.md（主人画像）/\n  32→ *   workspace/（唯一默认可写区）/ memories/ / skills/。\n  33→ * 单槽 64KB 上限；全部原子写（临时文件 + rename）。\n  34→ *\n  35→ * 权限边界：模型的原始文件工具只挂 workspace/（agent.ts 的 pathGuard 指过来）；\n  36→ * memories/skills 的写只能走宿主类型化接口（remember 落执事 scope / partner_skill_write）。\n  37→ * 本模块**只做存储**，不 import agent.ts——装配方向 partners ← agent，防循环。\n  38→ */\n  39→\n  40→export const COMPANIONS_ENABLED =\n  41→\t(process.env.COMPANIONS_ENABLED?.trim() || \"true\").toLowerCase() !== \"false\";\n  42→\n  43→/**\n  44→ * 岗位契约总开关（2026-11-08 员工人格化刀一 E1）：`PARTNER_CONTRACT=false` → 不播种\n  45→ * `CONTRACT.md`、不注入、写端点 400；SOUL 侧行为零变化（一行 env 回到纯 SOUL 形态）。\n  46→ * 与其它开关同一读法：只有明确写 false/0 才关，拼错一个值不会把能力误关。\n  47→ */\n  48→export function partnerContractEnabled(): boolean {\n  49→\tconst raw = process.env.PARTNER_CONTRACT?.trim().toLowerCase();\n  50→\tif (!raw) return true;\n  51→\treturn raw !== \"false\" && raw !== \"0\";\n  52→}\n  53→\n  54→/**\n  55→ * 岗位契约的固定四节（2026-11-08 E1）。**标题逐字**：契约文件按这四个二级标题分节，\n  56→ * 渲染时只认这四节，其余内容忽略；空节连标题一起省略。\n  57→ * 新建执事播种的空模板 = 只有这四个标题（存量执事不自动补文件，缺失 = 该节为空）。\n  58→ */\n  59→export const PARTNER_CONTRACT_SECTIONS = [\n  60→\t\"职责范围\",\n  61→\t\"决策分级\",\n  62→\t\"验收标准\",\n  63→\t\"汇报对象\",\n  64→] as const;\n  65→\n  66→/** 新建执事的空契约模板：只有四节标题，没有正文。 */\n  67→export function partnerContractTemplate(): string {\n  68→\treturn PARTNER_CONTRACT_SECTIONS.map((section) => `## ${section}`).join(\"\\n\\n\");\n  69→}\n  70→\n  71→const DEFAULT_DB_PATH = \".data/partners.sqlite\";\n  72→const DEFAULT_HOMES_ROOT = \".data/partner-homes\";\n  73→\n  74→/** 单槽上限（SOUL.md / USER.md / 技能文件同口径，cindy 同款） */\n  75→export const PARTNER_SLOT_LIMIT = 64 * 1024;\n  76→\n  77→// ── 总管（批次D D1）─────────────────────────────────────\n  78→/** 总管固定 partnerId。内部字面量、非 uuid；例外理由见文件头注释。 */\n  79→export const CHIEF_PARTNER_ID = \"chief\";\n  80→const CHIEF_PARTNER_NAME = \"总管\";\n  81→\n  82→/** 总管身份化总开关：false/0 = 不播种、persona 常量直读，回到改动前形态（D1 回滚开关）。 */\n  83→export function chiefPartnerEnabled(): boolean {\n  84→\tconst raw = process.env.CHIEF_PARTNER?.trim().toLowerCase();\n  85→\tif (!raw) return true;\n  86→\treturn raw !== \"false\" && raw !== \"0\";\n  87→}\n  88→\n  89→/** 总管技能目录（纯路径，不打开 DB）；与 store.skillsDirOf(\"chief\") 同址。 */\n  90→export function chiefSkillsDir(): string {\n  91→\tconst homesRoot = process.env.PARTNER_HOMES_ROOT?.trim() || DEFAULT_HOMES_ROOT;\n  92→\treturn join(homesRoot, CHIEF_PARTNER_ID, \"skills\");\n  93→}\n  94→\n  95→export type PartnerStatus = \"active\" | \"paused\" | \"archived\";\n  96→\n  97→export interface PartnerRow {\n  98→\tid: string;\n  99→\tname: string;\n 100→\tstatus: PartnerStatus;\n 101→\t/** 当前身份快照版本号；还没建过版本 = null */\n 102→\tcurrentVersion: number | null;\n 103→\tcreatedAt: string;\n 104→\tupdatedAt: string;\n 105→\t/** 执事的领域名（批次D D2）；普通执事为 null。小写 ASCII，同 chancellor DOMAIN_PATTERN。 */\n 106→\tdomain: string | null;\n 107→\t/**\n 108→\t * 头像（2026-11-06 侧栏调整 B1）：有界 PNG data URL，或 null（未设置 → 前端用名字首字）。\n 109→\t * 只供 `<img>` 渲染；服务端不存路径、不收外部 URL、不收 SVG（理由见 shared 的 PartnerAvatarSchema）。\n 110→\t */\n 111→\tavatar: string | null;\n 112→\t/**\n 113→\t * 派发权（2026-11-06 执事派发权开关）：带 domain 的执事是否作为分管负责人接单。\n 114→\t * 默认关。只对带 domain 的执事有意义。\n 115→\t */\n 116→\tdispatchAuthority: boolean;\n 117→\t/**\n 118→\t * 当前目标（2026-11-08 员工人格化刀二 E4）：这一阵子在奔什么，用户 / 总管可改。\n 119→\t * **不版本化**（不是身份，是现取现用的状态），只进 detail 端点与 PATCH，\n 120→\t * 列表形状不变（字段经 shared 暴露在刀三）。空串 / null = 清除。\n 121→\t */\n 122→\tcurrentGoal: string | null;\n 123→}\n 124→\n 125→export interface PartnerVersionRow {\n 126→\tpartnerId: string;\n 127→\tversion: number;\n 128→\t/** SOUL.md 正文快照（冻结） */\n 129→\tsoulSource: string;\n 130→\t/**\n 131→"
    },
