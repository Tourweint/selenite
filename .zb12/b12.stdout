    "output": {
      "type": "text",
      "text": "   1→import assert from \"node:assert/strict\";\n   2→import { existsSync, mkdtempSync, rmSync } from \"node:fs\";\n   3→import { tmpdir } from \"node:os\";\n   4→import { join } from \"node:path\";\n   5→import { test } from \"node:test\";\n   6→import { DatabaseSync } from \"node:sqlite\";\n   7→import { Store } from \"../../../../../../chancellor/src/store.ts\";\n   8→import type { Ticket } from \"../../../../../../chancellor/src/types.ts\";\n   9→import {\n  10→\tbuildPartnerStatusSection,\n  11→\tbuildPartnerTurnContext,\n  12→\trenderContractSection,\n  13→\tsplitContractSections,\n  14→} from \"./partner-context.ts\";\n  15→import { ATTENTION_REPLY_GUIDANCE } from \"../delegation.ts\";\n  16→import {\n  17→\tPARTNER_CONTRACT_SECTIONS,\n  18→\tPartnersStore,\n  19→\tpartnerContractEnabled,\n  20→\tpartnerContractTemplate,\n  21→} from \"../partners.ts\";\n  22→\n  23→/**\n  24→ * 员工人格化刀一（E1 契约 / E5 状态感 / B2 受阻口径）的最小充分单测。\n  25→ *\n  26→ * 全程临时目录：不碰真实 `.data/`（AGENTS 的测试纪律）；审批用桩（ApprovalStore\n  27→ * 是进程单例，单测里不该去读真实的 approvals.json）。\n  28→ */\n  29→\n  30→function tempRoot(): { root: string; db: string; homes: string; workRoot: string } {\n  31→\tconst root = mkdtempSync(join(tmpdir(), \"lifediary-partner-context-\"));\n  32→\treturn {\n  33→\t\troot,\n  34→\t\tdb: join(root, \"partners.sqlite\"),\n  35→\t\thomes: join(root, \"homes\"),\n  36→\t\tworkRoot: join(root, \"runs\"),\n  37→\t};\n  38→}\n  39→\n  40→function ticketFixture(\n  41→\tworkRoot: string,\n  42→\tid: string,\n  43→\tstatus: string,\n  44→\textra: Record<string, unknown> = {},\n  45→): Ticket {\n  46→\tconst now = new Date().toISOString();\n  47→\treturn {\n  48→\t\tid,\n  49→\t\tprompt: `夹具 ${id}`,\n  50→\t\tstatus,\n  51→\t\tcreated_at: now,\n  52→\t\tupdated_at: now,\n  53→\t\toptions: { dry: true, maxTasks: 8, workRoot },\n  54→\t\t...extra,\n  55→\t} as Ticket;\n  56→}\n  57→\n  58→test(\"契约：新建执事播种四节空模板；改契约 = 双快照 bump，SOUL / 能力延续\", () => {\n  59→\tconst { root, db, homes } = tempRoot();\n  60→\tconst store = new PartnersStore(db, homes);\n  61→\ttry {\n  62→\t\tconst partner = store.create(\"小澈\");\n  63→\t\tassert.equal(partner.currentVersion, 1);\n  64→\t\tassert.ok(existsSync(join(store.homeOf(partner.id), \"CONTRACT.md\")), \"新建执事要有 CONTRACT.md\");\n  65→\t\tassert.equal(store.readContractFromHome(partner.id), partnerContractTemplate());\n  66→\t\t// 空模板 = 只有四个标题，渲染出来是空（没有一节有正文）\n  67→\t\tassert.equal(renderContractSection(store.readContractFromHome(partner.id)), undefined);\n  68→\n  69→\t\tconst v1Soul = store.getVersion(partner.id, 1)?.soulSource ?? \"\";\n  70→\t\tconst contract1 = [\n  71→\t\t\t\"## 职责范围\",\n  72→\t\t\t\"负责前端与桌面壳。\",\n  73→\t\t\t\"\",\n  74→\t\t\t\"## 决策分级\",\n  75→\t\t\t\"改样式自己定；改接口先申请。\",\n  76→\t\t\t\"\",\n  77→\t\t\t\"## 验收标准\",\n  78→\t\t\t\"跑通 typecheck + 探针。\",\n  79→\t\t\t\"\",\n  80→\t\t\t\"## 汇报对象\",\n  81→\t\t\t\"向总管汇报，每周一次。\",\n  82→\t\t].join(\"\\n\");\n  83→\t\tconst v2 = store.bumpContract(partner.id, contract1);\n  84→\t\tassert.equal(v2, 2);\n  85→\t\tconst current2 = store.currentVersion(partner.id);\n  86→\t\tassert.equal(current2?.contractSource, contract1);\n  87→\t\tassert.equal(current2?.soulSource, v1Soul, \"改契约不动 SOUL 正文\");\n  88→\n  89→\t\t// 冻结：v1 的契约快照仍是空模板（演化链可追溯）\n  90→\t\tassert.equal(store.getVersion(partner.id, 1)?.contractSource, partnerContractTemplate());\n  91→\n  92→\t\t// 再改 SOUL：新版本必须把当前契约一起快照过去（一个版本 = 一对）\n  93→\t\tconst v3 = store.bumpSoul(partner.id, \"你是小澈，改过的人格。\");\n  94→\t\tassert.equal(v3, 3);\n  95→\t\tassert.equal(store.currentVersion(partner.id)?.contractSource, contract1);\n  96→\n  97→\t\t// 切模型链同样不冲掉契约\n  98→\t\tconst v4 = store.setModelChain(partner.id, [\n  99→\t\t\t{ providerId: \"faux\", modelId: \"faux\", keyEnv: \"PROBE_KEY\" },\n 100→\t\t]);\n 101→\t\tassert.equal(v4, 4);\n 102→\t\tassert.equal(store.currentVersion(partner.id)?.contractSource, contract1);\n 103→\t} finally {\n 104→\t\tstore.close();\n 105→\t\trmSync(root, { recursive: true, force: true });\n 106→\t}\n 107→});\n 108→\n 109→test(\"契约：老库（partner_versions 没有 contract_source 列）打开不炸，旧行读出 null\", () => {\n 110→\tconst { root, db, homes } = tempRoot();\n 111→\ttry {\n 112→\t\t// 手工造一份改动前的库结构（没有 contract_source）\n 113→\t\tconst legacy = new DatabaseSync(db);\n 114→\t\tlegacy.exec(`\n 115→\t\t\tCREATE TABLE partners (\n 116→\t\t\t\tid TEXT PRIMARY KEY, name TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'active',\n 117→\t\t\t\tcurrent_version INTEGER, created_at TEXT NOT NULL, updated_at TEXT NOT NULL\n 118→\t\t\t);\n 119→\t\t\tCREATE TABLE partner_versions (\n 120→\t\t\t\tpartner_id TEXT NOT NULL, version INTEGER NOT NULL, soul_source TEXT NOT NULL,\n 121→\t\t\t\tcapabilities TEXT, created_at TEXT NOT NULL, PRIMARY KEY (partner_id, version)\n 122→\t\t\t);\n 123→\t\t`);\n 124→\t\tconst now = new Date().toISOString();\n 125→\t\tlegacy.prepare(\n 126→\t\t\t\"INSERT INTO partners (id, name, status, current_version, created_at, updated_at) VALUES (?, ?, 'active', 1, ?, ?)\",\n 127→\t\t).run(\"legacy-id\", \"老执事\", now, now);\n 128→\t\tlegacy.prepare(\n 129→\t\t\t\"INSERT INTO partner_versions (partner_id, version, soul_source, capabilities, created_at) VALUES (?, 1, ?, NULL, ?)\",\n 130→\t\t).run(\"legacy-id\", \"老身份\", now);\n 131→\t\tlegacy.close();\n 132→\n 133→\t\tconst store = new PartnersStore(db, homes);\n 134→\t\ttry {\n 135→\t\t\tconst version = store.currentVersion(\"legacy-id\");\n 136→\t\t\tassert.ok(version, \"旧库打开后仍能读版本\");\n 137→\t\t\tassert.equal(version?.soulSource, \"老身份\");\n 138→\t\t\tassert.equal(version?.contractSource, null, \"缺列 = null（无契约快照），不补数据\");\n 139→\t\t\t// 迁移补列后新版本能正常带契约\n 140→\t\t\tconst next = store.bumpContract(\"legacy-id\", \"## 职责范围\\n新契约\");\n 141→\t\t\tassert.equal(next, 2);\n 142→\t\t\tassert.match(store.currentVersion(\"legacy-id\")?.contractSource ?? \"\", /新契约/);\n 143→\t\t} finally {\n 144→\t\t\tstore.close();\n 145→\t\t}\n 146→\t} finally {\n 147→\t\trmSync(root, { recursive: true, force: true });\n 148→\t}\n 149→});\n 150→\n 151→test(\"开关旁路：PARTNER_CONTRACT=false → 不播种文件、不渲染契约；在办段不受影响\", () => {\n 152→\tconst { root, db, homes, workRoot } = tempRoot();\n 153→\tconst previous = process.env.PARTNER_CONTRACT;\n 154→\tprocess.env.PARTNER_CONTRACT = \"false\";\n 155→\tconst store = new PartnersStore(db, homes);\n 156→\ttry {\n 157→\t\tassert.equal(partnerContractEnabled(), false);\n 158→\t\tconst partner = store.create(\"小澈\");\n 159→\t\tassert.equal(existsSync(join(store.homeOf(partner.id), \"CONTRACT.md\")), false, \"关着就不建文件\");\n 160→\t\tstore.linkSession({\n 161→\t\t\tpartnerId: partner.id,\n 162→\t\t\trole: \"canonical\",\n 163→\t\t\trouteKey: \"canonical\",\n 164→\t\t\tsessionId: 101,\n 165→\t\t});\n 166→\t\t// 即使库里有契约快照，关着也不渲染\n 167→\t\tassert.equal(renderContractSection(\"## 职责范围\\n写点什么\"), undefined);\n 168→\n 169→\t\tconst saved = new Store(workRoot);\n 170→\t\tsaved.saveTicket(ticketFixture(workRoot, \"T-off\", \"dispatching\", { originConversationId: \"101\" }));\n 171→\t\tsaved.close();\n 172→\n 173→\t\tconst context = buildPartnerTurnContext(partner.id, 101, {\n 174→\t\t\tstore,\n 175→\t\t\tworkRoot,\n 176→\t\t\tapprovals: { pendingOf: () => [] },\n 177→\t\t});\n 178→\t\tassert.equal(context.contract, null);\n 179→\t\tassert.match(context.status ?? \"\", /T-off/, \"在办段与契约开关无关\");\n 180→\t\tassert.ok(!(context.text ?? \"\").includes(\"【岗位契约】\"));\n 181→\t} finally {\n 182→\t\tstore.close();\n 183→\t\tif (previous === undefined) delete process.env.PARTNER_CONTRACT;\n 184→\t\telse process.env.PARTNER_CONTRACT = previous;\n 185→\t\trmSync(root, { recursive: true, force: true });\n 186→\t}\n 187→});\n 188→\n 189→test(\"装配：SOUL / 岗位契约 / 当前在办三段各自可见，顺序 = 契约 → 在办\", () => {\n 190→\tconst { root, db, homes, workRoot } = tempRoot();\n 191→\tconst store = new PartnersStore(db, homes);\n 192→\ttry {\n 193→\t\tconst partner = store.create(\"阿岚\", { soulSeed: \"你是阿岚，管桌面壳。\" });\n 194→\t\tstore.linkSession({\n 195→\t\t\tpartnerId: partner.id,\n 196→\t\t\trole: \"canonical\",\n 197→\t\t\trouteKey: \"canonical\",\n 198→\t\t\tsessionId: 202,\n 199→\t\t});\n 200→\t\tstore.bumpContract(\n 201→\t\t\tpartner.id,\n 202→\t\t\t[\n 203→\t\t\t\t\"## 职责范围\",\n 204→\t\t\t\t\"桌面壳与安装包。\",\n 205→\t\t\t\t\"\",\n 206→\t\t\t\t\"## 决策分级\",\n 207→\t\t\t\t\"文案自己定；动安装流程先申请。\",\n 208→\t\t\t\t\"\",\n 209→\t\t\t\t\"## 验收标准\",\n 210→\t\t\t\t\"能装能卸，探针全绿。\",\n 211→\t\t\t\t\"\",\n 212→\t\t\t\t\"## 汇报对象\",\n 213→\t\t\t\t\"向总管汇报。\",\n 214→\t\t\t].join(\"\\n\"),\n 215→\t\t);\n 216→\n 217→\t\tconst saved = new Store(workRoot);\n 218→\t\tsaved.saveTicket(\n 219→\t\t\tticketFixture(workRoot, \"T-doing\", \"dispatching\", {\n 220→\t\t\t\toriginConversationId: \"202\",\n 221→\t\t\t\tlastAction: \"在改安装脚本\",\n 222→\t\t\t}),\n 223→\t\t);\n 224→\t\tsaved.saveTicket(\n 225→\t\t\tticketFixture(workRoot, \"T-done\", \"done\", {\n 226→\t\t\t\toriginConversationId: \"202\",\n 227→\t\t\t\tlastAction: \"三个探针全绿\",\n 228→\t\t\t\tupdated_at: new Date(Date.now() + 1000).toISOString(),\n 229→\t\t\t}),\n 230→\t\t);\n 231→\t\t// 别人发起的单不该出现在他的在办里\n 232→\t\tsaved.saveTicket(\n 233→\t\t\tticketFixture(workRoot, \"T-other\", \"dispatching\", { originConversationId: \"999\" }),\n 234→\t\t);\n 235→\t\tsaved.close();\n 236→\n 237→\t\tconst context = buildPartnerTurnContext(partner.id, 202, {\n 238→\t\t\tstore,\n 239→\t\t\tworkRoot,\n 240→\t\t\tapprovals: { pendingOf: () => [{ tool: \"bash\", args: \"npm run build\" }] },\n 241→\t\t});\n 242→\n 243→\t\t// ① SOUL（身份正文）\n 244→\t\tassert.match(context.soul, /你是阿岚/, \"SOUL 段来自当前版本快照\");\n 245→\t\t// ② 岗位契约：四节全文\n 246→\t\tassert.match(context.contract ?? \"\", /【岗位契约】/);\n 247→\t\tassert.match(context.contract ?? \"\", /## 职责范围\\n桌面壳与安装包。/);\n 248→\t\tassert.match(context.contract ?? \"\", /## 决策分级/);\n 249→\t\tassert.match(context.contract ?? \"\", /## 验收标准/);\n 250→\t\tassert.match(context.contract ?? \"\", /## 汇报对象/);\n 251→\t\t// ③ 当前在办：在办单 / 待审批 / 最近一单\n 252→\t\tassert.match(context.status ?? \"\", /【当前在办】/);\n 253→\t\tassert.match(context.status ?? \"\", /T-doing（进行中）：在改安装脚本/);\n 254→\t\tassert.match(context.status ?? \"\", /bash：npm run build/);\n 255→\t\tassert.match(context.status ?? \"\", /最近一单：T-done（已完成）：三个探针全绿/);\n 256→\t\tassert.ok(!(context.status ?? \"\").includes(\"T-other\"), \"别人发起的单不进他的在办\");\n 257→\n 258→\t\t// 合并文本：契约在前、在办在后\n 259→\t\tconst text = context.text ?? \"\";\n 260→\t\tassert.ok(text.indexOf(\"【岗位契约】\") < text.indexOf(\"【当前在办】\"));\n 261→\t\tassert.ok(text.includes(\"【岗位契约】\") && text.includes(\"【当前在办】\"));\n 262→\t} finally {\n 263→\t\tstore.close();\n 264→\t\trmSync(root, { recursive: true, force: true });\n 265→\t}\n 266→});\n 267→\n 268→test(\"空态省略：空契约 + 无在办 / 无待批 / 无最近单 → 契约与在办都不注入\", () => {\n 269→\tconst { root, db, homes, workRoot } = tempRoot();\n 270→\tconst store = new PartnersStore(db, homes);\n 271→\ttry {\n 272→\t\tconst partner = store.create(\"空空\");\n 273→\t\tstore.linkSession({\n 274→\t\t\tpartnerId: partner.id,\n 275→\t\t\trole: \"canonical\",\n 276→\t\t\trouteKey: \"canonical\",\n 277→\t\t\tsessionId: 303,\n 278→\t\t});\n 279→\t\tconst context = buildPartnerTurnContext(partner.id, 303, {\n 280→\t\t\tstore,\n 281→\t\t\tworkRoot,\n 282→\t\t\tapprovals: { pendingOf: () => [] },\n 283→\t\t});\n 284→\t\tassert.match(context.soul, /空空/, \"SOUL 永远在\");\n 285→\t\tassert.equal(context.contract, null);\n 286→\t\tassert.equal(context.status, null);\n 287→\t\t// 2026-11-09 T2：注入防线默认开 → 前两段空时 text 只剩防线（固定字节）\n 288→\t\tassert.match(context.guard ?? \"\", /【材料安全】/);\n 289→\t\tassert.equal(context.text, context.guard, \"没有契约/在办时只注入防线\");\n 290→\n 291→\t\t// 开关关 → 三段都空，text 回到 undefined（与旧行为逐字节一致）\n 292→\t\tconst previous = process.env.AGENT_INJECTION_GUARD;\n 293→\t\ttry {\n 294→\t\t\tprocess.env.AGENT_INJECTION_GUARD = \"false\";\n 295→\t\t\tconst bare = buildPartnerTurnContext(partner.id, 303, {\n 296→\t\t\t\tstore,\n 297→\t\t\t\tworkRoot,\n 298→\t\t\t\tapprovals: { pendingOf: () => [] },\n 299→\t\t\t});\n 300→\t\t\tassert.equal(bare.guard, null);\n 301→\t\t\tassert.equal(bare.text, undefined, \"防线关 + 两段都空 → 不注入任何东西\");\n 302→\t\t} finally {\n 303→\t\t\tif (previous === undefined) delete process.env.AGENT_INJECTION_GUARD;\n 304→\t\t\telse process.env.AGENT_INJECTION_GUARD = previous;\n 305→\t\t}\n 306→\t} finally {\n 307→\t\tstore.close();\n 308→\t\trmSync(root, { recursive: true, force: true });\n 309→\t}\n 310→});\n 311→\n 312→test(\"在办段：明细 ≤3 条 + 超出只报条数；attention 口径文案在段内\", () => {\n 313→\tconst { root, db, homes, workRoot } = tempRoot();\n 314→\tconst store = new PartnersStore(db, homes);\n 315→\ttry {\n 316→\t\tconst partner = store.create(\"忙人\");\n 317→\t\tstore.linkSession({\n 318→\t\t\tpartnerId: partner.id,\n 319→\t\t\trole: \"canonical\",\n 320→\t\t\trouteKey: \"canonical\",\n 321→\t\t\tsessionId: 404,\n 322→\t\t});\n 323→\t\tconst saved = new Store(workRoot);\n 324→\t\tfor (let index = 0; index < 5; index += 1) {\n 325→\t\t\tsaved.saveTicket(\n 326→\t\t\t\tticketFixture(workRoot, `T-${index}`, \"dispatching\", {\n 327→\t\t\t\t\toriginConversationId: \"404\",\n 328→\t\t\t\t\tupdated_at: new Date(Date.now() + index * 1000).toISOString(),\n 329→\t\t\t\t}),\n 330→\t\t\t);\n 331→\t\t}\n 332→\t\tsaved.close();\n 333→\n 334→\t\tconst section = buildPartnerStatusSection(partner.id, 404, {\n 335→\t\t\tstore,\n 336→\t\t\tworkRoot,\n 337→\t\t\tapprovals: {\n 338→\t\t\t\tpendingOf: () => [\n 339→\t\t\t\t\t{ tool: \"bash\", args: \"npm test\" },\n 340→\t\t\t\t\t{ tool: \"write\", args: \"a.ts\" },\n 341→\t\t\t\t\t{ tool: \"edit\", args: \"b.ts\" },\n 342→\t\t\t\t\t{ tool: \"bash\", args: \"rm -rf x\" },\n 343→\t\t\t\t],\n 344→\t\t\t},\n 345→\t\t});\n 346→\t\tassert.ok(section);\n 347→\t\tassert.equal((section.match(/^- T-/gm) ?? []).length, 3, \"在办明细最多 3 条\");\n 348→\t\tassert.match(section ?? \"\", /另有 2 单在办/);\n 349→\t\tassert.match(section ?? \"\", /另有 1 条待批/);\n 350→\t\t// 只说\"有几条\"不说全量参数正文（日志 / 提示词纪律）\n 351→\t\tassert.equal((section.match(/^- (bash|write|edit)：/gm) ?? []).length, 3);\n 352→\t\tassert.match(section ?? \"\", /先跳过，继续其余部分，这项回头再补/);\n 353→\t\tassert.equal(ATTENTION_REPLY_GUIDANCE.includes(\"答得了就直接答\"), true);\n 354→\t} finally {\n 355→\t\tstore.close();\n 356→\t\trmSync(root, { recursive: true, force: true });\n 357→\t}\n 358→});\n 359→\n 360→test(\"刀二：当前目标 + 履历摘要在同一装配点；顺序 = 契约 → 目标 → 在办；零记录不加\", () => {\n 361→\tconst { root, db, homes, workRoot } = tempRoot();\n 362→\tconst store = new PartnersStore(db, homes);\n 363→\ttry {\n 364→\t\tconst partner = store.create(\"阿岚\");\n 365→\t\tstore.linkSession({\n 366→\t\t\tpartnerId: partner.id,\n 367→\t\t\trole: \"canonical\",\n 368→\t\t\trouteKey: \"canonical\",\n 369→\t\t\tsessionId: 505,\n 370→\t\t});\n 371→\t\tstore.bumpContract(partner.id, \"## 职责范围\\n桌面壳与安装包。\");\n 372→\t\tstore.setCurrentGoal(partner.id, \"本季度把安装包做稳\");\n 373→\n 374→\t\t// 一张在办单，让【当前在办】段存在（履历摘要挂在段末尾）。\n 375→\t\tconst saved = new Store(workRoot);\n 376→\t\tsaved.saveTicket(\n 377→\t\t\tticketFixture(workRoot, \"T-505\", \"dispatching\", { originConversationId: \"505\" }),\n 378→\t\t);\n 379→\t\tsaved.close();\n 380→\n 381→\t\tconst deps = {\n 382→\t\t\tstore,\n 383→\t\t\tworkRoot,\n 384→\t\t\tapprovals: { pendingOf: () => [] },\n 385→\t\t\tworkSummary: () => ({ done: 8, failed: 1, stopped: 1, total: 10 }),\n 386→\t\t};\n 387→\t\tconst context = buildPartnerTurnContext(partner.id, 505, deps);\n 388→\n 389→\t\t// ① 目标段（不版本化、现取现用）\n 390→\t\tassert.equal(context.goal, \"【当前目标】本季度把安装包做稳\");\n 391→\t\t// ② 契约段照旧\n 392→\t\tassert.match(context.contract ?? \"\", /【岗位契约】/);\n 393→\t\t// ③ 在办段末尾的履历摘要（过去时）+ 盘点口径（不打分 / 不自动建规则）\n 394→\t\tassert.match(context.status ?? \"\", /【当前在办】/);\n 395→\t\tassert.match(context.status ?? \"\", /近 10 单：完成 8、失败 1、中止 1/);\n 396→\t\tassert.match(context.status ?? \"\", /不打分、不列 KPI 数字/);\n 397→\t\tassert.match(context.status ?? \"\", /不要自己悄悄创建回顾规则/);\n 398→\t\tconst text = context.text ?? \"\";\n 399→\t\tassert.ok(text.indexOf(\"【岗位契约】\") < text.indexOf(\"【当前目标】\"));\n 400→\t\tassert.ok(text.indexOf(\"【当前目标】\") < text.indexOf(\"【当前在办】\"));\n 401→\n 402→\t\t// 零记录：段还在（有在办单），但不加履历摘要行、不带盘点口径。\n 403→\t\tconst zero = buildPartnerTurnContext(partner.id, 505, { ...deps, workSummary: () => null });\n 404→\t\tassert.ok(!(zero.status ?? \"\").includes(\"近 10 单\"), \"零记录不加\");\n 405→\t\tassert.ok(!(zero.status ?? \"\").includes(\"不打分\"), \"零记录不带盘点口径\");\n 406→\t\tassert.match(zero.status ?? \"\", /【当前在办】/, \"在办段照常\");\n 407→\n 408→\t\t// 清除目标：目标段消失，其余不变。\n 409→\t\tstore.setCurrentGoal(partner.id, null);\n 410→\t\tconst noGoal = buildPartnerTurnContext(partner.id, 505, deps);\n 411→\t\tassert.equal(noGoal.goal, null);\n 412→\t\tassert.ok(!(noGoal.text ?? \"\").includes(\"【当前目标】\"));\n 413→\t\tassert.match(noGoal.text ?? \"\", /近 10 单：完成 8、失败 1、中止 1/, \"履历摘要不受影响\");\n 414→\t} finally {\n 415→\t\tstore.close();\n 416→\t\trmSync(root, { recursive: true, force: true });\n 417→\t}\n 418→});\n 419→\n 420→test(\"契约解析：只认四个固定标题，空节连标题一起省略\", () => {\n 421→\tconst source = [\n 422→\t\t\"# 我的契约（这行不是节标题，忽略）\",\n 423→\t\t\"\",\n 424→\t\t\"## 职责范围\",\n 425→\t\t\"只管前端。\",\n 426→\t\t\"\",\n 427→\t\t\"### 子标题保留\",\n 428→\t\t\"细节。\",\n 429→\t\t\"\",\n 430→\t\t\"## 决策分级\",\n 431→\t\t\"\",\n 432→\t\t\"## 验收标准\",\n 433→\t\t\"探针全绿。\",\n 434→\t\t\"\",\n 435→\t\t\"## 汇报对象\",\n 436→\t\t\"## 无关章节\",\n 437→\t\t\"不该出现。\",\n 438→\t].join(\"\\n\");\n 439→\tconst sections = splitContractSections(source);\n 440→\tassert.deepEqual([...sections.keys()].sort(), [...PARTNER_CONTRACT_SECTIONS].sort());\n 441→\tassert.equal(sections.get(\"职责范围\"), \"只管前端。\\n\\n### 子标题保留\\n细节。\");\n 442→\tassert.equal(sections.get(\"决策分级\"), \"\");\n 443→\tconst rendered = renderContractSection(source) ?? \"\";\n 444→\tassert.match(rendered, /## 职责范围/);\n 445→\tassert.ok(!rendered.includes(\"## 决策分级\"), \"空节省略标题\");\n 446→\tassert.ok(!rendered.includes(\"不该出现\"), \"四节之外的内容不注入\");\n 447→});\n 448→"
    },
