          "value": "200:export interface ToolDeps {\n201-\t/** 记忆引擎；为 null 时 remember / recall 会明确报错而不是静默失败 */\n202-\tmemory: MemoryEngine | null;\n203-\t/** 内部会话 id → 记忆作用域 */\n204-\tscopeOf: (conversationId: number) => MemoryScope;\n205-\t/** 技能库；为 null 时 skill 工具不上（技能目录不存在/为空，索引也不会渲染） */\n206-\tskills?: SkillStore | null;\n207-\t/**\n208-\t * 派活能力；为 false 时 delegate 工具不上。\n209-\t *\n210-\t * 2026-11-02：默认开。装上 chancellor 之后主 agent 才有\"把活派出去\"的手。\n211-\t * 关掉它（`CHANCELLOR_ENABLED=false`）时工具清单回到 8 个，行为与改动前完全一致。\n212-\t */\n213-\tdelegate?: boolean;\n214-\t/** 测试用：替换真正跑 chancellor 的入口；生产不传，直接用 runChancellor。 */\n215-\tdelegateRun?: typeof runChancellor;\n216-\t/**\n217-\t * 任务单跑完后回灌会话（2026-11-03）。\n218-\t *\n219-\t * 工具不直接碰会话对象：由 `agent.ts` 传入，内部走 `sayInChat`。\n220-\t * 会话忙时 durable 会把这条写入排到本轮结束，不打断当前对话。\n221-\t */\n222-\treportDelegation?: (conversationId: number, report: DelegationReport) => void;\n223-\t/**\n224-\t * 任务专线双写（2026-11-08 扫尾批 8g）。\n225-\t *\n226-\t * 装配层（`agent/lifecycle.ts`）传 `taskConversationMirror`；不传 = 只写留言表。\n227-\t * 刻意用注入而不是在 tools.ts 里直接 import task-conversation：探针/单测也调\n228-\t * `createTools`，那里没有 durable 上下文，不能因为\"带了个默认值\"就去开真实 Harness。\n229-\t */\n230-\tmirrorDelegation?: (ticketId: string, entry: DelegationMirrorEntry) => void;\n231-\t/**\n232-\t * 项目/工作区登记表（2026-11-03 方案 §5.5）。\n233-\t * 派新活必须先过这里：没有已登记且仍在工作区内的项目一律返回 `needs_project`，\n234-\t * 不建目录、不写文件、不建任务单。\n235-\t */\n236-\tprojects?: ProjectsStore | null;\n237-\t/**\n238-\t * 执事能力（2026-11-05 批次B B2）：为 true 时 `partner_skill_write` 上架。\n239-\t * agent.ts 传 `COMPANIONS_ENABLED`——开关关掉时工具不注册，行为与改动前一致（回滚开关）。\n240-\t */\n241-\tpartners?: boolean;\n242-\t/**\n243-\t * 执事管理工具的存储 / chancellor 工作根（批次D D3）。测试注入临时目录，\n244-\t * 不碰真实 .data/；不传用全局 partnersStore() + chancellorWorkRoot()。\n245-\t */\n246-\tministerContext?: () => MinisterContext;\n247-\t/**\n248-\t * 群组能力（2026-11-07 群组入口统一）：为 true 时 `group_manage` 上架。\n249-\t * agent.ts 不传 → 回落 `groupsAvailable()`（GROUPS_ENABLED + COMPANIONS_ENABLED 双闸）；\n250-\t * 关掉任一个时工具不注册，模型也够不到建群（一行回滚）。\n251-\t */\n252-\tgroups?: boolean;\n253-\t/** 群组核心的存储（2026-11-07）。测试注入临时 store，不碰真实 .data/。 */\n254-\tgroupContext?: () => GroupContext;\n255-\t/** 派单回执表；不传用默认 `.data/delegations.sqlite`。测试可注入临时库。 */\n256-\treceipts?: DelegationReceipts | null;\n257-\t/**\n258-\t * 课题存储（2026-11-07 长期课题跟进）。可选注入：为 null / 缺省时\n259-\t * `propose_topic` 与 `web_search` 都不注册（研究回合也拿不到搜索）。\n260-\t */"
        },
