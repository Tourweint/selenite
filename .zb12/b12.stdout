      "text": " 460→\t\t\t\tcontent: args.content,\n 461→\t\t\t\timportance: args.importance,\n 462→\t\t\t\t// 人自己说的（或当面转述的），可信度最高\n 463→\t\t\t\tveracity: \"stated\",\n 464→\t\t\t\tsource: args.taught ? \"taught\" : \"user\",\n 465→\t\t\t\t// 有效期只对 intention 生效（2026-11-09 T4 §3）：其它 kind 传了也忽略，\n 466→\t\t\t\t// 不因为一个多余参数把普通事实变成\"会过期\"。\n 467→\t\t\t\texpiresAt:\n 468→\t\t\t\t\t(args.kind ?? \"fact\") === \"intention\" && typeof args.expiresInDays === \"number\"\n 469→\t\t\t\t\t\t? new Date(\n 470→\t\t\t\t\t\t\t\tapi.now() +\n 471→\t\t\t\t\t\t\t\t\tMath.min(365, Math.max(1, Math.floor(args.expiresInDays))) * 86_400_000,\n 472→\t\t\t\t\t\t\t).toISOString()\n 473→\t\t\t\t\t\t: null,\n 474→\t\t\t});\n 475→\t\t\t// 写入路径末尾同样按 cap 修剪（只记条数，见 memory-prune.ts）。\n 476→\t\t\tconst pruned = pruneSessionMemory(engine);\n 477→\t\t\tif (pruned > 0) console.log(`[memory] 会话记忆修剪 -${pruned} 条`);\n 478→\t\t\treturn text(`已记住：${record.content}`);\n 479→\t\t},\n 480→\t});\n 481→\n 482→\tconst recall = defineTool({\n 483→\t\tname: \"recall\",\n 484→\t\tdescription:\n 485→\t\t\t\"在长期记忆里检索。和对方有关的事想不起来了，先用它查，不要猜。\" +\n 486→\t\t\t\"当前对话的上下文里通常已经带了相关记忆，只有在不够用时才调用。\",\n 487→\t\tparameters: Type.Object({\n 488→\t\t\tquery: Type.String({ description: \"要查什么，用关键词或一句话\" }),\n 489→\t\t\tlimit: Type.Optional(Type.Number({ description: \"最多返回几条，默认 5\" })),\n 490→\t\t}),\n 491→\t\texecute: async (args, api) => {\n 492→\t\t\tconst engine = requireMemory();\n 493→\t\t\t// 群会话不参与记忆引擎（群组方案 §2.2，v1 最简形态）：群聊查记忆也跳过\n 494→\t\t\tif (partnersStore().isGroupSession(api.conversationId)) {\n 495→\t\t\t\treturn text(\"群聊不走个人记忆；答案以群里的聊天记录为准。\");\n 496→\t\t\t}\n 497→\t\t\tconst hits = engine.recall({\n 498→\t\t\t\ttext: args.query,\n 499→\t\t\t\tscopes: [\"global\", scopeKey(scopeOf(api.conversationId))],\n 500→\t\t\t\tlimit: Math.max(1, Math.min(20, Math.floor(args.limit ?? 5))),\n 501→\t\t\t});\n 502→\t\t\tif (hits.length === 0) return text(\"没有找到相关记忆。\");\n 503→\t\t\treturn text(\n 504→\t\t\t\thits\n 505→\t\t\t\t\t.map((hit) => `- [${hit.record.kind}] ${hit.record.content}（${hit.record.createdAt.slice(0, 10)}）`)\n 506→\t\t\t\t\t.join(\"\\n\"),\n 507→\t\t\t);\n 508→\t\t},\n 509→\t});\n 510→\n 511→\tconst remind = defineTool({\n 512→\t\tname: \"set_reminder\",\n 513→\t\tdescription:\n 514→\t\t\t\"定一个到点提醒。时间写 ISO 8601（带时区），例如 2026-10-29T08:00:00+08:00。\" +\n 515→\t\t\t\"提醒会落库，进程重启也不会丢。\",\n 516→\t\tparameters: Type.Object({\n 517→\t\t\ttext: Type.String({ description: \"到点要提醒的内容\" }),\n 518→\t\t\tat: Type.String({ description: \"触发时间，ISO 8601\" }),\n 519→\t\t}),\n 520→\t\texecute: async (args, api, context) => {\n 521→\t\t\tconst at = Date.parse(args.at);\n 522→\t\t\tif (Number.isNaN(at)) throw new Error(`时间格式看不懂：${args.at}`);\n 523→\t\t\tif (at <= api.now()) throw new Error(`这个时间已经过去了：${args.at}`);\n 524→\n 525→\t\t\tawait api.commit(\n 526→\t\t\t\t(tx) =>\n 527→\t\t\t\t\ttx.createTask(\n 528→\t\t\t\t\t\tReminderTask,\n 529→\t\t\t\t\t\t{ text: args.text, at },\n 530→\t\t\t\t\t\t{ ownership: { kind: \"conversation\" } },\n 531→\t\t\t\t\t),\n 532→\t\t\t\tcontext,\n 533→\t\t\t);\n 534→\t\t\treturn text(`好，${new Date(at).toLocaleString(\"zh-CN\")} 提醒你：${args.text}`);\n 535→\t\t},\n 536→\t});\n 537→\n 538→\t// 按会话记最后一张单：resume 只可能发生在同一轮对话里。\n 539→\t// 不落库——进程重启后会话已断，老单本来也接不上，落库只会多出迁移/过期/清理的常态成本。\n 540→\tconst lastTicketByConversation = new Map<number, string>();\n 541→\t// 续跑被拒时可能改派新单：记住这轮用的项目，改派后仍然落在同一个项目里。\n 542→\tconst lastProjectByConversation = new Map<number, ProjectRef>();\n 543→\tconst run = deps.delegateRun ?? runChancellor;\n 544→\t/** 回滚开关：`DELEGATION_PROJECT_REQUIRED=false` 回到 2026-11-02 的无项目行为。 */\n 545→\tconst projectRequired = envFlag(\"DELEGATION_PROJECT_REQUIRED\", true);\n 546→\t/**\n 547→\t * 设备活项目前置豁免（2026-11-08 扫尾批 3-H B3）：默认开。\n 548→\t * `DELEGATION_DEVICE_PROJECT_EXEMPT=false` → 设备活也要项目（回到本批前行为）。\n 549→\t */\n 550→\tconst deviceProjectExempt = envFlag(\"DELEGATION_DEVICE_PROJECT_EXEMPT\", true);\n 551→\n 552→\tconst proposeProject = defineTool({\n 553→\t\tname: \"propose_project\",\n 554→\t\tdescription:\n 555→\t\t\t\"在用户已选定工作区的前提下，提出新建一个项目根目录。\" +\n 556→\t\t\t\"它只提交待用户确认的请求，**不会创建目录、也不会登记项目**；用户在项目设置里确认后才真正建目录。\" +\n 557→\t\t\t\"只有用户明确要新建一个项目（新的根目录）时才调用；项目内部的子目录不需要、也不应该新建项目。\",\n 558→\t\tparameters: Type.Object({\n 559→\t\t\tname: Type.String({ description: \"项目名，给用户看的短名，例如 手机端 / 桌面壳 / 文档站\" }),\n 560→\t\t\tpath: Type.String({\n 561→\t\t\t\tdescription: \"工作区内的相对路径，例如 projects/新的小工具；不要写绝对路径，不要包含 ..\",\n 562→\t\t\t}),\n 563→\t\t}),\n 564→\t\texecute: async (args) => {\n 565→\t\t\tif (!deps.projects) {\n 566→\t\t\t\treturn text(\n 567→\t\t\t\t\tJSON.stringify({ ok: false, error: \"needs_project\", message: \"项目登记表不可用\" }),\n 568→\t\t\t\t);\n 569→\t\t\t}\n 570→\t\t\ttry {\n 571→\t\t\t\tconst proposal = deps.projects.proposeProject(args.name, args.path);\n 572→\t\t\t\treturn text(\n 573→\t\t\t\t\tJSON.stringify({\n 574→\t\t\t\t\t\tok: true,\n 575→\t\t\t\t\t\tproposalId: proposal.id,\n 576→\t\t\t\t\t\tname: proposal.name,\n 577→\t\t\t\t\t\tpath: proposal.relativePath,\n 578→\t\t\t\t\t\tmessage:\n 579→\t\t\t\t\t\t\t\"已提交待确认：用户在项目设置里确认后才会创建目录并登记。\" +\n 580→\t\t\t\t\t\t\t\"确认之前不要派工到它，也不要自己建这个目录。\",\n 581→\t\t\t\t\t}),\n 582→\t\t\t\t);\n 583→\t\t\t} catch (error) {\n 584→\t\t\t\tconst code = error instanceof ProjectError ? error.code : \"failed\";\n 585→\t\t\t\tconst message = error instanceof Error ? error.message : String(error);\n 586→\t\t\t\treturn text(JSON.stringify({ ok: false, error: code, message }));\n 587→\t\t\t}\n 588→\t\t},\n 589→\t});\n 590→\n 591→\t// 派活（2026-11-02）：主 agent 的\"手\"。它自己不动手，把活交给外面的工人，\n 592→\t// 只拿回一句话。工具的 description 里\"不适合\"那半句比\"适合\"更重要——\n 593→\t// 写宽了，主 agent 会把一次 read 就能答的事也派出去，每次都起 worker，比不用还贵。\n 594→\tconst domainList = (): string => {\n 595→\t\ttry {\n 596→\t\t\tconst domains = listManagers(chancellorWorkRoot())\n 597→\t\t\t\t.map((entry) => entry.domain)\n 598→\t\t\t\t.filter((domain) => DOMAIN_PATTERN.test(domain));\n 599→\t\t\treturn domains.length > 0 ? domains.join(\" / \") : \"（暂无，可用小写英文新建）\";\n 600→\t\t} catch {\n 601→\t\t\treturn \"（当前领域清单不可读）\";\n 602→\t\t}\n 603→\t};\n 604→\tconst delegate = defineTool({\n 605→\t\tname: \"delegate\",\n 606→\t\tdescription:\n 607→\t\t\t\"把一件需要多步动手的活派给外面的工人（领域负责人/执行者）去做。\" +\n 608→\t\t\t\"适合：要改多个文件、要跑命令、要查证之后再动手的任务；\" +\n 609→\t\t\t\"**以及在手机上操作 App**——打开某个 App、点按钮、输入文字、翻页、看屏幕上显示了什么。\" +\n 610→\t\t\t\"不适合：回答问题、闲聊、一次 read 就能答的事、需要边做边问对方的事。\" +\n 611→\t\t\t\"**派出去后会立即返回任务单号，不会占住这一轮对话；后台跑完会有一条汇报写进会话。**\" +\n 612→\t\t\t\"所以返回后直接告诉用户「已派发，完成后会汇报」即可，不要等结果、不要反复查询、不要重复派。\" +\n 613→\t\t\t\"填 `domain` 把活交给对应领域的负责人。**领域名必须是小写 ASCII**（小写字母、数字、连字符，如 `frontend` / `desktop-shell`）；\" +\n 614→\t\t\t`当前已有领域：${domainList()}。不填则按旧路径直接派 worker。` +\n 615→\t\t\t\"**派新活时必须带 `project`（已登记的项目名或 id）**；手机/设备 worker 这类\" +\n 616→\t\t\t\"不落本机磁盘的活可省 `project`（设备活豁免）；本机活没有可用项目时会返回 \" +\n 617→\t\t\t\"`{\\\"error\\\":\\\"needs_project\\\"}` 并列出已有项目——先问用户要建哪个项目，\" +\n 618→\t\t\t\"用 `propose_project` 提交、等用户在设置里确认，再派。\" +\n 619→\t\t\t\"如果上一轮派出去的活卡住了、你问了用户一个问题、用户刚回答了你，用 `resume: true` 接着原单跑：\" +\n 620→\t\t\t\"`requirement` 里只写用户的那句回答（比如「验证码 1234」），不要重述整个任务，\" +\n 621→\t\t\t\"**更不要重新派**——重派会让对方从头再做一遍。\" +\n 622→\t\t\t\"对方在回答你上一轮的问题时，他这句话本身就是要交回去的内容：直接拿它调 resume，\" +\n 623→\t\t\t\"不要再反问一遍，也不要自己替它把剩下的事做完。\" +\n 624→\t\t\t\"会话里没有可续的单时会按新活派，并在结果里告诉你。\" +\n 625→\t\t\t\"**注意（只讲文件路径，不是能力限制）**：工人写文件时用相对路径（如 `summary.md`），\" +\n 626→\t\t\t\"不要指定工作目录之外的绝对路径；产物最后落在 chancellor 的 runs/<ticket>/ 下，不在你指定的绝对位置。\" +\n 627→\t\t\t\"工人在手机上干活时，它看到的是手机屏幕、点的是手机上的按钮——**它碰不到你电脑上的文件**；\" +\n 628→\t\t\t\"反过来，它交回来的是一句话，不是手机里的截图或文件。\" +\n 629→\t\t\t// 2026-11-08 员工人格化刀一 E1 消费点 2（任务书四段）：描述层给口径，参数结构不变。\n 630→\t\t\t\"**任务书按四段写**：目标 / 怎么算好 / 可自主范围 / 必须请示。\" +\n 631→\t\t\t\"你若带「岗位契约」，后两段直接按契约的「决策分级」「验收标准」填写；没有契约就按常理写清边界。\" +\n 632→\t\t\t// 2026-11-09 保证实现纵深 §2.2：计划附件与任务书四段并列，不替换。\n 633→\t\t\t\"**多步活要写 `steps`**：一件事如果有 ≥3 个动作、或者要跨文件改，就用 steps 列出可核对的动作序列\" +\n 634→\t\t\t\"（≤12 条，每条一句话说清做什么、怎么算做到）；一句话就能说完的小活不写。\" +\n 635→\t\t\t\"工人回报「需要你」（need_input / need_decision / need_action）时，答得了就答；\" +\n 636→\t\t\t\"一时答不了，明确告诉它「这一项先跳过，继续其余部分，这项回头再补」，别让整单停在一件小事上。\",\n 637→\t\tparameters: Type.Object({\n 638→\t\t\trequirement: Type.String({\n 639→\t\t\t\tdescription:\n 640→\t\t\t\t\t\"要做的事，按四段写清：① 目标（要达成什么）② 怎么算好（验收标准）\" +\n 641→\t\t\t\t\t\"③ 可自主范围（哪些你可以自己定）④ 必须请示（哪些要先问你）。\" +\n 642→\t\t\t\t\t\"带岗位契约时，后两段照契约的「决策分级」「验收标准」写。\" +\n 643→\t\t\t\t\t\"resume 时只写用户的那句回答，不要重述任务。\" +\n 644→\t\t\t\t\t\"要写文件时给相对路径；要读的文件给绝对路径没问题。\",\n 645→\t\t\t}),\n 646→\t\t\tproject: Type.Optional(\n 647→\t\t\t\tType.String({\n 648→\t\t\t\t\tdescription:\n 649→\t\t\t\t\t\t\"已登记的项目名或 id。派新活时必填；续跑（resume）时可以省略，沿用原单的项目。\" +\n 650→\t\t\t\t\t\t\"不知道有哪些项目时，先不带，工具会返回 needs_project 和项目清单。\",\n 651→\t\t\t\t}),\n 652→\t\t\t),\n 653→\t\t\tdomain: Type.Optional(\n 654→\t\t\t\tType.String({\n 655→\t\t\t\t\tdescription:\n 656→\t\t\t\t\t\t\"领域负责人的领域名，**必须是小写 ASCII**（小写字母、数字、连字符，如 `frontend` / `desktop-shell`）。\" +\n 657→\t\t\t\t\t\t`当前已有领域：${domainList()}。` +\n 658→\t\t\t\t\t\t\"填了就把活交给该领域负责人；不填则直接派 worker（兼容旧行为）。\",\n 659→\t\t\t\t}),\n 660→\t\t\t),\n 661→\t\t\ttargetDevice: Type.Optional(\n 662→\t\t\t\tType.String({\n 663→\t\t\t\t\tdescription:\n 664→\t\t\t\t\t\t\"把活派给**另一台电脑**的 harness 执行（设备矩阵）。填中结名册里的设备 id。\" +\n 665→\t\t\t\t\t\t\"`\\\"auto\\\"` = 电脑自己挑一台（DEVICE_AUTO_DISPATCH 开启时）：**优先主机**（用户在设置里指定的那台），\" +\n 666→\t\t\t\t\t\t\"主机满载或离线才按忙碌度外流到别的机器；挑不出就在本机执行并说明原因；不填仍是本机执行。\" +\n 667→\t\t\t\t\t\t\"设备描述（如「存储机」）与主机位可在 /relay/overview 看到，供点名参考，不参与自动挑选。\" +\n 668→\t\t\t\t\t\t\"填了就跑远程分支：本机的项目登记表不参与，`project` 由目标机判；\" +\n 669→\t\t\t\t\t\t\"目标离线会直接失败（不排队）。\",\n 670→\t\t\t\t}),\n 671→\t\t\t),\n 672→\t\t\tresume: Type.Optional(\n 673→\t\t\t\tType.Boolean({\n 674→\t\t\t\t\tdescription:\n 675→\t\t\t\t\t\t\"接着上一张单跑（上次派出去的活卡住了、你问了用户、用户刚回答时用）。不填 = 新派一件。\",\n 676→\t\t\t\t}),\n 677→\t\t\t),\n 678→\t\t\trequestId: Type.Optional(\n 679→\t\t\t\tType.String({\n 680→"
