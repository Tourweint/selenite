    "output": {
      "type": "text",
      "text": "Stdout: diff --git a/ts/apps/server/src/agent/lifecycle.ts b/ts/apps/server/src/agent/lifecycle.ts\nindex 45f76f4..bd2839c 100644\n--- a/ts/apps/server/src/agent/lifecycle.ts\n+++ b/ts/apps/server/src/agent/lifecycle.ts\n@@ -132,6 +132,8 @@ import {\n \tLOOP_GUARD_BLOCK_MESSAGE,\n \tMAX_TURNS,\n \tTURN_LIMIT_INSTRUCTION,\n+\tVERIFICATION_IRON_LAW,\n+\tlifecycleOwnsVerification,\n \taborting,\n \tlimitHits,\n \trunTurns,\n@@ -419,7 +421,24 @@ async function openHarness(): Promise<Harness> {\n \t\t\t\t\t\treturn resolvePersona(partnersStore, PERSONA);\n \t\t\t\t\t},\n \t\t\t\t},\n-\t\t\t\t// 注入防线（2026-11-09 T2）：紧跟在 persona 之后，固定字节、不含动态内容。\n+\t\t\t\t// 验证铁律（2026-11-10 批 12 §一.1）：紧跟 persona，固定字节、不含动态内容。\n+\t\t\t\t// 非总管的执事轮由 partner-context 注入（他们的 persona 段本来就不出现），\n+\t\t\t\t// 这里跳过，免得同一段在一轮里进两遍；查档案失败按总管处理（主对话不能哑）。\n+\t\t\t\t{\n+\t\t\t\t\tkey: \"verification_iron_law\",\n+\t\t\t\t\trender: (input) => {\n+\t\t\t\t\t\tlet partnerId: string | null = null;\n+\t\t\t\t\t\tif (COMPANIONS_ENABLED) {\n+\t\t\t\t\t\t\ttry {\n+\t\t\t\t\t\t\t\tpartnerId = partnersStore().partnerIdOfSession(Number(input.conversationId));\n+\t\t\t\t\t\t\t} catch {\n+\t\t\t\t\t\t\t\t// 档案库读失败：按总管处理\n+\t\t\t\t\t\t\t}\n+\t\t\t\t\t\t}\n+\t\t\t\t\t\treturn lifecycleOwnsVerification(partnerId) ? VERIFICATION_IRON_LAW : undefined;\n+\t\t\t\t\t},\n+\t\t\t\t},\n+\t\t\t\t// 注入防线（2026-11-09 T2）：排在 persona / 验证铁律之后，固定字节、不含动态内容。\n \t\t\t\t// 关掉时整段省略（不注空壳）。\n \t\t\t\t{\n \t\t\t\t\tkey: \"injection_guard\",\ndiff --git a/ts/apps/server/src/delegation.ts b/ts/apps/server/src/delegation.ts\nindex 101e201..61218e9 100644\n--- a/ts/apps/server/src/delegation.ts\n+++ b/ts/apps/server/src/delegation.ts\n@@ -19,6 +19,8 @@ import type {\n \tChancellorRequest,\n \tTicketResult,\n } from \"../../../../../chancellor/src/index.ts\";\n+import { TAKEOVER_HINT } from \"./agent/turn-gate.ts\";\n+import { failureStreak, takeoverHintEnabled } from \"./failure-streak.ts\";\n import type { ProjectRef } from \"./projects.ts\";\n import {\n \tdelegationMessages,\n@@ -304,6 +306,53 @@ export const WORK_REVIEW_GUIDANCE = [\n \t\"不要自己悄悄创建回顾规则——要主人配，或主人说一句你再用 routine_manage 建。\",\n ].join(\"\\n\");\n \n+/**\n+ * 委派回报四行格式（2026-11-10 批 12 §一.3，按 nightly-labs 的汇报口径改写）。\n+ *\n+ * 为什么要有：工人交回来的常常是\"过程流水账\"或一句\"做完了\"，派活的人拿不到\n+ * 可核对的东西，只能再问一遍。四行把**结论 / 成果 / 证据 / 解锁**固定成同一形状，\n+ * 读的人一眼知道要不要接手。\n+ *\n+ * 固定字节；落点：`delegate` 工具描述（派活前让总管 / 执事把这套口径交待给工人）。\n+ */\n+export const REPORT_FOUR_LINES = [\n+\t\"状态：完成 / 部分完成 / 卡住\",\n+\t\"结果：一句话说清做成了什么（不是过程）\",\n+\t\"证据：拿什么证明的（改了哪个文件 / 跑了什么命令 / 看到什么输出）\",\n+\t\"解锁：卡住时，下一步需要谁做什么；没卡住就写「无」\",\n+].join(\"\\n\");\n+\n+/**\n+ * 干活期间的沉默纪律 + 交付物自含证据（2026-11-10 批 12 §一.6，四#3 剩余）。\n+ *\n+ * 为什么要有：执事接单后每做一步播报一句「我正在…」，等于把人的注意力当进度条用；\n+ * 真正需要人的时候（结果 / 决定 / 交不了差）反而埋在一串噪声里。交付物另附证据，\n+ * 是为了让\"做完了\"可被核对，而不是让主人再跑一遍验证。\n+ *\n+ * 固定字节；落点：执事轮输入（partner-context，总管与执事共用同一装配点）。\n+ */\n+export const WORK_SILENCE_DISCIPLINE = [\n+\t\"【干活期间】\",\n+\t\"- 接单确认只发一次，点名说清要干什么；之后干活期间不说话（不播报「我正在…」）。\",\n+\t\"- 再开口只有三种情况：有结果了 / 需要人做决定 / 干不完要交代。\",\n+\t\"- 交付物必须自己带着验收证据：改了哪个文件、跑了什么、看到什么。没有证据的「做完了」不算完成。\",\n+].join(\"\\n\");\n+\n+/**\n+ * 提问纪律：一次一个问题（2026-11-10 批 12 §一.7.1，四#4）。\n+ *\n+ * 为什么要有：把三个问题塞进一段话，人只会回答最后一个；问「这样可以吗」等于\n+ * 把判断又推回给人。点名对象、给出选项，才是一次能结束的提问。\n+ *\n+ * 固定字节；落点：执事轮输入（partner-context），挨着 ATTENTION_REPLY_GUIDANCE 的口径。\n+ */\n+export const ATTENTION_ONE_QUESTION = [\n+\t\"【提问纪律】\",\n+\t\"- 一次只问一个具体问题，别把三个问题塞进一段话。\",\n+\t\"- 问题要点名对象与期望：「第 2 条的标题你想要哪种：A / B」，不要问「这样可以吗」。\",\n+\t\"- 问题若是因为某条消息 / 某个文件引起的，点名那条消息或文件，别让人自己去回忆。\",\n+].join(\"\\n\");\n+\n /** 注入给 chancellor 的宰相身份正文上限（批次D D2）：宿主侧按 UTF-8 字节截断，chancellor 只透传。 */\n export const MANAGER_SOUL_LIMIT_BYTES = 4 * 1024;\n \n@@ -333,6 +382,13 @@ function truncateUtf8(text: string, maxBytes: number): string {\n export function formatReport(\n \tresult: TicketResult,\n \tdomain: string,\n+\toptions: {\n+\t\t/**\n+\t\t * 同类失败连击已达阈值（2026-11-10 批 12 §一.4）：在 needs_you 那行末尾\n+\t\t * 追加接管建议。默认 false，旧调用方逐字节不变。\n+\t\t */\n+\t\ttakeover?: bo