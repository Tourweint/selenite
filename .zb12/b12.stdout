    "output": {
      "type": "text",
      "text": "   1→/**\n   2→ * 派活的进度与「需要你」事件（2026-11-02；2026-11-03 补异步任务单字段）。\n   3→ *\n   4→ * 为什么单独一个模块：发事件的是工具（`tools.ts` 里的 `delegate`），\n   5→ * 收事件的是对话流（`agent.ts` 的 `chatStream`）。这两个文件本来就互相引用，\n   6→ * 再把通道塞进其中一边就会成环。放中间，两边都只依赖它。\n   7→ *\n   8→ * 2026-11-03：派单改成\"立即受理、后台执行\"。`startDelegation` 是这一段的最小骨架：\n   9→ * 同步返回任务单号，后台跑完再发事件 / 写汇报。真正的进程管理仍然在 chancellor 里。\n  10→ *\n  11→ * 2026-11-04：审批事件**借道本通道**（`type: \"approval\"`），因为它与派活同样是\n  12→ * \"工具钩子写、对话流读\"的一对多通道。只是借传输，与派活语义无关。\n  13→ */\n  14→\n  15→import path from \"node:path\";\n  16→import type { DelegationPhase } from \"@lifediary/shared\";\n  17→import type {\n  18→\tChancellorEvent,\n  19→\tChancellorRequest,\n  20→\tTicketResult,\n  21→} from \"../../../../../chancellor/src/index.ts\";\n  22→import type { ProjectRef } from \"./projects.ts\";\n  23→import {\n  24→\tdelegationMessages,\n  25→\ttype DelegationSenderKind,\n  26→} from \"./delegation-messages.ts\";\n  27→import type { WorkSettlementInput, WorkStatus } from \"./work-record.ts\";\n  28→\n  29→export type DelegationEvent =\n  30→\t/** 进度：这张单在哪个阶段、办到第几件、共几件、这件叫什么 */\n  31→\t| {\n  32→\t\t\ttype: \"delegate\";\n  33→\t\t\tticketId: string;\n  34→\t\t\tdomain: string;\n  35→\t\t\tphase: DelegationPhase;\n  36→\t\t\tdone: number;\n  37→\t\t\ttotal: number;\n  38→\t\t\tcurrent: string;\n  39→\t\t\tmessage?: string;\n  40→\t\t\t/** 项目名；没有项目的旧链路为空。 */\n  41→\t\t\tproject?: string;\n  42→\t\t\t/** 最近一次动作，和 current 同源，但读接口按这个口径展示。 */\n  43→\t\t\tlastAction?: string;\n  44→\t\t\t/** 发事件这一刻的心跳；客户端据此判断「还活着」。 */\n  45→\t\t\tlastHeartbeat?: string;\n  46→\t\t\t/** 等文件租约时被谁卡住。 */\n  47→\t\t\twaitingOn?: string;\n  48→\t  }\n  49→\t/** 需要人：一个问题，不是一句「出错了」 */\n  50→\t| {\n  51→\t\t\ttype: \"attention\";\n  52→\t\t\tticketId: string;\n  53→\t\t\tdomain: string;\n  54→\t\t\tkind: \"need_input\" | \"need_decision\" | \"need_action\";\n  55→\t\t\tquestion: string;\n  56→\t  }\n  57→\t/** 写类工具要人确认（2026-11-04 批次二）；借本通道传输，与派活无关 */\n  58→\t| {\n  59→\t\t\ttype: \"approval\";\n  60→\t\t\tcallId: string;\n  61→\t\t\ttool: string;\n  62→\t\t\targs: string;\n  63→\t\t\tdeadlineAt: string;\n  64→\t\t\t/** 自主轮标记（批次C C2）：例行轮的审批卡，纯增量字段 */\n  65→\t\t\torigin?: \"autonomous\";\n  66→\t  };\n  67→\n  68→export interface DelegationReport {\n  69→\tticketId: string;\n  70→\tdomain: string;\n  71→\tphase: DelegationPhase;\n  72→\t/** 写回会话的一行话，已截断到 80 字 */\n  73→\ttext: string;\n  74→}\n  75→\n  76→/**\n  77→ * 任务专线会话的镜像条目（2026-11-08 扫尾批 8g）。\n  78→ *\n  79→ * 只描述\"往会话里追加一行什么\"，怎么落（pi.assistant 条目、队列、幂等）由\n  80→ * `task-conversation.ts` 决定。`kind` 目前只用于日志与测试断言：\n  81→ *   - `notice`  = 进度/系统提示；\n  82→ *   - `report`  = 执行端向主人汇报（终局那一行）；\n  83→ *   - `message` = 留言表里的 out（派活原话 / 回答）同步一份。\n  84→ * 镜像失败不挡派活：调用方拿到的是 `void`，实现内部自己兜。\n  85→ */\n  86→export interface DelegationMirrorEntry {\n  87→\tkind: \"notice\" | \"report\" | \"message\";\n  88→\ttext: string;\n  89→}\n  90→\n  91→export interface DelegationRuntime {\n  92→\t/** 真正跑 chancellor 的入口；测试可替换 */\n  93→\trun: (\n  94→\t\trequest: ChancellorRequest,\n  95→\t\toptions: { onEvent?: (event: ChancellorEvent) => void },\n  96→\t) => Promise<TicketResult>;\n  97→\temit: (conversationId: number, event: DelegationEvent) => void;\n  98→\t/** 后台跑完后回灌会话；不传 = 不汇报 */\n  99→\treport?: (conversationId: number, report: DelegationReport) => void;\n 100→\t/**\n 101→\t * 任务专线会话的双写缝（2026-11-08 扫尾批 8g）。\n 102→\t *\n 103→\t * 推送时机与 `emit` / `recordMessage` / 终局汇报完全一致（同步调用、同步入队），\n 104→\t * 所以专线里的条目顺序 = 事件顺序。不传 = 只写留言表（单测与旧装配零改动）。\n 105→\t */\n 106→\tmirror?: (ticketId: string, entry: DelegationMirrorEntry) => void;\n 107→\t/** `DELEGATION_AUTO_REPORT`，默认 true */\n 108→\t\tautoReport: boolean;\n 109→\t\t/**\n 110→\t\t * 装配/测试缝（批次D D2）：按 domain 反查执事身份。不传 = 不注入身份\n 111→\t\t * （旧领域、远程锚点会话、以及单元测试都走这条）。只有**本机** delegate 工具装配它，\n 112→\t\t * 这样「不做跨电脑执事」由装配层保证，内核不查执事库、不在禁用执事时建库。\n 113→\t\t */\n 114→\t\tidentityHitFor?: (domain: string) => { name: string; soul: string } | null;\n 115→\t\t/**\n 116→\t\t * 作废位查询（2026-11-07 扫尾批 1 A1）：单子被取消后，进度与终局都不再外发/回写。\n 117→\t\t * 不传 = 没有作废概念（单测与旧调用方零改动）。由装配层读 delegations 库现查，\n 118→\t\t * 这样取消发生后哪怕单子还在后台跑，也能立刻静默。\n 119→\t\t */\n 120→\t\tisCanceled?: (ticketId: string) => boolean;\n 121→\t\t/**\n 122→\t\t * 终态结算落一条 work 履历（2026-11-08 刀二 E2）。只在真终态调一次：\n 123→\t\t * done / failed / aborted / canceled；needs_you / idle 是中间态，不落账。\n 124→\t\t * 不传 = 不落账（单测与旧调用方零改动）。由装配层注入，内核不碰记忆库。\n 125→\t\t */\n 126→\t\trecordWork?: (input: WorkSettlementInput) => void;\n 127→\t\tlog?: (line: string) => void;\n 128→\t}\n 129→\n 130→export interface DelegationKickoff {\n 131→\tconversationId: number;\n 132→\t/** 领域负责人；空串表示按 v0.3 直接派 worker（兼容旧行为） */\n 133→\tdomain: string;\n 134→\trequirement: string;\n 135→\t/** 这张单落在哪个已登记项目里（2026-11-03 方案 §5.5）；续跑时沿用原单 */\n 136→\tproject?: ProjectRef;\n 137→\t/** 有值 = 续跑这张单；没有 = 新派 */\n 138→\tresumeTicketId?: string;\n 139→\t/** 幂等键；回执先落再入队，重启后同 id 只返回原单号。 */\n 140→\trequestId?: string;\n 141→\t/**\n 142→\t * 硬开关（2026-11-07 执事直派）：false 时 chancellor 忽略 domain，绝不建分管宰相。\n 143→\t * 只由\"执事在自己领域内派活\"这一条路由设置——他本来就是该领域的负责人，\n 144→\t * 再起一个分管等于把同一身份跑两遍。缺省 = 走既有分管路径。\n 145→\t */\n 146→\tmanagers?: false;\n 147→\t/**\n 148→\t * 这条派活是谁说的（2026-11-07 派活留言）。\n 149→\t *\n 150→\t * 只用于**旁路簿记**：派单落一条\"来自 X · 时间 · 原文\"的留言，让任务详情\n 151→\t * 能回答\"谁让我干这个\"。不影响派单语义，也不改 chancellor 的任何输入。\n 152→\t * 缺省 = 不记留言（单测与旧调用方零改动）。\n 153→\t */\n 154→\tsender?: { kind: DelegationSenderKind; name: string };\n 155→\t/**\n 156→\t * 计划附件（2026-11-09 保证实现纵深 §2）：这条要求拆成的可核对动作序列。\n 157→\t * 已由 `normalizeDelegationSteps` 校验；缺省 = 旧行为（不落字段、不进提示词）。\n 158→\t */\n 159→\tsteps?: string[];\n 160→\t/**\n 161→\t * 只续跑、不许改派（2026-11-08 扫尾批 8g 任务回话）。\n 162→\t *\n 163→\t * `delegate` 工具的既有语义是\"续跑被拒就按新活派\"；任务详情里的回话不能这样——\n 164→\t * 主人是回答这张单，不是让总管重开一件。true 时续跑在派活前被拒就只返回\n 165→\t * `fellBack=true`，不建新单（调用方据此提示\"这单已经不在等回答\"）。\n 166→\t */\n 167→\tresumeOnly?: boolean;\n 168→\t/**\n 169→\t * 不把 out 留言再镜像进专线（2026-11-08 扫尾批 8g）。\n 170→\t *\n 171→\t * 任务详情的回话已经以**用户条目**写进专线了，续跑时再镜像一条 `【留言】主人：…`\n 172→\t * 等于同一句话出现两次。留言表照写（过渡期兜底视图），只跳过会话镜像。\n 173→\t */\n 174→\tskipMessageMirror?: boolean;\n 175→}\n 176→\n 177→/**\n 178→ * chancellor 的任务单落在哪。默认沿用它的 `process.cwd()/runs`；\n 179→ * 服务端和只读接口必须读同一个位置，所以用同一个入口。\n 180→ */\n 181→export function chancellorWorkRoot(): string {\n 182→\tconst configured = process.env.CHANCELLOR_WORK_ROOT?.trim();\n 183→\treturn path.resolve(configured || path.join(process.cwd(), \"runs\"));\n 184→}\n 185→\n 186→type Sink = (event: DelegationEvent) => void;\n 187→\n 188→const sinks = new Map<number, Set<Sink>>();\n 189→\n 190→export function watchDelegation(conversationId: number, sink: Sink): () => void {\n 191→\tlet set = sinks.get(conversationId);\n 192→\tif (!set) {\n 193→\t\tset = new Set();\n 194→\t\tsinks.set(conversationId, set);\n 195→\t}\n 196→\tset.add(sink);\n 197→\treturn () => {\n 198→\t\tset.delete(sink);\n 199→\t\tif (set.size === 0) sinks.delete(conversationId);\n 200→\t};\n 201→}\n 202→\n 203→// ── 全局事件口（2026-11-05 批次B B3）：例行任务引擎的触发源 ──\n 204→// 跨会话广播，不落盘、不重放；订阅方（routines/观察层）异常绝不影响派活主链路。\n 205→const delegationSinks = new Set<(event: DelegationEvent, conversationId: number) => void>();\n 206→\n 207→export function watchAllDelegationEvents(\n 208→\tsink: (event: DelegationEvent, conversationId: number) => void,\n 209→): () => void {\n 210→\tdelegationSinks.add(sink);\n 211→\treturn () => delegationSinks.delete(sink);\n 212→}\n 213→\n 214→export function emitDelegation(conversationId: number, event: DelegationEvent): void {\n 215→\tfor (const sink of delegationSinks) {\n 216→\t\ttry {\n 217→\t\t\tsink(event, conversationId);\n 218→\t\t} catch {\n 219→\t\t\t/* 订阅方异常不该影响派活 */\n 220→\t\t}\n 221→\t}\n 222→\tconst set = sinks.get(conversationId);\n 223→\tif (!set) return;\n 224→\tfor (const sink of set) {\n 225→\t\ttry {\n 226→\t\t\tsink(event);\n 227→\t\t} catch {\n 228→\t\t\t/* 订阅方异常不该影响派活 */\n 229→\t\t}\n 230→\t}\n 231→}\n 232→\n 233→/** 压成一行再按字数截断；派活汇报与恢复回灌共用（2026-11-04）。 */\n 234→export function truncate(text: string, max: number): string {\n 235→\tconst oneLine = text.replace(/\\s+/g, \" \").trim();\n 236→\treturn oneLine.length <= max ? oneLine : `${oneLine.slice(0, max - 1)}…`;\n 237→}\n 238→\n 239→/** 计划附件的上限（2026-11-09 §2.1）：≤12 条，每条 ≤200 字。 */\n 240→export const DELEGATION_STEPS_MAX = 12;\n 241→export const DELEGATION_STEP_MAX_CHARS = 200;\n 242→\n 243→/**\n 244→ * 校验 `delegate` 的 steps 参数（纯函数，单测直接断言）。\n 245→ *\n 246→ * 语义 = \"这条要求拆成的可核对动作序列\"。不传 / 空数组 = 旧行为（ticket 不带 steps 字段）；\n 247→ * 超限直接报错，**不建单**——宁可让模型改一次参数，也不要在详情里显示半截步骤。\n 248→ */\n 249→export function normalizeDelegationSteps(\n 250→\traw: unknown,\n 251→): { ok: true; steps?: string[] } | { ok: false; message: string } {\n 252→\tif (raw === undefined || raw === null) return { ok: true };\n 253→\tif (!Array.isArray(raw)) return { ok: false, message: \"steps 必须是字符串数组\" };\n 254→\tif (raw.length === 0) return { ok: true };\n 255→\tif (raw.length > DELEGATION_STEPS_MAX) {\n 256→\t\treturn { ok: false, message: `steps 最多 ${DELEGATION_STEPS_MAX} 条（当前 ${raw.length}）` };\n 257→\t}\n 258→\tconst steps: string[] = [];\n 259→\tfor (const item of raw) {\n 260→\t\tif (typeof item !== \"string\") return { ok: false, message: \"steps 每一项都必须是字符串\" };\n 261→\t\tconst text = item.trim();\n 262→\t\tif (!text) return { ok: false, message: \"steps 里不能有空步骤\" };\n 263→\t\tif (text.length > DELEGATION_STEP_MAX_CHARS) {\n 264→\t\t\treturn {\n 265→\t\t\t\tok: false,\n 266→\t\t\t\tmessage: `每条步骤最多 ${DELEGATION_STEP_MAX_CHARS} 字（当前 ${text.length}）`,\n 267→\t\t\t};\n 268→\t\t}\n 269→\t\tsteps.push(text);\n 270→\t}\n 271→\treturn { ok: true, steps };\n 272→}\n 273→\n 274→/**\n 275→ * 收到工人「需要你」时的应答口径（2026-11-08 员工人格化刀一 §4 B2，提示词层）。\n 276→ *\n 277→ * 为什么要有这一条：attention 三种（need_input / need_decision / need_action）是\n 278→ * **工人卡住等你**，不是\"出错了\"。执事答得了就该直接答；一时答不了（缺信息 / 要问主人 /\n 279→ * 需要用户拍板），也必须明确让工人**跳过该项继续其余部分**——否则整单停在一件小事上，\n 280→ * 用户看到的是\"活干到一半没了\"。审批侧已有同款\"先做不需要批准的部分\"（批 8c turn-gate），\n 281→ * 这里只补 attention 这一侧，两处互不替代。\n 282→ *\n 283→ * 落点：由 `agent/partner-context.ts` 拼进执事轮的「当前在办」段（只在有在办事项时出现）。\n 284→ */\n 285→export const ATTENTION_REPLY_GUIDANCE = [\n 286→\t\"工人回报「需要你」（need_input / need_decision / need_action）时：\",\n 287→\t\"- 答得了就直接答（缺什么信息就补什么，要主人拍板的就明确说是哪一项）。\",\n 288→\t\"- 一时答不了，就明确告诉工人：「这一项先跳过，继续其余部分，这项回头再补」——不要让整单停在这一项上，也不要自己猜一个答案糊过去。\",\n 289→].join(\"\\n\");\n 290→\n 291→/**\n 292→ * 周期盘点口径（2026-11-08 员工人格化刀二 E4，方案 §五.5：不打分、不搞 KPI 数字）。\n 293→ *\n 294→ * 提示词层，两处消费：`tools.ts` 的 `routine_manage` 工具描述、\n 295→ * `agent/partner-context.ts` 的装配段。执事按周期盘点时：读自己 work 履历 →\n 296→ * 一段自然语言总结（几单、成几单、什么教训）→ 总结落一条 episode 记忆 → 向主人汇报。\n 297→ * 刻意**不**要求自动建周回顾规则（静默的自动轮 = 意外 token 账单）：规则由主人配，\n 298→ * 或主人说一句\"你每周五自己盘点\"后由执事经 routine_manage 自建（人点头过一次）。\n 299→ */\n 300→export const WORK_REVIEW_GUIDANCE = [\n 301→\t\"按周期盘点自己干过的活时：读自己的 work 工作履历，用一段自然语言说清这一阵子\",\n 302→\t\"接了几单、成了几单、哪一单卡过、有什么该记取的教训（不打分、不列 KPI 数字）；\",\n 303→\t\"把这段总结用 remember 落一条 kind=episode 的记忆，再向主人汇报。\",\n 304→\t\"不要自己悄悄创建回顾规则——要主人配，或主人说一句你再用 routine_manage 建。\",\n 305→].join(\"\\n\");\n 306→\n 307→/** 注入给 chancellor 的宰相身份正文上限（批次D D2）：宿主侧按 UTF-8 字节截断，chancellor 只透传。 */\n 308→export const MANAGER_SOUL_LIMIT_BYTES = 4 * 1024;\n 309→\n 310→/**\n 311→ * 纯函数：把按 domain 命中的执事组装成 ChancellorRequest.managerIdentity。\n 312→ * 没命中（旧领域 / 执事库不可用）返回 undefined —— 请求不带身份，行为与改动前一致。\n 313→ * soul 取调用方给的**当前版本快照正文**（不读磁盘当前值），按字节截到 ≤4KB、不切坏多字节字符。\n 314→ * 抽成导出的纯函数是为了单测能直接断言组装结果，不必起服务。\n 315→ */\n 316→export function buildManagerIdentity(\n 317→\thit: { name: string; soul: string } | null | undefined,\n 318→): { name: string; soul: string } | undefined {\n 319→\tif (!hit) return undefined;\n 320→\treturn { name: hit.name, soul: truncateUtf8(hit.soul, MANAGER_SOUL_LIMIT_BYTES) };\n 321→}\n 322→\n 323→function truncateUtf8(text: string, maxBytes: number): string {\n 324→\tconst buf = Buffer.from(text, \"utf8\");\n 325→\tif (buf.length <= maxBytes) return text;\n 326→\tlet end = maxBytes;\n 327→\t// 回退到不切断 UTF-8 多字节序列的边界（续字节 10xxxxxx 一律往回让）。\n 328→\twhile (end > 0 && ((buf[end] ?? 0) & 0xc0) === 0x80) end -= 1;\n 329→\treturn buf.subarray(0, end).toString(\"utf8\");\n 330→}\n 331→\n 332→/** 结论怎么写成会话里那一行。80 字上限是方案里定的。 */\n 333→export function formatReport(\n 334→\tresult: TicketResult,\n 335→\tdomain: string,\n 336→): DelegationReport {\n 337→\tconst phase: DelegationPhase =\n 338→\t\tresult.status === \"done\"\n 339→\t\t\t? \"done\"\n 340→\t\t\t: result.status === \"needs_you\"\n 341→\t\t\t\t? \"needs_you\"\n 342→\t\t\t\t: result.status === \"aborted\"\n 343→\t\t\t\t\t? \"aborted\"\n 344→\t\t\t\t\t: \"failed\";\n 345→\tconst head = `【任务 ${result.ticketId}${domain ? ` · ${domain}` : \"\"}】`;\n 346→\tconst body =\n 347→\t\tphase === \"done\"\n 348→\t\t\t? `已完成：${result.line}`\n 349→\t\t\t: phase === \"needs_you\"\n 350→\t\t\t\t? `有一项需要你处理：${result.attention?.question ?? result.line}`\n 351→\t\t\t\t: phase === \"aborted\"\n 352→\t\t\t\t\t? `已中断：${result.line}`\n 353→\t\t\t\t\t: `未完成：${result.line}`;\n 354→\treturn {\n 355→\t\tticketId: result.ticketId,\n 356→\t\tdomain,\n 357→\t\tphase,\n 358→\t\ttext: truncate(`${head}${body}`, 80),\n 359→\t};\n 360→}\n 361→\n 362→/** 进度行的阶段词（专线会话用；终态走 REPORT，不在 `emitProgress` 里）。 */\n 363→const PROGRESS_LABEL: Partial<Record<DelegationPhase, string>> = {\n 364→\taccepted: \"已受理\",\n 365→\tplanning: \"规划中\",\n 366→\trunning: \"进行中\",\n 367→\treviewing: \"核对中\",\n 368→};\n 369→\n 370→/**\n 371→ * 进度事件 → 专线会话里的一行（纯函数，单测直接断言）。\n 372→ *\n 373→ * 刻意不合并、不节流：留言表/事件是逐条发生的，专线也逐条记，\n 374→ * 这样\"专线里的顺序\"才真的等于\"事件发生的顺序\"（方案 §四的验证项）。\n 375→ */\n 376→export function formatProgressLine(input: {\n 377→\tphase: DelegationPhase;\n 378→\tdone: number;\n 379→\ttotal: number;\n 380→\tcurrent: string;\n 381→\twaitingOn?: string;\n 382→}): string {\n 383→\tconst label = PROGRESS_LABEL[input.phase] ?? input.phase;\n 384→\tconst count = input.total > 0 ? `（${input.done}/${input.total}）` : \"\";\n 385→\tconst waiting = input.waitingOn ? `，等 ${input.waitingOn}` : \"\";\n 386→\treturn `【进度】${label}：${input.current || \"…\"}${count}${waiting}`;\n 387→}\n 388→\n 389→/** 留言 → 专线里的一行。 */\n 390→export function formatMessageLine(name: string, body: string): string {\n 391→\treturn `【留言】${name}：${body}`;\n 392→}\n 393→\n 394→/**\n 395→ * 立即受理：同步返回任务单号，后台跑完再发事件/汇报。\n 396→ *\n 397→ * 为什么能同步拿到单号：`runChancellor` 在第一次 `await` 之前就会发出\n 398→ * `ticket`（v0.3 路径）或 `manager`（分管路径）事件，两张都带 `ticketId`。\n 399→ * 所以这里不需要改 chancellor 的契约，也不需要预生成单号。\n 400→ */\n 401→export function startDelegation(\n 402→\tkick: DelegationKickoff,\n 403→\truntime: DelegationRuntime,\n 404→): {\n 405→\tticketId: string;\n 406→\toutcome: Promise<TicketResult>;\n 407→\t/** 续跑被拒、已改派新单（单号对不上，不能当成续跑成功）。 */\n 408→\tfellBack: boolean;\n 409→} {\n 410→\tlet ticketId = \"\";\n 411→\tlet total = 0;\n 412→\tlet done = 0;\n 413→\tlet current = \"\";\n 414→\tlet settled = false;\n 415→\n 416→\tconst projectName = kick.project?.name || kick.project?.id;\n 417→\t// 身份在派单开始时取一次快照，两次 launch（含续跑失败回退）共用同一个值：\n 418→\t// 单次派单内不变，不与「改 SOUL 下一轮生效」的版本化语义打架。\n 419→\t// 直派（2026-11-07）不注入身份：调用者本人就是该领域的负责人，再注入等于叠两层。\n 420→\tconst managerIdentity =\n 421→\t\tkick.domain && kick.managers !== false\n 422→\t\t\t? buildManagerIdentity(runtime.identityHitFor?.(kick.domain) ?? null)\n 423→\t\t\t: undefined;\n 424→\tconst emitProgress = (phase: DelegationPhase, next?: string, waitingOn?: string): void => {\n 425→\t\tif (next !== undefined) current = next;\n 426→\t\t// 单号还没出来时先不发：前端要靠 ticketId 归并，发空号只会多一条噪声。\n 427→\t\tif (!ticketId) return;\n 428→\t\t// 作废单点 2：已取消就不再转发进度事件（SSE 安静）。\n 429→\t\tif (runtime.isCanceled?.(ticketId)) return;\n 430→\t\truntime.emit(kick.conversationId, {\n 431→\t\t\ttype: \"delegate\",\n 432→\t\t\tticketId,\n 433→\t\t\tdomain: kick.domain,\n 434→\t\t\tphase,\n 435→\t\t\tdone,\n 436→\t\t\ttotal,\n 437→\t\t\tcurrent,\n 438→\t\t\tlastAction: current,\n 439→\t\t\tlastHeartbeat: new Date().toISOString(),\n 440→\t\t\t...(projectName ? { project: projectName } : {}),\n 441→\t\t\t...(waitingOn ? { waitingOn } : {}),\n 442→\t\t});\n 443→\t\t// 双写（8g）：同一刻、同一内容进专线会话，不额外合并进度。\n 444→\t\truntime.mirror?.(ticketId, {\n 445→\t\t\tkind: \"notice\",\n 446→\t\t\ttext: formatProgressLine({ phase, done, total, current, ...(waitingOn ? { waitingOn } : {}) }),\n 447→\t\t});\n 448→\t};\n 449→\n 450→\tconst translate = (event: ChancellorEvent): void => {\n 451→\t\tif (event.ticketId && !ticketId) ticketId = event.ticketId;\n 452→\t\tswitch (event.type) {\n 453→\t\t\tcase \"ticket\":\n 454→\t\t\t\temitProgress(\"accepted\", event.message ?? \"已受理\");\n 455→\t\t\t\tbreak;\n 456→\t\t\tcase \"manager\":\n 457→\t\t\t\temitProgress(\"planning\", \"领域负责人接手\");\n 458→\t\t\t\tbreak;\n 459→\t\t\tcase \"planned\":\n 460→\t\t\t\ttotal = event.total ?? total;\n 461→\t\t\t\temitProgress(\"running\", \"拆好了，开始派\");\n 462→\t\t\t\tbreak;\n 463→\t\t\tcase \"task-start\":\n 464→\t\t\t\temitProgress(\"running\", event.slug ?? current);\n 465→\t\t\t\tbreak;\n 466→\t\t\tcase \"task-done\":\n 467→\t\t\t\tdone += 1;\n 468→\t\t\t\temitProgress(\"running\", event.slug ?? current);\n 469→\t\t\t\tbreak;\n 470→\t\t\tcase \"task-waiting\":\n 471→\t\t\t\t// 租约没拿到：任务没启动，不算完成；把等待对象带给前端。\n 472→\t\t\t\temitProgress(\"running\", event.message ?? current, event.waitingOn);\n 473→\t\t\t\tbreak;\n 474→\t\t\tcase \"reviewing\":\n 475→\t\t\t\temitProgress(\"reviewing\", \"核对\");\n 476→\t\t\t\tbreak;\n 477→\t\t\tcase \"goal\":\n 478→\t\t\t\temitProgress(\"reviewing\", \"核对结论\");\n 479→\t\t\t\tbreak;\n 480→\t\t\tdefault:\n 481→\t\t\t\tbreak;\n 482→\t\t}\n 483→\t};\n 484→\n 485→\tconst settle = (result: TicketResult): void => {\n 486→\t\tif (settled) return;\n 487→\t\tsettled = true;\n 488→\t\tticketId = result.ticketId || ticketId;\n 489→\t\t// 终态结算（2026-11-08 刀二 E2）：真终态落一条 work 履历，settled 守卫保证一次。\n 490→\t\t//\n 491→\t\t// 放在作废位判断**之前**：取消 / 中止也要结算（终态=canceled / aborted）。\n 492→\t\t// needs_you / idle 是\"等回答 / 等子单\"的中间态，不落账——否则续跑后会\n 493→\t\t// 对同一单再落一条，违反\"每单一条、终态写一次、中间态不写\"。\n 494→\t\t// 写失败只 warn，不影响结算主流程（recordWork 自身也兜了一层）。\n 495→\t\tconst canceled = runtime.isCanceled?.(ticketId) ?? false;\n 496→\t\tconst workStatus: WorkStatus | null = canceled\n 497→\t\t\t? \"canceled\"\n 498→\t\t\t: result.status === \"done\" || result.status === \"failed\" || result.status === \"aborted\"\n 499→\t\t\t\t? result.status\n 500→\t\t\t\t: null;\n 501→\t\tif (workStatus && runtime.recordWork) {\n 502→\t\t\ttry {\n 503→\t\t\t\truntime.recordWork({\n 504→\t\t\t\t\tticketId,\n 505→\t\t\t\t\trequirement: kick.requirement,\n 506→\t\t\t\t\tstatus: workStatus,\n 507→\t\t\t\t\tline: result.line,\n 508→\t\t\t\t\tproductDirs: (result.tasks ?? []).map((task) => task.dir).filter(Boolean),\n 509→\t\t\t\t\toriginConversationId: kick.conversationId,\n 510→\t\t\t\t\tdomain: kick.domain,\n 511→\t\t\t\t});\n 512→\t\t\t} catch (error) {\n 513→\t\t\t\tconst detail = error instanceof Error ? error.message : String(error);\n 514→\t\t\t\tconsole.warn(`[work] 履历落账异常（不影响结算）: ${detail.slice(0, 200)}`);\n 515→\t\t\t}\n 516→\t\t}\n 517→\t\t// 作废单点 1：已取消的单既不写回会话（不 recordMessage、不发 report），\n 518→\t\t// 也不为它发任何事件（作废单点 4：SSE 不再为该单发事件）。\n 519→\t\t// 执行端照常跑完、产物照常落盘——只是 harness 不再搬运结果。\n 520→\t\tif (canceled) return;\n 521→\t\tconst report = formatReport(result, kick.domain);\n 522→\t\t// 结论也落成一条留言：任务详情里 out / in 成对，读起来就是一段经过\n 523→\t\trecordMessage(\"in\", result.line || report.text, { kind: \"system\", name: \"执行端\" });\n 524→\t\t// 双写（8g）：REPORT 落 assistant 条目，语义 = 执行端向主人汇报。\n 525→\t\t// 用完整的那句 result.line（留言表同源），不是 80 字截断的 report.text。\n 526→\t\truntime.mirror?.(ticketId, { kind: \"report\", text: `【汇报】${result.line || report.text}` });\n 527→\t\truntime.emit(kick.conversationId, {\n 528→\t\t\ttype: \"delegate\",\n 529→\t\t\tticketId,\n 530→\t\t\tdomain: kick.domain,\n 531→\t\t\tphase: report.phase,\n 532→\t\t\tdone,\n 533→\t\t\ttotal,\n 534→\t\t\tcurrent: \"\",\n 535→\t\t\tlastAction: result.line,\n 536→\t\t\tlastHeartbeat: new Date().toISOString(),\n 537→\t\t\t...(projectName ? { project: projectName } : {}),\n 538→\t\t\tmessage: result.line,\n 539→\t\t});\n 540→\t\tif (result