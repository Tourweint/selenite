    "arguments": "{\"file_path\": \"D:\\\\Projects\\\\projects\\\\lh-b12\\\\ts\\\\apps\\\\server\\\\src\\\\delegation.ts\", \"new_string\": \"/** 结论怎么写成会话里那一行。80 字上限是方案里定的。 */\\nexport function formatReport(\\n\\tresult: TicketResult,\\n\\tdomain: string,\\n\\toptions: {\\n\\t\\t/**\\n\\t\\t * 同类失败连击已达阈值（2026-11-10 批 12 §一.4）：在 needs_you 那行末尾\\n\\t\\t * 追加接管建议。默认 false，旧调用方逐字节不变。\\n\\t\\t */\\n\\t\\ttakeover?: boolean;\\n\\t} = {},\\n): DelegationReport {\\n\\tconst phase: DelegationPhase =\\n\\t\\tresult.status === \\\"done\\\"\\n\\t\\t\\t? \\\"done\\\"\\n\\t\\t\\t: result.status === \\\"needs_you\\\"\\n\\t\\t\\t\\t? \\\"needs_you\\\"\\n\\t\\t\\t\\t: result.status === \\\"aborted\\\"\\n\\t\\t\\t\\t\\t? \\\"aborted\\\"\\n\\t\\t\\t\\t\\t: \\\"failed\\\";\\n\\tconst head = `【任务 ${result.ticketId}${domain ? ` · ${domain}` : \\\"\\\"}】`;\\n\\tconst body =\\n\\t\\tphase === \\\"done\\\"\\n\\t\\t\\t? `已完成：${result.line}`\\n\\t\\t\\t: phase === \\\"needs_you\\\"\\n\\t\\t\\t\\t? `有一项需要你处理：${result.attention?.question ?? result.line}${\\n\\t\\t\\t\\t\\t\\toptions.takeover ? `（${TAKEOVER_HINT}）` : \\\"\\\"\\n\\t\\t\\t\\t\\t}`\\n\\t\\t\\t\\t: phase === \\\"aborted\\\"\\n\\t\\t\\t\\t\\t? `已中断：${result.line}`\\n\\t\\t\\t\\t\\t: `未完成：${result.line}`;\\n\\treturn {\\n\\t\\tticketId: result.ticketId,\\n\\t\\tdomain,\\n\\t\\tphase,\\n\\t\\ttext: truncate(`${head}${body}`, 80),\\n\\t};\\n}\", \"old_string\": \"/** 结论怎么写成会话里那一行。80 字上限是方案里定的。 */\\nexport function formatReport(\\n\\tresult: TicketResult,\\n\\tdomain: string,\\n): DelegationReport {\\n\\tconst phase: DelegationPhase =\\n\\t\\tresult.status === \\\"done\\\"\\n\\t\\t\\t? \\\"done\\\"\\n\\t\\t\\t: result.status === \\\"needs_you\\\"\\n\\t\\t\\t\\t? \\\"needs_you\\\"\\n\\t\\t\\t\\t: result.status === \\\"aborted\\\"\\n\\t\\t\\t\\t\\t? \\\"aborted\\\"\\n\\t\\t\\t\\t\\t: \\\"failed\\\";\\n\\tconst head = `【任务 ${result.ticketId}${domain ? ` · ${domain}` : \\\"\\\"}】`;\\n\\tconst body =\\n\\t\\tphase === \\\"done\\\"\\n\\t\\t\\t? `已完成：${result.line}`\\n\\t\\t\\t: phase === \\\"needs_you\\\"\\n\\t\\t\\t\\t? `有一项需要你处理：${result.attention?.question ?? result.line}`\\n\\t\\t\\t\\t: phase === \\\"aborted\\\"\\n\\t\\t\\t\\t\\t? `已中断：${result.line}`\\n\\t\\t\\t\\t\\t: `未完成：${result.line}`;\\n\\treturn {\\n\\t\\tticketId: result.ticketId,\\n\\t\\tdomain,\\n\\t\\tphase,\\n\\t\\ttext: truncate(`${head}${body}`, 80),\\n\\t};\\n}\"}",
