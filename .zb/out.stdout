"会话考古：读全部会话（含 task- 专线），标题没有改名时取首句\", async () => {\n 102→\t// 不读真实 .data/chat-meta.json\n 103→\tprocess.env.AGENT_CHAT_META_PATH = join(tmpdir(), \"lifediary-no-such-chat-meta.json\");\n 104→\n 105→\tconst entry = (kind: \"pi.user\" | \"pi.assistant\", text: string, at: number) => ({\n 106→\t\tkind,\n 107→\t\tmodel: [{ role: kind === \"pi.user\" ? \"user\" : \"assistant\", content: [{ type: \"text\", text }], timestamp: at }],\n 108→\t});\n 109→\tconst reader: SessionReader = {\n 110→\t\tasync snapshot() {\n 111→\t\t\treturn { byExternal: { \"conv-main\": 1, \"task-T-9\": 2 } };\n 112→\t\t},\n 113→\t\tasync conversation(id: never) {\n 114→\t\t\tconst entries =\n 115→\t\t\t\tNumber(id) === 1\n 116→\t\t\t\t\t? [entry(\"pi.user\", \"周末去爬山吧\", NOW - 2 * DAY)]\n 117→\t\t\t\t\t: [entry(\"pi.user\", \"整理纪要：爬山装备清单\", NOW - 1 * DAY)];\n 118→\t\t\treturn { context: async () => ({ entries }) } as never;\n 119→\t\t},\n 120→\t};\n 121→\n 122→\tconst hits = await searchSessions(reader, \"爬山\", {}, NOW);\n 123→\tassert.equal(hits.length, 2, \"普通会话与任务专线都在检索范围内\");\n 124→\tconst task = hits.find((hit) => hit.conversationId === \"task-T-9\");\n 125→\tassert.ok(task, \"任务专线应被命中\");\n 126→\tassert.equal(task!.title, \"整理纪要：爬山装备清单\", \"没有改名时标题取首句\");\n 127→\tassert.ok(hits.some((hit) => hit.conversationId === \"conv-main\"));\n 128→});\n 129→\n 130→test(\"会话考古：开关与条件注册（不传 = 工具不上架）\", () => {\n 131→\tassert.equal(recallSessionsEnabled({}), true, \"缺省开\");\n 132→\tassert.equal(recallSessionsEnabled({ AGENT_RECALL_SESSIONS: \"false\" }), false, \"false 关\");\n 133→\tassert.equal(recallSessionsEnabled({ AGENT_RECALL_SESSIONS: \"0\" }), false, \"0 关\");\n 134→\tassert.equal(recallSessionsEnabled({ AGENT_RECALL_SESSIONS: \"off\" }), false, \"off 关\");\n 135→\n 136→\tconst base = { memory: null, scopeOf: () => ({ type: \"global\" as const }), delegate: false };\n 137→\tconst withTool = createTools({ ...base, recallSessions: async () => [] });\n 138→\tassert.ok(withTool.some((tool) => tool.name