    "output": {
      "type": "text",
      "text": "1010→  if (!readLlmConfig()) return c.json({ messages: [] });\n1011→\n1012→  const chat = await openChat(c.req.param(\"conversationId\"));\n1013→  if (!chat) return c.json({ error: \"unknown_conversation\" }, 404);\n1014→\n1015→  const limit = Number(c.req.query(\"limit\") ?? 50);\n1016→  const messages = await readTranscript(chat, Number.isFinite(limit) ? limit : 50);\n1017→  // 会话种类（2026-11-06 B2）：前端据此恢复\"普通 worker / 总管\"身份，不按 id 猜\n1018→  const chatKind = await chatKindOf(chat);\n1019→\n1020→  const sinceRaw = c.req.query(\"sinceSeq\");\n1021→  const eventStore = chatEventStoreOf();\n1022→  if (sinceRaw === undefined || sinceRaw === \"\" || !eventStore) {\n1023→    return c.json({ conversationId: chat.externalId, messages, chatKind });\n1024→  }\n1025→  const sinceSeq = Number(sinceRaw);\n1026→  if (!Number.isFinite(sinceSeq) || sinceSeq < 0) {\n1027→    return c.json({ error: \"bad_request\", message: \"sinceSeq 必须是非负整数\" }, 400);\n1028→  }\n1029→  const { from, events } = eventStore.replaySince(chat.internalId, Math.floor(sinceSeq));\n1030→  return c.json({ conversationId: chat.externalId, messages, chatKind, fromSeq: from, events });\n1031→});\n1032→\n1033→/**\n1034→ * 注入审计（2026-11-10 批 26b §二 / #7 批 A）。\n1035→ *\n1036→ * `GET /api/v1/agent/chat/:conversationId/injections` → `[{id, source, scope, length}]`：\n1037→ * 框架当前接管的注入清单。**只回元数据、不回正文**（`length` 是正文字符数），\n1038→ * 所以即便正文是固定提示词也不会从这里泄露。\n1039→ *\n1040→ * 开关 `AGENT_INJECTION_AUDIT`（默认开；显式 `false` → 404，一行回滚，与 TOPICS/导出同口径）。\n1041→ * `conversationId` 只作上下文传入：批 A 接管的是框架级静态注入（所有会话同一份），\n1042→ * 因此这里不解析 durable 会话、不依赖 LLM 配置、也不校验会话是否存在——它是诊断端点，\n1043→ * 不是会话数据接口。批 A 只接管了 `injection_guard` 一个，数组至多一行。\n1044→ */\n1045→app.get(\"/api/v1/agent/chat/:conversationId/injections\", (c) => {\n1046→  if (!injectionAuditEnabled()) return c.json({ error: \"not_found\" }, 404);\n1047→  return c.json(auditInjections({ conversationId: c.req.param(\"conversationId\") }));\n1048→});\n1049→\n1050→/**\n1051→ * 记忆摘要（导出「接续文件」用）：该**作用域**的 preference + experience，最多 20 条。\n1052→ *\n1053→ * 主对话看 `global`，执事会话看自己的 `partner:<uuid>` 键空间——与偏好落点同口径\n1054→ * （`preferenceScopeOf`）。`session:` 原始对话沉淀刻意不导：接续文件要的是\"关于这个人 /\n1055→ * 这段关系\"的长期事实，不是又抄一遍对话。\n1056→ */\n1057→function handoffMemoryOf(internalId: number): HandoffMemory {\n1058→  if (!memoryEngine) return { enabled: false, scope: \"\", items: [] };\n1059→  const scope = scopeKey(preferenceScopeOf(internalId));\n1060→  try {\n1061→    const records = memoryEngine.list({ scopes: [scope], limit: 200 });\n1062→    const items = records\n1063→      .filter((record) => record.kind === \"preference\" || record.kind === \"experience\")\n1064→      .slice(0, HANDOFF_MEMORY_LIMIT)\n1065→      .map((record) => ({ kind: record.kind, content: record.content }));\n1066→    return { enabled: true, scope, items };\n1067→  } catch {\n1068→    // 只给枚举级说明：原始错误可能带上路径 / 正文\n1069→    console.warn(\"[export] 记忆摘要读取失败（本次不带记忆）\");\n1070→"
    },
