    "output": {
      "type": "text",
      "text": "   1→import { createHash, randomBytes, randomInt, timingSafeEqual } from \"node:crypto\";\n   2→import { existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from \"node:fs\";\n   3→import { networkInterfaces } from \"node:os\";\n   4→import { dirname } from \"node:path\";\n   5→\n   6→/**\n   7→ * 一次性配对码 + 设备凭据（2026-10-29）。\n   8→ *\n   9→ * 背景：App 端去掉了账号体系，但 harness 仍需要回答\"这台手机是不是被允许的\"。\n  10→ * 设计取舍（详见 App 仓库 `docs/设计方案/2026-10-29-去账号化与改连Harness改造方案.md` §4.6）：\n  11→ *\n  12→ * - **码里不放长期密钥**：二维码只含 6 位短码（默认 300 秒、单次、错 5 次作废），\n  13→ *   手机拿码换一个长期 `deviceToken`。截图泄露的是废码，不是凭据。\n  14→ * - **落库不落明文**：码与设备令牌都只存 sha256；库文件泄露 ≠ 凭据可用。\n  15→ * - **只存文件不建表**：数据量极小（一枚码 + 几台设备），不值得为它开一个 SQLite schema；\n  16→ *   也刻意不混进 pi-durable 的存储（那边的表由内核管，外部表混进去升级会痛）。\n  17→ */\n  18→\n  19→const CODE_TTL_SECONDS = Number(process.env.PAIR_CODE_TTL_SECONDS ?? 300);\n  20→const MAX_CODE_ATTEMPTS = 5;\n  21→const MAX_DEVICES = 32;\n  22→\n  23→const STORE_PATH =\n  24→\tprocess.env.PAIRING_STORE_PATH?.trim() || \".data/pairing.json\";\n  25→\n  26→interface StoredCode {\n  27→\t/** sha256(code)，不存明文 */\n  28→\thash: string;\n  29→\texpiresAt: number;\n  30→\tusedAt?: number;\n  31→\tattempts: number;\n  32→}\n  33→\n  34→interface StoredDevice {\n  35→\tid: string;\n  36→\tname: string;\n  37→\t/** sha256(deviceToken) */\n  38→\ttokenHash: string;\n  39→\t/** 指纹（2026-11-10 批 26 §四）：sha256(id + tokenHash) 的短摘要，人眼可核。 */\n  40→\tfingerprint?: string;\n  41→\t/** 键被换过（文件里的 tokenHash 与指纹对不上）：该设备的凭据一律 fail-closed。 */\n  42→\tkeyChangedAt?: number;\n  43→\tcreatedAt: number;\n  44→\tlastSeenAt?: number;\n  45→\trevokedAt?: number;\n  46→}\n  47→\n  48→interface Store {\n  49→\tcode?: StoredCode;\n  50→\tdevices: StoredDevice[];\n  51→}\n  52→\n  53→export type RedeemError =\n  54→\t| \"unknown_code\"\n  55→\t| \"code_used\"\n  56→\t| \"code_expired\"\n  57→\t| \"too_many_attempts\";\n  58→\n  59→export interface RedeemResult {\n  60→\tdeviceToken: string;\n  61→\tdeviceId: string;\n  62→\t/** 人眼可核的设备指纹（批 26 §四）；开关关着时不出现。 */\n  63→\tfingerprint?: string;\n  64→}\n  65→\n  66→/**\n  67→ * 指纹开关（2026-11-10 批 26 §四）：默认开。\n  68→ * `PAIR_DEVICE_FINGERPRINT=false` → 不生成 / 不下发指纹，也不做键变更判定（一行回滚）。\n  69→ */\n  70→export function deviceFingerprintEnabled(env: NodeJS.ProcessEnv = process.env): boolean {\n  71→\tconst raw = (env.PAIR_DEVICE_FINGERPRINT ?? \"\").trim().toLowerCase();\n  72→\tif (!raw) return true;\n  73→\treturn raw !== \"false\" && raw !== \"0\" && raw !== \"off\";\n  74→}\n  75→\n  76→/**\n  77→ * 设备指纹：`sha256(\"lifediary-device-v1|id|tokenHash\")` 前 12 位十六进制，4-4-4 分组。\n  78→ *\n  79→ * 只回答一个问题——\"手机上和电脑上显示的是不是同一台\"。48 bit 够人眼核对，\n  80→ * **不可反推令牌**，也不当凭据用（鉴权仍只认 deviceToken 的 sha256）。\n  81→ */\n  82→export function deviceFingerprint(deviceId: string, tokenHash: string): string {\n  83→\tconst digest = createHash(\"sha256\")\n  84→\t\t.update(`lifediary-device-v1|${deviceId}|${tokenHash}`)\n  85→\t\t.digest(\"hex\")\n  86→\t\t.slice(0, 12)\n  87→\t\t.toUpperCase();\n  88→\treturn `${digest.slice(0, 4)}-${digest.slice(4, 8)}-${digest.slice(8, 12)}`;\n  89→}\n  90→\n  91→function sha256(value: string): string {\n  92→\treturn createHash(\"sha256\").update(value).digest(\"hex\");\n  93→}\n  94→\n  95→/** 定长比较（两个 sha256 hex 等长），避免把\"前缀对了\"泄露给计时攻击 */\n  96→function hashEquals(a: string, b: string): boolean {\n  97→\tconst bufferA = Buffer.from(a);\n  98→\tconst bufferB = Buffer.from(b);\n  99→\tif (bufferA.length !== bufferB.length) return false;\n 100→\treturn timingSafeEqual(bufferA, bufferB);\n 101→}\n 102→\n 103→function load(storePath: string): Store {\n 104→\ttry {\n 105→\t\tif (!existsSync(storePath)) return { devices: [] };\n 106→\t\tconst parsed = JSON.parse(readFileSync(storePath, \"utf8\")) as Store;\n 107→\t\treturn { code: parsed.code, devices: Array.isArray(parsed.devices) ? parsed.devices : [] };\n 108→\t} catch (error) {\n 109→\t\t// 文件损坏就当作没有配对过（设备得重新扫一次），而不是让服务起不来\n 110→\t\tconsole.warn(\n 111→\t\t\t`[pairing] 读取 ${storePath} 失败，按空状态继续: ${error instanceof Error ? error.message : String(error)}`,\n 112→\t\t);\n 113→\t\treturn { devices: [] };\n 114→\t}\n 115→}\n 116→\n 117→function save(storePath: string, store: Store): void {\n 118→\tmkdirSync(dirname(storePath), { recursive: true });\n 119→\tconst tmp = `${storePath}.tmp`;\n 120→\twriteFileSync(tmp, JSON.stringify(store, null, 2), \"utf8\");\n 121→\trenameSync(tmp, storePath);\n 122→}\n 123→\n 124→export class PairingStore {\n 125→\tprivate readonly store: Store;\n 126→\n 127→\tconstructor(private readonly storePath: string = STORE_PATH) {\n 128→\t\tthis.store = load(storePath);\n 129→\t\t// 迁移 + 键变更判定都在构造时做一次：指纹缺失补算，指纹对不上 → 标记 fail-closed。\n 130→\t\tif (deviceFingerprintEnabled()) this.sealFingerprints();\n 131→\t}\n 132→\n 133→\t/**\n 134→\t * 给每台设备补/核指纹（2026-11-10 批 26 §四）。\n 135→\t *\n 136→\t * - 老记录没有指纹 → 补算写入（一次性迁移，不算键变更）；\n 137→\t * - 有指纹但对不上 → **标记 keyChangedAt**，该设备凭据 failed closed。\n 138→\t *   键只会在配对时生成、正常路径不会变；对不上说明文件被改过 / 从别的机器搬了过来，\n 139→\t *   这时\"静默按新键认\"等于把别人换进来的键当成主人。\n 140→\t */\n 141→\tprivate sealFingerprints(now = Date.now()): void {\n 142→\t\tlet dirty = false;\n 143→\t\tfor (const device of this.store.devices) {\n 144→\t\t\tconst expected = deviceFingerprint(device.id, device.tokenHash);\n 145→\t\t\tif (device.fingerprint === undefined) {\n 146→\t\t\t\tdevice.fingerprint = expected;\n 147→\t\t\t\tdirty = true;\n 148→\t\t\t\tcontinue;\n 149→\t\t\t}\n 150→\t\t\tif (device.fingerprint !== expected && device.keyChangedAt === undefined) {\n 151→\t\t\t\tdevice.keyChangedAt = now;\n 152→\t\t\t\tdirty = true;\n 153→\t\t\t\tconsole.warn(\n 154→\t\t\t\t\t`[pairing] 设备 ${device.id.slice(0, 8)} 的凭据指纹不匹配，已按 fail-closed 停用`,\n 155→\t\t\t\t);\n 156→\t\t\t}\n 157→\t\t}\n 158→\t\tif (dirty) this.persist();\n 159→\t}\n 160→\n 161→\t/** 落盘失败只 warn：配对库写不进去不该让服务起不来（与 load 同口径）。 */\n 162→\tprivate persist(): void {\n 163→\t\ttry {\n 164→\t\t\tsave(this.storePath, this.store);\n 165→\t\t} catch (error) {\n 166→\t\t\tconsole.warn(\n 167→\t\t\t\t`[pairing] 写入 ${this.storePath} 失败: ${error instanceof Error ? error.message : String(error)}`,\n 168→\t\t\t);\n 169→\t\t}\n 170→\t}\n 171→\n 172→\t/** 生成一枚新码（同一时刻只保留一枚；新码顶掉旧码）。返回明文码，只在此刻存在。 */\n 173→\tissueCode(now = Date.now()): { code: string; expiresAt: number } {\n 174→\t\tconst code = String(randomInt(0, 1_000_000)).padStart(6, \"0\");\n 175→\t\tconst expiresAt = now + CODE_TTL_SECONDS * 1000;\n 176→\t\tthis.store.code = { hash: sha256(code), expiresAt, attempts: 0 };\n 177→\t\tthis.persist();\n 178→\t\treturn { code, expiresAt };\n 179→\t}\n 180→\n 181→\t/** 当前是否还有一枚可用码（调试页据此显示\"生成/等待扫码\"） */\n 182→\thasLiveCode(now = Date.now()): boolean {\n 183→\t\tconst code = this.store.code;\n 184→\t\treturn !!code && !code.usedAt && code.expiresAt > now && code.attempts < MAX_CODE_ATTEMPTS;\n 185→\t}\n 186→\n 187→\t/** 用码换设备凭据。失败会累计尝试次数（撞上限即作废这枚码）。 */\n 188→\tredeem(code: string, deviceName: string, now = Date.now()): RedeemResult | RedeemError {\n 189→\t\tconst current = this.store.code;\n 190→\t\tif (!current) return \"unknown_code\";\n 191→\t\tif (current.usedAt) return \"code_used\";\n 192→\t\tif (current.expiresAt <= now) return \"code_expired\";\n 193→\t\tif (current.attempts >= MAX_CODE_ATTEMPTS) return \"too_many_attempts\";\n 194→\n 195→\t\tif (!hashEquals(current.hash, sha256(code.trim()))) {\n 196→\t\t\tcurrent.attempts += 1;\n 197→\t\t\tthis.persist();\n 198→\t\t\treturn current.attempts >= MAX_CODE_ATTEMPTS ? \"too_many_attempts\" : \"unknown_code\";\n 199→\t\t}\n 200→\n 201→\t\tconst deviceToken = randomBytes(32).toString(\"base64url\");\n 202→\t\tconst tokenHash = sha256(deviceToken);\n 203→\t\tconst id = randomBytes(8).toString(\"hex\");\n 204→\t\tconst device: StoredDevice = {\n 205→\t\t\tid,\n 206→\t\t\tname: deviceName.trim().slice(0, 40) || \"手机\",\n 207→\t\t\ttokenHash,\n 208→\t\t\tcreatedAt: now,\n 209→\t\t\t...(deviceFingerprintEnabled() ? { fingerprint: deviceFingerprint(id, tokenHash) } : {}),\n 210→\t\t};\n 211→\t\tcurrent.usedAt = now;\n 212→\t\t// 设备上限：踢掉最久没用过的那台（防无限堆积）\n 213→\t\tthis.store.devices = [...this.store.devices, device]\n 214→\t\t\t.filter((item) => !item.revokedAt)\n 215→\t\t\t.sort((a, b) => (b.lastSeenAt ?? b.createdAt) - (a.lastSeenAt ?? a.createdAt))\n 216→\t\t\t.slice(0, MAX_DEVICES);\n 217→\t\tthis.persist();\n 218→\t\treturn {\n 219→\t\t\tdeviceToken,\n 220→\t\t\tdeviceId: device.id,\n 221→\t\t\t...(device.fingerprint ? { fingerprint: device.fingerprint } : {}),\n 222→\t\t};\n 223→\t}\n 224→\n 225→\t/** 设备凭据是否有效（每次请求都会走一次；命中即刷新 lastSeenAt，但最多每分钟落一次盘） */\n 226→\tverifyDeviceToken(token: string, now = Date.now()): boolean {\n 227→\t\tconst hash = sha256(token);\n 228→\t\tlet touched = false;\n 229→\t\tfor (const device of this.store.devices) {\n 230→\t\t\tif (device.revokedAt) continue;\n 231→\t\t\t// 键变更 fail-closed（批 26 §四）：指纹对不上的设备不再接受任何凭据，\n 232→\t\t\t// 直到主人在电脑上撤销 / 重新配对。宁可多要求一次配对，不静默认一把被换掉的键。\n 233→\t\t\tif (device.keyChangedAt) continue;\n 234→\t\t\tif (!hashEquals(device.tokenHash, hash)) continue;\n 235→\t\t\tif (!device.lastSeenAt || now - device.lastSeenAt > 60_000) {\n 236→\t\t\t\tdevice.lastSeenAt = now;\n 237→\t\t\t\ttouched = true;\n 238→\t\t\t}\n 239→\t\t\tif (touched) this.persist();\n 240→\t\t\treturn true;\n 241→\t\t}\n 242→\t\treturn false;\n 243→\t}\n 244→\n 245→\t/** 对外设备清单：始终不含 tokenHash；开关关着时连指纹 / 键变更位也不出现（回滚）。 */\n 246→\tlistDevices(): Array<Omit<StoredDevice, \"tokenHash\">> {\n 247→\t\tconst withFingerprint = deviceFingerprintEnabled();\n 248→\t\treturn this.store.devices.map(({ tokenHash: _hidden, ...rest }) => {\n 249→\t\t\tif (withFingerprint) return rest;\n 250→\t\t\tconst { fingerprint: _fingerprint, keyChangedAt: _keyChanged, ...legacy } = rest;\n 251→\t\t\treturn legacy;\n 252→\t\t});\n 253→\t}\n 254→\n 255→\trevokeDevice(id: string, now = Date.now()): boolean {\n 256→\t\tconst device = this.store.devices.find((item) => item.id === id && !item.revokedAt);\n 257→\t\tif (!device) return false;\n 258→\t\tdevice.revokedAt = now;\n 259→\t\tthis.persist();\n 260→\t\treturn true;\n 261→\t}\n 262→\n 263→\t/** 调试页展示：当前码还剩多少秒（没有可用码返回 0） */\n 264→\tcodeRemainingSeconds(now = Date.now()): number {\n 265→\t\tconst code = this.store.code;\n 266→\t\tif (!code || code.usedAt || code.expiresAt <= now) return 0;\n 267→\t\treturn Math.max(0, Math.ceil((code.expiresAt - now) / 1000));\n 268→\t}\n 269→}\n 270→\n 271→/** 配对链接：手机扫出来的就是这一行（自定义 scheme，App 自己 parse） */\n 272→export function buildPairUrl(base: string, code: string): string {\n 273→\tconst url = new URL(base.startsWith(\"http\") ? base : `http://${base}`);\n 274→\treturn `lifediary-pair://v1?base=${encodeURIComponent(url.origin)}&code=${code}`;\n 275→}\n 276→\n 277→/**\n 278→ * 手机该连的地址：显式 `PAIR_BASE_URL` 优先，否则取首个非内网回环的 IPv4 + 端口。\n 279→ * 手机经 USB 反代时也可能填 127.0.0.1，所以这里只负责\"给一个大概率可用的默认值\"。\n 280→ */\n 281→export function resolvePairBase(port: number): string {\n 282→\tconst explicit = process.env.PAIR_BASE_URL?.trim();\n 283→\tif (explicit) return explicit.replace(/\\/+$/, \"\");\n 284→\tconst interfaces = networkInterfaces();\n 285→\tfor (const group of Object.values(interfaces)) {\n 286→\t\tfor (const item of group ?? []) {\n 287→\t\t\tif (item.family === \"IPv4\" && !item.internal) return `http://${item.address}:${port}`;\n 288→\t\t}\n 289→\t}\n 290→\treturn `http://127.0.0.1:${port}`;\n 291→}\n 292→"
    },
