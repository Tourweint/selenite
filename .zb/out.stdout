      "text": " 185→\t\t\t\t);\n 186→\t\t\t}\n 187→\t\t}\n 188→\t\tif (dirty) this.persist();\n 189→\t}\n 190→\n 191→\t/** 落盘失败只 warn：配对库写不进去不该让服务起不来（与 load 同口径）。 */\n 192→\tprivate persist(): void {\n 193→\t\ttry {\n 194→\t\t\tsave(this.storePath, this.store);\n 195→\t\t} catch (error) {\n 196→\t\t\tconsole.warn(\n 197→\t\t\t\t`[pairing] 写入 ${this.storePath} 失败: ${error instanceof Error ? error.message : String(error)}`,\n 198→\t\t\t);\n 199→\t\t}\n 200→\t}\n 201→\n 202→\t/** 生成一枚新码（同一时刻只保留一枚；新码顶掉旧码）。返回明文码，只在此刻存在。 */\n 203→\tissueCode(now = Date.now()): { code: string; expiresAt: number } {\n 204→\t\tconst code = String(randomInt(0, 1_000_000)).padStart(6, \"0\");\n 205→\t\tconst expiresAt = now + CODE_TTL_SECONDS * 1000;\n 206→\t\tthis.store.code = { hash: sha256(code), expiresAt, attempts: 0 };\n 207→\t\tthis.persist();\n 208→\t\treturn { code, expiresAt };\n 209→\t}\n 210→\n 211→\t/** 当前是否还有一枚可用码（调试页据此显示\"生成/等待扫码\"） */\n 212→\thasLiveCode(now = Date.now()): boolean {\n 213→\t\tconst code = this.store.code;\n 214→\t\treturn !!code && !code.usedAt && code.expiresAt > now && code.attempts < MAX_CODE_ATTEMPTS;\n 215→\t}\n 216→\n 217→\t/** 用码换设备凭据。失败会累计尝试次数（撞上限即作废这枚码）。 */\n 218→\tredeem(code: string, deviceName: string, now = Date.now()): RedeemResult | RedeemError {\n 219→\t\tconst current = this.store.code;\n 220→\t\tif (!current) return \"unknown_code\";\n 221→\t\tif (current.usedAt) return \"code_used\";\n 222→\t\tif (current.expiresAt <= now) return \"code_expired\";\n 223→\t\tif (current.attempts >= MAX_CODE_ATTEMPTS) return \"too_many_attempts\";\n 224→\n 225→\t\tif (!hashEquals(current.hash, sha256(code.trim()))) {\n 226→\t\t\tcurrent.attempts += 1;\n 227→\t\t\tthis.persist();\n 228→\t\t\treturn current.attempts >= MAX_CODE_ATTEMPTS ? \"too_many_attempts\" : \"unknown_code\";\n 229→\t\t}\n 230→\n 231→\t\tconst deviceToken = randomBytes(32).toString(\"base64url\");\n 232→\t\tconst tokenHash = sha256(deviceToken);\n 233→\t\tconst id = randomBytes(8).toString(\"hex\");\n 234→\t\tconst device: StoredDevice = {\n 235→\t\t\tid,\n 236→\t\t\tname: deviceName.trim().slice(0, 40) || \"手机\",\n 237→\t\t\ttokenHash,\n 238→\t\t\tcreatedAt: now,\n 239→\t\t\t...(deviceFingerprintEnabled() ? { fingerprint: deviceFingerprint(id, tokenHash) } : {}),\n 240→\t\t};\n 241→\t\tcurrent.usedAt = now;\n 242→\t\t// 设备上限：踢掉最久没用过的那台（防无限堆积）\n 243→\t\tthis.store.devices = [...this.store.devices, device]\n 244→\t\t\t.filter((item) => !item.revokedAt)\n 245→\t\t\t.sort((a, b) => (b.lastSeenAt ?? b.createdAt) - (a.lastSeenAt ?? a.createdAt))\n 246→\t\t\t.slice(0, MAX_DEVICES);\n 247→\t\tthis.persist();\n 248→\t\treturn {\n 249→\t\t\tdeviceToken,\n 250→\t\t\tdeviceId: device.id,\n 251→\t\t\t...(device.fingerprint ? { fingerprint: device.fingerprint } : {}),\n 252→\t\t};\n 253→\t}\n 254→\n 255→"
