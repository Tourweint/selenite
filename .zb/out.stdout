        "content": " 860→\n 861→\tsetAppliedVersion(partnerId: string, sessionId: number, version: number): void {\n 862→\t\tthis.db\n 863→\t\t\t.prepare(\n 864→\t\t\t\t\"UPDATE partner_session_links SET applied_version = ? WHERE partner_id = ? AND session_id = ?\",\n 865→\t\t\t)\n 866→\t\t\t.run(version, partnerId, sessionId);\n 867→\t}\n 868→\n 869→\t/** 内部会话 id → 拥有它的执事（反向查链接表）。没链接 = null（普通主人会话）。 */\n 870→\tpartnerIdOfSession(sessionId: number): string | null {\n 871→\t\t// `session_id > 0` 滤掉执事的 delegation 占位行（session_id=0）：\n 872→\t\t// 它登记的是领域路由，不是任何真实会话，不能让 0 号会话被误认成执事专线。\n 873→\t\tconst row = this.db\n 874→\t\t\t.prepare(\n 875→\t\t\t\t\"SELECT partner_id FROM partner_session_links WHERE session_id = ? AND session_id > 0 ORDER BY created_at LIMIT 1\",\n 876→\t\t\t)\n 877→\t\t\t.get(sessionId) as { partner_id?: unknown } | undefined;\n 878→\t\treturn row?.partner_id ? String(row.partner_id) : null;\n 879→\t}\n 880→\n 881→\t/**\n 882→\t * 该执事名下所有**真实**会话的内部 id（2026-11-08 员工人格化刀一 E5）。\n 883→\t *\n 884→\t * 用途：判断\"这张派活单是不是他发起的\"——派单时 `originConversationId` 落的就是\n 885→\t * 发起会话的内部 id。canonical / routine / group 都算；`session_id > 0` 滤掉\n 886→\t * delegation 占位行（领域路由不是会话）。只读，不建链接。\n 887→\t */\n 888→\tsessionIdsOf(partnerId: string): number[] {\n 889→\t\tconst rows = this.db\n 890→\t\t\t.prepare(\n 891→\t\t\t\t\"SELECT session_id FROM partner_session_links WHERE partner_id = ? AND session_id > 0\",\n 892→\t\t\t)\n 893→\t\t\t.all(partnerId) as Array<{ session_id?: unknown }>;\n 894→\t\treturn rows\n 895→\t\t\t.map((row) => Number(row.session_id))\n 896→\t\t\t.filter((id) => Number.isInteger(id) && id > 0);\n 897→\t}\n 898→\n 899→\t/**\n 900→\t * `partnerIdOfSession` 的反向只读助手（2026-11-08 扫尾批 8d 执事间递话）：\n 901→\t * 执事**主会话**的内部 id；还没建过会话 = null。\n 902→\t *\n 903→\t * 只看 `canonical`（执事主会话）。例行专线 / 群成员会话 / 领域路由都不是\"递话该落的会话\"：\n 904→\t * 前者跑完即弃、后者没有对外的入口。**只读**：不建会话、不改身份版本——\n 905→\t * 建会话要跑身份对齐（partner-runtime，import agent），那是装配层的事，不塞进存储层。\n 906→\t */\n 907→\tsessionIdOfPartner(partnerId: string): number | null {\n 908→\t\treturn this.findSessionLink(partnerId, \"canonical\", \"canonical\")?.sessionId ?? null;\n 909→\t}\n 910→\n 911→\t// ── 例行任务定义（B3）────────────────────────────────\n 912→\tcreateRoutine(input: {\n 913→\t\tpartnerId: string;\n 914→\t\tname: string;\n 915→\t\tprompt: string;\n 916→\t\ttriggers: RoutineTrigger[];\n 917→\t\tsessionMode: \"persistent\" | \"fresh\";\n 918→\t\tenabled: boolean;\n 919→\t\t/** 完成条件（2026-11-10 批 13 §四）：文字条件，达成即停 */\n 920→\t\tuntil?: { note: string };\n 921→\t\t/** 跑满 N 次自动停 */\n 922→\t\tmaxRuns?: number;\n 923→\t}): RoutineDef {\n 924→\t\tif (!this.get(input.partnerId)) throw new Error(`执事不存在：${input.partnerId}`);\n 925→\t\tconst id = randomUUID();\n 926→\t\tconst now = new Date().toISOString();\n 927→\t\tthis.db\n 928→\t\t\t.prepare(\n 929→\t\t\t\t\"INSERT INTO routines (id, partner_id, name, prompt, triggers, session_mode, enabled, revision, until_note, max_runs, created_at, updated_at) VALUES (?, ?, ?, ?, ?, ?, ?, 1, ?, ?, ?, ?)\",\n 930→",
