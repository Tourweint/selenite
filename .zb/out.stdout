"，见 conversationThinkingLevel()。\n1101→ * 这个 Map 只是让\"切过非 off 就保持\"在引用还没读到时也有个依据。\n1102→ */\n1103→const stickyLevels = new Map<number, ThinkingLevel>();\n1104→/** 已判定\"不切\"的长会话：别每次工具调用都重读 usage */\n1105→const thinkingRefused = new Set<number>();\n1106→\n1107→/** 这个会话的粘性档位（非 off 才有；openai-compat 的档位优先级用） */\n1108→export function stickyThinkingLevel(internalId: number): ThinkingLevel | null {\n1109→\treturn stickyLevels.get(internalId) ?? null;\n1110→}\n1111→\n1112→/** 记一笔\"切到过这个档\"：off 等于清粘性（用户可以显式降回关） */\n1113→export function rememberLevel(internalId: number, level: ThinkingLevel): void {\n1114→\tif (level === \"off\") stickyLevels.delete(internalId);\n1115→\telse stickyLevels.set(internalId, level);\n1116→}\n1117→\n1118→/** 短会话阈值（方案 D3 定 4000；风险表留了 4k→8k 的放宽口子，用环境变量调，不改代码） */\n1119→function thinkingTokenLimit(): number {\n1120→\tconst raw = Number(process.env.AGENT_THINK_TOKEN_LIMIT);\n1121→\treturn Number.isFinite(raw) && raw > 0 ? Math.floor(raw) : 4000;\n1122→}\n1123→\n1124→/**\n1125→ * 该会话上一轮的 prompt 规模（方案 D3a 的测量口径）。\n1126→ *\n1127→ * AssistantMessage.usage.input 就是那一轮的真实重算量（≈当前前缀大小）；\n1128→ * 没有任何带 usage 的 assistant 条目（首轮还没跑完过）→ 返回 null，按 D3a 视为短会话。\n1129→ */\n1130→async function lastTurnInputTokens(\n1131→\tconversation: Conversation,\n1132→\tcontext: Context,\n1133→): Promise<number | null> {\n1134→\tconst view = await conversation.context(context);\n1135→\tfor (let index = view.entries.length - 1; index >= 0; index -= 1) {\n1136→\t\tconst entry = view.entries[index];\n1137→\t\tif (!entry || entry.kind !== \"pi.assistant\") continue;\n1138→\t\tconst message = entry.model?.[0] as { usage?: { input?: number } } | undefined;\n1139→\t\tif (message && typeof message.usage?.input === \"number\") return message.usage.input;\n1140→\t}\n1141→\treturn null;\n1142→}\n1143→\n1144→/**\n1145→ * 工具第一次被调用时把该会话切到目标档（2026-10-31 方案 D2/D3；2026-11-04 档位化）。\n1146→ *\n1147→ * 目标档 = `AGENT_THINK_TOOL_LEVEL`（默认 `low`，非法值回退 low；旧语义是固定 deep/high）。\n1148→ * 模型**不换**（D1），只换思考变体；长会话（上一轮 prompt ≥ 阈值）**不切** ——\n1149→ * 切一次就是整段前缀重算，长会话付不起；短会话也只切一次（粘性记账），切了就保持。\n1150→ * 为什么在**工具钩子**里切而不是开局预判：预判要额外一次判定（慢且可能判错），\n1151→ * 而\"模型自己决定调工具\"本身就是最准的信号。切换发生在工具结果回来之前，\n1152→ * 所以本轮的后续推理就用上了思考档；代价 = 当前前缀重算一次（D3 明码标价）。\n1153→ */\n1154→async function switchThinkingOnTool(api: HookApi, context: Context): Promise<void> {\n1155→\t// 已经切过/已判定不切的，不再碰库（每次工具调用都去 configure/读上下文是白付的）\n1156→\tif (stickyThinkingLevel(api.conversationId) || thinkingRefused.has(api.conversationId)) return;\n1157→\t// 2026-10-31 命名整改（方案 D11）：这个名字以前叫 AGENT_TOOL_UPGRADE，\n1158→\t// 语义是\"升级到更贵的模型\"，会把读代码的人（包括我自己）带偏成\"换模型\"；\n1159→\t// 现在它做的是\"把思考档切上去\"。旧别名 AGENT_TOOL_UPGRADE 已于 2026-11-07 删除。\n1160→\tif ((process.env.AGENT_THINK_ON_TOOL ?? \"on\").trim().toLowerCase() === \"off\") {\n1161→\t\treturn;\n1162→\t}\n1163→\n1164→\tconst config = readLlmConfig();\n1165→\tif (!config) return;\n1166→\t// 目标档：非法值回退 low；off = \"不切\"，与总开关关掉同义（切一次只为了多思考）\n1167→\tconst wanted = thinkingToolLevel();\n1168→\tif (wanted === \"off\") return;\n1169→\n1170→\ttry {\n1171→\t\tconst harness = await getHarness();\n1172→\t\tconst conversation = await harness.conversation(api.conversationId as never, context);\n1173→\t\tif (!conversation) return;\n1174→\t\tconst lastInput = await lastTurnInputTokens(conversation, context);\n1175→\t\tconst limit = thinkingTokenLimit();\n1176→\t\tif (lastInput !== null && lastInput >= limit) {\n1177→\t\t\tthinkingRefused.add(api.conversationId);\n1178→\t\t\tconsole.log(\n1179→\t\t\t\t`[agent] 会话 ${api.conversationId} 首次工具调用时 prompt≈${lastInput} ≥ ${limit}，保持当前档（长会话不切，方案 D3）`,\n1180→\t\t\t);\n1181→\t\t\treturn;\n1182→",
