      "text": "10326→async function renderSettings() {\n10327→  const page = currentSettingsPage();\n10328→  renderSettingsNav(page);\n10329→  el.settingsInner.setAttribute(\"role\", \"tabpanel\");\n10330→  el.settingsInner.setAttribute(\"aria-labelledby\", `settings-tab-${page}`);\n10331→\n10332→  if (page === \"appearance\") {\n10333→    const choice = currentThemeChoice();\n10334→    const accent = localStorage.getItem(KEY_ACCENT) || \"indigo\";\n10335→    el.settingsInner.innerHTML = sectionMarkup(\n10336→      \"外观\",\n10337→      `<div class=\"card\">\n10338→        ${rowMarkup(\n10339→          \"主题\",\n10340→          \"四套色板，点哪套就固定下来（不再跟随系统）\",\n10341→          `<div class=\"theme-picker\" role=\"radiogroup\" aria-label=\"主题\">\n10342→             ${THEMES.map(\n10343→               (item) =>\n10344→                 `<button class=\"theme-choice\" type=\"button\" role=\"radio\"\n10345→                    data-theme-choice=\"${item.id}\" aria-checked=\"${choice === item.id}\"\n10346→                    title=\"${item.name}\" aria-label=\"${item.name}\"\n10347→                    style=\"--tc-bg:${item.bg};--tc-card:${item.card};--tc-accent:${item.accent}\">\n10348→                    <span class=\"theme-chip\" aria-hidden=\"true\">\n10349→                      <span class=\"theme-chip-dot\"></span>\n10350→                      <span class=\"theme-chip-card\"></span>\n10351→                    </span>\n10352→                    <span class=\"theme-name\">${item.name}</span>\n10353→                  </button>`,\n10354→             ).join(\"\")}\n10355→           </div>`,\n10356→        )}\n10357→        <div class=\"divider\"></div>\n10358→        ${rowMarkup(\n10359→          \"主题色\",\n10360→          \"三个都取自手机端色板，不另造颜色\",\n10361→          `<div class=\"swatches\" role=\"radiogroup\" aria-label=\"主题色\">\n10362→             ${ACCENTS.map(\n10363→               (item) =>\n10364→                 `<button class=\"swatch\" type=\"button\" data-accent-choice=\"${item.id}\"\n10365→                    style=\"background:${item.chip}\" title=\"${item.name}\" aria-label=\"${item.name}\"\n10366→                    aria-checked=\"${accent === item.id}\"></button>`,\n10367→             ).join(\"\")}\n10368→           </div>`,\n10369→        )}\n10370→      </div>`,\n10371→    );\n10372→\n10373→    // 主题色板：点击即切 + 持久化，无需确认；当前项由 syncThemeControls 描边\n10374→    for (const button of el.settingsInner.querySelectorAll(\"[data-theme-choice]\")) {\n10375→      button.addEventListener(\"click\", () => setThemeChoice(button.dataset.themeChoice));\n10376→    }\n10377→    for (const button of el.settingsInner.querySelectorAll(\"[data-accent-choice]\")) {\n10378→      button.addEventListener(\"click\", () => setAccent(button.dataset.accentChoice));\n10379→    }\n10380→  } else if (page === \"chats\") {\n10381→    const sendKey = localStorage.getItem(KEY_SEND) || \"enter\";\n10382→    const showActs = localStorage.getItem(KEY_ACTS) !== \"0\";\n10383→    el.settingsInner.innerHTML = `${sectionMarkup(\n10384→      \"会话\",\n10385→      `<div class=\"card\">\n10386→        ${rowMarkup(\n10387→          \"搜索会话\",\n10388→          \"先按标题/第一句找；输入 2 字以上还会搜正文内容\",\n10389→          `<input class=\"chat-search\" id=\"settings-search\" type=\"search\" placeholder=\"搜索…\" aria-label=\"搜索会话\" />`,\n10390→        )}\n10391→        <div class=\"divider\"></div>\n10392→        <div id=\"search-results\"></div>\n10393→        <div id=\"content-results\"></div>\n10394→        ${rowMarkup(\n10395→          \"回车发送\",\n10396→          \"开启后回车直接发送；关掉则回车换行、Ctrl+Enter 发送\",\n10397→          switchMarkup(sendKey === \"enter\", {\n10398→            label: \"回车发送\",\n10399→            attrs: 'data-send-key-switch',\n10400→          }),\n10401→        )}\n10402→        <div class=\"divider\"></div>\n10403→        ${rowMarkup(\n10404→          \"工具活动\",\n10405→          \"关掉就只看回答，不看「读了哪个文件、跑了什么命令」\",\n10406→          switchMarkup(showActs, { label: \"显示工具活动\", attrs: 'data-acts-switch' }),\n10407→        )}\n10408→        ${\n10409→          state.removed\n10410→            ? `<div class=\"divider\"></div>\n10411→               ${rowMarkup(\n10412→                 \"已移除的会话\",\n10413→                 `有 ${state.removed} 个会话从列表里拿掉了，数据还在`,\n10414→                 `<button class=\"ghost\" type=\"button\" id=\"restore-chats\">恢复</button>`,\n10415→                 { inlineHint: true },\n10416→               )}`\n10417→            : \"\"\n10418→        }\n10419→        <div class=\"divider\"></div>\n10420→        ${rowMarkup(\n10421→          \"导出全部数据\",\n10422→          \"会话、消息、供应商配置（不含密钥）打包成 JSON，自己存档或复制\",\n10423→          `<button class=\"ghost\" type=\"button\" id=\"settings-export-all\">导出</button>`,\n10424→        )}\n10425→      </div>`,\n10426→    )}\n10427→    ${sectionMarkup(\n10428→      \"权限\",\n10429→      `<div class=\"card\">\n10430→        ${rowMarkup(\n10431→          \"Agent 权限\",\n10432→          \"决定它能替你动到什么程度：完全访问 = 能改文件、能跑命令。改完立刻生效。\",\n10433→          `<div class=\"segmented slide\" role=\"radiogroup\" aria-label=\"权限\" id=\"policy-switch\">\n10434→             <button type=\"button\" data-policy=\"full\" aria-checked=\"false\">完全访问</button>\n10435→             <button type=\"button\" data-policy=\"read-only\" aria-checked=\"false\">只读</button>\n10436→"
