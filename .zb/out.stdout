      "text": " 375→\n 376→\t// ── 4. 用量 ───────────────────────────────────────\n 377→\tconsole.log(\"\\n· 4. 用量接口\");\n 378→\tconst usageResponse = await fetch(`${BASE}/api/v1/agent/usage`);\n 379→\tconst usage = (await usageResponse.json()) as {\n 380→\t\tmodels: { model: string; totalTokens: number }[];\n 381→\t};\n 382→\tcheck(usage.models.length > 0, \"有用量记录\", JSON.stringify(usage.models[0]));\n 383→\n 384→\t// ── 5. 提醒 ───────────────────────────────────────\n 385→\t// ── 4.5 注入审计端点（2026-11-10 批 26b §二）──────────\n 386→\t// 真 HTTP 验：只回元数据、不回正文；批 A 框架只接管 injection_guard 一个。\n 387→\tconsole.log(\"\\n· 4.5 注入审计端点（只回元数据，不回正文）\");\n 388→\tconst injectionsRes = await fetch(`${BASE}/api/v1/agent/chat/${externalId}/injections`);\n 389→\tcheck(injectionsRes.status === 200, \"GET .../injections → 200\", String(injectionsRes.status));\n 390→\tconst injections = (await injectionsRes.json()) as Array<Record<string, unknown>>;\n 391→\tcheck(\n 392→\t\tArray.isArray(injections) && injections.length === 1,\n 393→\t\t\"批 A 只接管一个注入\",\n 394→\t\tJSON.stringify(injections),\n 395→\t);\n 396→\tconst injRow = injections[0] ?? {};\n 397→\tcheck(\n 398→\t\tinjRow.id === \"injection_guard\" &&\n 399→\t\t\tinjRow.source === \"injection_guard\" &&\n 400→\t\t\tinjRow.scope === \"session\" &&\n 401→\t\t\ttypeof injRow.length === \"number\" &&\n 402→\t\t\t(injRow.length as number) > 0,\n 403→\t\t\"审计行形状 {id,source,scope,length}\",\n 404→\t\tJSON.stringify(injRow),\n 405→\t);\n 406→\tcheck(\n 407→\t\t!(\"text\" in injRow) && !JSON.stringify(injections).includes(\"【材料安全】\"),\n 408→\t\t\"审计不返正文（无 text 字段、无实文片段）\",\n 409→\t);\n 410→\n 411→\tconsole.log(\"\\n· 5. 提醒接口\");\n 412→\tconst at = Date.now() + 1_200;\n 413→\tconst created = await fetch(`${BASE}/api/v1/agent/reminders`, {\n 414→\t\tmethod: \"POST\",\n 415→\t\theaders: { \"content-type\": \"application/json\" },\n 416→\t\tbody: JSON.stringify({ conversationId: externalId, text: \"该写日记了\", at }),\n 417→\t});\n 418→\tcheck(created.status === 201, \"提醒创建成功\", String(created.status));\n 419→\n 420→\tconst pending = (await (await fetch(`${BASE}/api/v1/agent/reminders`)).json()) as {\n 421→\t\treminders: { text: string; status: string }[];\n 422→\t};\n 423→\tcheck(pending.reminders.length === 1, \"列表里有一条待触发\", JSON.stringify(pending.reminders[0]));\n 424→\n 425→"
