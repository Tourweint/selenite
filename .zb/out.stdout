      "type": "text",
      "text": "  62→}\n  63→\n  64→/** 只依赖 Models 的查询面，单测可传替身，不用真起 provider 目录。 */\n  65→interface AuxModelLookup {\n  66→\tgetModel(provider: string, id: string): unknown;\n  67→\tgetProviders(): readonly { id: string }[];\n  68→}\n  69→\n  70→export interface AuxiliaryDeps {\n  71→\tenv?: NodeJS.ProcessEnv;\n  72→\t/** 当前会话模型；不传就读 `readLlmConfig()`（拿不到 = 没有可用模型） */\n  73→\tcurrent?: ModelRef | null;\n  74→\tmodels?: AuxModelLookup;\n  75→}\n  76→\n  77→/**\n  78→ * 某用途实际该用的模型引用。\n  79→ *\n  80→ * 解析顺序：\n  81→ *   1. 没有当前模型 → null（调用方按\"没有模型\"处理）；\n  82→ *   2. `AUX_LLM=false` 或该用途没 pin → 当前模型；\n  83→ *   3. pin 的名字先在当前供应商里找，再按目录顺序找同名模型（同名跨供应商不能猜，\n  84→ *      先认当前这一家）；找不到 → **回落当前模型并 warn**，不静默换一家不存在的模型。\n  85→ *\n  86→ * 返回 null 只表示\"没有可用的 LLM\"，不表示\"pin 配错了\"。\n  87→ */\n  88→export function auxiliaryModel(use: AuxUse, deps: AuxiliaryDeps = {}): ModelRef | null {\n  89→\tconst env = deps.env ?? process.env;\n  90→\tconst current = deps.current === undefined ? (readLlmConfig()?.model ?? null) : deps.current;\n  91→\tif (!current) return null;\n  92→\tif (!auxiliaryEnabled(env)) return current;\n  93→\n  94→\tconst pinned = auxPinnedModelId(use, env);\n  95→\tif (!pinned) return current;\n  96→\n  97→\tconst models = deps.models ?? currentModels();\n  98→\tif (models.getModel(current.provider, pinned)) {\n  99→\t\treturn { provider: current.provider, modelId: pinned };\n 100→\t}\n 101→\tfor (const provider of models.getProviders()) {\n 102→\t\tif (models.getModel(provider.id, pinned)) {\n 103→\t\t\treturn { provider: provider.id, modelId: pinned };\n 104→\t\t}\n 105→\t}\n 106→\n 107→\t// 配错不换路由：回落当前模型，只记用途枚举与模型名（没有对话内容）\n 108→\tconsole.warn(\n 109→\t\t`[aux] AUX_MODEL_${use.toUpperCase()}=${pinned} 不在模型目录里，回落当前模型`,\n 110→\t);\n 111→\treturn current;\n 112→}\n 113→"
    },
