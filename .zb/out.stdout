      "text": "1495→\t\t\t\ttypeof exported.modelSelection?.modelId === \"string\"),\n1496→\t\t\"modelSelection 形状正确\",\n1497→\t\tJSON.stringify(exported.modelSelection?.[\"providerId\"] ?? null),\n1498→\t);\n1499→\tcheck(Array.isArray(exported.usage?.models), \"usage 原样带 models\");\n1500→\n1501→\t// ── 18. 任务单来源对话（L1，2026-11-05，接口文档 §2.9）──\n1502→\tconsole.log(\"\\n· 18. 任务单来源对话（conversationId）\");\n1503→\tconst TICKETS_BASE = resolve(\".data/probe-http-tickets\");\n1504→\t// workRoot 的 managers/ 在同级：必须把工作根再下沉一层，别碰到真实的 .data/managers。\n1505→\tconst TICKETS_ROOT = join(TICKETS_BASE, \"runs\");\n1506→\tconst TICKETS_DB = resolve(\".data/probe-http-delegations.sqlite\");\n1507→\tconst PARTNER_DB = resolve(\".data/probe-http-partners.sqlite\");\n1508→\tconst PARTNER_HOMES = resolve(\".data/probe-http-partner-homes\");\n1509→\trmSync(TICKETS_BASE, { recursive: true, force: true });\n1510→\trmSync(TICKETS_DB, { force: true });\n1511→\tserver.kill();\n1512→\tawait sleep(800);\n1513→\t// 执事库要等旧进程完全退出再删：Windows 上打开着的 sqlite 删不掉。\n1514→\trmSync(PARTNER_DB, { force: true });\n1515→\trmSync(`${PARTNER_DB}-wal`, { force: true });\n1516→\trmSync(`${PARTNER_DB}-shm`, { force: true });\n1517→\trmSync(PARTNER_HOMES, { recursive: true, force: true });\n1518→\tserver = startServer({\n1519→\t\t...secretEnv,\n1520→\t\tCHANCELLOR_ENABLED: \"false\",\n1521→\t\tCHANCELLOR_WORK_ROOT: TICKETS_ROOT,\n1522→\t\tDELEGATIONS_DB_PATH: TICKETS_DB,\n1523→\t});\n1524→\tawait waitForReady();\n1525→\n1526→\t// 一张真实会话：它是所有来源对话断言的对照物。\n1527→\tconst sourceChat = await chat({ messages: [{ role: \"user\", content: \"来源对话探针\" }] });\n1528→\tconst sourceConversationId = sourceChat.result.conversationId ?? \"\";\n1529→\tcheck(Boolean(sourceConversationId), \"建一条来源对话\", sourceConversationId);\n1530→\n1531→\t// ticket.json / 回执里存的是宿主内部会话 id；用同一份 durable 库拿到内→外映射。\n1532→\tprocess.env.AGENT_DB_PATH = resolve(DB);\n1533→\tprocess.env.MEMORY_DB_PATH = resolve(MEMORY_DB);\n1534→\tprocess.env.MEMORY_ENABLED = \"false\";\n1535→\tprocess.env.LLM_PROVIDER = \"faux\";\n1536→\tprocess.env.PROVIDERS_PATH = resolve(\".data/probe-http-providers.json\");\n1537→\tprocess.env.PARTNERS_DB_PATH = resolve(\".data/probe-http-partners.sqlite\");\n1538→\tprocess.env.COMPANIONS_ENABLED = \"false\";\n1539→\tprocess.env.CHANCELLOR_ENABLED = \"false\";\n1540→\tconst { externalChatIds, getHarness } = await import(\"../src/agent.ts\");\n1541→\tconst idMap = await externalChatIds();\n1542→\tconst internalId = [...idMap.entries()].find(\n1543→\t\t([, external]) => external === sourceConversationId,\n1544→\t)?.[0];\n1545→\tcheck(internalId !== undefined, \"拿到会话的内外 id 映射\", `${internalId} -> ${sourceConversationId}`);\n1546→\t// 探针只借一次映射；不关掉的话 Windows 上 finally 删不掉服务端库（句柄还在）。\n1547→\tawait (await getHarness()).close(BACKGROUND_CONTEXT);\n1548→\n1549→\tconst { Store } = await import(\"../../../../../chancellor/src/store.ts\");\n1550→\tconst { DelegationReceipts } = await import(\"../src/delegation-receipts.ts\");\n1551→\tconst nowIso = new Date().toISOString();\n1552→\tconst fixture = (id: string, extra: Record<string, unknown> = {}) =>\n1553→\t\t({\n1554→\t\t\tid,\n1555→\t\t\tprompt: `来源对话夹具 ${id}`,\n1556→\t\t\tstatus: \"dispatching\",\n1557→\t\t\tcreated_at: nowIso,\n1558→\t\t\tupdated_at: nowIso,\n1559→\t\t\toptions: { dry: true, maxTasks: 8, workRoot: TICKETS_ROOT },\n1560→\t\t\t...extra,\n1561→\t\t}) as Ticket;\n1562→\tconst store = new Store(TICKETS_ROOT);\n1563→\t// 新单：宿主派单时写进来的内部 id（子单继承同值）。\n1564→\tstore.saveTicket(fixture(\"T-source\", { originConversationId: String(internalId) }));\n1565→\tstore.saveTicket(\n1566→\t\tfixture(\"T-child\", {\n1567→\t\t\tparentTicketId: \"T-source\",\n1568→\t\t\toriginConversationId: String(internalId),\n1569→\t\t}),\n1570→\t);\n1571→\t// 历史单：ticket.json 没有字段，靠派单回执反查；以及一张既没字段也没回执的（→ null）。\n1572→\tstore.saveTicket(fixture(\"T-legacy\"));\n1573→\tstore.saveTicket(fixture(\"T-orphan\"));\n1574→\t// 计划附件 / 返工轮次夹具（2026-11-09 §2.3 / §1.5）：详情必须读得到，缺省不出现。\n1575→\tstore.saveTicket(\n1576→\t\tfixture(\"T-steps\", {\n1577→\t\t\tsteps: [\"读 src/a.ts\", \"改 src/b.ts\"],\n1578→\t\t\trepairRound: 1,\n1579→\t\t}),\n1580→\t);\n1581→\t// 任务专线夹具（8g）：非终态 + 有宿主会话，但**没有 plan.json**——\n1582→\t// 续跑会在派活前被 chancellor 拒掉，正好验 resumeOnly（不偷偷改派新单）。\n1583→\tstore.saveTicket(\n1584→\t\tfixture(\"T-say\", {\n1585→\t\t\tstatus: \"needs_you\",\n1586→\t\t\toriginConversationId: String(internalId),\n1587→\t\t\t// 键控基线（批 21 §四）：steps 进专线的验收标准块（没有 plan.json → writes 为空）。\n1588→\t\t\tsteps: [\"确认需求\", \"给出方案\"],\n1589→\t\t}),\n1590→\t);\n1591→\tstore.close();\n1592→\tconst receipts = new DelegationReceipts(TICKETS_DB);\n1593→\treceipts.begin(\"probe-legacy\", \"probe-fingerprint\", { explicit: true });\n1594→\treceipts.accept(\"probe-legacy\", \"T-legacy\", internalId);\n1595→\treceipts.close();\n1596→\n1597→\t// 领域单：chiefName 按 ticket.options.domain 反查 partners 表的执事名（L1 §2.2）。\n1598→\tconst { ensureManager } = await import(\"../../../../../chancellor/src/manager/registry.ts\");\n1599→\tconst { PartnersStore } = await import(\"../src/partners.ts\");\n1600→\tconst domainRunsDir = ensureManager(TICKETS_ROOT, \"probe-domain\").runs_dir;\n1601→\tconst domainStore = new Store(domainRunsDir);\n1602→\tdomainStore.saveTicket(\n1603→\t\tfixture(\"T-domain\", {\n1604→\t\t\toptions: { dry: true, maxTasks: 8, workRoot: TICKETS_ROOT, domain: \"probe-domain\" },\n1605→\t\t}),\n1606→\t);\n1607→\tdomainStore.close();\n1608→\tconst seededChiefName = \"探针总管\";\n1609→\tconst partnerStore = new PartnersStore(PARTNER_DB, PARTNER_HOMES);\n1610→\tpartnerStore.create(seededChiefName, {\n1611→\t\tdomain: \"probe-domain\",\n1612→\t\tsoulSeed: \"探针播种的领域执事\",\n1613→\t});\n1614→\tpartnerStore.close();\n1615→\n1616→\tconst ticketsJson = (await (await fetch(`${BASE}/api/v1/tickets?limit=100`)).json()) as {\n1617→\t\ttickets: Array<{\n1618→\t\t\tid: string;\n1619→\t\t\tconversationId: string | null;\n1620→\t\t\tconversationTitle: string | null;\n1621→\t\t\tchiefName: string | null;\n1622→\t\t}