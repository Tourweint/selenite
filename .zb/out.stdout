tions, guardProvider } from \\\"./injection.ts\\\";\\nimport {\\n\\\\tLIFECYCLE_MESSAGE_PROVIDERS,\\n\\\\tclarifyContractProvider,\\n\\\\tcurrentProjectProvider,\\n\\\\tpersonaProvider,\\n\\\\tskillsProvider,\\n\\\\ttopicsProvider,\\n\\\\tverificationIronLawProvider,\\n} from \\\"./lifecycle-injections.ts\\\";`\\n],\\n[\\n`import {\\n\\\\tAPPROVAL_WAITING_MESSAGE,\\n\\\\tHARD_STOP_GRACE,\\n\\\\tLOOP_GUARD_BLOCK_MESSAGE,\\n\\\\tMAX_TURNS,\\n\\\\tTURN_LIMIT_INSTRUCTION,\\n\\\\tVERIFICATION_IRON_LAW,\\n\\\\tlifecycleOwnsVerification,\\n\\\\taborting,\\n\\\\tlimitHits,\\n\\\\trunTurns,\\n\\\\ttoolsBlocked,\\n\\\\twaitForApproval,\\n} from \\\"./turn-gate.ts\\\";`,\\n`import {\\n\\\\tAPPROVAL_WAITING_MESSAGE,\\n\\\\tHARD_STOP_GRACE,\\n\\\\tLOOP_GUARD_BLOCK_MESSAGE,\\n\\\\tMAX_TURNS,\\n\\\\taborting,\\n\\\\tlimitHits,\\n\\\\trunTurns,\\n\\\\ttoolsBlocked,\\n\\\\twaitForApproval,\\n} from \\\"./turn-gate.ts\\\";`\\n],\\n];\\n\\nfor (const [a,b] of reps) {\\n  if (!s.includes(a)) { console.log('MISS:', a.slice(0,60)); continue; }\\n  s = s.replace(a,b);\\n}\\nfs.writeFileSync(p,s);\\nconsole.log('ok');\\nEOF\", \"description\": \"Update lifecycle imports\"}",
