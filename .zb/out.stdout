    "output": {
      "type": "text",
      "text": "   1→import { readFileSync } from \"node:fs\";\n   2→import { contentText } from \"@earendil-works/pi-ai\";\n   3→import type { Conversation } from \"@earendil-works/pi-durable\";\n   4→import { redactSecrets } from \"@lifediary/memory\";\n   5→import { CTX, Chats } from \"./shared.ts\";\n   6→\n   7→/**\n   8→ * 会话考古：跨会话检索 transcript（2026-11-09 T4 §4）。\n   9→ *\n  10→ * 记忆四层记的是\"提炼过的事实\"，但用户经常问的是\"上个月咱们是不是聊过 X\"——\n  11→ * 这句话可能出现在执事会话、群聊、任务专线，而不在任何一条记忆里。\n  12→ * 这里直接在**本机 durable 的全部会话**里做子串检索，只读、不建索引、不做向量。\n  13→ *\n  14→ * 与 `session.ts:searchTranscripts` 的关系：那个是\"历史对话列表\"里的搜索，\n  15→ * 刻意跳过任务专线与已隐藏会话；本工具要覆盖\"所有会话\"，所以单独走一份\n  16→ * 读取逻辑（复用同一套 Chats 映射与 transcript 结构），不去改列表搜索的语义。\n  17→ *\n  18→ * 隐私：\n  19→ *   - 只读本机自己的库（没有远程/跨设备调用）；\n  20→ *   - snippet 落回模型前过一遍 `redactSecrets`（T4 §2 的同一把尺子）；\n  21→ *   - 日志只记 query 字数与命中条数，不记正文。\n  22→ */\n  23→\n  24→export interface SessionSearchHit {\n  25→\t/** 对外会话 uuid（与 listChats 同一个 id 空间） */\n  26→\tconversationId: string;\n  27→\t/** 会话标题；没有改过名就用首条用户消息 */\n  28→\ttitle: string;\n  29→\t/** 命中消息的时间（epoch ms） */\n  30→\tat: number;\n  31→\t/** 命中处前后各约 100 字，整段 ≤ 200 字；凭据已打码 */\n  32→\tsnippet: string;\n  33→}\n  34→\n  35→export interface SessionSearchOptions {\n  36→\t/** 只搜最近多少天，默认 30，收敛到 1..365。 */\n  37→\tdays?: number;\n  38→\t/** 最多几条命中，默认 5，收敛到 1..20。 */\n  39→\tlimit?: number;\n  40→}\n  41→\n  42→/** 一条可检索的 transcript 行（角色不在工具输出里，留着给测试与将来扩展）。 */\n  43→export interface TranscriptLine {\n  44→\trole: \"user\" | \"assistant\";\n  45→\ttext: string;\n  46→\tat: number;\n  47→}\n  48→\n  49→export interface TranscriptSource {\n  50→\tconversationId: string;\n  51→\ttitle: string;\n  52→\tlines: TranscriptLine[];\n  53→}\n  54→\n  55→const DAY_MS = 86_400_000;\n  56→const DEFAULT_DAYS = 30;\n  57→const MAX_DAYS = 365;\n  58→const DEFAULT_LIMIT = 5;\n  59→const MAX_LIMIT = 20;\n  60→/** snippet 硬上限：命中处前后各 100 字。 */\n  61→export const SNIPPET_MAX_CHARS = 200;\n  62→\n  63→/**\n  64→ * 工具上架开关（`AGENT_RECALL_SESSIONS`，默认开）。false/0/off → 工具不上架，\n  65→ * 与 `send_to_agent` 的回滚形态一致（模型侧 tool_unavailable，一行回滚）。\n  66→ */\n  67→export function recallSessionsEnabled(env: NodeJS.ProcessEnv = process.env): boolean {\n  68→\tconst raw = env.AGENT_RECALL_SESSIONS?.trim().toLowerCase();\n  69→\tif (!raw) return true;\n  70→\treturn raw !== \"false\" && raw !== \"0\" && raw !== \"off\";\n  71→}\n  72→\n  73→function clampInt(value: unknown, fallback: number, min: number, max: number): number {\n  74→\tif (typeof value !== \"number\" || !Number.isFinite(value)) return fallback;\n  75→\treturn Math.min(max, Math.max(min, Math.floor(value)));\n  76→}\n  77→\n  78→/**\n  79→ * 纯检索核心：给定若干会话的 transcript 行，返回命中片段。\n  80→ *\n  81→ * 抽成纯函数是为了让 §4.4 的用例不必真起 durable：跨两个会话建数据、\n  82→ * 验 days/limit/snippet 截断都在这里完成；durable 适配层只负责\"把库读成这个形状\"。\n  83→ */\n  84→export function searchTranscriptLines(\n  85→\tsources: TranscriptSource[],\n  86→\tquery: string,\n  87→\toptions: SessionSearchOptions = {},\n  88→\tnow: number = Date.now(),\n  89→): SessionSearchHit[] {\n  90→\tconst needle = query.trim().toLowerCase();\n  91→\t// 1 个字会把整个库捞出来；与 searchTranscripts 同口径，短于 2 字直接空。\n  92→\tif (needle.length < 2) return [];\n  93→\tconst days = clampInt(options.days, DEFAULT_DAYS, 1, MAX_DAYS);\n  94→\tconst limit = clampInt(options.limit, DEFAULT_LIMIT, 1, MAX_LIMIT);\n  95→\tconst cutoff = now - days * DAY_MS;\n  96→\n  97→\tconst hits: SessionSearchHit[] = [];\n  98→\tfor (const source of sources) {\n  99→\t\tfor (const line of source.lines) {\n 100→\t\t\tif (!line.text || line.at < cutoff) continue;\n 101→\t\t\tconst index = line.text.toLowerCase().indexOf(needle);\n 102→\t\t\tif (index === -1) continue;\n 103→\t\t\t// 命中处前后各 100 字：从 index-100 起裁 200，保证整段不超过上限。\n 104→\t\t\tconst start = Math.max(0, index - 100);\n 105→\t\t\tconst snippet = redactSecrets(line.text.slice(start, start + SNIPPET_MAX_CHARS)).trim();\n 106→\t\t\thits.push({\n 107→\t\t\t\tconversationId: source.conversationId,\n 108→\t\t\t\ttitle: source.title,\n 109→\t\t\t\tat: line.at,\n 110→\t\t\t\tsnippet,\n 111→\t\t\t});\n 112→\t\t}\n 113→\t}\n 114→\n 115→\treturn hits.sort((a, b) => b.at - a.at).slice(0, limit);\n 116→}\n 117→\n 118→/** durable 的最小读取面：测试注入假实现，生产传 Harness。 */\n 119→export interface SessionReader {\n 120→\tsnapshot(\n 121→\t\tdoc: typeof Chats,\n 122→\t\tctx: typeof CTX,\n 123→\t): Promise<{ byExternal?: Record<string, number> } | undefined>;\n 124→\tconversation(id: never, ctx: typeof CTX): Promise<Conversation | undefined>;\n 125→}\n 126→\n 127→/**\n 128→ * 会话标题存在 `.data/chat-meta.json`（durable 没有标题概念，见 session.ts）。\n 129→ *\n 130→ * 为什么在这里重读而不 import `chatTitles()`：`session.ts` 依赖 `lifecycle.ts`，\n 131→ * 而 `lifecycle.ts` 又要 import 本模块去装配工具——反向 import 会成环。\n 132→ * 读的是一份只有 `titles` 的 JSON，重复这一小段比拆环便宜。\n 133→ */\n 134→function readChatTitles(): Record<string, string> {\n 135→\tconst path = process.env.AGENT_CHAT_META_PATH?.trim() || \".data/chat-meta.json\";\n 136→\ttry {\n 137→\t\tconst parsed = JSON.parse(readFileSync(path, \"utf8\")) as { titles?: unknown };\n 138→\t\tif (parsed.titles && typeof parsed.titles === \"object\") {\n 139→\t\t\treturn parsed.titles as Record<string, string>;\n 140→\t\t}\n 141→\t} catch {\n 142→\t\t// 没有改名文件 = 全部用首句，不影响检索\n 143→\t}\n 144→\treturn {};\n 145→}\n 146→\n 147→function firstUserText(lines: TranscriptLine[]): string {\n 148→\tconst first = lines.find((line) => line.role === \"user\" && line.text);\n 149→\treturn first ? first.text.slice(0, 40) : \"\";\n 150→}\n 151→\n 152→/**\n 153→ * 跨所有会话检索（含执事 / 群 / 任务专线）。\n 154→ *\n 155→ * 逐会话打开读 context，代价与 `listChats` 同口径：本机个人规模（几十到几百个会话）\n 156→ * 一次显式调用可接受；真慢了再上 FTS 索引，不在这一版引入。\n 157→ */\n 158→export async function searchSessions(\n 159→\treader: SessionReader,\n 160→\tquery: string,\n 161→\toptions: SessionSearchOptions = {},\n 162→\tnow: number = Date.now(),\n 163→): Promise<SessionSearchHit[]> {\n 164→\tif (query.trim().length < 2) return [];\n 165→\tconst chats = await reader.snapshot(Chats, CTX);\n 166→\tconst titles = readChatTitles();\n 167→\tconst sources: TranscriptSource[] = [];\n 168→\n 169→\tfor (const [conversationId, internalId] of Object.entries(chats?.byExternal ?? {})) {\n 170→\t\ttry {\n 171→\t\t\tconst conversation = await reader.conversation(internalId as never, CTX);\n 172→\t\t\tif (!conversation) continue;\n 173→\t\t\tconst view = await conversation.context(CTX);\n 174→\t\t\tconst lines: TranscriptLine[] = [];\n 175→\t\t\tfor (const entry of view.entries) {\n 176→\t\t\t\tif (entry.kind !== \"pi.user\" && entry.kind !== \"pi.assistant\") continue;\n 177→\t\t\t\tconst message = entry.model?.[0];\n 178→\t\t\t\tif (!message) continue;\n 179→\t\t\t\tconst text = contentText(message.content).trim();\n 180→\t\t\t\tif (!text) continue;\n 181→\t\t\t\tconst at = typeof message.timestamp === \"number\" ? message.timestamp : 0;\n 182→\t\t\t\tlines.push({ role: entry.kind === \"pi.user\" ? \"user\" : \"assistant\", text, at });\n 183→\t\t\t}\n 184→\t\t\tif (lines.length === 0) continue;\n 185→\t\t\tsources.push({\n 186→\t\t\t\tconversationId,\n 187→\t\t\t\t// 标题可能来自用户首句（\"我的 key 是 sk-…\"），同一把尺子过一遍\n 188→\t\t\t\ttitle: redactSecrets(titles[conversationId]?.trim() || firstUserText(lines)),\n 189→\t\t\t\tlines,\n 190→\t\t\t});\n 191→\t\t} catch (error) {\n 192→\t\t\t// 单个会话读失败不挡整查（与 listChats / searchTranscripts 同口径）；只记 id 与原因\n 193→\t\t\tconst detail = error instanceof Error ? error.message : String(error);\n 194→\t\t\tconsole.warn(`[recall_sessions] 会话 ${conversationId} 读取失败: ${detail}`);\n 195→\t\t}\n 196→\t}\n 197→\n 198→\treturn searchTranscriptLines(sources, query, options, now);\n 199→}\n 200→"
    },
