      "text": "   1→import assert from \"node:assert/strict\";\n   2→import { test } from \"node:test\";\n   3→import type { MemoryScope } from \"@lifediary/memory\";\n   4→import type { SkillStore } from \"./skills.ts\";\n   5→import type { TopicsStore } from \"./topics.ts\";\n   6→import type { SearchModule } from \"./search.ts\";\n   7→\n   8→/**\n   9→ * 工具 schema 缓存守卫（2026-11-10 批 16 §二；全景调研七 #9）。\n  10→ *\n  11→ * 工具清单是**提示词前缀**的一部分：模型看到的系统提示里工具按注册顺序排列，\n  12→ * 顺序一变（或描述改动）前缀就变，上游的 prompt cache 整段失效——一次改动带来\n  13→ * 每轮全量 token 的重算。这不是运行时问题，是**每次发版都在付的账单**，\n  14→ * 所以用快照式断言钉住：顺序变了就红，逼人先确认这是有意的。\n  15→ *\n  16→ * 为什么不做运行时检查：运行时检查只能拦\"这一次请求\"，拦不住\"发版后一直贵\"；\n  17→ * 而且多一次分支。纪律归测试。\n  18→ *\n  19→ * 这份清单只覆盖**顺序**；描述正文的改动仍靠 变更记录 记（AGENTS.md 硬约束）。\n  20→ * 更新清单 = 一次有意的契约变更：同步在 `docs/变更记录/` 里写清为什么。\n  21→ */\n  22→\n  23→/** 当前注册顺序（2026-11-10 批 16 核对）。改动它之前先读文件头的理由。 */\n  24→const REGISTERED_ORDER = [\n  25→\t\"remember\",\n  26→\t\"recall\",\n  27→\t\"set_reminder\",\n  28→\t\"recall_sessions\",\n  29→\t\"persona_recall\",\n  30→\t\"skill\",\n  31→\t\"send_to_agent\",\n  32→\t\"delegate\",\n  33→\t\"propose_project\",\n  34→\t\"ask_user\",\n  35→\t\"report_progress\",\n  36→\t\"partner_skill_write\",\n  37→\t\"partner_manage\",\n  38→\t\"group_manage\",\n  39→\t\"routine_manage\",\n  40→\t\"web_search\",\n  41→\t\"propose_topic\",\n  42→];\n  43→\n  44→const CACHE_WARNING =\n  45→\t\"工具注册顺序 / 描述变动会打掉提示词缓存（前缀资产）：确认是有意的再更新这份清单，\" +\n  46→\t\"并在 docs/变更记录/ 里写清为什么。\";\n  47→\n  48→// 全开装配：把条件注册的工具全部纳入快照，否则\"条件分支顺序\"这半边没人守。\n  49→process.env.AGENT_ASK_USER = \"true\";\n  50→process.env.COMPANIONS_ENABLED = \"true\";\n  51→process.env.GROUPS_ENABLED = \"true\";\n  52→process.env.TOPICS_ENABLED = \"true\";\n  53→\n  54→const { createTools } = await import(\"./tools.ts\");\n  55→\n  56→const SCOPE: MemoryScope = { type: \"global\" };\n  57→const SKILLS: SkillStore = { names: () => [], manual: () => undefined, indexFor: () => undefined };\n  58→// 只为了让条件注册成立，执行期不会被调到。\n  59→const TOPICS = {} as unknown as TopicsStore;\n  60→const SEARCH = {} as unknown as SearchModule;\n  61→\n  62→function fullTools() {\n  63→\treturn createTools({\n  64→\t\tmemory: null,\n  65→\t\tscopeOf: () => SCOPE,\n  66→\t\tskills: SKILLS,\n  67→\t\trecallSessions: async () => [],\n  68→\t\tpersonaAsk: async () => ({ ok: true, question: \"stub\" }),\n  69→\t\trelay: { deliver: async () => ({ ok: false, error: \"stub\" }) },\n  70→\t\tprogressReport: true,\n  71→\t\tpartners: true,\n  72→\t\tgroups: true,\n  73→\t\troutineSelfService: true,\n  74→\t\ttopics: TOPICS,\n  75→\t\tsearch: SEARCH,\n  76→\t});\n  77→}\n  78→\n  79→test(\"工具注册顺序稳定（缓存前缀资产，顺序见测试文件头）\", () => {\n  80→\tconst actual = fullTools().map((tool) => tool.name);\n  81→\tassert.deepEqual(actual, REGISTERED_ORDER, CACHE_WARNING);\n  82→});\n  83→\n  84→test(\"快照没有重名（重名等于同一个工具被注册两次，前缀也会变）\", () => {\n  85→\tassert.equal(new Set(REGISTERED_ORDER).size, REGISTERED_ORDER.length, CACHE_WARNING);\n  86→});\n  87→"
    },
