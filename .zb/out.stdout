      "text": "   1→import type { SettledSubmissionRecord } from \"@earendil-works/pi-durable\";\n   2→import type { MemoryScope } from \"@lifediary/memory\";\n   3→import { chatContentText, type ChatMessage } from \"@lifediary/shared\";\n   4→import { pruneSessionMemory } from \"../memory-prune.ts\";\n   5→import { appendPersonaExport, personaExportEnabled } from \"../persona-export.ts\";\n   6→import { memoryEngine, preferenceScopeOf } from \"./assist.ts\";\n   7→import { TASK_CONVERSATION_PREFIX } from \"./shared.ts\";\n   8→\n   9→/**\n  10→ * 「这一轮真正收尾」的统一动作（2026-11-08 扫尾批 4a 从 index.ts 抽出；\n  11→ * 2026-11-08 批 10-A 下沉成独立模块，供审批续跑轮共用）。\n  12→ *\n  13→ * 原来这段内联在 `/chat` 的流里；编辑重发与审批续跑都在后台跑同一套 `chatStream`，\n  14→ * 抽出来才能保证\"观察层 / 记忆抽取 / 会话记忆修剪\"只有一份实现。\n  15→ *\n  16→ * 为什么观察层用**注入**而不是直接 import `autonomy.ts`：\n  17→ * `autonomy.ts` 反过来 import 桶 `agent.ts`，而本模块在 `agent/` 里被 session.ts 引用，\n  18→ * 直接 import 会绕成一个环。启动时由 index.ts 把 `autonomyObserver().onTurnSettled`\n  19→ * 塞进来，装配关系留在顶层，内核文件之间保持单向。\n  20→ *\n  21→ * 记忆只吃文本：图片不进记忆，去的是\"他说了什么\"。\n  22→ */\n  23→export type TurnSettledObserver = (\n  24→\tconversationId: number,\n  25→\tstatus: SettledSubmissionRecord[\"status\"],\n  26→\treason: string,\n  27→) => void;\n  28→\n  29→let observer: TurnSettledObserver | null = null;\n  30→\n  31→/** 启动装配调用一次；传 null 只给单测清理用。 */\n  32→export function setTurnSettledObserver(next: TurnSettledObserver | null): void {\n  33→\tobserver = next;\n  34→}\n  35→\n  36→export interface SettledChat {\n  37→\tinternalId: number;\n  38→\texternalId: string;\n  39→}\n  40→\n  41→/**\n  42→ * 本轮最终 assistant 文本的懒读取（2026-11-09 persona 接入批二）。\n  43→ *\n  44→ * `plain` 是**请求时刻**的消息快照，客户端通常只带这一句 user，拿不到本轮新生成的回复；\n  45→ * 内核在 settle 后由 session.ts 提供\"读 durable 里本轮最后一条 assistant\"的入口。\n  46→ * 只有导出开关打开、且 plain 里没有尾随 assistant 时才会被调用（默认关 = 零成本）。\n  47→ */\n  48→export type TurnReplyReader = () => Promise<string>;\n  49→\n  50→export function turnSettledHandler(chat: SettledChat, messages: ChatMessage[]) {\n  51→\tconst scope: MemoryScope = { type: \"session\", id: String(chat.internalId) };\n  52→\tconst plain = messages.map((message) => ({\n  53→\t\trole: message.role,\n  54→\t\tcontent: chatContentText(message.content),\n  55→\t}));\n  56→\treturn (record: SettledSubmissionRecord, replyText?: TurnReplyReader): void => {\n  57→\t\t// 观察层的 errored/usage-limit 事件源（批次C C1）；开关关着时内部直接返回\n  58→\t\tobserver?.(\n  59→\t\t\tNumber(chat.internalId),\n  60→\t\t\trecord.status,\n  61→\t\t\trecord.status === \"unanswered\" ? record.reason : \"\",\n  62→\t\t);\n  63→\t\t// persona 导出（2026-11-09 批二）：done 轮追加一行；开关默认关，三项会话过滤在模块内。\n  64→\t\t// 不 await —— 写盘慢了不拖对话；失败只 warn（导出绝不能打断对话）。\n  65→\t\tif (record.status === \"done\" && personaExportEnabled()) {\n  66→\t\t\tappendPersonaExport(chat, plain, undefined, {\n  67→\t\t\t\tturnId: String(record.id),\n  68→\t\t\t\t...(replyText ? { reply: replyText } : {}),\n  69→\t\t\t});\n  70→\t\t}\n  71→\t\tif (!memoryEngine || record.status !== \"done\") return;\n  72→\t\t// 任务专线（`task-` 前缀，2026-11-08 扫尾批 8g）不进记忆引擎：就算主人从会话页\n  73→\t\t// 直接点开它回话，也不该把\"任务过程\"沉淀成关于人的记忆（与研究回合同一口径）。\n  74→\t\tif (chat.externalId.startsWith(TASK_CONVERSATION_PREFIX)) return;\n  75→\t\t// 刻意不 await —— 记忆写慢了不该拖慢任何东西\n  76→\t\tvoid memoryEngine\n  77→\t\t\t.ingestTurn(plain, scope, {\n  78→\t\t\t\t// 2026-11-06：偏好挂更宽的 scope（主人 global / 执事 partner:<id>），\n  79→\t\t\t\t// 其余仍落本会话。不传这个参数 = 全部落本会话，与旧行为一致。\n  80→\t\t\t\tpreferenceScope: preferenceScopeOf(chat.internalId),\n  81→\t\t\t})\n  82→\t\t\t.then((result) => {\n  83→\t\t\t\tif (result.added.length > 0 || result.reinforced.length > 0) {\n  84→\t\t\t\t\tconsole.log(`[memory] +${result.added.length} ~${result.reinforced.length}`);\n  85→\t\t\t\t}\n  86→\t\t\t\t// 写入路径末尾按 MEMORY_SESSION_CAP 修剪会话/伙伴作用域；只记条数（D8）。\n  87→\t\t\t\tconst pruned = pruneSessionMemory(memoryEngine);\n  88→\t\t\t\tif (pruned > 0) console.log(`[memory] prune -${pruned}`);\n  89→\t\t\t})\n  90→\t\t\t.catch((error: unknown) => {\n  91→\t\t\t\tconst detail = error instanceof Error ? error.message : String(error);\n  92→\t\t\t\tconsole.error(`[memory] 写入失败: ${detail}`);\n  93→\t\t\t});\n  94→\t};\n  95→}\n  96→"
    },
