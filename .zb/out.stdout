      "text": "   1→/**\n   2→ * 杂活模型（auxiliary LLM）一等化（2026-11-10 批 20 §二）。\n   3→ *\n   4→ * 问题：偏好抽取已经用\"独立的一次性模型调用\"，但\"用哪个模型\"是按当前会话模型隐式决定的，\n   5→ * 散的。标题 / 压缩 / 裁判这些同样\"短输入短输出\"的活以后也需要能单独指定一个小模型。\n   6→ *\n   7→ * 这一层只回答一个问题：**某用途该用哪个模型**。\n   8→ *   - 用途枚举是固定的四种（`title` / `compact` / `review` / `extract`）；\n   9→ *   - 每个用途可以用 `AUX_MODEL_<USE>` pin 一个模型 id；\n  10→ *   - 没配 / 配的名字不在目录里 → 回落当前会话模型（行为与改动前一致）；\n  11→ *   - `AUX_LLM=false` → 全部回落当前模型（一行回滚）。\n  12→ *\n  13→ * 接线状态（2026-11-10 批 23b §三）：\n  14→ *   - 已接：`extract`（`memory-extract.ts` 偏好抽取）、`review`（`routine-gate.ts` 例行条件判定\n  15→ *     + `memory-consolidate.ts` 的语义整理建议，后一处是批 23b 补的）；\n  16→ *   - **没接**：`title`（当前没有自动标题）、`compact`（内核 `Conversation.compact()`\n  17→ *     只收 `instructions` + `Context`，压缩模型由当前会话模型与 compaction policy 决定，\n  18→ *     **无法指定单独的压缩模型**——不是这里不接，是内核没有这个入口）。\n  19→ *\n  20→ * 这一层不做模型调用本身——调用方自己决定超时 / 重试 / 失败语义。\n  21→ */\n  22→\n  23→import type { ModelRef } from \"./provider.ts\";\n  24→import { currentModels, readLlmConfig } from \"./provider.ts\";\n  25→\n  26→export type AuxUse = \"title\" | \"compact\" | \"review\" | \"extract\";\n  27→\n  28→/** 用途清单（文档 / 探针用；新增用途时这里与 `AuxUse` 一起改）。 */\n  29→export const AUX_USES: readonly AuxUse[] = [\"title\", \"compact\", \"review\", \"extract\"];\n  30→\n  31→/**\n  32→ * 总开关：默认开；只有显式 `false` 才关（与仓库里其它\"默认开\"的开关同口径）。\n  33→ * 关掉 = 所有用途都回到当前会话模型，行为与引入本模块之前逐字节一致。\n  34→ */\n  35→export function auxiliaryEnabled(env: NodeJS.ProcessEnv = process.env): boolean {\n  36→\treturn (env.AUX_LLM ?? \"\").trim().toLowerCase() !== \"false\";\n  37→}\n  38→\n  39→/** 某用途 pin 的模型 id；没配 / 空白 → null（不是\"配了空串\"，是没配）。 */\n  40→export function auxPinnedModelId(use: AuxUse, env: NodeJS.ProcessEnv = process.env): string | null {\n  41→\tconst raw = env[`AUX_MODEL_${use.toUpperCase()}`]?.trim();\n  42→\treturn raw || null;\n  43→}\n  44→\n  45→/** 只依赖 Models 的查询面，单测可传替身，不用真起 provider 目录。 */\n  46→interface AuxModelLookup {\n  47→\tgetModel(provider: string, id: string): unknown;\n  48→\tgetProviders(): readonly { id: string }[];\n  49→}\n  50→\n  51→export interface AuxiliaryDeps {\n  52→\tenv?: NodeJS.ProcessEnv;\n  53→\t/** 当前会话模型；不传就读 `readLlmConfig()`（拿不到 = 没有可用模型） */\n  54→\tcurrent?: ModelRef | null;\n  55→\tmodels?: AuxModelLookup;\n  56→}\n  57→\n  58→/**\n  59→ * 某用途实际该用的模型引用。\n  60→ *\n  61→ * 解析顺序：\n  62→ *   1. 没有当前模型 → null（调用方按\"没有模型\"处理）；\n  63→ *   2. `AUX_LLM=false` 或该用途没 pin → 当前模型；\n  64→ *   3. pin 的名字先在当前供应商里找，再按目录顺序找同名模型（同名跨供应商不能猜，\n  65→ *      先认当前这一家）；找不到 → **回落当前模型并 warn**，不静默换一家不存在的模型。\n  66→ *\n  67→ * 返回 null 只表示\"没有可用的 LLM\"，不表示\"pin 配错了\"。\n  68→ */\n  69→export function auxiliaryModel(use: AuxUse, deps: AuxiliaryDeps = {}): ModelRef | null {\n  70→\tconst env = deps.env ?? process.env;\n  71→\tconst current = deps.current === undefined ? (readLlmConfig()?.model ?? null) : deps.current;\n  72→\tif (!current) return null;\n  73→\tif (!auxiliaryEnabled(env)) return current;\n  74→\n  75→\tconst pinned = auxPinnedModelId(use, env);\n  76→\tif (!pinned) return current;\n  77→\n  78→\tconst models = deps.models ?? currentModels();\n  79→\tif (models.getModel(current.provider, pinned)) {\n  80→\t\treturn { provider: current.provider, modelId: pinned };\n  81→\t}\n  82→\tfor (const provider of models.getProviders()) {\n  83→\t\tif (models.getModel(provider.id, pinned)) {\n  84→\t\t\treturn { provider: provider.id, modelId: pinned };\n  85→\t\t}\n  86→\t}\n  87→\n  88→\t// 配错不换路由：回落当前模型，只记用途枚举与模型名（没有对话内容）\n  89→\tconsole.warn(\n  90→\t\t`[aux] AUX_MODEL_${use.toUpperCase()}=${pinned} 不在模型目录里，回落当前模型`,\n  91→\t);\n  92→\treturn current;\n  93→}\n  94→"
    },
