      "text": "1198→\t\t\tconst outgoing: TranscriptMessage = {\n1199→\t\t\t\trole: \"user\",\n1200→\t\t\t\ttext,\n1201→\t\t\t\tat,\n1202→\t\t\t\tid: messageIdOf(chat.externalId, Number(entry.id)),\n1203→\t\t\t};\n1204→\t\t\tif (images.length > 0) outgoing.images = images;\n1205→\t\t\tmessages.push(outgoing);\n1206→\t\t\tcontinue;\n1207→\t\t}\n1208→\n1209→\t\tif (entry.kind === \"pi.tool-result\") {\n1210→\t\t\tconst message = entry.model?.[0];\n1211→\t\t\tif (!message || message.role !== \"toolResult\") continue;\n1212→\t\t\tconst slot = byCallId.get(message.toolCallId);\n1213→\t\t\tif (!slot) continue;\n1214→\t\t\tconst { step } = slot;\n1215→\t\t\tstep.ok = !message.isError;\n1216→\t\t\tconst output = clampText(contentText(message.content), STEP_OUTPUT_LIMIT);\n1217→\t\t\tif (output) step.output = output;\n1218→\t\t\tconst diff = stepDiff((message as { details?: unknown }).details);\n1219→\t\t\tif (diff) step.diff = diff;\n1220→\t\t\tif (typeof message.durationMs === \"number\") step.ms = Math.round(message.durationMs);\n1221→\t\t\tslot.settled = true;\n1222→\t\t\tcontinue;\n1223→\t\t}\n1224→\n1225→\t\tif (entry.kind !== \"pi.assistant\") continue;\n1226→\t\tconst message = entry.model?.[0];\n1227→\t\tif (!message || message.role !== \"assistant\") continue;\n1228→\t\tconst at = typeof message.timestamp === \"number\" ? message.timestamp : 0;\n1229→\t\t// assistant 的 timestamp 是\"请求开始\"，收尾时刻要再加 durationMs（pi-ai 的口径）；\n1230→\t\t// 没有 durationMs 的旧记录退回 timestamp，宁可少算也不编一个数出来。\n1231→\t\tconst endedAt =\n1232→\t\t\tat + (typeof message.durationMs === \"number\" ? Math.max(0, Math.round(message.durationMs)) : 0);\n1233→\n1234→\t\t// 带工具调用的中间回合：只收步骤，不当成一条\"回答\"下发（正文往往是空的）\n1235→\t\tconst parts = Array.isArray(message.content) ? message.content : [];\n1236→\t\tconst calls = parts.filter((item) => item.type === \"toolCall\");\n1237→\t\tif (calls.length > 0) {\n1238→\t\t\tfor (const call of calls) {\n1239→\t\t\t\tconst step: TranscriptStep = { name: call.name, ok: true };\n1240→\t\t\t\tconst label = toolLabel(call.arguments);\n1241→\t\t\t\tif (label) step.label = label;\n1242→\t\t\t\tconst args = toolArgs(call.arguments).args;\n1243→\t\t\t\tif (args) step.args = args;\n1244→\t\t\t\tpending.push(step);\n1245→\t\t\t\tbyCallId.set(call.id, { step, settled: false });\n1246→\t\t\t}\n1247→\t\t\tcontinue;\n1248→\t\t}\n1249→\n1250→\t\tconst text = contentText(message.content).trim();\n1251→\t\tif (!text) continue;\n1252→\t\tconst outgoing: TranscriptMessage = { role: \"assistant\", text, at };\n1253→\t\tif (pending.length > 0) {\n1254→\t\t\t// 没配到结果的（中断 / 崩在工具里）在这里定案：ok=false，避免历史把它画成成功。\n1255→\t\t\t// 判据是 settled 而不是\"有没有输出\"——成功的 `read` 也可能一字不吐。\n1256→\t\t\tfor (const slot of byCallId.values()) {\n1257→\t\t\t\tif (!slot.settled) slot.step.ok = false;\n1258→\t\t\t}\n1259→\t\t\toutgoing.steps = pending;\n1260→\t\t\tif (turnStartAt !== undefined && endedAt > turnStartAt) outgoing.workMs = endedAt - turnStartAt;\n1261→\t\t}\n1262→\t\tmessages.push(outgoing);\n1263→\t\tpending = [];\n1264→\t\tbyCallId.clear();\n1265→\t}\n1266→\n1267→\t// 收尾兜底：一轮因为撞工具回合上限 / 被停 / 崩在工具里而没能产出正文时，\n1268→\t// 上面那条\"挂在回答上\"的路就没有挂靠点，整轮步骤会凭空消失——\n1269→\t// 而这恰恰是最需要看过程的一轮。这里给它们一条只有步骤、正文为空的 assistant，\n1270→\t// 客户端照常渲染工作过程块（正文是空的，自然不显示字）。\n1271→\tif (pending.length > 0) {\n1272→\t\tfor (const slot of byCallId.values()) {\n1273→\t\t\tif (!slot.settled) slot.step.ok = false;\n1274→\t\t}\n1275→\t\tconst lastAt =\n1276→\t\t\ttypeof view.entries.at(-1)?.model?.[0]?.timestamp === \"number\"\n1277→\t\t\t\t? (view.entries.at(-1)?.model?.[0]?.timestamp as number)\n1278→\t\t\t\t: 0;\n1279→\t\tconst outgoing: TranscriptMessage = { role: \"assistant\", text: \"\", at: lastAt, steps: pending };\n1280→\t\tif (turnStartAt !== undefined && lastAt > turnStartAt) outgoing.workMs = lastAt - turnStartAt;\n1281→\t\tmessages.push(outgoing);\n1282→\t}\n1283→\n1284→\treturn limit > 0 ? messages.slice(-limit) : messages;\n1285→}\n1286→\n1287→/** 最后一轮模型回答的纯文本（用于补齐流式没吐完的部分） */\n1288→async function answerText(conversation: Conversation): Promise<string> {\n1289→\tconst view = await conversation.context(CTX);\n1290→\tfor (let index = view.entries.length - 1; index >= 0; index -= 1) {\n1291→\t\tconst entry = view.entries[index];\n1292→\t\tif (!entry || entry.kind !== \"pi.assistant\") continue;\n1293→"
