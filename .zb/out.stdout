      "text": "1089→export interface TranscriptMessage {\n1090→\trole: \"user\" | \"assistant\";\n1091→\ttext: string;\n1092→\t/** 消息时间，epoch 毫秒 */\n1093→\tat: number;\n1094→\t/**\n1095→\t * 可寻址 id（2026-11-08 扫尾批 4a）：只给 user 消息，编辑重发拿它指位置。\n1096→\t * uuid 形状、不含 durable 内部自增 id（见 {@link messageIdOf}）。\n1097→\t */\n1098→\tid?: string;\n1099→\t/** 用户消息带的图片（2026-11-08 扫尾批 4a）；文字仍走 `text` */\n1100→\timages?: { mimeType: string; data: string }[];\n1101→\t/** 这一轮的工作步骤（2026-11-07）；没有工具调用就不带 */\n1102→\tsteps?: TranscriptStep[];\n1103→\t/** 那一轮从提问到收尾的墙钟时长（毫秒） */\n1104→\tworkMs?: number;\n1105→}\n1106→\n1107→/**\n1108→ * 对外 messageId（2026-11-08 扫尾批 4a）。\n1109→ *\n1110→ * 为什么不直接下发 durable 的条目 id：硬约束是\"对外 id 一律 uuid，内部自增整数不外泄\"。\n1111→ * 这里用 `(会话对外 uuid, 条目 id)` 做 sha256 再切成 uuid 形状 —— 稳定、可反查\n1112→ * （读回条目时按同一函数重算），且离开会话 id 就没有意义。\n1113→ */\n1114→export function messageIdOf(externalId: string, entryId: number): string {\n1115→\tconst hex = createHash(\"sha256\").update(`${externalId}:${entryId}`).digest(\"hex\");\n1116→\treturn `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20, 32)}`;\n1117→}\n1118→\n1119→/**\n1120→ * 一步工作过程的截断上限：与 `tool` 事件的 `output` 同一口径（2000 字符）。\n1121→ * 现场看到多长，回头翻到就多长——两边不一致会让人怀疑历史被裁剪过。\n1122→ */\n1123→const STEP_OUTPUT_LIMIT = TOOL_OUTPUT_LIMIT;\n1124→/** 编辑类工具的 diff 单独给一档（比输出略短，面板里是一屏的事） */\n1125→const STEP_DIFF_LIMIT = 2000;\n1126→\n1127→/** 与 toolOutput 同口径：先取文字、trim，再按上限截断并标注还剩多少 */\n1128→function clampText(text: string, limit: number): string | undefined {\n1129→\tconst one = text.trim();\n1130→\tif (!one) return undefined;\n1131→\treturn one.length > limit\n1132→\t\t? `${one.slice(0, limit)}\\n…（还有 ${one.length - limit} 字符）`\n1133→\t\t: one;\n1134→}\n1135→\n1136→/**\n1137→ * 从 `tool-result` 的 details 里取编辑 diff（2026-11-07）。\n1138→ *\n1139→ * `edit` 工具把 `{ diff, patch, firstChangedLine }` 放在 details 里（读\n1140→ * `pi-durable` 的 `tools/edit.js` 确认），其它工具没有这个字段，所以这里\n1141→ * 只认 `diff`，不强求——读不到就当作\"这一步没有差异可看\"。\n1142→ */\n1143→function stepDiff(details: unknown): string | undefined {\n1144→\tif (!details || typeof details !== \"object\") return undefined;\n1145→\tconst diff = (details as { diff?: unknown }).diff;\n1146→\treturn typeof diff === \"string\" ? clampText(diff, STEP_DIFF_LIMIT) : undefined;\n1147→}\n1148→\n1149→/**\n1150→ * 读会话已有的对话记录。\n1151→ *\n1152→ * 存在的理由：一轮对话现在可以在**没有客户端看着**的情况下跑完（见 chatStream），\n1153→ * 所以客户端下次打开必须能把结果拉回来，否则\"关掉界面它照样跑完\"对用户没有意义。\n1154→ *\n1155→ * 2026-11-07 起连同**工作过程**一起回放：流式期间的 `tool` 事件只活在当轮 DOM 里，\n1156→ * 刷新就没了；而步骤本来就躺在 durable 里（`pi.assistant` 的 toolCall +\n1157→ * `pi.tool-result`），所以这里只是按调用顺序把它们配成对，不新增任何存储。\n1158→ *\n1159→ * 配对规则（与 durable 的落库顺序一一对应）：\n1160→ *   pi.user → [pi.assistant(带 toolCall) → pi.tool-result × n] × m → pi.assistant(正文)\n1161→ * 步骤挂在**它后面那条带正文的回答**上；一轮里没有工具调用，`steps` 字段就不下发。\n1162→ * 被中断、始终没等到回答的那一轮没有挂靠点，历史里不回放它的步骤（当轮界面上\n1163→ * 仍会显示\"已中断生成\"，只是不持久化——与那句提示自己的生命周期一致）。\n1164→ */\n1165→export async function readTranscript(\n1166→\tchat: ResolvedChat,\n1167→\tlimit = 50,\n1168→): Promise<TranscriptMessage[]> {\n1169→\tconst view = await chat.conversation.context(CTX);\n1170→\tconst messages: TranscriptMessage[] = [];\n1171→\n1172→\t/** 本轮的步骤，按 toolCallId 索引；回答落盘时整段挂上去 */\n1173→\tlet pending: TranscriptStep[] = [];\n1174→\tconst byCallId = new Map<string, { step: TranscriptStep; settled: boolean }>();\n1175→\t/** 助手条目里模型侧看到的正文；entries 的类型是 Message 联合，取用前要收窄 */\n1176→\t/** 本轮提问的时间（算 workMs 用）；没有 user 开头就留 undefined */\n1177→\tlet turnStartAt: number | undefined;\n1178→\n1179→\tfor (const entry of view.entries) {\n1180→\t\tif (entry.kind === \"pi.user\") {\n1181→\t\t\t// 新一轮：上一轮没等到回答的步骤没有挂靠点，直接丢掉（见函数头注释）\n1182→\t\t\tpending = [];\n1183→\t\t\tbyCallId.clear();\n1184→\t\t\tconst message = entry.model?.[0];\n1185→\t\t\tif (!message) continue;\n1186→\t\t\tconst text = contentText(message.content).trim();\n1187→\t\t\tconst at = typeof message.timestamp === \"number\" ? message.timestamp : 0;\n1188→\t\t\t// 2026-11-08 4a：纯图消息没有文本，也要下发（老逻辑会把它整条丢掉）\n1189→\t\t\tconst parts = Array.isArray(message.content) ? message.content : [];\n1190→\t\t\tconst images = parts\n1191→\t\t\t\t.filter(\n1192→\t\t\t\t\t(part): part is { type: \"image\"; mimeType: string; data: string } =>\n1193→\t\t\t\t\t\tpart.type === \"image\",\n1194→\t\t\t\t)\n1195→\t\t\t\t.map((part) => ({ mimeType: part.mimeType, data: part.data }));\n1196→\t\t\tif (!text && images.length === 0) continue;\n1197→\t\t\tturnStartAt = at || undefined;\n1198→\t\t\tconst outgoing: TranscriptMessage = {\n1199→"
