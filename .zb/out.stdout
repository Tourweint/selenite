    "callId": "call_00_7kN36Ii4eHBk7pL79LWI0100",
    "status": "completed",
    "output": {
      "type": "text",
      "text": "   1→/**\n   2→ * 注入框架批 A（2026-11-10 批 26b §二 / #7）单测。\n   3→ *\n   4→ * 钉住五件事：条目形状 / 排序稳定（打乱输入顺序输出一致）/ 同 id 去重（后者覆盖）/\n   5→ * 只接管了一个 / 审计不返正文；外加硬标准——接管后 injection_guard 正文逐字节一致。\n   6→ */\n   7→import assert from \"node:assert/strict\";\n   8→import { after, before, test } from \"node:test\";\n   9→import { INJECTION_GUARD } from \"./injection-guard.ts\";\n  10→import {\n  11→\tINJECTION_REGISTRY,\n  12→\tauditInjections,\n  13→\tcollectInjections,\n  14→\tguardProvider,\n  15→\tinjectionAuditEnabled,\n  16→\ttype InjectionContext,\n  17→\ttype InjectionEntry,\n  18→\ttype InjectionProvider,\n  19→} from \"./injection.ts\";\n  20→\n  21→const ctx: InjectionContext = { conversationId: 1 };\n  22→\n  23→/** guardProvider 读 AGENT_INJECTION_GUARD；整份文件统一保证它开着，避免被开发机 env 干扰。 */\n  24→let savedGuard: string | undefined;\n  25→before(() => {\n  26→\tsavedGuard = process.env.AGENT_INJECTION_GUARD;\n  27→\tdelete process.env.AGENT_INJECTION_GUARD;\n  28→});\n  29→after(() => {\n  30→\tif (savedGuard === undefined) delete process.env.AGENT_INJECTION_GUARD;\n  31→\telse process.env.AGENT_INJECTION_GUARD = savedGuard;\n  32→});\n  33→\n  34→function sys(id: string, text: string, order: number): InjectionEntry {\n  35→\treturn { id, text, order, scope: \"session\", channel: \"system\" };\n  36→}\n  37→\n  38→// ── 硬标准 ─────────────────────────────────────────────\n  39→test(\"硬标准：collectInjections([guardProvider], ctx).system[0].text === INJECTION_GUARD\", () => {\n  40→\tconst collected = collectInjections([guardProvider], ctx);\n  41→\tassert.equal(collected.system.length, 1);\n  42→\tassert.equal(collected.system[0].text, INJECTION_GUARD, \"注入正文逐字节一致\");\n  43→\tassert.equal(collected.message.length, 0, \"guard 只走 system 通道\");\n  44→});\n  45→\n  46→// ── 条目形状 ───────────────────────────────────────────\n  47→test(\"条目形状：恰好 {id,text,order,scope,channel} 五个字段、类型正确\", () => {\n  48→\tconst entry = collectInjections([guardProvider], ctx).system[0];\n  49→\tassert.deepEqual(Object.keys(entry).sort(), [\"channel\", \"id\", \"order\", \"scope\", \"text\"]);\n  50→\tassert.equal(entry.id, \"injection_guard\");\n  51→\tassert.equal(entry.channel, \"system\");\n  52→\tassert.equal(entry.scope, \"session\");\n  53→\tassert.equal(typeof entry.order, \"number\");\n  54→\tassert.equal(typeof entry.text, \"string\");\n  55→});\n  56→\n  57→// ── 排序稳定：打乱输入顺序输出一致 ───────────────────────\n  58→test(\"排序：order 升序 / 同 order 按 id 字典序；打乱 providers 顺序输出一致\", () => {\n  59→\tconst pA: InjectionProvider = () => sys(\"b\", \"B\", 2);\n  60→\tconst pB: InjectionProvider = () => sys(\"a\", \"A\", 1);\n  61→\tconst pC: InjectionProvider = () => sys(\"c\", \"C\", 1);\n  62→\tconst out1 = collectInjections([pA, pB, pC], ctx);\n  63→\tconst out2 = collectInjections([pC, pA, pB], ctx);\n  64→\tassert.deepEqual(out1, out2, \"打乱输入顺序输出不变\");\n  65→\tassert.deepEqual(out1.system.map((e) => e.id), [\"a\", \"c\", \"b\"], \"order 升序，同 order 按 id\");\n  66→});\n  67→\n  68→// ── 同 id 去重：后者覆盖 ────────────────────────────────\n  69→test(\"同 id 去重：后者覆盖（规范序里最后一次出现胜出），且不受 provider 顺序影响\", () => {\n  70→\tconst single: InjectionProvider = () => [\n  71→\t\tsys(\"dup\", \"FIRST\", 1),\n  72→\t\tsys(\"dup\", \"LATER\", 2),\n  73→\t];\n  74→\tconst out = collectInjections([single], ctx);\n  75→\tassert.equal(out.system.length, 1);\n  76→\tassert.equal(out.system[0].text, \"LATER\");\n  77→\n  78→\tconst p1: InjectionProvider = () => sys(\"x\", \"P1\", 1);\n  79→\tconst p2: InjectionProvider = () => sys(\"x\", \"P2\", 2);\n  80→\tassert.equal(collectInjections([p1, p2], ctx).system[0].text, \"P2\");\n  81→\tassert.equal(collectInjections([p2, p1], ctx).system[0].text, \"P2\", \"打乱后仍是 P2\");\n  82→});\n  83→\n  84→// ── 按 channel 分流 ────────────────────────────────────\n  85→test(\"按 channel 分流：system / message 各归各位\", () => {\n  86→\tconst s = sys(\"s\", \"S\", 0);\n  87→\tconst m: InjectionEntry = { id: \"m\", text: \"M\", order: 0, scope: \"turn\", channel: \"message\" };\n  88→\tconst out = collectInjections([() => [m, s]], ctx);\n  89→\tassert.deepEqual(out.system.map((e) => e.id), [\"s\"]);\n  90→\tassert.deepEqual(out.message.map((e) => e.id), [\"m\"]);\n  91→});\n  92→\n  93→// ── 只接管了一个 ───────────────────────────────────────\n  94→test(\"批 A 只接管了一个注入（injection_guard）\", () => {\n  95→\tassert.equal(INJECTION_REGISTRY.length, 1, \"其余 6 个 section / 5 处 extra.push 一个都没登记\");\n  96→\tassert.equal(INJECTION_REGISTRY[0].source, \"injection_guard\");\n  97→\tassert.equal(auditInjections(ctx).length, 1, \"审计也只一行\");\n  98→});\n  99→\n 100→// ── guard 开关：关时省略整段（与改造前逐字节一致）────────\n 101→test(\"guardProvider 关时返回 undefined → system 为空（整段省略）\", () => {\n 102→\tconst prev = process.env.AGENT_INJECTION_GUARD;\n 103→\ttry {\n 104→\t\tprocess.env.AGENT_INJECTION_GUARD = \"false\";\n 105→\t\tconst collected = collectInjections([guardProvider], ctx);\n 106→\t\tassert.equal(collected.system.length, 0);\n 107→\t\tassert.equal(collected.message.length, 0);\n 108→\t\tassert.equal(auditInjections(ctx).length, 0, \"关时审计也不列这一条\");\n 109→\t} finally {\n 110→\t\tdelete process.env.AGENT_INJECTION_GUARD;\n 111→\t\tif (prev !== undefined) process.env.AGENT_INJECTION_GUARD = prev;\n 112→\t}\n 113→});\n 114→\n 115→// ── 审计不返正文 ───────────────────────────────────────\n 116→test(\"审计只回 {id,source,scope,length}，不回正文\", () => {\n 117→\tconst rows = auditInjections(ctx);\n 118→\tassert.equal(rows.length, 1);\n 119→\tconst row = rows[0];\n 120→\tassert.deepEqual(Object.keys(row).sort(), [\"id\", \"length\", \"scope\", \"source\"]);\n 121→\tassert.equal(row.id, \"injection_guard\");\n 122→\tassert.equal(row.length, INJECTION_GUARD.length);\n 123→\tassert.ok(!(\"text\" in row), \"没有 text 字段\");\n 124→\tassert.ok(!JSON.stringify(rows).includes(INJECTION_GUARD), \"全文不含注入正文\");\n 125→});\n 126→\n 127→// ── 审计开关：默认开，显式 false 关 ─────────────────────\n 128→test(\"审计开关 AGENT_INJECTION_AUDIT：默认开，显式 false 关\", () => {\n 129→\tassert.equal(injectionAuditEnabled({}), true);\n 130→\tassert.equal(injectionAuditEnabled({ AGENT_INJECTION_AUDIT: \"\" }), true);\n 131→\tassert.equal(injectionAuditEnabled({ AGENT_INJECTION_AUDIT: \"0\" }), true);\n 132→\tassert.equal(injectionAuditEnabled({ AGENT_INJECTION_AUDIT: \"FALSE\" }), false);\n 133→});\n 134→"
    },
    "providerData": {
