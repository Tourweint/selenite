f (result === undefined) continue;\n    if (Array.isArray(result)) all.push(...result);\n    else all.push(result);\n  }\n  // 规范序：order 升序，同 order 按 id 字典序；再补字段做全序，保证打乱输入也稳定。\n  all.sort(\n    (a, b) =>\n      a.order - b.order ||\n      cmp(a.id, b.id) ||\n      cmp(a.channel, b.channel) ||\n      cmp(a.scope, b.scope) ||\n      cmp(a.text, b.text),\n  );\n  // 按 id 去重，后者覆盖（保留规范序里最后一次出现，输出仍有序）。\n  const deduped = all.filter(\n    (entry, index) => !all.some((later, j) => j > index && later.id === entry.id),\n  );\n  return {\n    system: deduped.filter((e) => e.channel === \"system\"),\n    message: deduped.filter((e) => e.channel === \"message\"),\n  };\n}\n\nfunction cmp(a: string, b: string): number {\n  return a < b ? -1 : a > b ? 1 : 0;\n}\n\n// ── 批 A 唯一接管的注入：injection_guard ──────────────────\nexport const INJECTION_GUARD_ID = \"injection_guard\";\n\nexport const guardProvider: InjectionProvider = () => {\n  if (!injectionGuardEnabled()) return undefined;\n  return {\n    id: INJECTION_GUARD_ID,\n    text: INJECTION_GUARD,\n    // 批 A 只有这一个 provider，order 只作框架内排序用；section 位置由 lifecycle 的数组下标决定。\n    order: 0,\n    scope: \"session\",\n    channel: \"system\",\n  };\n};\n\n/** 批 A 框架登记的注入源：只此一个；其余 6 个 section 与 5 处 extra.push 不动。 */\nexport interface RegisteredInjection {\n  source: string;\n  provider: InjectionProvider;\n}\nexport const INJECTION_REGISTRY: readonly RegisteredInjection[] = [\n  { source: INJECTION_GUARD_ID, provider: guardProvider },\n];\n\n/** 审计开关（默认开；显式 false 关，关时端点 404，一行回滚）。 */\nexport function injectionAuditEnabled(env: NodeJS.ProcessEnv = process.env): boolean {\n  return (env.AGENT_INJECTION_AUDIT ?? \"\").trim().toLowerCase() !== \"false\";\n}\n\nexport interface InjectionAuditRow {\n  id: string;\n  source: string;\n  scope: InjectionScope;\n  length: number;\n}\n\n/** 审计投影：只回元数据，绝不回正文（length 是 text 的字符数）。 */\nexport function auditInjections(ctx: InjectionContext): InjectionAuditRow[] {\n  const rows: InjectionAuditRow[] = [];\n  for (const { source, provider } of INJECTION_REGISTRY) {\n    const { system, message } = collectInjections([provider], ctx);\n    for (const entry of [...system, ...message]) {\n      rows.push({ id: entry.id, source, scope: entry.scope, length: entry.text.length });\n    }\n  }\n  return rows;\n}\n\n/** lifecycle 的 injection_guard section 用它取回正文；关时 system 为空 → undefined（省略整段）。 */\nexport function guardInjectionText(ctx: InjectionContext): string | undefined {\n  return collectInjections([guardProvider], ctx).system[0]?.text;\n}\n```\n\nWait, `guardInjectionText` — this is a helper for lifecycle. Actually lifecycle can just call `collectInjections([guardProvider], ctx).system[0]?.text` directly. But a small helper is cleaner. Hmm, but it's a one-liner helper. Let me just have lifecycle call collectInjections directly (to visibly use the framework in the takeover). Actually, I'll provide the helper to avoid lifecycle importing collectInjections + guardProvider + building ctx... actually lifecycle needs ctx anyway. Let me have lifecycle do:\n\n```ts\nimport { guardProvider, collectInjections } from \"./injection.ts\";\n...\n{\n  key: \"injection_guard\",\n  render: (input) => collectInjections([guardProvider], { conversationId: input.conversationId }).system[0]?.text,\n},\n```\n\nThat's clear and uses the framework. Good. I won't add `guardInjectionText` helper (avoid one-off abstraction). But the hard-standard test calls `collectInjections([guardProvider], ctx).system[0].text` directly. Good.\n\nHold on — `input.conversationId` type. Let me check the Section render input type. It's from pi-durable's `defineExtension` sections. Let me check what `input.conversationId` is. In the code: `Number(input.conversationId)` and `String(input.conversationId)` are used, so it's probably a `string | number` or branded type. Let me check the type to make sure `{ conversationId: input.conversationId }` typechecks against `InjectionContext.conversationId: number | string`. If `inpu