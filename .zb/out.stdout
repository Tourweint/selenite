      "text": " 380→\t\t\tstage: \"artifacts\",\n 381→\t\t});\n 382→\t\tstore.saveReview({\n 383→\t\t\tticket_id: \"T-gates\",\n 384→\t\t\tseq: 2,\n 385→\t\t\tslug: \"02-test\",\n 386→\t\t\tverdict: \"fail\",\n 387→\t\t\treason: \"测试没过\",\n 388→\t\t\tstage: \"process\",\n 389→\t\t});\n 390→\t\tstore.close();\n 391→\n 392→\t\tconst app = new Hono();\n 393→\t\tmountDelegationApi(app, { workRoot });\n 394→\n 395→\t\tconst response = await app.request(\"/api/v1/tickets/T-gates\");\n 396→\t\tassert.equal(response.status, 200);\n 397→\t\tconst body = (await response.json()) as {\n 398→\t\t\tgates?: Array<{ name: string; passed: boolean; note?: string }>;\n 399→\t\t};\n 400→\t\tassert.deepEqual(body.gates, [\n 401→\t\t\t{ name: \"验收：01-write\", passed: true, note: \"文件已改\" },\n 402→\t\t\t{ name: \"验收：02-test\", passed: false, note: \"测试没过\" },\n 403→\t\t\t{ name: \"返工\", passed: true, note: \"已返工 2 轮\" },\n 404→\t\t]);\n 405→\n 406→\t\tconst saved = process.env.TICKET_GATES;\n 407→\t\tprocess.env.TICKET_GATES = \"false\";\n 408→\t\ttry {\n 409→\t\t\tconst off = await app.request(\"/api/v1/tickets/T-gates\");\n 410→\t\t\tconst offBody = (await off.json()) as Record<string, unknown>;\n 411→\t\t\tassert.equal(\"gates\" in offBody, false, \"开关关掉详情不带 gates\");\n 412→\t\t} finally {\n 413→\t\t\tif (saved === undefined) delete process.env.TICKET_GATES;\n 414→\t\t\telse process.env.TICKET_GATES = saved;\n 415→\t\t}\n 416→\t} finally {\n 417→\t\trmSync(root, { recursive: true, force: true });\n 418→\t}\n 419→});\n 420→\n 421→test(\"多副本对齐：同 requestId 的单在列表/详情共用 groupId；开关关掉不出现\", async () => {\n 422→\tconst root = temp(\"api-fanout\");\n 423→\ttry {\n 424→\t\tconst workRoot = join(root, \"runs\");\n 425→\t\t// 同一 requestId 的副本分散在不同 runs 目录（顶层 / 领域各一份；同库只有一个\n 426→\t\t// idempotency_key 唯一位，真实扇出也是这样按领域分目录落的）。\n 427→\t\tconst manager = ensureManager(workRoot, \"fan\");\n 428→\t\tconst rootStore = new Store(workRoot);\n 429→\t\trootStore.saveTicket(makeTicket(\"T-fan-a\", workRoot, { idempotencyKey: \"req-1\" }));\n 430→\t\trootStore.saveTicket(makeTicket(\"T-solo\", workRoot));\n 431→\t\trootStore.close();\n 432→\t\tconst managerStore = new Store(manager.runs_dir);\n 433→\t\tmanagerStore.saveTicket(\n 434→\t\t\tmakeTicket(\"T-fan-b\", manager.runs_dir, {\n 435→\t\t\t\tidempotencyKey: \"req-1\",\n 436→\t\t\t\toptions: { dry: true, maxTasks: 8, workRoot: manager.runs_dir, domain: \"fan\" },\n 437→\t\t\t}),\n 438→\t\t);\n 439→\t\tmanagerStore.close();\n 440→\n 441→\t\tconst app = new Hono();\n 442→\t\tmountDelegationApi(app, { workRoot });\n 443→\n 444→\t\tconst list = (await (await app.request(\"/api/v1/tickets?limit=50\")).json()) as {\n 445→\t\t\ttickets: Array<{ id: string; groupId: string | null }>;\n 446→\t\t};\n 447→\t\tconst byId = new Map(list.tickets.map((ticket) => [ticket.id, ticket.groupId]));\n 448→\t\tassert.equal(byId.get(\"T-fan-a\"), \"req-1\");\n 449→\t\tassert.equal(byId.get(\"T-fan-b\"), \"req-1\");\n 450→\t\tassert.equal(byId.get(\"T-solo\"), null, \"没有 requestId 的单不带组\");\n 451→\n 452→\t\tconst detail = (await (await app.request(\"/api/v1/tickets/T-fan-a\")).json()) as {\n 453→\t\t\tgroupId?: string;\n 454→\t\t};\n 455→\t\tassert.equal(detail.groupId, \"req-1\");\n 456→\n 457→\t\tconst saved = process.env.DELEGATION_FANOUT_GROUP;\n 458→\t\tprocess.env.DELEGATION_FANOUT_GROUP = \"false\";\n 459→\t\ttry {\n 460→\t\t\tconst offDetail = (await (await app.request(\"/api/v1/tickets/T-fan-a\")).json()) as Record<\n 461→\t\t\t\tstring,\n 462→\t\t\t\tunknown\n 463→\t\t\t>;\n 464→\t\t\tassert.equal(\"groupId\" in offDetail, false, \"开关关掉详情不带 groupId\");\n 465→\t\t\tconst offList = (await (await app.request(\"/api/v1/tickets?limit=50\")).json()) as {\n 466→\t\t\t\ttickets: Array<{ groupId: string | null }>;\n 467→\t\t\t};\n 468→\t\t\tassert.ok(offList.tickets.every((ticket) => ticket.groupId === null), \"列表也不带组\");\n 469→\t\t} finally {\n 470→\t\t\tif (saved === undefined) delete process.env.DELEGATION_FANOUT_GROUP;\n 471→\t\t\telse process.env.DELEGATION_FANOUT_GROUP = saved;\n 472→\t\t}\n 473→\t} finally {\n 474→\t\t// Windows 上目录句柄回收比文件慢半拍；断言已经跑完，清理失败不应把用例判红。\n 475→\t\ttry {\n 476→\t\t\trmSync(root, { recursive: true, force: true, maxRetries: 20, retryDelay: 100 });\n 477→\t\t} catch {\n 478→\t\t\t/* 句柄由 OS 在进程退出时回收 */\n 479→\t\t}\n 480→\t}\n 481→});\n 482→\n 483→// ── 验收项逐项投影（2026-11-10 批 23 §一）────────────────────\n 484→\n 485→test(\"验收项：只认 `验：` 前缀（半角冒号同样认），状态只按 reviews 判\", () => {\n 486→\tconst checks = projectAcceptanceChecks(\n 487→\t\t[\"读 src/a.ts\", \"验：npm test 全绿\", \" 验: 类型检查 0 错 \"],\n 488→\t\t[\n 489→\t\t\t{ slug: \"01-write\", verdict: \"pass\" },\n 490→"
