    "output": {
      "type": "text",
      "text": " 440→ *\n 441→ * durable 没有标题和删除的概念，所以这两件事只写我们自己的 `chat-meta.json`：\n 442→ * 改名不影响内核；「移除」只是不在列表里出现，会话与记忆都还在。\n 443→ */\n 444→app.post(\"/api/v1/agent/chat/:conversationId/rename\", async (c) => {\n 445→  const body = (await c.req.json().catch(() => null)) as { title?: string } | null;\n 446→  const title = body?.title ?? \"\";\n 447→  return c.json({ ok: true, ...renameChat(c.req.param(\"conversationId\"), title) });\n 448→});\n 449→\n 450→app.post(\"/api/v1/agent/chat/:conversationId/hide\", (c) => {\n 451→  hideChat(c.req.param(\"conversationId\"));\n 452→  return c.json({ ok: true });\n 453→});\n 454→\n 455→app.post(\"/api/v1/agent/chats/restore\", (c) => c.json({ ok: true, restored: restoreChats() }));\n 456→\n 457→/** 置顶 / 取消置顶（2026-11-04 批次一）：只影响列表顺序，写 chat-meta，不碰会话本身 */\n 458→app.post(\"/api/v1/agent/chat/:conversationId/pin\", async (c) => {\n 459→  const body = (await c.req.json().catch(() => null)) as { pinned?: boolean } | null;\n 460→  const pinned = body?.pinned !== false;\n 461→  return c.json({ ok: true, pinned: pinChat(c.req.param(\"conversationId\"), pinned) });\n 462→});\n 463→\n 464→/**\n 465→ * 访问档位（2026-11-03）：完全访问 / 只读 / 不跑命令。\n 466→ * 改完立刻生效——beforeTool 每次调用都重新判断，不用重启服务。\n 467→ *\n 468→ * 2026-11-08（扫尾批 4a）：响应顺带投影两个能力开关（`attachments` / `editResend`），\n 469→ * 前端据此决定渲染不渲染入口。它们是**环境变量**、不是可写档位，所以 POST 不收、\n 470→ * 但响应里照样带着（读一次 policy 就知道当前能力面）。\n 471→ */\n 472→app.get(\"/api/v1/agent/policy\", (c) => c.json(policyProjection()));\n 473→\n 474→app.post(\"/api/v1/agent/policy\", async (c) => {\n 475→  const body = (await c.req.json().catch(() => null)) as\n 476→    | { access?: string; blocked?: string[]; approvalLevel?: unknown; confirmWrites?: unknown }\n 477→    | null;\n 478→  const access = body?.access;\n 479→  if (access && access !== \"full\" && access !== \"read-only\" && access !== \"no-shell\") {\n 480→    return c.json({ error: \"bad_request\", message: \"access 只能是 full / read-only / no-shell\" }, 400);\n 481→  }\n 482→  // 三档（2026-11-08 扫尾批 10-C）：新字段优先，旧布尔照旧收（true→ask-all / false→none）\n 483→  if (\n 484→    body &&\n 485→    \"approvalLevel\" in body &&\n 486→    body.approvalLevel !== \"ask-all\" &&\n 487→    body.approvalLevel !== \"ask-critical\" &&\n 488→    body.approvalLevel !== \"none\"\n 489→  ) {\n 490→    return c.json(\n 491→      { error: \"bad_request\", message: \"approvalLevel 只能是 ask-all / ask-critical / none\" },\n 492→      400,\n 493→    );\n 494→  }\n 495→  if (body && \"confirmWrites\" in body && typeof body.confirmWrites !== \"boolean\") {\n 496→    return c.json({ error: \"bad_request\", message: \"confirmWrites 只能是布尔值\" }, 400);\n 497→  }\n 498→  const approvalLevel =\n 499→    body?.approvalLevel === \"ask-all\" ||\n 500→    body?.approvalLevel === \"ask-critical\" ||\n 501→    body?.approvalLevel === \"none\"\n 502→      ? body.approvalLevel\n 503→      : undefined;\n 504→  setPolicy({\n 505→    ...(access ? { access: access as \"full\" | \"read-only\" | \"no-shell\" } : {}),\n 506→    ...(Array.isArray(body?.blocked) ? { blocked: body!.blocked! } : {}),\n 507→    ...(approvalLevel ? { approvalLevel } : {}),\n 508→    ...(typeof body?.confirmWrites === \"boolean\" ? { confirmWrites: body.confirmWrites } : {}),\n 509→  });\n 510→  // 与改动前一致：POST 回的是写后的策略本身（不含 label），额外带上只读能力投影\n 511→  const next = getPolicy();\n 512→  return c.json({\n 513→    ok: true,\n 514→    access: next.access,\n 515→    blocked: next.blocked,\n 516→    approvalLevel: next.approvalLevel,\n 517→    // 派生字段：旧客户端只认布尔\n 518→    confirmWrites: next.confirmWrites,\n 519→    // 2026-11-08 扫尾批 8c：审批形态是 env（不可写），这里只回显，形状与 GET 对齐\n 520→    approvalMode: next.approvalMode,\n 521→    attachments: attachmentsEnabled(),\n 522→    editResend: editResendEnabled(),\n 523→  });\n 524→});\n 525→\n 526→/** policy 投影：档位 + 标签 + 能力开关（只读投影，不写 .data/policy.json）。 */\n 527→function policyProjection() {\n 528→  return {\n 529→    ...getPolicy(),\n 530→    attachments: attachmentsEnabled(),\n 531→    editResend: editResendEnabled(),\n 532→  };\n 533→}\n 534→\n 535→/**\n 536→ * 思考强度档（2026-11-04 思考档位方案 D4）：同一个模型的四条思考变体，不换模型。\n 537→ *\n 538→ * body：`{ thinking: \"off\"|\"low\"|\"medium\"|\"high\" }`；旧 `{ mode: \"fast\"|\"deep\" }` 兼容映射\n 539→ * （fast→off、deep→high）。按**当前模型支持域**校验：未知值或未声明档位 → 400。\n 540→ * 写入即 configure 持久化到 durable 会话（重启保留）；faux 下 chatModelRef 原样返回，空操作 ok。\n 541→ */\n 542→app.post(\"/api/v1/agent/chat/:conversationId/mode\", async (c) => {\n 543→  if (!readLlmConfig()) return c.json({ ok: false, reason: \"llm_not_configured\" }, 503);\n 544→  const body = (await c.req.json().catch(() => null)) as\n 545→    | { thinking?: unknown; mode?: unknown }\n 546→    | null;\n 547→  const level = parseThinkingLevel(body);\n 548→  if (!level) {\n 549→    return c.json(\n 550→      {\n 551→        error: \"bad_request\",\n 552→        message: \"thinking 只能是 off / low / medium / high（旧 mode 兼容 fast / deep）\",\n 553→      },\n 554→      400,\n 555→    );\n 556→  }\n 557→  // 支持域不在 = 上游大概率 400（medium 对 glm-5.3 实测如此）；在入口说清楚，别让它变成一次失败的生成\n 558→  const supported = currentThinkingLevels();\n 559→  if (!supported.includes(level)) {\n 560→    return c.json(\n 561→      {\n 562→        error: \"bad_request\",\n 563→        message: `当前模型不支持思考档 ${level}；支持：${supported.join(\" / \")}`,\n 564→      },\n 565→      400,\n 566→    );\n 567→  }\n 568→\n 569→  const chat = await openChat(c.req.param(\"conversationId\"));\n 570→  if (!chat) return c.json({ error: \"unknown_conversation\" }, 404);\n 571→  await applyChatMode(chat, level);\n 572→  return c.json({ ok: true, thinking: level });\n 573→});\n 574→\n 575→/**\n 576→ * 手动压缩（扫尾批 1 B1，方案 §二）：`POST .../agent/chat/:conversationId/compact`。\n 577→ * body `{ \"instructions\"?: string }`；受理即回 `{ok:true,taskId}`，压缩在后台做。\n 578→ * `?wait=1` 时再等 `harness.waitForTask` 至多 `AGENT_COMPACT_WAIT_MS`（默认 60000）：\n 579→ * 完成回 `{ok:true,compacted:true}`；超时回 `{ok:true,waited:false,taskId}`（受理仍有效）。\n 580→ * 会话不存在 404、模型未配置 503，与 `/mode` 同口径；压缩事件内核本就发，SSE 透传不动。\n 581→ */\n 582→app.post(\"/api/v1/agent/chat/:conversationId/compact\", async (c) => {\n 583→  if (!readLlmConfig()) return c.json({ ok: false, reason: \"llm_not_configured\" }, 503);\n 584→  const body = (await c.req.json().catch(() => null)) as { instructions?: unknown } | null;\n 585→  const instructions = typeof body?.instructions === \"string\" ? body.instructions : undefined;\n 586→  const chat = await openChat(c.req.param(\"conversationId\"));\n 587→  if (!chat) return c.json({ error: \"unknown_conversation\" }, 404);\n 588→  const taskId = await startChatCompaction(chat, instructions);\n 589→  if (c.req.query(\"wait\") === \"1\") {\n 590→    const raw = Number(process.env.AGENT_COMPACT_WAIT_MS ?? 60000);\n 591→    const waitMs = Number.isFinite(raw) && raw > 0 ? raw : 60000;\n 592→    const compacted = await waitChatCompaction(taskId, waitMs);\n 593→    if (compacted) return c.json({ ok: true, compacted: true });\n 594→    return c.json({ ok: true, waited: false, taskId });\n 595→  }\n 596→  return c.json({ ok: true, taskId });\n 597→});\n 598→\n 599→/** 新体 `{thinking}` 优先；没有就按旧体 `{mode}` 映射（2026-11-04 思考档位 D4） */\n 600→function parseThinkingLevel(body: { thinking?: unknown; mode?: unknown } | null): ThinkingLevel | null {\n 601→  if (typeof body?.thinking === \"string\") {\n 602→    const parsed = ThinkingLevelSchema.safeParse(body.thinking.trim().toLowerCase());\n 603→    return parsed.success ? parsed.data : null;\n 604→  }\n 605→  const legacy = typeof body?.mode === \"string\" ? body.mode.trim().toLowerCase() : \"\";\n 606→  if (legacy === \"fast\") return \"off\";\n 607→  if (legacy === \"deep\") return \"high\";\n 608→  return null;\n 609→}\n 610→\n 611→\n 612→app.get(\"/healthz\", (c) => {\n 613→  // model/models 给\"这台机器现在用什么模型\"一个扁平答案（2026-11-04 批次五）：\n 614→  // models 语义收窄为**默认供应商的清单**；要分组 / 要 key 状态请走 /agent/model 与 /agent/providers。\n 615→  // mock 时 model=null；faux 时 model=\"faux\"、清单为空。\n 616→  const info = runtimeModelInfo();\n 617→  return c.json({\n 618→    ok: true,\n 619→    llm: info.model ? \"upstream\" : \"mock\",\n 620→"
    },
