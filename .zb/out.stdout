就重新算。\n 956→\t\t\t\t\t\t//\n 957→\t\t\t\t\t\t// 拿 `run.inputs[0]` 当 run 身份：run.taskId 每一轮都会变\n 958→\t\t\t\t\t\t// （每一轮是一个新的 generation 任务），用它计数永远归零，\n 959→\t\t\t\t\t\t// 上限就形同虚设 —— 这个坑是实测踩出来的。\n 960→\t\t\t\t\t\tconst live = await api.snapshot(LiveDoc, api.conversationId, ctx);\n 961→\t\t\t\t\t\tconst runId = live?.run?.inputs?.[0] ?? live?.run?.taskId;\n 962→\t\t\t\t\t\tconst key = `${api.conversationId}:${String(runId ?? \"none\")}`;\n 963→\t\t\t\t\t\tconst used = (runTurns.get(key) ?? 0) + 1;\n 964→\t\t\t\t\t\trunTurns.set(key, used);\n 965→\n 966→\t\t\t\t\t\t// 执事间递话（2026-11-08 扫尾批 8d）：把 run 身份记给通道，并认领\n 967→\t\t\t\t\t\t// \"这一轮由递话触发\"的一次性标记。认领放在这里而不是 beforeTool，\n 968→\t\t\t\t\t\t// 是因为一次模型请求对应一轮里**第一个**必到的点；mid-run 被 followUp\n 969→\t\t\t\t\t\t// 插进来的递话也在这里认领（那时 used>1，标记落到同一个 run 键上）。\n 970→\t\t\t\t\t\tbeginRelayRun(api.conversationId, key);\n 971→\t\t\t\t\t\tif (claimRelayTarget(api.conversationId)) {\n 972→\t\t\t\t\t\t\tmarkRelayRun(api.conversationId, key);\n 973→\t\t\t\t\t\t}\n 974→\n 975→\t\t\t\t\t\tif (MAX_TURNS > 0 && used > MAX_TURNS) {\n 976→\t\t\t\t\t\t\ttoolsBlocked.add(api.conversationId);\n 977→\t\t\t\t\t\t\tlimitHits.set(api.conversationId, (limitHits.get(api.conversationId) ?? 0) + 1);\n 978→\t\t\t\t\t\t\textra.push({\n 979→\t\t\t\t\t\t\t\trole: \"system\",\n 980→\t\t\t\t\t\t\t\tcontent: TURN_LIMIT_INSTRUCTION,\n 981→\t\t\t\t\t\t\t\ttimestamp: Date.now(),\n 982→\t\t\t\t\t\t\t});\n 983→\t\t\t\t\t\t\tconsole.warn(\n 984→\t\t\t\t\t\t\t\t`[agent] 会话 ${api.conversationId}（run ${String(live?.run?.taskId)}）工具回合达上限 ${MAX_TURNS}`,\n 985→\t\t\t\t\t\t\t);\n 986→\t\t\t\t\t\t\tif (used > MAX_TURNS + HARD_STOP_GRACE && !aborting.has(key)) {\n 987→\t\t\t\t\t\t\t\taborting.add(key);\n 988→\t\t\t\t\t\t\t\tconsole.warn(`[agent] 会话 ${api.conversationId} 无视上限，硬停这一轮`);\n 989→\t\t\t\t\t\t\t\tvoid abortRun(api.conversationId);\n 990→\t\t\t\t\t\t\t}\n 991→\t\t\t\t\t\t} else if (used === 1) {\n 992→\t\t\t\t\t\t\t// 新的一轮，把上一轮封掉的工具放开\n 993→\t\t\t\t\t\t\ttoolsBlocked.delet