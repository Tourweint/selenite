    "output": {
      "type": "text",
      "text": " 120→} from \"./provider.ts\";\n 121→import { injectProviderKeys } from \"./provider-secrets.ts\";\n 122→// 会话导出「接续文件」（2026-11-10 批 20 §一）：拼接是纯函数，正文只在响应体里出现。\n 123→import {\n 124→  buildHandoff,\n 125→  chatExportHandoffEnabled,\n 126→  HANDOFF_MEMORY_LIMIT,\n 127→  handoffFileName,\n 128→  parseHandoffLimit,\n 129→  type HandoffMemory,\n 130→} from \"./chat-handoff.ts\";\n 131→// 旧会话定点找回（2026-11-10 批 20 §四）：按消息下标取窗口，不改内核加 seq。\n 132→import {\n 133→  chatContextLookupEnabled,\n 134→  contextMessageOf,\n 135→  parseAroundIndex,\n 136→  parseContextRadius,\n 137→  sliceAroundIndex,\n 138→} from \"./chat-context.ts\";\n 139→import { chancellorWorkRoot } from \"./delegation.ts\";\n 140→import { DelegationReceipts } from \"./delegation-receipts.ts\";\n 141→import {\n 142→\tcollectDeadLetters,\n 143→\trecoverReportEnabled,\n 144→\treportRecoveredTickets,\n 145→\ttype DeadLetterChild,\n 146→} from \"./recovery-report.ts\";\n 147→import { recoverDelegations, type RecoveredTicket } from \"../../../../../chancellor/src/index.ts\";\n 148→// 恢复注记（2026-11-09 任务书 T3 §5）：只有进程内记账，无存储依赖。\n 149→import { markRecoverResume, recoverNoteEnabled } from \"./agent/recover-note.ts\";\n 150→// 注入审计（2026-11-10 批 26b §二）：只回元数据、不回正文的框架注入清单。\n 151→import { auditInjections, injectionAuditEnabled } from \"./agent/injection.ts\";\n 152→import { Store } from \"../../../../../chancellor/src/store.ts\";\n 153→import { listManagers } from \"../../../../../chancellor/src/manager/registry.ts\";\n 154→\n 155→// Node 20.12+ 自带 .env 加载；文件不存在时静默跳过，不让本地启动被环境文件卡住。\n 156→try {\n 157→  (process as unknown as { loadEnvFile?: (path?: string) => void }).loadEnvFile?.();\n 158→} catch {\n 159→  /* no .env, that's fine */\n 160→}\n 161→\n 162→// 2026-11-05 密钥直填：启动时把 .data/provider-keys.json 注入进程 env。\n 163→// 必须放在 loadEnvFile 之后、任何模型配置读取之前——手写 .env / 部署 env 的已有值优先。\n 164→injectProviderKeys();\n 165→\n 166→// 界面高级开关（2026-11-09）：.data/agent-flags.json 里用户改过的开关覆盖 env。\n 167→// 必须放在路由挂载之前——挂载期的开关（执事/群组/课题/技能管理）要吃到覆盖值。\n 168→loadFlagOverrides();\n 169→\n 170→const app = new Hono();\n 171→\n 172→/** 服务端错误日志落点：桌面壳拉起进程时没有终端，文件是唯一能回看的地方。 */\n 173→const SERVER_ERROR_LOG = process.env.AGENT_ERROR_LOG?.trim() || \".data/server-errors.log\";\n 174→\n 175→/** 追加一行错误（尽力而为：写不进去只 warn，绝不能因为记日志再把请求搞挂）。 */\n 176→function appendServerError(line: string): void {\n 177→  try {\n 178→    mkdirSync(dirname(SERVER_ERROR_LOG), { recursive: true });\n 179→    appendFileSync(SERVER_ERROR_LOG, line);\n 180→  } catch (error) {\n 181→    console.warn(`[error] 写 ${SERVER_ERROR_LOG} 失败: ${error instanceof Error ? error.message : error}`);\n 182→  }\n 183→}\n 184→\n 185→/**\n 186→ * 未捕获错误的统一出口（2026-11-07）。\n 187→ *\n 188→ * 两个理由：\n 189→ * 1. **看得见**：Hono 默认只 `console.error` 一行，而桌面壳是 `cmd.Start()` 起的、\n 190→ *    没有重定向 stdout/stderr，服务端日志根本没人收——\"页面 500\"于是变成无头案。\n 191→ *    这里把错误追加到 `.data/server-errors.log`（只记时间/方法/路径/错误与栈，\n 192→ *    不记请求体与对话内容），出问题时能直接查。\n 193→ * 2. **说得清**：500 空体让前端只能显示\"读历史失败：500\"。这里回一个 `internal_error`\n 194→ *    加一句稳定的说明，前端能把它当\"服务端内部错误\"处理，而不是当成历史丢了。\n 195→ *    错误细节（message/stack）只进服务端日志，不下发客户端——它可能带上游地址或路径。\n 196→ */\n 197→app.onError((error, c) => {\n 198→  const message = error instanceof Error ? error.message : String(error);\n 199→  const at = new Date().toISOString();\n 200→  const line = `${at} ${c.req.method} ${c.req.path} :: ${message}\\n${\n 201→    error instanceof Error && error.stack ? `${error.stack}\\n` : \"\"\n 202→  }`;\n 203→  console.error(`[error] ${c.req.method} ${c.req.path}: ${message}`);\n 204→  appendServerError(line);\n 205→  return c.json({ error: \"internal_error\", message: \"服务端内部错误，详见服务端日志\" }, 500);\n 206→});\n 207→\n 208→// M0 只在本机/局域网跑，放开来源方便真机调试。\n 209→// 上公网前必须收紧成具体来源，否则等于把私人 Agent 敞开。\n 210→app.use(\n 211→  \"*\",\n 212→  cors({\n 213→    origin: \"*\",\n 214→    allowMethods: [\"GET\", \"POST\", \"PUT\", \"DELETE\", \"OPTIONS\"],\n 215→    // X-Conversation-Id 是兼容层的会话绑定头，X-Task 是任务通道的任务名（原生客户端不发预检，但浏览器/WebView 会）\n 216→    allowHeaders: [\"Content-Type\", \"Authorization\", \"X-Conversation-Id\", \"X-Task\", \"Accept\"],\n 217→  }),\n 218→);\n 219→\n 220→// 鉴权只作用于 API；调试页是静态 UI，真正的数据都要过 /api/v1\n 221→//\n 222→// 凭据两档（2026-10-29 配对）：共享令牌 `AGENT_TOKEN`（命令行/调试）+ 扫码换来的设备凭据。\n 223→// **配对的两个端点必须免鉴权**——手机在配对之前手里还没有任何凭据。\n 224→const pairing = new PairingStore();\n 225→const auth = createAuthMiddleware(process.env.AGENT_TOKEN?.trim() || null, {\n 226→  verifyDeviceToken: (token) => pairing.verifyDeviceToken(token),\n 227→});\n 228→\n 229→// SSE 事件重放库（2026-11-04 seq 方案）。惰性建：回滚开关关着就永远不建库。\n 230→// 库路径可用 AGENT_SSE_SEQ_DB_PATH 覆盖（探针用），默认 .data/chat-events.sqlite。\n 231→let chatEventStore: ChatEventStore | undefined;\n 232→const chatEventStoreOf = (): ChatEventStore | undefined => {\n 233→  if (!sseSeqEnabled()) return undefined;\n 234→  chatEventStore ??= new ChatEventStore();\n 235→  return chatEventStore;\n 236→};\n 237→const PAIR_OPEN_PATHS = new Set([\"/api/v1/pair/info\", \"/api/v1/pair/redeem\"]);\n 238→app.use(\"/api/v1/*\", async (c, next) => {\n 239→  if (PAIR_OPEN_PATHS.has(c.req.path)) return next();\n 240→  return auth(c, next);\n 241→});\n 242→\n 243→// redeem 限流：每 IP 每分钟 10 次（防有人对着 6 位码暴力枚举）\n 244→const redeemHits = new Map<string, { count: number; resetAt: number }>();\n 245→const REDEEM_PER_MINUTE = 10;\n 246→function redeemRateLimited(ip: string, now = Date.now()): boolean {\n 247→  const hit = redeemHits.get(ip);\n 248→  if (!hit || hit.resetAt <= now) {\n 249→    redeemHits.set(ip, { count: 1, resetAt: now + 60_000 });\n 250→    return false;\n 251→  }\n 252→  hit.count += 1;\n 253→  return hit.count > REDEEM_PER_MINUTE;\n 254→}\n 255→\n 256→// OpenAI 兼容端点：手机 App 已经在按这个协议说话，服务端适配比改客户端便宜\n 257→mountOpenAiCompat(app);\n 258→\n 259→// 日记成稿镜像（2026-10-29）：独立库 .data/diary.sqlite，只收手机的推送，没有\"在这里改日记\"的入口\n 260→mountDiary(app);\n 261→\n 262→// 手机 worker 通道（2026-11-02）：poll / model / result，鉴权沿用上面的 /api/v1/* 中间件\n 263→mountPhoneWorker(app);\n 264→\n 265→// 受限 shell（2026-11-02 第四个接口）：只放行虚拟屏需要的那几种 adb shell 形状\n 266→mountWorkerShell(app);\n 267→\n 268→// 项目与工作区（2026-11-03 方案 §5.5）：派单前置。新建项目根目录只提交待确认请求，\n 269→// 用户在设置页确认后才建目录、登记。界面上线前用 HTTP 也能完成同一流程。\n 270→mountProjects(app);\n 271→// 默认工作区（2026-11-08 用户拍板）：首次使用不再要引导，没设过就静默落 <主目录>/lifediary。\n 272→// LIFEDIARY_DEFAULT_WORKSPACE=off 退回旧行为（不播种）；已设置过的一律不动。\n 273→seedDefaultWorkspace();\n 274→\n 275→// 文件浏览入口（2026-11-06）：open-explorer + files 只读浏览。回滚开关\n 276→// EXPLORER_OPEN=false / FILE_BROWSE=false（方案：docs/设计方案/2026-11-06-文件浏览入口（桌面资源管理器与手机端）.md）。\n 277→mountFiles(app);\n 278→\n 279→// 任务中心只读接口（2026-11-03 方案 §5.9）：领域列表 + 单 ticket 明细。\n 280→mountDelegationApi(app);\n 281→\n 282→// 执事管理（2026-11-05 批次B B2）：档案 CRUD + 手动跑一轮。开关关着一个路由都不挂（404 = 未启用）。\n 283→mountCompanions(app);\n 284→\n 285→// 群组（2026-11-06 群组方案）：执事群聊 + 共享时间线 + 确定性调度。\n 286→// GROUPS_ENABLED / COMPANIONS_ENABLED 任一关着一个路由都不挂（404 = 未启用）。\n 287→mountGroups(app);\n 288→\n 289→// 长期课题（2026-11-07 长期课题跟进）：课题户口本 + 提议确认 + 研究回合。\n 290→// 开关关着一个路由都不挂（404 = 未启用）；研究闹钟由 agent 里注册的 TopicTask 负责。\n 291→mountTopics(app);\n 292→\n 293→// 搜索配置：课题研究的硬前提（没 key 时 propose_topic / 研究回合都会拒绝）。\n 294→mountSearch(app);\n 295→\n 296→// 审批答复（2026-11-04 批次二）：待批列表 + 幂等答复。开关关着时列表恒为空。\n 297→mountApprovalApi(app);\n 298→// bash 后台任务管理面（2026-11-10 批 21 §二）：转后台之后要能看见、能收尾。\n 299→mountBgJobs(app);\n 300→// 高级开关（2026-11-09）：界面读写运行时开关（.data/agent-flags.json）。AGENT_FLAGS_UI=false 整组不挂。\n 301→mountFlags(app);\n 302→// 记忆管理（2026-11-06）：看 / 删 / 标过时。只读列表不碰 durable，删改直接落记忆库。\n 303→mountMemoryApi(app, { enabled: memoryEngine !== null });\n 304→// 技能管理（2026-11-08 扫尾批 9-S）：目录解析 = AGENT_SKILLS_DIR → 用户目录 → 应用目录兜底。\n 305→// 技能增删只影响下一个会话（D5 既有取舍），UI 文案已如实说明。\n 306→mountSkills(app);\n 307→\n 308→// 界面（2026-11-03）：原来那张 M0 调试页换成了真界面，仍然是同源静态文件。\n 309→// 桌面壳和浏览器打开的都是这个 `/`。\n 310→mountWeb(app);\n 311→\n 312→// ── 配对（2026-10-29）：手机扫这一屏换设备凭据 ────────────────\n 313→const SERVER_VERSION = \"0.1.0\";\n 314→\n 315→function currentPort(): number {\n 316→  return Number(process.env.PORT ?? 39847);\n 317→}\n 318→\n 319→/**\n 320→ * 配对码的 JSON 版（2026-11-03）：桌面端要在自己的设置页里显示二维码，\n 321→ * 而 `/pair` 返回的是一整张 HTML。同一个码、同一个来源，只是换个格式。\n 322→ */\n 323→app.get(\"/api/v1/pair/qr\", async (c) => {\n 324→  const { code, expiresAt } = pairing.issueCode();\n 325→  const url = buildPairUrl(resolvePairBase(currentPort()), code);\n 326→  const dataUrl = await QRCode.toDataURL(url, { margin: 1, width: 320 });\n 327→  c.header(\"Cache-Control\", \"no-store\");\n 328→  return c.json({\n 329→    url,\n 330→    dataUrl,\n 331→    machineName: hostname(),\n 332→    expiresInSeconds: Math.max(1, Math.round((expiresAt - Date.now()) / 1000)),\n 333→  });\n 334→});\n 335→\n 336→/** 已配对的设备（桌面设置页要看「有哪些手机连着」）。凭据哈希不外泄。 */\n 337→app.get(\"/api/v1/pair/devices\", (c) => {\n 338→  const devices = pairing.listDevices().map((device) => ({\n 339→    id: device.id,\n 340→    name: device.name,\n 341→    createdAt: device.createdAt,\n 342→    lastSeenAt: device.lastSeenAt ?? null,\n 343→    revoked: Boolean(device.revokedAt),\n 344→    // 人眼可核的指纹 + 键变更位（2026-11-10 批 26 §四）；开关关着时两者都不出现。\n 345→    ...(device.fingerprint !== undefined ? { fingerprint: device.fingerprint } : {}),\n 346→    ...(device.keyChangedAt !== undefined\n 347→      ? { keyChanged: true, keyChangedAt: device.keyChangedAt }\n 348→      : {}),\n 349→  }));\n 350→  return c.json({ devices });\n 351→});\n 352→\n 353→/** 撤掉一台设备（CORS 只放 GET/POST，所以用 POST 而不是 DELETE） */\n 354→app.post(\"/api/v1/pair/devices/:id/revoke\", (c) => {\n 355→  const ok = pairing.revokeDevice(c.req.param(\"id\"));\n 356→  return ok ? c.json({ ok: true }) : c.json({ ok: false }, 404);\n 357→});\n 358→\n 359→/** 配对页每次打开都换一枚新码（旧码立即作废，符合\"一次性\"语义） */\n 360→app.get(\"/pair\", async (c) => {\n 361→  const { code, expiresAt } = pairing.issueCode();\n 362→  const url = buildPairUrl(resolvePairBase(currentPort()), code);\n 363→  const dataUrl = await QRCode.toDataURL(url, { margin: 1, width: 320 });\n 364→  c.header(\"Cache-Control\", \"no-store\");\n 365→  return c.html(\n 366→    pairPage({\n 367→      url,\n 368→      dataUrl,\n 369→      machineName: hostname(),\n 370→      expiresInSeconds: Math.max(1, Math.round((expiresAt - Date.now()) / 1000)),\n 371→    }),\n 372→  );\n 373→});\n 374→\n 375→/** 探活：手机在兑换前先确认\"这台机器在不在\"（不含任何密钥） */\n 376→app.get(\"/api/v1/pair/info\", (c) =>\n 377→  c.json({ name: hostname(), version: SERVER_VERSION, pairing: true }),\n 378→);\n 379→\n 380→/** 出一枚新码（命令行/别的客户端用；调试页走 /pair 页面） */\n 381→app.post(\"/api/v1/pair/code\", (c) => {\n 382→  const { code, expiresAt } = pairing.issueCode();\n 383→  return c.json({ code, expiresAt, url: buildPairUrl(resolvePairBase(currentPort()), code) });\n 384→});\n 385→\n 386→/** 用码换设备凭据（免鉴权：手机此刻还没有任何凭据） */\n 387→app.post(\"/api/v1/pair/redeem\", async (c) => {\n 388→  const ip = (() => {\n 389→    try {\n 390→      return getConnInfo(c).remote.address ?? \"local\";\n 391→    } catch {\n 392→      return \"local\";\n 393→    }\n 394→  })();\n 395→  if (redeemRateLimited(ip)) return c.json({ error: \"too_many_attempts\" }, 429);\n 396→\n 397→  const body = (await c.req.json().catch(() => null)) as\n 398→    | { code?: string; deviceName?: string }\n 399→    | null;\n 400→  const code = body?.code?.trim();\n 401→  if (!code) return c.json({ error: \"bad_request\" }, 400);\n 402→\n 403→  const result = pairing.redeem(code, body?.deviceName?.trim() || \"手机\");\n 404→  if (typeof result === \"string\") {\n 405→    const status =\n 406→      result === \"unknown_code\"\n 407→        ? 404\n 408→        : result === \"code_used\"\n 409→          ? 409\n 410→          : result === \"code_expired\"\n 411→            ? 410\n 412→            : 429;\n 413→    return c.json({ error: result }, status);\n 414→  }\n 415→  console.log(`[pair] 新设备已配对（${ip}），当前共 ${pairing.listDevices().length} 台`);\n 416→  return c.json({\n 417→    deviceToken: result.deviceToken,\n 418→    deviceId: result.deviceId,\n 419→    ...(result.fingerprint ? { fingerprint: result.fingerprint } : {}),\n 420→    name: hostname(),\n 421→    version: SERVER_VERSION,\n 422→  });\n 423→});\n 424→\n 425→app.get(\"/api/v1/pair/devices\", (c) => c.json(pairing.listDevices()));\n 426→\n 427→app.post(\"/api/v1/pair/devices/:id/revoke\", (c) =>\n 428→  pairing.revokeDevice(c.req.param(\"id\"))\n 429→    ? c.json({ ok: true })\n 430→    : c.json({ error: \"unknown_device\" }, 404),\n 431→);\n 432→\n 433→/** 会话索引（只元数据，供手机重装后重建历史列表） */\n 434→app.get(\"/api/v1/agent/chats\", async (c) => {\n 435→  const limit = Number(c.req.query(\"limit\") ?? 50);\n 436→  const chats = await listChats(Number.isFinite(limit) ? limit : 50);\n 437→  return c.json({ chats, removed: chatMetaSummary().hidden });\n 438→});\n 439→\n 440→/**\n 441→ * 会话改名 / 从列表移除（2026-11-03）。\n 442→ *\n 443→ * durable 没有标题和删除的概念，所以这两件事只写我们自己的 `chat-meta.json`：\n 444→ * 改名不影响内核；「移除」只是不在列表里出现，会话与记忆都还在。\n 445→ */\n 446→app.post(\"/api/v1/agent/chat/:conversationId/rename\", async (c) => {\n 447→  const body = (await c.req.json().catch(() => null)) as { title?: string } | null;\n 448→  const title = body?.title ?? \"\";\n 449→  return c.json({ ok: true, ...renameChat(c.req.param(\"conversationId\"), title) });\n 450→"
    },
