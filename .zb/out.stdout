    "arguments": "{\"file_path\": \"D:\\\\Projects\\\\projects\\\\lh-b26\\\\ts\\\\apps\\\\server\\\\src\\\\phone-worker.ts\", \"new_string\": \"/**\\n * 从队列头取一张**还活着**的单。\\n *\\n * 执行前重验（2026-11-10 批 26 §一）：排队期间被取消 / 已过期 / 登记已被顶掉的单\\n * **一律不交出去**——手机上少跑一次被取消的活，就没有\\\"取消后仍产生副作用\\\"。\\n * 收尾交给各自的计时器 / abort 监听，队列这里只负责跳过。\\n */\\nfunction nextQueuedTask(): PhoneTask | null {\\n  const guard = phoneEnsureActive();\\n  while (ready.length > 0) {\\n    const taskId = ready.shift();\\n    if (taskId === undefined) break;\\n    const entry = pending.get(taskId);\\n    if (!entry) continue;\\n    if (guard && inactiveReason(entry) !== null) continue;\\n    return entry.task;\\n  }\\n  return null;\\n}\", \"old_string\": \"function nextQueuedTask(): PhoneTask | null {\\n  while (ready.length > 0) {\\n    const taskId = ready.shift();\\n    if (taskId === undefined) break;\\n    const entry = pending.get(taskId);\\n    if (entry) return entry.task;\\n  }\\n  return null;\\n}\"}",
