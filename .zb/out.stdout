      "type": "text",
      "text": " 380→\t\ttopic.noNewStreak = input.noNew ? topic.noNewStreak + 1 : 0;\n 381→\t\ttopic.lastRunAt = now.toISOString();\n 382→\t\tdelete topic.lastError;\n 383→\t\tthis.save();\n 384→\t\treturn finding;\n 385→\t}\n 386→\n 387→\tmarkPushed(topicId: string): void {\n 388→\t\tconst topic = this.get(topicId);\n 389→\t\tif (!topic || !topic.pendingPush) return;\n 390→\t\ttopic.pendingPush = false;\n 391→\t\tthis.save();\n 392→\t}\n 393→\n 394→\t/** 渲染即视为已通知：取走攒着的简报并一次性清空（每课题每次活跃只报一次）。 */\n 395→\tdrainPendingPushes(): Topic[] {\n 396→\t\tconst pending = this.load().topics.filter((topic) => topic.pendingPush);\n 397→\t\tif (pending.length === 0) return [];\n 398→\t\tfor (const topic of pending) topic.pendingPush = false;\n 399→\t\tthis.save();\n 400→\t\treturn pending.map((topic) => ({ ...topic, findings: [...topic.findings] }));\n 401→\t}\n 402→\n 403→\tsetLastError(topicId: string, error: string): void {\n 404→\t\tconst topic = this.get(topicId);\n 405→\t\tif (!topic) return;\n 406→\t\ttopic.lastError = error;\n 407→\t\tthis.save();\n 408→\t}\n 409→\n 410→\tpatch(id: string, input: { cron?: string; status?: TopicStatus }): TopicPatchResult {\n 411→\t\tconst topic = this.get(id);\n 412→\t\tif (!topic) return { ok: false, reason: \"not_found\" };\n 413→\t\tif (input.status !== undefined && input.status !== \"active\" && input.status !== \"paused\") {\n 414→\t\t\treturn { ok: false, reason: \"bad_status\" };\n 415→\t\t}\n 416→\t\tif (input.cron !== undefined) {\n 417→\t\t\tconst cron = input.cron.trim().replace(/\\s+/g, \" \");\n 418→\t\t\tif (!cron || nextCronFire(cron, new Date()) === null) {\n 419→\t\t\t\treturn { ok: false, reason: \"bad_cron\" };\n 420→\t\t\t}\n 421→\t\t\ttopic.cron = cron;\n 422→\t\t}\n 423→\t\tif (input.status !== undefined) {\n 424→\t\t\ttopic.status = input.status;\n 425→\t\t\tif (input.status === \"active\") {\n 426→\t\t\t\tdelete topic.closedAt;\n 427→\t\t\t\tdelete topic.closeReason;\n 428→\t\t\t}\n 429→\t\t}\n 430→\t\ttopic.revision += 1;\n 431→\t\tthis.save();\n 432→\t\treturn { ok: true, topic };\n 433→\t}\n 434→\n 435→\tclose(id: string, reason?: string): Topic | null {\n 436→\t\tconst topic = this.get(id);\n 437→\t\tif (!topic) return null;\n 438→\t\tif (topic.status !== \"closed\") {\n 439→\t\t\ttopic.status = \"closed\";\n 440→\t\t\ttopic.revision += 1;\n 441→\t\t\ttopic.pendingPush = false;\n 442→\t\t\ttopic.closedAt = nowIso();\n 443→\t\t\tconst text = reason?.trim();\n 444→\t\t\tif (text) topic.closeReason = text.slice(0, 200);\n 445→\t\t\telse delete topic.closeReason;\n 446→\t\t\tthis.save();\n 447→\t\t}\n 448→\t\treturn topic;\n 449→\t}\n 450→\n 451→\t// ── 提示词摘要 ──\n 452→\t/**\n 453→\t * 给 agent section 用的紧凑清单：题目 / 口味 / 下次研究时间 / 最新发现一句。\n 454→\t * 只列 active 课题（paused 的不会跑，没必要每轮提醒）。\n 455→\t */\n 456→\tdigestForInjection(from: Date = new Date()): string {\n 457→\t\tconst active = this.listActive();\n 458→\t\tif (active.length === 0) return \"\";\n 459→\t\treturn active\n 460→"
    },
