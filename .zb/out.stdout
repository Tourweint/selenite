      "text": "   1→import assert from \"node:assert/strict\";\n   2→import { createHash } from \"node:crypto\";\n   3→import { mkdtempSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\n   4→import { tmpdir } from \"node:os\";\n   5→import { join } from \"node:path\";\n   6→import { test } from \"node:test\";\n   7→import { PairingStore, deviceFingerprint } from \"./pairing.ts\";\n   8→import type { RedeemResult } from \"./pairing.ts\";\n   9→\n  10→/**\n  11→ * 配对设备指纹 + 键变更 fail-closed（2026-11-10 批 26 §四）。\n  12→ *\n  13→ * 指纹只用来人眼核对；键变更在服务端表现为：文件里的 tokenHash 与指纹对不上 →\n  14→ * 该设备凭据一律失效，直到主人撤销 / 重配。这里直接改文件模拟\"键被换掉\"。\n  15→ */\n  16→\n  17→interface StoredFile {\n  18→\tdevices: Array<{\n  19→\t\tid: string;\n  20→\t\tname: string;\n  21→\t\ttokenHash: string;\n  22→\t\tfingerprint?: string;\n  23→\t\tkeyChangedAt?: number;\n  24→\t\tcreatedAt: number;\n  25→\t}>;\n  26→}\n  27→\n  28→function tempDir(prefix: string): string {\n  29→\treturn mkdtempSync(join(tmpdir(), `lifediary-${prefix}-`));\n  30→}\n  31→\n  32→function readStore(file: string): StoredFile {\n  33→\treturn JSON.parse(readFileSync(file, \"utf8\")) as StoredFile;\n  34→}\n  35→\n  36→function pairOne(file: string, name = \"测试机\"): { store: PairingStore; redeemed: RedeemResult } {\n  37→\tconst store = new PairingStore(file);\n  38→\tconst code = store.issueCode().code;\n  39→\tconst redeemed = store.redeem(code, name);\n  40→\tassert.notEqual(typeof redeemed, \"string\", \"配对应当成功\");\n  41→\treturn { store, redeemed: redeemed as RedeemResult };\n  42→}\n  43→\n  44→test(\"指纹人眼可核：4-4-4 大写十六进制，同设备稳定、不同设备不同；清单不含 tokenHash\", () => {\n  45→\tconst dir = tempDir(\"pair-fingerprint\");\n  46→\ttry {\n  47→\t\tconst file = join(dir, \"pairing.json\");\n  48→\t\tconst { store, redeemed } = pairOne(file);\n  49→\t\tassert.match(redeemed.fingerprint ?? \"\", /^[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}$/);\n  50→\n  51→\t\tconst stored = readStore(file).devices[0]!;\n  52→\t\tassert.equal(\n  53→\t\t\tredeemed.fingerprint,\n  54→\t\t\tdeviceFingerprint(stored.id, stored.tokenHash),\n  55→\t\t\t\"指纹必须能由落盘的 id + tokenHash 复算\",\n  56→\t\t);\n  57→\n  58→\t\tconst listed = store.listDevices();\n  59→\t\tassert.equal(listed[0]?.fingerprint, redeemed.fingerprint);\n  60→\t\tassert.equal(\"tokenHash\" in (listed[0] as Record<string, unknown>), false, \"清单不下发哈希\");\n  61→\n  62→\t\tconst second = pairOne(file, \"第二台\");\n  63→\t\tassert.notEqual(second.redeemed.fingerprint, redeemed.fingerprint, \"两台设备指纹必须不同\");\n  64→\t\tassert.equal(store.verifyDeviceToken(redeemed.deviceToken), true);\n  65→\t\tassert.equal(second.store.verifyDeviceToken(second.redeemed.deviceToken), true);\n  66→\t} finally {\n  67→\t\trmSync(dir, { recursive: true, force: true });\n  68→\t}\n  69→});\n  70→\n  71→test(\"键变更 fail-closed：文件里的 tokenHash 被换掉 → 标记 + 凭据立即失效\", () => {\n  72→\tconst dir = tempDir(\"pair-key-change\");\n  73→\ttry {\n  74→\t\tconst file = join(dir, \"pairing.json\");\n  75→\t\tconst { redeemed } = pairOne(file);\n  76→\n  77→\t\tconst tampered = readStore(file);\n  78→\t\ttampered.devices[0]!.tokenHash = createHash(\"sha256\").update(\"另一把钥匙\").digest(\"hex\");\n  79→\t\twriteFileSync(file, JSON.stringify(tampered, null, 2), \"utf8\");\n  80→\n  81→\t\tconst reloaded = new PairingStore(file);\n  82→\t\tassert.equal(reloaded.verifyDeviceToken(redeemed.deviceToken), false, \"键变了就不认旧凭据\");\n  83→\t\tconst device = reloaded.listDevices()[0];\n  84→\t\tassert.equal(typeof device?.keyChangedAt, \"number\", \"要留下键变更标记\");\n  85→\t\tassert.equal(device?.fingerprint, redeemed.fingerprint, \"指纹仍是配对时那一枚，便于人眼对照\");\n  86→\n  87→\t\t// 标记是持久的：再加载一次不能把它洗掉。\n  88→\t\tconst again = new PairingStore(file);\n  89→\t\tassert.equal(typeof again.listDevices()[0]?.keyChangedAt, \"number\");\n  90→\t\t// 撤销 / 重配仍可用：新码换新设备不受影响。\n  91→\t\tconst fresh = pairOne(file, \"重新配对\");\n  92→\t\tassert.equal(fresh.store.verifyDeviceToken(fresh.redeemed.deviceToken), true);\n  93→\t} finally {\n  94→\t\trmSync(dir, { recursive: true, force: true });\n  95→\t}\n  96→});\n  97→\n  98→test(\"老记录迁移：没有指纹的文件加载时补算，不误判键变更\", () => {\n  99→\tconst dir = tempDir(\"pair-legacy\");\n 100→\ttry {\n 101→\t\tconst file = join(dir, \"pairing.json\");\n 102→\t\tconst token = \"legacy-device-token\";\n 103→\t\tconst tokenHash = createHash(\"sha256\").update(token).digest(\"hex\");\n 104→\t\twriteFileSync(\n 105→\t\t\tfile,\n 106→\t\t\tJSON.stringify(\n 107→\t\t\t\t{ devices: [{ id: \"legacy0001\", name: \"老手机\", tokenHash, createdAt: 1 }] },\n 108→\t\t\t\tnull,\n 109→\t\t\t\t2,\n 110→\t\t\t),\n 111→\t\t\t\"utf8\",\n 112→\t\t);\n 113→\n 114→\t\tconst store = new PairingStore(file);\n 115→\t\tassert.equal(store.verifyDeviceToken(token), true, \"迁移不能把老设备踢下线\");\n 116→\t\tconst device = store.listDevices()[0];\n 117→\t\tassert.equal(device?.fingerprint, deviceFingerprint(\"legacy0001\", tokenHash));\n 118→\t\tassert.equal(device?.keyChangedAt, undefined);\n 119→\t\tassert.equal(readStore(file).devices[0]?.fingerprint, device?.fingerprint, \"补算要落盘\");\n 120→\t} finally {\n 121→\t\trmSync(dir, { recursive: true, force: true });\n 122→\t}\n 123→});\n 124→\n 125→test(\"开关 PAIR_DEVICE_FINGERPRINT=false：不生成 / 不下发指纹，也不做键变更判定\", () => {\n 126→\tconst dir = tempDir(\"pair-fingerprint-off\");\n 127→\tconst saved = process.env.PAIR_DEVICE_FINGERPRINT;\n 128→\tprocess.env.PAIR_DEVICE_FINGERPRINT = \"false\";\n 129→\ttry {\n 130→\t\tconst file = join(dir, \"pairing.json\");\n 131→\t\tconst { store, redeemed } = pairOne(file);\n 132→\t\tassert.equal(redeemed.fingerprint, undefined);\n 133→\t\tconst device = store.listDevices()[0];\n 134→\t\tassert.equal(\"fingerprint\" in (device as Record<string, unknown>), false);\n 135→\t\tassert.equal(\"keyChangedAt\" in (device as Record<string, unknown>), false);\n 136→\t\tassert.equal(\"fingerprint\" in readStore(file).devices[0]!, false);\n 137→\n 138→\t\t// 开关关着 → 不判键变更（回到本批之前的形态）：文件改坏也只按哈希自然失效。\n 139→\t\tconst tampered = readStore(file);\n 140→\t\ttampered.devices[0]!.tokenHash = createHash(\"sha256\").update(\"x\").digest(\"hex\");\n 141→\t\twriteFileSync(file, JSON.stringify(tampered, null, 2), \"utf8\");\n 142→\t\tconst reloaded = new PairingStore(file);\n 143→\t\tassert.equal(reloaded.listDevices()[0]?.keyChangedAt, undefined);\n 144→\t\tassert.equal(reloaded.verifyDeviceToken(redeemed.deviceToken), false);\n 145→\t} finally {\n 146→\t\tif (saved === undefined) delete process.env.PAIR_DEVICE_FINGERPRINT;\n 147→\t\telse process.env.PAIR_DEVICE_FINGERPRINT = saved;\n 148→\t\trmSync(dir, { recursive: true, force: true });\n 149→\t}\n 150→});\n 151→"
    },
