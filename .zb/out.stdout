  {
    "type": "function_call_result",
    "name": "Read",
    "callId": "call_00_ET_7I7QIyqSkKidC2VLm4GP7896",
    "status": "completed",
    "output": {
      "type": "text",
      "text": "   1→/**\n   2→ * 注入框架（2026-11-10 批 26b §二 / #7 批 A）。\n   3→ *\n   4→ * 背景：提示词注入目前散在两处——lifecycle 的 7 个 `sections[].render`（system 段，\n   5→ * 会进 durable 的 `pi.system`）与 beforeRequest 里 5 处 `extra.push({role:\"system\"})`\n   6→ * （每轮模型请求前临时拼）。这一层只做**收集 + 规范排序 + 去重 + 分流**，\n   7→ * 把\"有哪些注入、从哪来、多大\"变成可审计的清单；本批**只接管 `injection_guard` 一个**，\n   8→ * 其余 6 个 section 与 5 处 extra.push 一律不动（逐字节保持改造前形态）。\n   9→ *\n  10→ * 硬标准：接管后 `injection_guard` 的内容与位置与改造前逐字节一致——\n  11→ * section 仍留在 lifecycle `sections` 数组的原下标，`render` 改走本框架取回同一段\n  12→ * `INJECTION_GUARD` 实文。框架自身的 order 只用于框架内排序，不决定 section 的物理位置。\n  13→ */\n  14→\n  15→import { INJECTION_GUARD, injectionGuardEnabled } from \"./injection-guard.ts\";\n  16→\n  17→export type InjectionScope = \"session\" | \"once\" | \"turn\";\n  18→export type InjectionChannel = \"system\" | \"message\";\n  19→\n  20→export interface InjectionEntry {\n  21→\tid: string;\n  22→\ttext: string;\n  23→\torder: number;\n  24→\tscope: InjectionScope;\n  25→\tchannel: InjectionChannel;\n  26→}\n  27→\n  28→/**\n  29→ * 收集上下文。批 A 里 provider 都不读它，但框架要留这个口子给后续批次接会话级注入\n  30→ * （某会话要不要注、注哪一段）。只读、不下发客户端。\n  31→ */\n  32→export interface InjectionContext {\n  33→\tconversationId: number | string;\n  34→}\n  35→\n  36→export type InjectionProvider = (\n  37→\tctx: InjectionContext,\n  38→) => InjectionEntry | InjectionEntry[] | undefined;\n  39→\n  40→export interface CollectedInjections {\n  41→\tsystem: InjectionEntry[];\n  42→\tmessage: InjectionEntry[];\n  43→}\n  44→\n  45→function cmp(a: string, b: string): number {\n  46→\treturn a < b ? -1 : a > b ? 1 : 0;\n  47→}\n  48→\n  49→/**\n  50→ * 收集 → 规范排序 → 按 id 去重（后者覆盖）→ 按 channel 分流。\n  51→ *\n  52→ * 排序：`order` 升序；同 `order` 按 `id` 字典序；`order` 与 `id` 都相同时再按\n  53→ * `channel`/`scope`/`text` 补成全序——这样\"打乱 providers / 条目输入顺序\"输出也恒定，\n  54→ * 不会因稳定排序保留了输入顺序而让去重结果随输入抖。\n  55→ *\n  56→ * 去重（后者覆盖）：保留规范序里某 `id` **最后一次**出现的位置（后面覆盖前面），\n  57→ * 因此结果仍是有序的；同名 id 里 order / 字典序更大的那个胜出。\n  58→ */\n  59→export function collectInjections(\n  60→\tproviders: readonly InjectionProvider[],\n  61→\tctx: InjectionContext,\n  62→): CollectedInjections {\n  63→\tconst all: InjectionEntry[] = [];\n  64→\tfor (const provider of providers) {\n  65→\t\tconst result = provider(ctx);\n  66→\t\tif (result === undefined) continue;\n  67→\t\tif (Array.isArray(result)) all.push(...result);\n  68→\t\telse all.push(result);\n  69→\t}\n  70→\n  71→\tall.sort(\n  72→\t\t(a, b) =>\n  73→\t\t\ta.order - b.order ||\n  74→\t\t\tcmp(a.id, b.id) ||\n  75→\t\t\tcmp(a.channel, b.channel) ||\n  76→\t\t\tcmp(a.scope, b.scope) ||\n  77→\t\t\tcmp(a.text, b.text),\n  78→\t);\n  79→\n  80→\tconst lastIndexById = new Map<string, number>();\n  81→\tall.forEach((entry, index) => lastIndexById.set(entry.id, index));\n  82→\tconst deduped = all.filter((entry, index) => lastIndexById.get(entry.id) === index);\n  83→\n  84→\treturn {\n  85→\t\tsystem: deduped.filter((entry) => entry.channel === \"system\"),\n  86→\t\tmessage: deduped.filter((entry) => entry.channel === \"message\"),\n  87→\t};\n  88→}\n  89→\n  90→// ── 批 A 唯一接管的注入：injection_guard ───────────────────────────\n  91→/** section key / 注入 id，框架内统一用这个标识。 */\n  92→export const INJECTION_GUARD_ID = \"injection_guard\";\n  93→\n  94→/**\n  95→ * `injection_guard` provider：`AGENT_INJECTION_GUARD=false/0/off` 时返回 undefined，\n  96→ * 框架据此省略整段（与改造前 `render` 直接返回 undefined 逐字节一致）。\n  97→ */\n  98→export const guardProvider: InjectionProvider = () => {\n  99→\tif (!injectionGuardEnabled()) return undefined;\n 100→\treturn {\n 101→\t\tid: INJECTION_GUARD_ID,\n 102→\t\ttext: INJECTION_GUARD,\n 103→\t\t// 批 A 只有这一个 provider；order 只作框架内排序，section 物理位置由 lifecycle 数组下标决定。\n 104→\t\torder: 0,\n 105→\t\tscope: \"session\",\n 106→\t\tchannel: \"system\",\n 107→\t};\n 108→};\n 109→\n 110→/** 框架登记的注入源：`source` 是审计用的来源标识，不进正文、不下发正文。 */\n 111→export interface RegisteredInjection {\n 112→\tsource: string;\n 113→\tprovider: InjectionProvider;\n 114→}\n 115→\n 116→/** 批 A：只此一个。其余 section / extra.push 还没接管，绝不在这里冒名登记。 */\n 117→export const INJECTION_REGISTRY: readonly RegisteredInjection[] = [\n 118→\t{ source: INJECTION_GUARD_ID, provider: guardProvider },\n 119→];\n 120→\n 121→/**\n 122→ * 审计开关（默认开；显式 `false` 关，关时 `.../injections` 端点 404，一行回滚）。\n 123→ * 新开关净增类默认开，与仓库其它开关同口径。\n 124→ */\n 125→export function injectionAuditEnabled(env: NodeJS.ProcessEnv = process.env): boolean {\n 126→\treturn (env.AGENT_INJECTION_AUDIT ?? \"\").trim().toLowerCase() !== \"false\";\n 127→}\n 128→\n 129→export interface InjectionAuditRow {\n 130→\tid: string;\n 131→\tsource: string;\n 132→\tscope: InjectionScope;\n 133→\t/** 正文字符数；只回长度，不回正文。 */\n 134→\tlength: number;\n 135→}\n 136→\n 137→/**\n 138→ * 审计投影：对登记的每个源走一遍收集，产出 `{id, source, scope, length}`。\n 139→ * **绝不返回 `text` 或任何正文片段**——审计端点可以把这份数组原样下发。\n 140→ */\n 141→export function auditInjections(ctx: InjectionContext): InjectionAuditRow[] {\n 142→\tconst rows: InjectionAuditRow[] = [];\n 143→\tfor (const { source, provider } of INJECTION_REGISTRY) {\n 144→\t\tconst { system, message } = collectInjections([provider], ctx);\n 145→\t\tfor (const entry of [...system, ...message]) {\n 146→\t\t\trows.push({ id: entry.id, source, scope: entry.scope, length: entry.text.length });\n 147→\t\t}\n 148→\t}\n 149→\treturn rows;\n 150→}\n 151→"
    },
