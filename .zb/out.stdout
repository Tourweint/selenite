        "content": " 330→\t\treturn messagesStoreInstance.list(ticketId).map((message) => ({\n 331→\t\t\tdirection: message.direction,\n 332→\t\t\tfromKind: message.fromKind,\n 333→\t\t\tfromName: message.fromName,\n 334→\t\t\tbody: message.body,\n 335→\t\t\tcreatedAt: message.createdAt,\n 336→\t\t}));\n 337→\t} catch {\n 338→\t\treturn [];\n 339→\t}\n 340→}\n 341→\n 342→/** 看板列表行：只给界面需要的字段，不带 workRoot 绝对路径与 prompt 全文。 */\n 343→interface TicketSummary {\n 344→\tid: string;\n 345→\tprompt: string;\n 346→\tstatus: string;\n 347→\tdomain: string | null;\n 348→\tproject: string | null;\n 349→\ttotal: number;\n 350→\tpassed: number;\n 351→\temployee: string | null;\n 352→\tupdated_at: string;\n 353→\terror: string | null;\n 354→\tparentTicketId: string | null;\n 355→\tlastAction: string | null;\n 356→\tlastHeartbeat: string | null;\n 357→\twaitingOn: string | null;\n 358→\t/** 发起这张单的宿主对话（对外 uuid）；子单继承父单。查不到 → null。 */\n 359→\tconversationId: string | null;\n 360→\t/** 来源对话的显示标题：改过名用 chat-meta，否则首句 40 字。无来源/查不到 → null。 */\n 361→\tconversationTitle: string | null;\n 362→\t/** 负责这张单的总管名：ticket.options.domain → partners 表 name。直派/查不到 → null。 */\n 363→\tchiefName: string | null;\n 364→\t/** 作废位（扫尾批 1 A1）：harness 侧不再搬运这张单的结果。 */\n 365→\tcanceled: boolean;\n 366→\t/** 多副本归并（批 19 §五）：同一 requestId 的单共用这个值；没有 requestId → null。 */\n 367→\tgroupId: string | null;\n 368→\t/** 作废单显示 status=\"canceled\"，原始状态放在这里不丢事实。 */\n 369→\toriginStatus?: string;\n 370→}\n 371→\n 372→/**\n 373→ * 内部自增会话 id → 对外 uuid（2026-11-05）。\n 374→ *\n 375→ * ticket.json / 回执里存的是 durable 内部 id；接口对外只能给 uuid（对外 id 一律 uuid）。\n 376→ * 这里懒加载 agent，避免只读接口在启动/单测被导入时拉起整个运行时。\n 377→ */\n 378→function externalChatIdsLoader(): () => Promise<Map<number, string>> {\n 379→\tlet pending: Promise<Map<number, string>> | null = null;\n 380→\treturn () => {\n 381→\t\tpending ??= import(\"./agent.ts\")\n 382→\t\t\t.then((module) => module.externalChatIds())\n 383→\t\t\t.catch(() => new Map<number, string>());\n 384→\t\treturn pending;\n 385→\t};\n 386→}\n 387→\n 388→/**\n 389→ * 把 ticket.json / 回执里的来源会话值收敛成对外 uuid。\n 390→ * 非数字原样当 uuid（新单透传的就是宿主对话 id）；数字是内部 id，查映射；\n 391→ * 查不到（会话已不存在 / 旧进程没落映射）→ null，前端按\"无来源对话\"处理。\n 392→ */\n 393→async function resolveConversationId(\n 394→\traw: string | number | null | undefined,\n 395→\tloadExternal: () => Promise<Map<number, string>>,\n 396→): Promise<string | null> {\n 397→\tif (raw === null || raw === undefined) return null;\n 398→\tconst text = String(raw).trim();\n 399→\tif (!text) return null;\n 400→\tif (!/^\\d+$/.test(text)) return text;\n 401→\treturn (await loadExternal()).get(Number(text)) ?? null;\n 402→}\n 403→\n 404→/**\n 405→ * 来源对话取值顺序（2026-11-05）：新单看 ticket.json 的 originConversationId（含子单继承），\n 406→ * 历史单回查派单回执（receipts 只覆盖第一层，子单永远没有回执）。\n 407→ */\n 408→async function conversationIdOf(\n 409→\tticket: Ticket,\n 410→\tloadExternal: () => Promise<Map<number, string>>,\n 411→): Promise<string | null> {\n 412→\tlet raw: string | number | null | undefined = ticket.originConversationId;\n 413→\tif (raw === null || raw === undefined || raw === \"\") {\n 414→\t\ttry {\n 415→\t\t\traw = deadLetterStore().lookupByTicket(ticket.id)?.conversationId ?? null;\n 416→\t\t} catch {\n 417→\t\t\traw = null;\n 418→\t\t}\n 419→\t}\n 420→\treturn resolveConversationId(raw, loadExternal);\n 421→}\n 422→\n 423→/**\n 424→ * 对外 uuid → 显示标题（2026-11-05 L1）。\n 425→ *\n 426→ * 标题口径与手机端会话列表一致：`chat-meta` 里改过名的优先，否则用 `listChats` 的\n 427→ * firstText（首句前 40 字）。listChats 要逐会话 open，所以每次请求只建一次缓存；\n 428→ * 只有 chat-meta 没覆盖到的 id 才会触发它。\n 429→ */\n 430→function conversationTitlesLoader(\n 431→\tmaxChats: number,\n 432→): (conversationIds: Array<string | null>) => Promise<Map<string, string>> {\n 433→\tlet pendingNamed: Promise<Record<string, string>> | null = null;\n 434→\tlet pendingFirstText: Promise<Map<string, string>> | null = null;\n 435→\tconst namedOf = (): Promise<Record<string, string>> => {\n 436→\t\tpendingNamed ??= import(\"./agent.ts\")\n 437→\t\t\t.then((module) => module.chatTitles())\n 438→\t\t\t.catch(() => ({}));\n 439→\t\treturn pendingNamed;\n 440→\t};\n 441→\tconst firstTextOf = (): Promise<Map<string, string>> => {\n 442→\t\tpendingFirstText ??= import(\"./agent.ts\")\n 443→\t\t\t.then(async (module) => {\n 444→\t\t\t\tconst map = new Map<string, string>();\n 445→\t\t\t\tfor (const entry of await module.listChats(maxChats)) {\n 446→\t\t\t\t\tconst text = (entry.title ?? entry.firstText).trim();\n 447→\t\t\t\t\tif (text) map.set(entry.conversationId, text);\n 448→\t\t\t\t}\n 449→\t\t\t\treturn map;\n 450→",
