    "output": {
      "type": "text",
      "text": "  60→  <h1>让手机连上这台电脑</h1>\n  61→  <div class=\"card\">\n  62→    <img src=\"${options.dataUrl}\" alt=\"配对二维码\" />\n  63→    <div class=\"code\">${escapeHtml(extractCode(options.url))}</div>\n  64→    <div class=\"dim\">打开 App → 设置 → 扫一扫配对</div>\n  65→    <div class=\"dim\">这枚码 ${options.expiresInSeconds} 秒内有效，用一次就作废</div>\n  66→    <div class=\"url\">${name} · ${url}</div>\n  67→    <div class=\"row\">\n  68→      <button onclick=\"location.reload()\">换一枚</button>\n  69→      <span class=\"dim\" id=\"countdown\"></span>\n  70→    </div>\n  71→  </div>\n  72→  <div id=\"devices\"></div>\n  73→<script>\n  74→  var expire = ${options.expiresInSeconds};\n  75→  var left = expire;\n  76→  var el = document.getElementById('countdown');\n  77→  var timer = setInterval(function () {\n  78→    left -= 1;\n  79→    if (left <= 0) { clearInterval(timer); el.textContent = '已过期，点「换一枚」'; return; }\n  80→    el.textContent = left + ' 秒后失效';\n  81→  }, 1000);\n  82→\n  83→  // 带 token 打开时才是\"管理面\"：列出已配对设备并可撤销\n  84→  var token = new URLSearchParams(location.search).get('token');\n  85→  var box = document.getElementById('devices');\n  86→  if (token) {\n  87→    fetch('/api/v1/pair/devices', { headers: { 'Authorization': 'Bearer ' + token } })\n  88→      .then(function (r) { return r.ok ? r.json() : []; })\n  89→      .then(function (devices) {\n  90→        if (!devices.length) { box.innerHTML = '<div class=\"dim\">还没有已配对的设备</div>'; return; }\n  91→        devices.forEach(function (d) {\n  92→          var row = document.createElement('div');\n  93→          row.className = 'device';\n  94→          var label = document.createElement('span');\n  95→          label.textContent = d.name + (d.revokedAt ? '（已撤销）' : '') +\n  96→            ' · ' + new Date(d.createdAt).toLocaleString();\n  97→          row.appendChild(label);\n  98→          if (!d.revokedAt) {\n  99→            var btn = document.createElement('button');\n 100→            btn.className = 'ghost';\n 101→            btn.textContent = '撤销';\n 102→            btn.onclick = function () {\n 103→              fetch('/api/v1/pair/devices/' + d.id + '/revoke', {\n 104→                method: 'POST',\n 105→                headers: { 'Authorization': 'Bearer ' + token }\n 106→              }).then(function () { location.reload(); });\n 107→            };\n 108→            row.appendChild(btn);\n 109→          }\n 110→          box.appendChild(row);\n 111→        });\n 112→      })\n 113→      .catch(function () { box.innerHTML = '<div class=\"dim\">设备列表读取失败</div>'; });\n 114→  }\n 115→</script>\n 116→</body>\n 117→</html>`;\n 118→}\n 119→\n 120→function extractCode(pairUrl: string): string {\n 121→\tconst match = /[?&]code=([^&]+)/.exec(pairUrl);\n 122→\treturn match?.[1] ?? \"\";\n 123→}\n 124→"
    },
