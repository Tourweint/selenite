    "arguments": "{\"file_path\": \"D:\\\\Projects\\\\projects\\\\lh-b28\\\\ts\\\\apps\\\\server\\\\src\\\\agent\\\\session-search.ts\", \"old_string\": \"\\tif (query.length < 2) return null;\\n\\tconst options: SessionSearchOptions = {};\\n\\tconst days = raw.days === undefined ? undefined : Number(raw.days);\\n\\tconst limit = raw.limit === undefined ? undefined : Number(raw.limit);\\n\\tif (days !== undefined && Number.isFinite(days)) options.days = days;\\n\\tif (limit !== undefined && Number.isFinite(limit)) options.limit = limit;\\n\\treturn { query, options };\", \"new_string\": \"\\tif (query.length < 2) return null;\\n\\tconst options: SessionSearchOptions = {};\\n\\tconst daysRaw = raw.days?.trim();\\n\\tconst limitRaw = raw.limit?.trim();\\n\\tconst days = daysRaw ? Number(daysRaw) : undefined;\\n\\tconst limit = limitRaw ? Number(limitRaw) : undefined;\\n\\tif (days !== undefined && Number.isFinite(days)) options.days = days;\\n\\tif (limit !== undefined && Number.isFinite(limit)) options.limit = limit;\\n\\treturn { query, options };\"}",
