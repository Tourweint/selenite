live?.run?.taskId)}）工具回合达上限 ${MAX_TURNS}`,',\n'\\t\\t\\t\\t\\t\\t\\t);',\n'\\t\\t\\t\\t\\t\\t\\tif (used > MAX_TURNS + HARD_STOP_GRACE && !aborting.has(key)) {',\n'\\t\\t\\t\\t\\t\\t\\t\\taborting.add(key);',\n'\\t\\t\\t\\t\\t\\t\\t\\tconsole.warn(`[agent] 会话 ${api.conversationId} 无视上限，硬停这一轮`);',\n'\\t\\t\\t\\t\\t\\t\\t\\tvoid abortRun(api.conversationId);',\n'\\t\\t\\t\\t\\t\\t\\t}',\n'\\t\\t\\t\\t\\t\\t} else if (used === 1) {',\n'\\t\\t\\t\\t\\t\\t\\t// 新的一轮，把上一轮封掉的工具放开',\n'\\t\\t\\t\\t\\t\\t\\ttoolsBlocked.delete(api.conversationId);',\n'\\t\\t\\t\\t\\t\\t\\t// 防打转守卫同步清零（批次A A1）：判据按轮计，不跨轮累计',\n'\\t\\t\\t\\t\\t\\t\\tresetLoopGuard(api.conversationId);',\n'\\t\\t\\t\\t\\t\\t}',\n'',\n'\\t\\t\\t\\t\\t\\t// 5 处消息注入（2026-11-10 批 27 §三）：记忆召回 / 技能斜杠 / 恢复注记 /',\n'\\t\\t\\t\\t\\t\\t// 回合上限 / 执事轮上下文。框架负责排序与去重，装配处按收集结果**依次压入**，',\n'\\t\\t\\t\\t\\t\\t// 位置与改造前一致（仍是本轮模型请求最前面的几条 system 消息）。',\n'\\t\\t\\t\\t\\t\\t// 执事轮输入只在本轮第一次请求时算（used===1），provider 内照旧判定。',\n'\\t\\t\\t\\t\\t\\tconst extra = collectInjections(LIFECYCLE_MESSAGE_PROVIDERS, {',\n'\\t\\t\\t\\t\\t\\t\\tconversationId: api.conversationId,',\n'\\t\\t\\t\\t\\t\\t\\tturn: used,',\n'\\t\\t\\t\\t\\t\\t\\tuserText,',\n'\\t\\t\\t\\t\\t\\t}).message.map((item) => ({',\n'\\t\\t\\t\\t\\t\\t\\trole: \"system\" as const,',\n'\\t\\t\\t\\t\\t\\t\\tcontent: item.text,',\n'\\t\\t\\t\\t\\t\\t\\ttimestamp: Date.now(),',\n'\\t\\t\\t\\t\\t\\t}));',\n];\nlines.splice(922, 1037-922, ...body);\nfs.writeFileSync(p, lines.join('\\n'));\nconsole.log('spliced');\nEOF",
