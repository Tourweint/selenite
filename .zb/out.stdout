      "type": "text",
      "text": " 426→\t}\n 427→}\n 428→\n 429→type SectionInput = Parameters<NonNullable<PromptSection[\"render\"]>>[0];\n 430→\n 431→/** 会话种类快照（worker 分流用；读不到按 chief，与改造前同口径）。 */\n 432→async function chatKindOfSection(input: SectionInput): Promise<\"chief\" | \"worker\"> {\n 433→\tconst kinds = await input.read.snapshot(ChatKinds, CTX);\n 434→\treturn kinds?.byInternal?.[String(input.conversationId)] === \"worker\" ? \"worker\" : \"chief\";\n 435→}\n 436→\n 437→/** 群会话判定（档案读失败 → false，与改造前 try/catch 后按总管处理同口径）。 */\n 438→function groupOfSession(conversationId: number): boolean {\n 439→\tif (!COMPANIONS_ENABLED) return false;\n 440→\ttry {\n 441→\t\treturn partnersStore().isGroupSession(conversationId);\n 442→\t} catch {\n 443→\t\treturn false;\n 444→\t}\n 445→}\n 446→\n 447→export const LIFECYCLE_SECTIONS: readonly PromptSection[] = [\n 448→\t// 人格（2026-11-06 B2 分流）：非 chief 执事不注总管 persona；worker 用独立提示；\n 449→\t// chief / 无记录旧会话用 SOUL 快照，读不到回落 PERSONA。\n 450→\t{\n 451→\t\tkey: \"persona\",\n 452→\t\trender: async (input) => {\n 453→\t\t\tconst conversationId = Number(input.conversationId);\n 454→\t\t\tconst chatKind = await chatKindOfSection(input);\n 455→\t\t\treturn collectInjections([personaProvider], {\n 456→\t\t\t\tconversationId,\n 457→\t\t\t\tpartnerId: partnerOfSession(conversationId),\n 458→\t\t\t\tchatKind,\n 459→\t\t\t}).system[0]?.text;\n 460→\t\t},\n 461→\t},\n 462→\t// 验证铁律（2026-11-10 批 12 §一.1）：紧跟 persona，固定字节。\n 463→\t{\n 464→\t\tkey: \"verification_iron_law\",\n 465→\t\trender: (input) => {\n 466→\t\t\tconst conversationId = Number(input.conversationId);\n 467→\t\t\treturn collectInjections([verificationIronLawProvider], {\n 468→\t\t\t\tconversationId,\n 469→\t\t\t\tpartnerId: partnerOfSession(conversationId),\n 470→\t\t\t}).system[0]?.text;\n 471→\t\t},\n 472→\t},\n 473→\t// 开工前先问清（2026-11-10 批 19 §一）：只给总管 / 主对话。\n 474→\t{\n 475→\t\tkey: \"clarify_contract\",\n 476→\t\trender: async (input) => {\n 477→\t\t\tconst conversationId = Number(input.conversationId);\n 478→\t\t\tconst chatKind = await chatKindOfSection(input);\n 479→\t\t\treturn collectInjections([clarifyContractProvider], {\n 480→\t\t\t\tconversationId,\n 481→\t\t\t\tpartnerId: partnerOfSession(conversationId),\n 482→\t\t\t\tchatKind,\n 483→\t\t\t}).system[0]?.text;\n 484→\t\t},\n 485→\t},\n 486→\t// 注入防线（2026-11-09 T2）：固定字节；关掉时整段省略。\n 487→\t{\n 488→\t\tkey: \"injection_guard\",\n 489→\t\trender: (input) =>\n 490→\t\t\tcollectInjections([guardProvider], { conversationId: input.conversationId })\n 491→\t\t\t\t.system[0]?.text,\n 492→\t},\n 493→\t// 当前项目（2026-11-04 方案 §2.3）：每轮现渲染，不写进对话历史。\n 494→\t{\n 495→\t\tkey: \"current_project\",\n 496→\t\trender: (input) =>\n 497→\t\t\tcollectInjections([currentProjectProvider], { conversationId: input.conversationId })\n 498→\t\t\t\t.system[0]?.text,\n 499→\t},\n 500→\t// L1 技能索引（2026-10-31 方案 D5）：按会话冻结（provider 内部走 indexFor）。\n 501→\t{\n 502→\t\tkey: \"skills\",\n 503→\t\trender: (input) =>\n 504→\t\t\tcollectInjections([skillsProvider], { conversationId: input.conversationId })\n 505→\t\t\t\t.system[0]?.text,\n 506→\t},\n 507→\t// 课题（2026-11-07 §六）：每轮现渲染 + drainPendingPushes；只给总管主对话。\n 508→\t{\n 509→\t\tkey: \"topics\",\n 510→\t\trender: async (input) => {\n 511→\t\t\tconst conversationId = Number(input.conversationId);\n 512→\t\t\tconst chatKind = await chatKindOfSection(input);\n 513→\t\t\treturn collectInjections([topicsProvider], {\n 514→\t\t\t\tconversationId,\n 515→\t\t\t\tpartnerId: partnerOfSession(conversationId),\n 516→\t\t\t\tgroup: groupOfSession(conversationId),\n 517→\t\t\t\tchatKind,\n 518→\t\t\t}).system[0]?.text;\n 519→\t\t},\n 520→\t},\n 521→];\n 522→\n 523→async function openHarness(): Promise<Harness> {\n 524→\tconst config = readLlmConfig();\n 525→\tif (!config) throw new Error(\"LLM 未配置：设 LLM_API_KEY 之后再启动\");\n 526→"
