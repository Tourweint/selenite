      "type": "text",
      "text": "   1→import assert from \"node:assert/strict\";\n   2→import { test } from \"node:test\";\n   3→import {\n   4→\tAUX_USES,\n   5→\tauxPinnedModelId,\n   6→\tauxiliaryEnabled,\n   7→\tauxiliaryModel,\n   8→} from \"./auxiliary.ts\";\n   9→\n  10→/**\n  11→ * 杂活模型解析（2026-11-10 批 20 §二）。\n  12→ *\n  13→ * 这里钉的是\"配了怎么解析、没配怎么回落、配错了怎么办\"——不测真模型调用\n  14→ * （那在 `memory-extract.ts` 的装配层，且需要真上游）。\n  15→ */\n  16→\n  17→const CURRENT = { provider: \"bailian\", modelId: \"big-model\" };\n  18→\n  19→/** 两个供应商：同名模型只出现在第二个供应商里（验证跨供应商解析） */\n  20→function fakeModels(): {\n  21→\tgetModel(provider: string, id: string): unknown;\n  22→\tgetProviders(): readonly { id: string }[];\n  23→} {\n  24→\tconst catalog: Record<string, string[]> = {\n  25→\t\tbailian: [\"big-model\", \"small-model\"],\n  26→\t\tother: [\"tiny-model\"],\n  27→\t};\n  28→\treturn {\n  29→\t\tgetModel(provider, id) {\n  30→\t\t\treturn catalog[provider]?.includes(id) ? { id } : undefined;\n  31→\t\t},\n  32→\t\tgetProviders() {\n  33→\t\t\treturn Object.keys(catalog).map((id) => ({ id }));\n  34→\t\t},\n  35→\t};\n  36→}\n  37→\n  38→test(\"总开关：默认开，只有显式 false 才关\", () => {\n  39→\tassert.equal(auxiliaryEnabled({}), true);\n  40→\tassert.equal(auxiliaryEnabled({ AUX_LLM: \"\" }), true);\n  41→\tassert.equal(auxiliaryEnabled({ AUX_LLM: \"true\" }), true);\n  42→\tassert.equal(auxiliaryEnabled({ AUX_LLM: \"0\" }), true, \"默认开口径只认 false\");\n  43→\tassert.equal(auxiliaryEnabled({ AUX_LLM: \"FALSE\" }), false);\n  44→});\n  45→\n  46→test(\"pin 变量名按用途大写；没配 / 空白 → null\", () => {\n  47→\tassert.equal(auxPinnedModelId(\"extract\", {}), null);\n  48→\tassert.equal(auxPinnedModelId(\"extract\", { AUX_MODEL_EXTRACT: \"  \" }), null);\n  49→\tassert.equal(\n  50→\t\tauxPinnedModelId(\"extract\", { AUX_MODEL_EXTRACT: \" small-model \" }),\n  51→\t\t\"small-model\",\n  52→\t);\n  53→\tassert.equal(auxPinnedModelId(\"title\", { AUX_MODEL_TITLE: \"t\" }), \"t\");\n  54→\tassert.deepEqual([...AUX_USES], [\"title\", \"compact\", \"review\", \"extract\"]);\n  55→});\n  56→\n  57→test(\"没有当前模型 → null（不编一个路由）\", () => {\n  58→\tassert.equal(auxiliaryModel(\"extract\", { current: null, env: {} }), null);\n  59→});\n  60→\n  61→test(\"没 pin / 关掉总开关 → 当前会话模型（行为不变）\", () => {\n  62→\tassert.deepEqual(\n  63→\t\tauxiliaryModel(\"extract\", { current: CURRENT, env: {}, models: fakeModels() }),\n  64→\t\tCURRENT,\n  65→\t);\n  66→\tassert.deepEqual(\n  67→\t\tauxiliaryModel(\"extract\", {\n  68→\t\t\tcurrent: CURRENT,\n  69→\t\t\tenv: { AUX_LLM: \"false\", AUX_MODEL_EXTRACT: \"small-model\" },\n  70→\t\t\tmodels: fakeModels(),\n  71→\t\t}),\n  72→\t\tCURRENT,\n  73→\t\t\"AUX_LLM=false 时 pin 也不生效\",\n  74→\t);\n  75→});\n  76→\n  77→test(\"pin 命中当前供应商 → 同供应商换模型\", () => {\n  78→\tassert.deepEqual(\n  79→\t\tauxiliaryModel(\"extract\", {\n  80→\t\t\tcurrent: CURRENT,\n  81→\t\t\tenv: { AUX_MODEL_EXTRACT: \"small-model\" },\n  82→\t\t\tmodels: fakeModels(),\n  83→\t\t}),\n  84→\t\t{ provider: \"bailian\", modelId: \"small-model\" },\n  85→\t);\n  86→});\n  87→\n  88→test(\"pin 只在别的供应商里有 → 用那个供应商\", () => {\n  89→\tassert.deepEqual(\n  90→\t\tauxiliaryModel(\"title\", {\n  91→\t\t\tcurrent: CURRENT,\n  92→\t\t\tenv: { AUX_MODEL_TITLE: \"tiny-model\" },\n  93→\t\t\tmodels: fakeModels(),\n  94→\t\t}),\n  95→\t\t{ provider: \"other\", modelId: \"tiny-model\" },\n  96→\t);\n  97→});\n  98→\n  99→test(\"pin 不在目录里 → 回落当前模型（不静默换路由）\", () => {\n 100→\tassert.deepEqual(\n 101→\t\tauxiliaryModel(\"extract\", {\n 102→\t\t\tcurrent: CURRENT,\n 103→\t\t\tenv: { AUX_MODEL_EXTRACT: \"no-such-model\" },\n 104→\t\t\tmodels: fakeModels(),\n 105→\t\t}),\n 106→\t\tCURRENT,\n 107→\t);\n 108→});\n 109→\n 110→/**\n 111→ * 已接线的两处（2026-11-10 批 23b §三）：`extract`（偏好抽取）与 `review`（记忆整理建议）。\n 112→ * 配了 `AUX_MODEL_<USE>` 就返回该模型；没配回落当前会话模型。\n 113→ * `compact` 不在列：内核 `Conversation.compact()` 不收模型，没法接；`title` 当前没有自动标题。\n 114→ */\n 115→test(\"已接用途：pin 了用 pin 的模型，没配回落当前模型\", () => {\n 116→\tfor (const use of [\"extract\", \"review\"] as const) {\n 117→\t\tassert.deepEqual(\n 118→\t\t\tauxiliaryModel(use, {\n 119→\t\t\t\tcurrent: CURRENT,\n 120→\t\t\t\tenv: { [`AUX_MODEL_${use.toUpperCase()}`]: \"small-model\" },\n 121→\t\t\t\tmodels: fakeModels(),\n 122→\t\t\t}),\n 123→\t\t\t{ provider: \"bailian\", modelId: \"small-model\" },\n 124→\t\t\t`${use} 应当用 pin 的模型`,\n 125→\t\t);\n 126→\t\tassert.deepEqual(\n 127→\t\t\tauxiliaryModel(use, { current: CURRENT, env: {}, models: fakeModels() }),\n 128→\t\t\tCURRENT,\n 129→\t\t\t`${use} 没配时应回落当前模型`,\n 130→\t\t);\n 131→\t}\n 132→});\n 133→\n 134→/**\n 135→ * compact（2026-11-10 批 26b §一）：内核 `Conversation.compact()` 不收模型参数，\n 136→ * 所以 `compact` 用途**接不进压缩调用**；但这一层的解析必须照常工作——配了返回 pin 的\n 137→ * 模型、没配回落当前模型，绝不静默失效（未生效的事实由 startChatCompaction 记日志）。\n 138→ */\n 139→test(\"compact 用途能解析：配了返回 pin 的模型，没配回落当前模型\", () => {\n 140→\tassert.deepEqual(\n 141→\t\tauxiliaryModel(\"compact\", {\n 142→\t\t\tcurrent: CURRENT,\n 143→\t\t\tenv: { AUX_MODEL_COMPACT: \"small-model\" },\n 144→\t\t\tmodels: fakeModels(),\n 145→\t\t}),\n 146→\t\t{ provider: \"bailian\", modelId: \"small-model\" },\n 147→\t);\n 148→\tassert.deepEqual(\n 149→\t\tauxiliaryModel(\"compact\", { current: CURRENT, env: {}, models: fakeModels() }),\n 150→\t\tCURRENT,\n 151→\t);\n 152→});\n 153→"
    },
