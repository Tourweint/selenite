        "content": "   1→/**\n   2→ * 旧会话定点找回（2026-11-10 批 20 §四，只做后端）。\n   3→ *\n   4→ * `recall_sessions`（批 11）能给 snippet，但要\"从旧会话某一处往回看\"就得有下标寻址。\n   5→ * transcript 没有 seq 字段（前置勘察确认），所以这里用**消息数组下标**（从 0 开始）：\n   6→ *   `GET .../context?aroundIndex=<n>&radius=5`\n   7→ * 返回该条前后各 `radius` 条（含角色与时间），并带上 `total` 让人知道边界。\n   8→ *\n   9→ * 不碰内核（不为这个加 seq）、不做界面、不做 fork。\n  10→ */\n  11→\n  12→import type { TranscriptMessage } from \"./agent/session.ts\";\n  13→\n  14→/** 默认半径（前后各 5 条） */\n  15→export const CONTEXT_DEFAULT_RADIUS = 5;\n  16→/** 上限：一次最多看 50 条（前端一次也展示不了更多） */\n  17→export const CONTEXT_MAX_RADIUS = 50;\n  18→\n  19→/** 回滚开关：默认开；只有显式 `false` 才关（关 = 端点 404）。 */\n  20→export function chatContextLookupEnabled(env: NodeJS.ProcessEnv = process.env): boolean {\n  21→\treturn (env.CHAT_CONTEXT_LOOKUP ?? \"\").trim().toLowerCase() !== \"false\";\n  22→}\n  23→\n  24→/** `radius` 解析：未传 = 5；必须是 0–50 的整数，否则 null（调用方 400）。 */\n  25→export function parseContextRadius(raw: string | undefined): number | null {\n  26→\tif (raw === undefined || raw.trim() === \"\") return CONTEXT_DEFAULT_RADIUS;\n  27→\tconst value = Number(raw);\n  28→\tif (!Number.isInteger(value) || value < 0 || value > CONTEXT_MAX_RADIUS) return null;\n  29→\treturn value;\n  30→}\n  31→\n  32→/** `aroundIndex` 解析：必须是非负整数；缺省 / 非法 → null。 */\n  33→export function parseAroundIndex(raw: string | undefined): number | null {\n  34→\tif (raw === undefined || raw.trim() === \"\") return null;\n  35→\tconst value = Number(raw);\n  36→\tif (!Number.isInteger(value) || value < 0) return null;\n  37→\treturn value;\n  38→}\n  39→\n  40→export interface ContextSlice<T> {\n  41→\t/** 第一条的绝对下标（含） */\n  42→\tfrom: number;\n  43→\t/** 最后一条的绝对下标（含）；空窗口为 -1 */\n  44→\tto: number;\n  45→\tmessages: T[];\n  46→}\n  47→\n  48→/**\n  49→ * 以 `aroundIndex` 为中心切窗口（含两端）。\n  50→ *\n  51→ * 调用方已确认 `0 <= aroundIndex < messages.length`。窗口在边界处自然截断，\n  52→ * `from` / `to` 是**真实下标**——客户端据此知道\"上面还有 / 下面还有\"。\n  53→ */\n  54→export function sliceAroundIndex<T>(\n  55→\tmessages: T[],\n  56→\taroundIndex: number,\n  57→\tradius: number,\n  58→): ContextSlice<T> {\n  59→\tif (messages.length === 0) return { from: 0, to: -1, messages: [] };\n  60→\tconst from = Math.max(0, aroundIndex - radius);\n  61→\tconst to = Math.min(messages.length - 1, aroundIndex + radius);\n  62→\treturn { from, to, messages: messages.slice(from, to + 1) };\n  63→}\n  64→\n  65→/** 响应里的单条消息：只给角色 / 时间 / 正文 / 绝对下标（图片与步骤不在这里回放）。 */\n  66→export interface ContextMessage {\n  67→\trole: \"user\" | \"assistant\";\n  68→\ttext: string;\n  69→\tat: number;\n  70→\tindex: number;\n  71→\t/** user 消息的可寻址 id（与 §2.2 同源；assistant 没有） */\n  72→\tid?: string;\n  73→}\n  74→\n  75→export function contextMessageOf(\n  76→\tmessage: TranscriptMessage,\n  77→\tindex: number,\n  78→): ContextMessage {\n  79→\treturn {\n  80→\t\trole: message.role,\n  81→\t\ttext: message.text,\n  82→\t\tat: message.at,\n  83→\t\tindex,\n  84→\t\t...(message.id ? { id: message.id } : {}),\n  85→\t};\n  86→}\n  87→",
