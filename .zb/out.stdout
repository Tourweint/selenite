      "text": "   1→import assert from \"node:assert/strict\";\n   2→import { join } from \"node:path\";\n   3→import { tmpdir } from \"node:os\";\n   4→import test from \"node:test\";\n   5→import { createTools } from \"../tools.ts\";\n   6→import {\n   7→\tSNIPPET_MAX_CHARS,\n   8→\trecallSessionsEnabled,\n   9→\tsearchSessions,\n  10→\tsearchTranscriptLines,\n  11→\ttype SessionReader,\n  12→\ttype TranscriptSource,\n  13→} from \"./session-search.ts\";\n  14→\n  15→/**\n  16→ * 会话考古（2026-11-09 T4 §4）单测。\n  17→ *\n  18→ * 两段：\n  19→ *   1. 纯检索核心：跨两个会话命中、snippet 截断、days/limit、无命中空数组、snippet 打码；\n  20→ *   2. durable 适配层（假 reader）：任务专线/b 也纳入、标题取首句；外加条件注册开关。\n  21→ *\n  22→ * 不真起 durable，不碰真实 .data。\n  23→ */\n  24→\n  25→const DAY = 86_400_000;\n  26→const NOW = new Date(\"2026-11-09T12:00:00.000Z\").getTime();\n  27→\n  28→function source(id: string, title: string, lines: TranscriptSource[\"lines\"]): TranscriptSource {\n  29→\treturn { conversationId: id, title, lines };\n  30→}\n  31→\n  32→test(\"会话考古：跨两个会话命中两条，snippet ≤200 且包含命中词\", () => {\n  33→\tconst longLine = `${\"甲\".repeat(150)}马拉松${\"乙\".repeat(150)}`;\n  34→\tconst hits = searchTranscriptLines(\n  35→\t\t[\n  36→\t\t\tsource(\"conv-a\", \"跑步计划\", [\n  37→\t\t\t\t{ role: \"user\", text: longLine, at: NOW - 2 * DAY },\n  38→\t\t\t\t{ role: \"assistant\", text: \"那我们先把每周三次定下来\", at: NOW - 2 * DAY + 1000 },\n  39→\t\t\t]),\n  40→\t\t\tsource(\"conv-b\", \"群聊\", [\n  41→\t\t\t\t{ role: \"user\", text: \"马拉松报名截止日是月底，别忘了\", at: NOW - 1 * DAY },\n  42→\t\t\t]),\n  43→\t\t],\n  44→\t\t\"马拉松\",\n  45→\t\t{},\n  46→\t\tNOW,\n  47→\t);\n  48→\n  49→\tassert.equal(hits.length, 2, \"两个会话各命中一条\");\n  50→\tassert.deepEqual(\n  51→\t\tnew Set(hits.map((hit) => hit.conversationId)),\n  52→\t\tnew Set([\"conv-a\", \"conv-b\"]),\n  53→\t\t\"跨会话都命中\",\n  54→\t);\n  55→\tfor (const hit of hits) {\n  56→\t\tassert.ok(hit.snippet.length <= SNIPPET_MAX_CHARS, `snippet 不得超过 200 字：${hit.snippet.length}`);\n  57→\t\tassert.ok(hit.snippet.includes(\"马拉松\"), \"snippet 应包含命中词\");\n  58→\t}\n  59→\t// 长句两边都够 100 字：正好裁到 200，且命中词前面留了约 100 字\n  60→\tconst long = hits.find((hit) => hit.conversationId === \"conv-a\")!;\n  61→\tassert.equal(long.snippet.length, 200, \"长文命中应裁满 200 字\");\n  62→\tassert.equal(long.snippet.indexOf(\"马拉松\"), 100, \"命中词前应留 100 字\");\n  63→\tassert.equal(hits[0]!.conversationId, \"conv-b\", \"结果按时间倒序（新的在前）\");\n  64→});\n  65→\n  66→test(\"会话考古：days / limit 生效；无命中返回空数组\", () => {\n  67→\tconst old = \"很久以前聊过的旧事\";\n  68→\tconst sources = [\n  69→\t\tsource(\"conv-a\", \"旧会话\", [{ role: \"user\", text: old, at: NOW - 40 * DAY }]),\n  70→\t\tsource(\"conv-b\", \"新会话\", [{ role: \"user\", text: \"旧事重提一下\", at: NOW - 1 * DAY }]),\n  71→\t];\n  72→\n  73→\tassert.equal(searchTranscriptLines(sources, \"旧事\", {}, NOW).length, 1, \"默认 30 天只给新的那条\");\n  74→\tconst wider = searchTranscriptLines(sources, \"旧事\", { days: 60 }, NOW);\n  75→\tassert.equal(wider.length, 2, \"days=60 应把 40 天前的也捞回来\");\n  76→\n  77→\tconst limited = searchTranscriptLines(sources, \"旧事\", { days: 60, limit: 1 }, NOW);\n  78→\tassert.equal(limited.length, 1, \"limit 生效\");\n  79→\tassert.equal(limited[0]!.conversationId, \"conv-b\", \"limit 截断保留最新的\");\n  80→\n  81→\tassert.deepEqual(searchTranscriptLines(sources, \"量子纠缠\", {}, NOW), [], \"无命中返回空数组\");\n  82→\tassert.deepEqual(searchTranscriptLines(sources, \"旧\", {}, NOW), [], \"短于 2 字不发散\");\n  83→});\n  84→\n  85→test(\"会话考古：snippet 出模型前打码\", () => {\n  86→\tconst hits = searchTranscriptLines(\n  87→\t\t[\n  88→\t\t\tsource(\"conv-a\", \"配置\", [\n  89→\t\t\t\t{ role: \"user\", text: \"报名表在共享盘，api_key=abcdef123456 别外传\", at: NOW - DAY },\n  90→\t\t\t]),\n  91→\t\t],\n  92→\t\t\"报名表\",\n  93→\t\t{},\n  94→\t\tNOW,\n  95→\t);\n  96→\tassert.equal(hits.length, 1);\n  97→\tassert.ok(hits[0]!.snippet.includes(\"«redacted»\"), \"凭据应被打码\");\n  98→\tassert.ok(!hits[0]!.snippet.includes(\"abcdef123456\"), \"凭据值不应出现在 snippet 里\");\n  99→});\n 100→\n 101→test(\"会话考古：读全部会话（含 task- 专线），标题没有改名时取首句\", async () => {\n 102→\t// 不读真实 .data/chat-meta.json\n 103→\tprocess.env.AGENT_CHAT_META_PATH = join(tmpdir(), \"lifediary-no-such-chat-meta.json\");\n 104→\n 105→\tconst entry = (kind: \"pi.user\" | \"pi.assistant\", text: string, at: number) => ({\n 106→\t\tkind,\n 107→\t\tmodel: [{ role: kind === \"pi.user\" ? \"user\" : \"assistant\", content: [{ type: \"text\", text }], timestamp: at }],\n 108→\t});\n 109→\tconst reader: SessionReader = {\n 110→\t\tasync snapshot() {\n 111→\t\t\treturn { byExternal: { \"conv-main\": 1, \"task-T-9\": 2 } };\n 112→\t\t},\n 113→\t\tasync conversation(id: never) {\n 114→\t\t\tconst entries =\n 115→\t\t\t\tNumber(id) === 1\n 116→\t\t\t\t\t? [entry(\"pi.user\", \"周末去爬山吧\", NOW - 2 * DAY)]\n 117→\t\t\t\t\t: [entry(\"pi.user\", \"整理纪要：爬山装备清单\", NOW - 1 * DAY)];\n 118→\t\t\treturn { context: async () => ({ entries }) } as never;\n 119→\t\t},\n 120→\t};\n 121→\n 122→\tconst hits = await searchSessions(reader, \"爬山\", {}, NOW);\n 123→\tassert.equal(hits.length, 2, \"普通会话与任务专线都在检索范围内\");\n 124→\tconst task = hits.find((hit) => hit.conversationId === \"task-T-9\");\n 125→\tassert.ok(task, \"任务专线应被命中\");\n 126→\tassert.equal(task!.title, \"整理纪要：爬山装备清单\", \"没有改名时标题取首句\");\n 127→\tassert.ok(hits.some((hit) => hit.conversationId === \"conv-main\"));\n 128→});\n 129→\n 130→test(\"会话考古：开关与条件注册（不传 = 工具不上架）\", () => {\n 131→\tassert.equal(recallSessionsEnabled({}), true, \"缺省开\");\n 132→\tassert.equal(recallSessionsEnabled({ AGENT_RECALL_SESSIONS: \"false\" }), false, \"false 关\");\n 133→\tassert.equal(recallSessionsEnabled({ AGENT_RECALL_SESSIONS: \"0\" }), false, \"0 关\");\n 134→\tassert.equal(recallSessionsEnabled({ AGENT_RECALL_SESSIONS: \"off\" }), false, \"off 关\");\n 135→\n 136→\tconst base = { memory: null, scopeOf: () => ({ type: \"global\" as const }), delegate: false };\n 137→\tconst withTool = createTools({ ...base, recallSessions: async () => [] });\n 138→\tassert.ok(withTool.some((tool) => tool.name === \"recall_sessions\"), \"注入后工具应上架\");\n 139→\tconst without = createTools({ ...base, recallSessions: null });\n 140→\tassert.ok(!without.some((tool) => tool.name === \"recall_sessions\"), \"不注入则不上架（回滚形态）\");\n 141→});\n 142→"
    },
