      "text": "10436→             <button type=\"button\" data-policy=\"no-shell\" aria-checked=\"false\">不跑命令</button>\n10437→           </div>`,\n10438→        )}\n10439→        <div class=\"divider\"></div>\n10440→        ${rowMarkup(\n10441→          \"审批档\",\n10442→          \"全部问我 = 改文件 / 跑命令 / 派活前都问一句；只问重要的 = 只拦命令执行、派活等会起执行的动作；全不问 = 直接做。审批会直接弹在界面右下角，不用来这里找。\",\n10443→          `<div class=\"segmented slide\" role=\"radiogroup\" aria-label=\"审批档\" id=\"policy-approval-level\">\n10444→             <button type=\"button\" data-approval=\"ask-all\" aria-checked=\"false\">全部问我</button>\n10445→             <button type=\"button\" data-approval=\"ask-critical\" aria-checked=\"false\">只问重要的</button>\n10446→             <button type=\"button\" data-approval=\"none\" aria-checked=\"false\">全不问</button>\n10447→           </div>`,\n10448→        )}\n10449→        <div class=\"divider\"></div>\n10450→        ${rowMarkup(\n10451→          \"自主轮（观察与审批）\",\n10452→          \"在 设置 → 服务 → 高级开关 里改；这里只读显示当前状态。\",\n10453→          `<span class=\"kv\" id=\"policy-autonomy\">…</span>`,\n10454→        )}\n10455→      </div>`,\n10456→    )}`;\n10457→\n10458→    wireSettingsSearch();\n10459→    const sendSwitch = el.settingsInner.querySelector(\"[data-send-key-switch]\");\n10460→    sendSwitch?.addEventListener(\"click\", () => {\n10461→      const next = sendSwitch.getAttribute(\"aria-checked\") !== \"true\";\n10462→      sendSwitch.setAttribute(\"aria-checked\", String(next));\n10463→      localStorage.setItem(KEY_SEND, next ? \"enter\" : \"mod-enter\");\n10464→    });\n10465→    const actsSwitch = el.settingsInner.querySelector(\"[data-acts-switch]\");\n10466→    actsSwitch?.addEventListener(\"click\", () => {\n10467→      const next = actsSwitch.getAttribute(\"aria-checked\") !== \"true\";\n10468→      actsSwitch.setAttribute(\"aria-checked\", String(next));\n10469→      localStorage.setItem(KEY_ACTS, next ? \"1\" : \"0\");\n10470→      applyActPref();\n10471→    });\n10472→    document.getElementById(\"restore-chats\")?.addEventListener(\"click\", async () => {\n10473→      await request(\"/api/v1/agent/chats/restore\", { method: \"POST\" }).catch(() => undefined);\n10474→      await loadChats();\n10475→      void renderSettings();\n10476→    });\n10477→    document\n10478→      .getElementById(\"settings-export-all\")\n10479→      ?.addEventListener(\"click\", () => void exportAllData());\n10480→    void loadPolicy();\n10481→    void loadAutonomySwitch();\n10482→    void refreshApprovalPopups();\n10483→  } else if (page === \"projects\") {\n10484→    // 2026-11-05 G1：卡片补内衬（p-4 / sm:p-6），主项目/子项目/待确认三段分开；\n10485→    // 带目录选择器（壳内系统对话框、壳外只留手输）。\n10486→    el.settingsInner.innerHTML = `${sectionMarkup(\n10487→      \"主项目\",\n10488→      `<div class=\"card\">\n10489→        <div class=\"set-card-body\" id=\"workspace-card\">\n10490→          <div class=\"set-hint\">读取中…</div>\n10491→        </div>\n10492→      </div>`,\n10493→    )}\n10494→    ${sectionMarkup(\n10495→      \"子项目\",\n10496→      `<div class=\"card\">\n10497→        <div class=\"set-card-body\">\n10498→          <div class=\"set-card-head\">\n10499→            <div class=\"row-main\">\n10500→              <div class=\"set-card-title\" data-tip=\"派活时从这里选；目录丢了、或跑出当前工作区，会标出来。\">已登记的项目</div>\n10501→            </div>\n10502→            <button class=\"btn-primary\" type=\"button\" id=\"project-add\">\n10503→              <svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg>\n10504→              添加子项目\n10505→            </button>\n10506→          </div>\n10507→          <div class=\"proj-list\" id=\"project-list\">\n10508→            <div class=\"set-hint\">读取中…</div>\n10509→          </div>\n10510→        </div>\n10511→      </div>`,\n10512→    )}\n10513→    ${sectionMarkup(\n10514→      \"待确认的请求\",\n10515→      `<div class=\"card\">\n10516→        <div class=\"set-card-body\" id=\"proposal-list\">\n10517→          <div class=\"set-hint\">读取中…</div>\n10518→        </div>\n10519→      </div>`,\n10520→    )}`;\n10521→    document.getElementById(\"project-add\")?.addEventListener(\"click\", () => openAddSubprojectModal());\n10522→    void loadProjectsSettings();\n10523→  } else if (page === \"reminders\") {\n10524→    // E2 #4：只读列表顶部加「加一条」行，直接 POST /agent/reminders（不经过模型）。\n10525→    // 骨架建一次；loadReminders 只重填 #reminder-card，输入值不会被重建冲掉。\n10526→"
