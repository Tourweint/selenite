      "text": " 490→\t\t\tname = null;\n 491→\t\t}\n 492→\t\tcache.set(key, name);\n 493→\t\treturn name;\n 494→\t};\n 495→}\n 496→\n 497→async function summarizeTickets(\n 498→\trunsDir: string,\n 499→\tdomain: string | null,\n 500→\tlimit: number,\n 501→\tloadExternal: () => Promise<Map<number, string>>,\n 502→\tloadTitles: (conversationIds: Array<string | null>) => Promise<Map<string, string>>,\n 503→\tchiefNameOf: (domain: string | null | undefined) => string | null,\n 504→\tcanceledIds: Set<string>,\n 505→): Promise<TicketSummary[]> {\n 506→\tconst store = new Store(runsDir);\n 507→\ttry {\n 508→\t\tconst rows = store.listTickets(limit).map((row: TicketRow) => ({\n 509→\t\t\trow,\n 510→\t\t\tticket: readTicketJson(runsDir, row.id),\n 511→\t\t}));\n 512→\t\tconst summaries = await Promise.all(\n 513→\t\t\trows.map(async ({ row, ticket }) => ({\n 514→\t\t\t\tid: row.id,\n 515→\t\t\t\tprompt: row.prompt,\n 516→\t\t\t\tstatus: row.status,\n 517→\t\t\t\tdomain,\n 518→\t\t\t\tproject: ticket?.options.project?.name ?? null,\n 519→\t\t\t\ttotal: row.total,\n 520→\t\t\t\tpassed: row.passed,\n 521→\t\t\t\temployee: row.employee,\n 522→\t\t\t\tupdated_at: ticket?.updated_at ?? ticket?.created_at ?? \"\",\n 523→\t\t\t\terror: ticket?.error ?? null,\n 524→\t\t\t\tparentTicketId: ticket?.parentTicketId ?? null,\n 525→\t\t\t\t// 2026-11-04：近况字段落盘在 ticket.json，列表与详情都必须能直接看到。\n 526→\t\t\t\tlastAction: ticket?.lastAction ?? null,\n 527→\t\t\t\tlastHeartbeat: ticket?.lastHeartbeat ?? null,\n 528→\t\t\t\twaitingOn: ticket?.waitingOn ?? null,\n 529→\t\t\t\tconversationId: ticket ? await conversationIdOf(ticket, loadExternal) : null,\n 530→\t\t\t\tchiefName: chiefNameOf(ticket?.options.domain),\n 531→\t\t\t\t// 多副本归并（批 19 §五）：requestId 就是 groupId；开关关 / 没 requestId → null。\n 532→\t\t\t\tgroupId: fanoutGroupEnabled()\n 533→\t\t\t\t\t? String(ticket?.idempotencyKey ?? \"\").trim() || null\n 534→\t\t\t\t\t: null,\n 535→\t\t\t})),\n 536→\t\t);\n 537→\t\t// 标题只用本请求出现过的 conversationId 批量查一次（listChats 逐会话 open，不能逐行调）。\n 538→\t\tconst titles = await loadTitles(summaries.map((summary) => summary.conversationId));\n 539→\t\treturn summaries.map((summary) =>\n 540→\t\t\tapplyCancelProjection(\n 541→\t\t\t\t{\n 542→\t\t\t\t\t...summary,\n 543→\t\t\t\t\tconversationTitle: summary.conversationId\n 544→\t\t\t\t\t\t? titles.get(summary.conversationId) ?? null\n 545→\t\t\t\t\t\t: null,\n 546→\t\t\t\t},\n 547→\t\t\t\t// 作废位投影：status 显示成 canceled，原始状态留在 originStatus。\n 548→\t\t\t\t// 没作废的单也带 canceled:false（纯增量，老客户端按字段忽略即可）。\n 549→\t\t\t\tcanceledIds.has(summary.id),\n 550→\t\t\t),\n 551→\t\t);\n 552→\t} catch {\n 553→\t\treturn [];\n 554→\t} finally {\n 555→\t\tstore.close();\n 556→\t}\n 557→}\n 558→\n 559→function readTicketJson(runsDir: string, ticketId: string): Ticket | null {\n 560→\ttry {\n 561→\t\treturn JSON.parse(\n 562→\t\t\tfs.readFileSync(path.join(runsDir, ticketId, \"ticket.json\"), \"utf8\"),\n 563→\t\t) as Ticket;\n 564→\t} catch {\n 565→\t\treturn null;\n 566→\t}\n 567→}\n 568→\n 569→/**\n 570→ * 裁判记录读口（批 19 §四）：judge.json 是 chancellor 落盘的审计事实，宿主管道只读。\n 571→ * 文件缺失 / 坏 JSON → 空数组（老单没有裁判，不是错误）。\n 572→ */\n 573→function judgeCallsOfTicket(store: Store, ticketId: string): Array<{\n 574→\tround?: unknown;\n 575→\tverdict?: unknown;\n 576→\treason?: unknown;\n 577→}> {\n 578→\ttry {\n 579→\t\tconst file = JSON.parse(\n 580→\t\t\tfs.readFileSync(path.join(store.ticketDir(ticketId), JUDGE_FILE), \"utf8\"),\n 581→\t\t) as Parameters<typeof judgeCallsOf>[0];\n 582→\t\treturn judgeCallsOf(file) as Array<{ round?: unknown; verdict?: unknown; reason?: unknown }>;\n 583→\t} catch {\n 584→\t\treturn [];\n 585→\t}\n 586→}\n 587→\n 588→/** 探针可注入隔离库与假重派运行时；生产不传，走真 chancellor + 真汇报。 */\n 589→export interface DelegationApiOptions {\n 590→\tworkRoot?: string;\n 591→\tstore?: DelegationReceipts;\n 592→\tretryRuntime?: () => DelegationRuntime;\n 593→\t/** 回话端点（8g）的续跑运行时；探针替换成假 runner，生产走真 chancellor。 */\n 594→\tsayRuntime?: () => DelegationRuntime;\n 595→}\n 596→\n 597→export function mountDelegationApi(app: Hono, opts: DelegationApiOptions = {}): void {\n 598→\tconst workRootOf = (): string => path.resolve(opts.workRoot ?? chancellorWorkRoot());\n 599→\t// 与只读投影同一个懒建口径：注入了就用注入的，否则用进程内单例。\n 600→\tconst storeOf = (): DelegationReceipts => opts.store ?? deadLetterStore();\n 601→\n 602→\t// 键控基线的票面来源（2026-11-10 批 21 §四）：验收标准 = ticket.json 的 steps\n 603→\t// + plan.json 里各任务的 writes。专线模块不 import 任务中心，由这里注入。\n 604→\t// 任何读取失败都返回 null（不写基线），绝不挡专线本身的写入。\n 605→\tsetTaskBaselineProvider((ticketId) => {\n 606→\t\ttry {\n 607→\t\t\tconst found = findTicket(workRootOf(), ticketId);\n 608→\t\t\tif (!found) return null;\n 609→\t\t\ttry {\n 610→\t\t\t\tconst steps = Array.isArray(found.ticket.steps) ? found.ticket.steps : [];\n 611→\t\t\t\tlet writes: string[] = [];\n 612→\t\t\t\ttry {\n 613→\t\t\t\t\tconst plan = JSON.parse(\n 614→\t\t\t\t\t\tfs.readFileSync(path.join(found.store.ticketDir(ticketId), \"plan.json\"), \"utf8\"),\n 615→\t\t\t\t\t) as { tasks?: Array<{ writes?: unknown }> };\n 616→\t\t\t\t\twrites = (plan.tasks ?? []).flatMap((task) =>\n 617→\t\t\t\t\t\tArray.isArray(task.writes)\n 618→\t\t\t\t\t\t\t? task.writes.filter((item): item is string => typeof item === \"string\")\n 619→\t\t\t\t\t\t\t: [],\n 620→\t\t\t\t\t);\n 621→\t\t\t\t} catch {\n 622→\t\t\t\t\t// 还没规划 / 坏文件：只写 steps\n 623→\t\t\t\t}\n 624→\t\t\t\treturn { id: ticketId, steps, writes: [...new Set(writes)] };\n 625→\t\t\t} finally {\n 626→\t\t\t\tfound.store.close();\n 627→\t\t\t}\n 628→\t\t} catch {\n 629→\t\t\treturn null;\n 630→\t\t}\n 631→\t});\n 632→\n 633→\tapp.get(\"/api/v1/domains\", (c) => {\n 634→\t\tconst workRoot = workRootOf();\n 635→\t\tconst managers = listManagers(workRoot).map((entry) => {\n 636→\t\t\tconst runsDir = entry.meta?.runs_dir;\n 637→\t\t\tconst stats = runsDir && fs.existsSync(runsDir)\n 638→\t\t\t\t? ticketStats(runsDir)\n 639→\t\t\t\t: { active: 0, total: 0 };\n 640→\t\t\treturn {\n 641→\t\t\t\tdomain: entry.domain,\n 642→\t\t\t\tupdatedAt: entry.meta?.updated_at ?? \"\",\n 643→\t\t\t\tconversationId: entry.meta?.conversation_id ?? null,\n 644→\t\t\t\tactiveTickets: stats.active,\n 645→\t\t\t\ttotalTickets: stats.total,\n 646→\t\t\t\terror: entry.error,\n 647→\t\t\t};\n 648→\t\t});\n 649→\t\treturn c.json({ workRoot, domains: managers });\n 650→\t});\n 651→\n 652→\tapp.get(\"/api/v1/tickets\", async (c) => {\n 653→\t\tconst workRoot = workRootOf();\n 654→\t\tconst domainFilter = (c.req.query(\"domain\") ?? \"\").trim();\n 655→\t\tconst limit = Math.min(Math.max(Number(c.req.query(\"limit\")) || 100, 1), 300);\n 656→\t\tconst rows: TicketSummary[] = [];\n 657→\t\tconst loadExternal = externalChatIdsLoader();\n 658→\t\tconst loadTitles = conversationTitlesLoader(300);\n 659→\t\tconst chiefNameOf = chiefNamesLoader();\n 660→\t\tconst canceledIds = (() => {\n 661→\t\t\ttry {\n 662→\t\t\t\treturn storeOf().canceledTicketIds();\n 663→\t\t\t} catch {\n 664→\t\t\t\treturn new Set<string>();\n 665→\t\t\t}\n 666→\t\t})();\n 667→\n 668→\t\t// 顶层 workRoot：不分管的老单（domain = null）\n 669→\t\trows.push(\n 670→\t\t\t...(await summarizeTickets(workRoot, null, limit, loadExternal, loadTitles, chiefNameOf, canceledIds)),\n 671→\t\t);\n 672→\t\tfor (const entry of listManagers(workRoot)) {\n 673→\t\t\tconst runsDir = entry.meta?.runs_dir;\n 674→\t\t\tif (!runsDir || !fs.existsSync(runsDir)) continue;\n 675→\t\t\trows.push(\n 676→\t\t\t\t...(await summarizeTickets(\n 677→\t\t\t\t\trunsDir,\n 678→\t\t\t\t\tentry.domain,\n 679→\t\t\t\t\tlimit,\n 680→\t\t\t\t\tloadExternal,\n 681→\t\t\t\t\tloadTitles,\n 682→\t\t\t\t\tchiefNameOf,\n 683→\t\t\t\t\tcanceledIds,\n 684→\t\t\t\t)),\n 685→\t\t\t);\n 686→\t\t}\n 687→\n 688→\t\tconst filtered = domainFilter\n 689→\t\t\t? rows.filter((row) => row.domain === domainFilter)\n 690→\t\t\t: rows;\n 691→\t\tfiltered.sort((a, b) => (a.updated_at < b.updated_at ? 1 : -1));\n 692→\t\treturn c.json({\n 693→\t\t\tok: true,\n 694→\t\t\ttickets: filtered.slice(0, limit),\n 695→\t\t\t// 回滚开关下发：前端据此决定渲不渲染取消/重试按钮（开关关时不渲染）。\n 696→\t\t\tcancelEnabled: delegationCancelEnabled(),\n 697→\t\t});\n 698→\t});\n 699→\n 700→\tapp.get(\"/api/v1/tickets/:id\", async (c) => {\n 701→\t\tconst found = findTicket(workRootOf(), c.req.param(\"id\"));\n 702→\t\tif (!found) return c.json({ ok: false, error: \"not_found\" }, 404);\n 703→\t\ttry {\n 704→\t\t\t// 对外的来源对话给 uuid；ticket 原文里的内部 id 不下发（对外 id 一律 uuid）。\n 705→\t\t\tconst conversationId = await conversationIdOf(found.ticket, externalChatIdsLoader());\n 706→\t\t\tconst titles = await conversationTitlesLoader(300)(\n 707→\t\t\t\tconversationId ? [conversationId] : [],\n 708→\t\t\t);\n 709→\t\t\tconst ticketView = { ...found.ticket };\n 710→\t\t\tdelete ticketView.originConversationId;\n 711→\t\t\t// 作废位投影（扫尾批 1 A1）：详情同样叠加 canceled + status=canceled，\n 712→\t\t\t// 原始状态放 originStatus，不丢事实。\n 713→\t\t\tlet canceled = false;\n 714→\t\t\ttry {\n 715→\t\t\t\tcanceled = storeOf().isCanceled(found.ticket.id);\n 716→\t\t\t} catch {\n 717→\t\t\t\t/* 簿记库挂了不挡详情 */\n 718→\t\t\t}\n 719→\t\t\tconst projected = applyCancelProjection(ticketView, canceled);\n 720→\t\t\tconst runSource = runSourceOfTicket(found.ticket.id);\n 721→\t\t\t// 过程关口（批 19 §四）：只读 reviews / judge.json / repairRound 三处落盘事实；\n 722→\t\t\t// 开关关着就不出现这个键（前端零影响）。\n 723→\t\t\tconst reviews = found.store.reviewsOf(found.ticket.id);\n 724→\t\t\tconst gates = ticketGatesEnabled()\n 725→\t\t\t\t? buildTicketGates({\n 726→\t\t\t\t\t\treviews,\n 727→\t\t\t\t\t\tjudgeCalls: judgeCallsOfTicket(found.store, found.ticket.id),\n 728→\t\t\t\t\t\trepairRound: found.ticket.repairRound,\n 729→\t\t\t\t\t\tjudgeOn: judgeEnabled(),\n 730→\t\t\t\t\t})\n 731→\t\t\t\t: null;\n 732→\t\t\tconst groupId = fanoutGroupEnabled()\n 733→\t\t\t\t? String(found.ticket.idempotencyKey ?? \"\").trim() || null\n 734→\t\t\t\t: null;\n 735→\t\t\t// 验收项逐项投影（批 23 §一）：只认 steps 里 `验：` 开头的项；没有 = 不带键。\n 736→\t\t\tconst acceptanceChecks = acceptanceChecksEnabled()\n 737→\t\t\t\t? projectAcceptanceChecks(found.ticket.steps, reviews)\n 738→\t\t\t\t: [];\n 739→\t\t\t// 后台任务投影（批 23 §二）：只列该单时间窗口内的摘要，日志正文另走 bg-jobs 端点。\n 740→\t\t\tconst bgJobs = ticketBgJobsEnabled()\n 741→\t\t\t\t? (() => {\n 742→\t\t\t\t\t\ttry {\n 743→\t\t\t\t\t\t\treturn projectTicketBgJobs(found.ticket, listBgJobs(bashJobsDir()));\n 744→\t\t\t\t\t\t} catch {\n 745→\t\t\t\t\t\t\treturn [];\n 746→\t\t\t\t\t\t}\n 747→\t\t\t\t\t})()\n 748→\t\t\t\t: [];\n 749→\t\t\treturn c.json({\n 750→\t\t\t\tok: true,\n 751→\t\t\t\tticket: projected,\n 752→\t\t\t\tdomain: found.domain,\n 753→\t\t\t\tconversationId,\n 754→\t\t\t\tconversationTitle: conversationId ? titles.get(conversationId) ?? null : null,\n 755→\t\t\t\tchiefName: chiefNamesLoader()(found.ticket.options.domain),\n 756→\t\t\t\t// 触发来源（2026-11-10 批 15 §三，纯增量）：老数据 null 视为 human；\n 757→\t\t\t\t// 没有回执 / RUN_SOURCE=false 时**不出现**这个键（前端零影响）。\n 758→\t\t\t\t...(runSource ? { runSource } : {}),\n 759→\t\t\t\t// 多副本归并（批 19 §五）：同 requestId 的单带同一个 groupId。\n 760→\t\t\t\t...(groupId ? { groupId } : {}),\n 761→\t\t\t\t// 过程关口（批 19 §四）：过了哪些关，纯投影。\n 762→\t\t\t\t...(gates ? { gates } : {}),\n 763→\t\t\t\t// 验收项逐项状态（批 23 §一）：开关关 / 没有 `验：` 项时**不出现**。\n 764→\t\t\t\t...(acceptanceChecks.length > 0 ? { acceptanceChecks } : {}),\n 765→\t\t\t\t// 后台任务摘要（批 23 §二）：开关关 / 窗口内没有时**不出现**（正文在 /bg-jobs/:id/log）。\n 766→\t\t\t\t...(bgJobs.length > 0 ? { bgJobs } : {}),\n 767→\t\t\t\tcancelEnabled: delegationCancelEnabled(),\n 768→\t\t\t\t// 任务专线（2026-11-08 扫尾批 8g）：启用开关 + 确定性会话 id（`task-<票号>`）。\n 769→\t\t\t\t// 未建过时也会给 id；前端回读 GET messages 得到 404 就按\"还没有记录\"展示。\n 770→\t\t\t\ttaskConversationEnabled: taskAsConversationEnabled(),\n 771→\t\t\t\ttaskConversationId: getTaskConversation(found.ticket.id)?.conversationId ?? null,\n 772→\t\t\t\t// 派活留言（2026-11-07）：谁在什么时候说了什么。老单没有记录 = 空数组。\n 773→\t\t\t\tmessages: messagesOf(found.ticket.id),\n 774→\t\t\t\t// 路径只给相对项目信息，不把 workRoot 绝对路径下发给客户端。\n 775→\t\t\t\tproject: found.ticket.options.project ?? null,\n 776→\t\t\t\t// 计划附件与返工轮次（2026-11-09 §2.3 / §1.5）：可选字段，不出现 = 前