    "arguments": "{\"file_path\": \"D:\\\\Projects\\\\projects\\\\lh-b26\\\\ts\\\\apps\\\\server\\\\src\\\\phone-worker.ts\", \"new_string\": \"const transport: PhoneTransport = {\\n  dispatch(task, signal) {\\n    if (signal?.aborted) return Promise.reject(abortReason(signal));\\n\\n    return new Promise<PhoneResult>((resolve, reject) => {\\n      let settled = false;\\n\\n      const entry: PendingEntry = {\\n        task,\\n        deadlineAt: Date.now() + Math.max(1, task.budgetMs),\\n        signal,\\n        resolve: (result) => finish(() => resolve(result)),\\n      };\\n\\n      const finish = (apply: () => void): void => {\\n        if (settled) return;\\n        settled = true;\\n        clearTimeout(timer);\\n        signal?.removeEventListener(\\\"abort\\\", onAbort);\\n        // 同 taskId 重派时，旧单收尾不能连坐删掉新单的登记（否则新单永远交付不出去）。\\n        if (pending.get(task.taskId) === entry) pending.delete(task.taskId);\\n        const queued = ready.indexOf(task.taskId);\\n        if (queued >= 0) ready.splice(queued, 1);\\n        apply();\\n      };\\n\\n      const timer = setTimeout(() => {\\n        finish(() => reject(new PhoneTaskTimeoutError(task.taskId, task.budgetMs)));\\n      }, Math.max(1, task.budgetMs));\\n\\n      const onAbort = (): void => {\\n        // 墓碑：手机可能已经拿着这张单在跑了；它交回结果时按\\\"已取消、已丢弃\\\"回。\\n        markCanceled(task.taskId);\\n        finish(() => reject(abortReason(signal)));\\n      };\\n      signal?.addEventListener(\\\"abort\\\", onAbort, { once: true });\\n\\n      pending.set(task.taskId, entry);\\n\\n      if (!flushPoll(task)) ready.push(task.taskId);\\n    });\\n  },\\n};\", \"old_string\": \"const transport: PhoneTransport = {\\n  dispatch(task, signal) {\\n    if (signal?.aborted) return Promise.reject(abortReason(signal));\\n\\n    return new Promise<PhoneResult>((resolve, reject) => {\\n      let settled = false;\\n\\n      const finish = (apply: () => void): void => {\\n        if (settled) return;\\n        settled = true;\\n        clearTimeout(timer);\\n        signal?.removeEventListener(\\\"abort\\\", onAbort);\\n        pending.delete(task.taskId);\\n        const queued = ready.indexOf(task.taskId);\\n        if (queued >= 0) ready.splice(queued, 1);\\n        apply();\\n      };\\n\\n      const timer = setTimeout(() => {\\n        finish(() => reject(new PhoneTaskTimeoutError(task.taskId, task.budgetMs)));\\n      }, Math.max(1, task.budgetMs));\\n\\n      const onAbort = (): void => {\\n        finish(() => reject(abortReason(signal)));\\n      };\\n      signal?.addEventListener(\\\"abort\\\", onAbort, { once: true });\\n\\n      pending.set(task.taskId, {\\n        task,\\n        resolve: (result) => finish(() => resolve(result)),\\n      });\\n\\n      if (!flushPoll(task)) ready.push(task.taskId);\\n    });\\n  },\\n};\"}",
