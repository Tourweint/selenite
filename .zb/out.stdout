n 101→            btn.textContent = '撤销';\n 102→            btn.onclick = function () {\n 103→              fetch('/api/v1/pair/devices/' + d.id + '/revoke', {\n 104→                method: 'POST',\n 105→                headers: { 'Authorization': 'Bearer ' + token }\n 106→              }).then(function () { location.reload(); });\n 107→            };\n 108→            row.appendChild(btn);\n 109→          }\n 110→          box.appendChild(row);\n 111→        });\n 112→      })\n 113→      .catch(function () { box.innerHTML = '<div class=\"dim\">设备列表读取失败</div>'; });\n 114→  }\n 115→</script>\n 116→</body>\n 117→</html>`;\n 118→}\n 119→\n 120→function extractCode(pairUrl: string): string {\n 121→\tconst match = /[?&]code=([^&]+)/.exec(pairUrl);\n 122→\treturn match?.[1] ?? \"\";\n 123→}\n 124→",
