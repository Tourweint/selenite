        "content": " 380→\treturn goal ? `【当前目标】${goal}` : undefined;\n 381→}\n 382→\n 383→// ── 整体装配 ─────────────────────────────────────────────\n 384→\n 385→/**\n 386→ * 纪律段（2026-11-10 批 12 + 批 16）：执事轮常量口径，全部固定字节、不含动态内容。\n 387→ *\n 388→ * 为什么集中在这里：任务的七件里有四件是提示词纪律，它们与契约 / 状态一样\n 389→ * 「每轮现渲染、不写进 transcript」。**总管（chief）的验证铁律由 lifecycle 的\n 390→ * persona 段注入**，这里跳过，避免同一段进两遍；普通执事没有 persona 段，在这里补。\n 391→ * 答案接地（批 16 §五）不按身份分：谁汇报谁负责。\n 392→ */\n 393→export function buildPartnerDisciplineSection(partnerId: string): string {\n 394→\tconst blocks = [\n 395→\t\tverificationIronLawFor(partnerId),\n 396→\t\tRULING_DISCIPLINE,\n 397→\t\tWORK_SILENCE_DISCIPLINE,\n 398→\t\t// 答案接地（批 16 §五）：总管与执事都要——它管的是\"说出口的事实\"，\n 399→\t\t// 谁汇报谁负责，不按身份分。\n 400→\t\tGROUNDING_DISCIPLINE,\n 401→\t\t// 产物交接（批 19 §三）：接力时产物优先；同样不按身份分，谁交接谁负责。\n 402→\t\tartifactHandoffEnabled() ? ARTIFACT_HANDOFF : undefined,\n 403→\t\t// 主人数据红线（批 21 §七）：数据域分级/提案制/日记不可重写/引原话不打分；\n 404→\t\t// 不按身份分——总管与执事同样面对主人的数据。\n 405→\t\townerDataDisciplineEnabled() ? OWNER_DATA_DISCIPLINE : undefined,\n 406→\t\t// 汇报卡三规则（批 15 §二）：只给普通执事；总管那条时间线由界面承载，\n 407→\t\t// 加进来会改变总管纪律段的固定字节，故跳过。\n 408→\t\tpartnerId === CHIEF_PARTNER_ID || !briefCardRulesEnabled() ? undefined : BRIEF_CARD_RULES,\n 409→\t\tATTENTION_ONE_QUESTION,\n 410→\t];\n 411→\treturn blocks.filter((part): part is string => Boolean(part)).join(\"\\n\\n\");\n 412→}\n 413→\n 414→export interface PartnerTurnContext {\n 415→\t/** 身份正文（当前版本快照）。调用方放进 instructions；这里带出来是为了整体断言。 */\n 416→\tsoul: string;\n 417→\t/** 岗位契约段（开关关 / 空 → null） */\n 418→\tcontract: string | null;\n 419→\t/** 当前目标段（E4，无目标 → null） */\n 420→\tgoal: string | null;\n 421→\t/** 纪律段（批 12：验证 / 裁决 / 干活期间 / 提问；批 16：答案接地；固定字节，永远非空） */\n 422→\tdiscipline: string;\n 423→\t/** 当前在办段（三项皆空 + 无履历 → null） */\n 424→\tstatus: string | null;\n 425→\t/** 注入防线段（开关关 → null；固定字节，不随轮次变化） */\n 426→\tguard: string | null;\n 427→\t/** 注入模型请求的附加段：契约 + 目标 + 纪律 + 在办 + 防线（都空 → undefined） */\n 428→\ttext: string | undefined;\n 429→}\n 430→\n 431→/**\n 432→ * 执事轮输入的单一装配点（E1 + E5）。\n 433→ *\n 434→ * 顺序固定：**SOUL（身份）→ 岗位契约 → 当前目标 → 纪律 → 当前在办**。前两段来自同一个身份版本，\n 435→ * 后三段现查现拼。`text` 只含后四段：SOUL 在 instructions 里，重复一遍等于每轮\n 436→ * 白付一份 token，还会让模型看到两个版本的身份。\n 437→ *\n 438→ * 刀二只在同一装配点加两段（目标 / 履历摘要），批 12 再加一段固定纪律，\n 439→ * **没有第二条注入通道**。\n 440→ */\n 441→export function buildPartnerTurnContext(\n 442→\tpartnerId: string,\n 443→\tconversationId: number,\n 444→\tdeps: PartnerContextDeps = {},\n 445→): PartnerTurnContext {\n 446→\tconst store = deps.store ?? partnersStore();\n 447→\tconst current = store.currentVersion(partnerId);\n 448→\tconst soul = current?.soulSource ?? store.readSoulFromHome(partnerId) ?? \"\";\n 449→\t// 契约取\"当前版本快照\"；老库/手工放了文件但没快照的，退磁盘当前值。\n 450→\tconst contract = renderContractSection(\n 451→\t\tcurrent?.contractSource ?? store.readContractFromHome(partnerId),\n 452→\t) ?? null;\n 453→\tconst goal = buildPartnerGoalSection(partnerId, store) ?? null;\n 454→\t// 纪律段（批 12）放在动态状态之前：固定字节先落，在办清单每轮变。\n 455→\tconst discipline = buildPartnerDisciplineSection(partnerId);\n 456→\tconst status = buildPartnerStatusSection(partnerId, conversationId, { ...deps, store }) ?? null;\n 457→\t// 注入防线（2026-11-09 T2）：放在执事轮输入尾部；固定字节，开关只决定注不注。\n 458→\tconst guard = injectionGuardEnabled() ? INJECTION_GUARD : null;\n 459→\tconst text = [contract, goal, discipline, status, guard]\n 460→\t\t.filter((part): part is string => Boolean(part))\n 461→\t\t.join(\"\\n\\n\");\n 462→\treturn { soul, contract, goal, discipline, status, guard, text: text || undefined };\n 463→}\n 464→",
