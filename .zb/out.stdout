      "type": "text",
      "text": "   1→import assert from \"node:assert/strict\";\n   2→import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from \"node:fs\";\n   3→import { tmpdir } from \"node:os\";\n   4→import { join } from \"node:path\";\n   5→import { test } from \"node:test\";\n   6→import { Hono } from \"hono\";\n   7→import {\n   8→\tmountDelegationApi,\n   9→\tprojectAcceptanceChecks,\n  10→\tprojectTicketBgJobs,\n  11→} from \"./delegation-api.ts\";\n  12→import { ensureManager } from \"../../../../../chancellor/src/manager/registry.ts\";\n  13→import { Store } from \"../../../../../chancellor/src/store.ts\";\n  14→import type { Ticket } from \"../../../../../chancellor/src/types.ts\";\n  15→\n  16→function temp(prefix: string): string {\n  17→\treturn mkdtempSync(join(tmpdir(), `lifediary-${prefix}-`));\n  18→}\n  19→\n  20→function makeTicket(\n  21→\tid: string,\n  22→\tworkRoot: string,\n  23→\textra: Partial<Ticket> = {},\n  24→): Ticket {\n  25→\tconst now = new Date().toISOString();\n  26→\treturn {\n  27→\t\tid,\n  28→\t\tprompt: \"测试任务\",\n  29→\t\tstatus: \"dispatching\",\n  30→\t\tcreated_at: now,\n  31→\t\tupdated_at: now,\n  32→\t\toptions: { dry: true, maxTasks: 8, workRoot },\n  33→\t\t...extra,\n  34→\t};\n  35→}\n  36→\n  37→test(\"只读接口：领域列表给出在办/总数\", async () => {\n  38→\tconst root = temp(\"api-domains\");\n  39→\ttry {\n  40→\t\tconst workRoot = join(root, \"runs\");\n  41→\t\tconst manager = ensureManager(workRoot, \"frontend\");\n  42→\t\tconst managerStore = new Store(manager.runs_dir);\n  43→\t\tmanagerStore.saveTicket(makeTicket(\"T-m1\", manager.runs_dir));\n  44→\t\tmanagerStore.close();\n  45→\n  46→\t\tconst app = new Hono();\n  47→\t\tmountDelegationApi(app, { workRoot });\n  48→\t\tconst response = await app.request(\"/api/v1/domains\");\n  49→\t\tassert.equal(response.status, 200);\n  50→\t\tconst body = (await response.json()) as {\n  51→\t\t\tworkRoot: string;\n  52→\t\t\tdomains: Array<{\n  53→\t\t\t\tdomain: string;\n  54→\t\t\t\tactiveTickets: number;\n  55→\t\t\t\ttotalTickets: number;\n  56→\t\t\t\terror: string | null;\n  57→\t\t\t}>;\n  58→\t\t};\n  59→\t\tassert.equal(body.domains.length, 1);\n  60→\t\tassert.equal(body.domains[0]?.domain, \"frontend\");\n  61→\t\tassert.equal(body.domains[0]?.activeTickets, 1);\n  62→\t\tassert.equal(body.domains[0]?.totalTickets, 1);\n  63→\t\tassert.equal(body.domains[0]?.error, null);\n  64→\t} finally {\n  65→\t\trmSync(root, { recursive: true, force: true });\n  66→\t}\n  67→});\n  68→\n  69→test(\"只读接口：按单号读 ticket、任务与子单，区分根目录与领域目录\", async () => {\n  70→\tconst root = temp(\"api-ticket\");\n  71→\ttry {\n  72→\t\tconst workRoot = join(root, \"runs\");\n  73→\t\tconst manager = ensureManager(workRoot, \"frontend\");\n  74→\t\tconst managerStore = new Store(manager.runs_dir);\n  75→\n  76→\t\t// 根目录的单（没有领域）。\n  77→\t\tconst rootStore = new Store(workRoot);\n  78→\t\trootStore.saveTicket(makeTicket(\"T-root\", workRoot));\n  79→\n  80→\t\t// 领域目录里的父单 + 一个任务行 + 一张子单。\n  81→\t\tconst now = new Date().toISOString();\n  82→\t\tmanagerStore.saveTicket(makeTicket(\"T-mgr\", manager.runs_dir, { employee: \"manager\" }));\n  83→\t\tmanagerStore.saveTask({\n  84→\t\t\tticket_id: \"T-mgr\",\n  85→\t\t\tseq: 1,\n  86→\t\t\tslug: \"child\",\n  87→\t\t\ttitle: \"child\",\n  88→\t\t\tdir: join(manager.runs_dir, \"T-mgr\", \"01-child\"),\n  89→\t\t\tstatus: \"pending\",\n  90→\t\t\temployee: null,\n  91→"
    },
