    "output": {
      "type": "text",
      "text": "  60→\tverificationIronLawProvider,\n  61→} = await import(\"./lifecycle-injections.ts\");\n  62→const { LIFECYCLE_SECTIONS } = await import(\"./lifecycle.ts\");\n  63→const { PERSONA, WORKER_PERSONA, taskMemoryProvider } = await import(\"./assist.ts\");\n  64→const { buildPartnerTurnContext } = await import(\"./partner-context.ts\");\n  65→const { PartnersStore } = await import(\"../partners.ts\");\n  66→const { MAX_TURNS, TURN_LIMIT_INSTRUCTION, VERIFICATION_IRON_LAW } = await import(\"./turn-gate.ts\");\n  67→const { CLARIFY_CONTRACT } = await import(\"../delegation.ts\");\n  68→const { markRecoverResume } = await import(\"./recover-note.ts\");\n  69→\n  70→after(() => {\n  71→\trmSync(root, { recursive: true, force: true });\n  72→});\n  73→\n  74→const ctx = { conversationId: 1 };\n  75→\n  76→function entryOf(provider: (c: unknown) => unknown, context: Record<string, unknown> = {}) {\n  77→\treturn collectInjections([provider as never], { ...ctx, ...context }).system[0];\n  78→}\n  79→\n  80→// ── 框架：排序 / 去重 / 分流 ────────────────────────────\n  81→\n  82→test(\"排序：order 升序 / 同 order 按 id 字典序；打乱 providers 顺序输出一致\", () => {\n  83→\tconst sys = (id: string, text: string, order: number) => ({\n  84→\t\tid,\n  85→\t\ttext,\n  86→\t\torder,\n  87→\t\tscope: \"session\" as const,\n  88→\t\tchannel: \"system\" as const,\n  89→\t});\n  90→\tconst pA = () => sys(\"b\", \"B\", 2);\n  91→\tconst pB = () => sys(\"a\", \"A\", 1);\n  92→\tconst pC = () => sys(\"c\", \"C\", 1);\n  93→\tconst out1 = collectInjections([pA, pB, pC], ctx);\n  94→\tconst out2 = collectInjections([pC, pA, pB], ctx);\n  95→\tassert.deepEqual(out1, out2, \"打乱输入顺序输出不变\");\n  96→\tassert.deepEqual(out1.system.map((item) => item.id), [\"a\", \"c\", \"b\"]);\n  97→});\n  98→\n  99→test(\"同 id 去重：后者覆盖（规范序里最后一次出现胜出），不受 provider 顺序影响\", () => {\n 100→\tconst sys = (text: string, order: number) => ({\n 101→\t\tid: \"dup\",\n 102→\t\ttext,\n 103→\t\torder,\n 104→\t\tscope: \"session\" as const,\n 105→\t\tchannel: \"system\" as const,\n 106→\t});\n 107→\tconst out = collectInjections([() => [sys(\"FIRST\", 1), sys(\"LATER\", 2)]], ctx);\n 108→\tassert.equal(out.system.length, 1);\n 109→\tassert.equal(out.system[0].text, \"LATER\");\n 110→});\n 111→\n 112→test(\"按 channel 分流：system / message 各归各位\", () => {\n 113→\tconst s = { id: \"s\", text: \"S\", order: 0, scope: \"session\" as const, channel: \"system\" as const };\n 114→\tconst m = { id: \"m\", text: \"M\", order: 0, scope: \"turn\" as const, channel: \"message\" as const };\n 115→\tconst out = collectInjections([() => [m, s]], ctx);\n 116→\tassert.deepEqual(out.system.map((item) => item.id), [\"s\"]);\n 117→\tassert.deepEqual(out.message.map((item) => item.id), [\"m\"]);\n 118→});\n 119→\n 120→// ── 硬标准：B 期各 section 的正文逐字节一致 ────────────\n 121→\n 122→test(\"B: injection_guard 正文 === INJECTION_GUARD（批 A 硬标准不回退）\", () => {\n 123→\tassert.equal(entryOf(guardProvider).text, INJECTION_GUARD);\n 124→\tassert.equal(entryOf(guardProvider).id, \"injection_guard\");\n 125→});\n 126→\n 127→test(\"B: persona —— chief 回落 PERSONA，worker 用 WORKER_PERSONA，非 chief 执事不注\", () => {\n 128→\tassert.equal(entryOf(personaProvider, { chatKind: \"chief\", partnerId: null }).text, PERSONA);\n 129→\tassert.equal(entryOf(personaProvider, { chatKind: \"worker\", partnerId: null }).text, WORKER_PERSONA);\n 130→\tassert.equal(personaProvider({ ...ctx, chatKind: \"chief\", partnerId: \"p-1\" }), undefined);\n 131→});\n 132→\n 133→test(\"B: verification_iron_law —— 总管/无身份注，普通执事不注（由 partner-context 补）\", () => {\n 134→\tassert.equal(entryOf(verificationIronLawProvider, { partnerId: null }).text, VERIFICATION_IRON_LAW);\n 135→\tassert.equal(entryOf(verificationIronLawProvider, { partnerId: \"chief\" }).text, VERIFICATION_IRON_LAW);\n 136→\tassert.equal(verificationIronLawProvider({ ...ctx, partnerId: \"p-1\" }), undefined);\n 137→});\n 138→\n 139→test(\"B: clarify_contract —— 总管注、worker / 普通执事不注；开关关时整段省略\", () => {\n 140→\tassert.equal(entryOf(clarifyContractProvider, { partnerId: null, chatKind: \"chief\" }).text, CLARIFY_CONTRACT);\n 141→\tassert.equal(clarifyContractProvider({ ...ctx, partnerId: null, chatKind: \"worker\" }), undefined);\n 142→\tassert.equal(clarifyContractProvider({ ...ctx, partnerId: \"p-1\", chatKind: \"chief\" }), undefined);\n 143→\tconst saved = process.env.AGENT_CLARIFY_CONTRACT;\n 144→\tprocess.env.AGENT_CLARIFY_CONTRACT = \"false\";\n 145→\ttry {\n 146→\t\tassert.equal(clarifyContractProvider({ ...ctx, partnerId: null, chatKind: \"chief\" }), undefined);\n 147→\t} finally {\n 148→\t\tif (saved === undefined) delete process.env.AGENT_CLARIFY_CONTRACT;\n 149→\t\telse process.env.AGENT_CLARIFY_CONTRACT = saved;\n 150→\t}\n 151→});\n 152→\n 153→test(\"B: current_project —— 无项目时为固定句，有项目时为三行\", () => {\n 154→\tassert.equal(\n 155→\t\tentryOf(currentProjectProvider).text,\n 156→\t\t\"当前无特定项目（杂事模式）。文件操作默认在主工作区。\",\n 157→\t);\n 158→});\n 159→\n 160→"
    },
