,\n  45→\t\"idle\",\n  46→\t\"aborted\",\n  47→]);\n  48→\n  49→/**\n  50→ * 取消/重试回滚开关（扫尾批 1 A1）：`DELEGATION_CANCEL=false` 时两个端点一个都不挂（404），\n  51→ * 前端也从列表响应里读到 cancelEnabled=false 而不渲染按钮。缺省开。\n  52→ */\n  53→export function delegationCancelEnabled(): boolean {\n  54→\tconst raw = (process.env.DELEGATION_CANCEL?.trim() || \"true\").toLowerCase();\n  55→\treturn raw !== \"false\" && raw !== \"0\";\n  56→}\n  57→\n  58→/** 过程关口投影开关（2026-11-10 批 19 §四）：默认开；`TICKET_GATES=false` → 详情不带 gates。 */\n  59→export function ticketGatesEnabled(env: NodeJS.ProcessEnv = process.env): boolean {\n  60→\tconst raw = (env.TICKET_GATES ?? \"\").trim().toLowerCase();\n  61→\tif (!raw) return true;\n  62→\treturn raw !== \"false\" && raw !== \"0\" && raw !== \"off\";\n  63→}\n  64→\n  65→/** 多副本归并开关（2026-11-10 批 19 §五）：默认开；`DELEGATION_FANOUT_GROUP=false` → 不带 groupId。 */\n  66→export function fanoutGroupEnabled(env: NodeJS.ProcessEnv = process.env): boolean {\n  67→\tconst raw = (env.DELEGATION_FANOUT_GROUP ?? \"\").trim().toLowerCase();\n  68→\tif (!raw) return true;\n  69→\treturn raw !== \"false\" && raw !== \"0\" && raw !== \"off\";\n  70→}\n  71→\n  72→/** 任务过程关口（2026-11-10 批 19 §四.1）：只投影已有事实，不新增判定。 */\n  73→export interface TicketGate {\n  74→\tname: string;\n  75→\tpassed: boolean;\n  76→\tnote?: string;\n  77→}\n  78→\n  79→function clipNote(text: string, max = 80): string {\n  80→\tconst flat = text.replace(/\\s+/g, \" \").trim();\n  81→\treturn flat.length <= max ? flat : `${flat.slice(0, max - 1)}…`;\n  82→}\n  83→\n  84→/**\n  85→ * 关口投影（纯函数，单测直接断言）：验收关口（reviews[]）+ 裁判结论（开了才投影）\n  86→ * + 返工轮次。**不判断\"应该怎样\"**，只把落盘事实换成人能读的徽章。\n  87→ */\n  88→export function buildTicketGates(input: {\n  89→\treviews: Array<{ slug?: unknown; verdict?: unknown; reason?: unknown }>;\n  90→\tjudgeCalls?: Array<{ round?: unknown; verdict?: unknown; reason?: unknown }>;\n  91→\trepairRound?: number;\n  92→\tjudgeOn?: boolean;\n  93→}): TicketGate[] {\n  94→\tconst gates: TicketGate[] = [];\n  95→\tfor (const review of input.reviews) {\n  96→\t\tconst slug = String(review.slug ?? \"\").trim();\n  97→\t\tconst verdict = String(review.verdict ?? \"\").trim();\n  98→\t\tconst reason = String(review.reason ?? \"\").trim();\n  99→\t\tgates.push({\n 100→\t\t\tname: slug ? `验收：${slug}` : \"验收\",\n 101→\t\t\tpassed: verdict === \"pass\",\n 102→\t\t\t...(reason ? { note: clipNote(reason) } : {}),\n 103→\t\t});\n 104→\t}\n 105→\tif (input.judgeOn && input.judgeCalls && input.judgeCalls.length > 0) {\n 106→\t\tconst last = input.judgeCalls[input.judgeCalls.length - 1]!;\n 107→\t\tconst verdict = String(last.verdict ?? \"\").trim();\n 108→\t\tconst reason = String(last.reason ?? \"\").trim();\n 109→\t\tconst round = Number(last.round);\n 110→\t\tconst note = [Number.isFinite(round) && round > 0 ? `第 ${round} 轮` : \"\", verdict, reason]\n 111→\t\t\t.filter(Boolean)\n 112→\t\t\t.join(\" · \");\n 113→\t\tgates.push({\n 114→\t\t\tname: \"裁判\",\n 115→\t\t\tpassed: verdict === \"done\",\n 116→\t\t\t...(note ? { note: clipNote(note) } : {}),\n 117→\t\t});\n 118→\t}\n 119→\tconst repairRound = Number(input.repairRound);\n 120→\tif (Number.isInteger(repairRound) && repairRound > 0) {\n 121→"
