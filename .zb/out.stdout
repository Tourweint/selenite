    "status": "completed",
    "output": {
      "type": "text",
      "text": "   1→import { randomBytes, timingSafeEqual } from \"node:crypto\";\n   2→import { mkdirSync, readFileSync, writeFileSync } from \"node:fs\";\n   3→import { dirname } from \"node:path\";\n   4→import type { Context, Next } from \"hono\";\n   5→import { getCookie, setCookie } from \"hono/cookie\";\n   6→import { getConnInfo } from \"@hono/node-server/conninfo\";\n   7→\n   8→/**\n   9→ * 第一档鉴权：一个共享令牌。\n  10→ *\n  11→ * 它是**密码**，不是通行证 —— 只能回答\"你知道这个密钥吗\"，\n  12→ * 不能回答\"你是谁\"。个人自用够了，多设备/多用户要换 JWT。\n  13→ *\n  14→ * 口径刻意对齐 Java 版的 D2：\n  15→ *   - 失败一律 **403 空响应体**（App 不用区分是哪个服务拒绝的）\n  16→ *   - fail-closed：没配令牌时**不裸奔**\n  17→ */\n  18→\n  19→const LOCAL_ADDRESSES = new Set([\n  20→\t\"127.0.0.1\",\n  21→\t\"::1\",\n  22→\t\"::ffff:127.0.0.1\",\n  23→]);\n  24→\n  25→/**\n  26→ * 本机页面凭据（2026-11-03）：服务启动时随机生成一枚“本机 cookie”。\n  27→ *\n  28→ * 目的：桌面壳 / 本机浏览器打开 `/` 时自动连上，不再手填 AGENT_TOKEN。\n  29→ * 只在 loopback 请求且带这枚 cookie 时直通；curl、探针、别的本地脚本没有\n  30→ * 这枚 cookie，仍走令牌校验 —— 没有把“本机”变成无条件的后门。\n  31→ * HttpOnly：页面 JS 读不到；SameSite=Strict：别的网站发起的请求带不上。\n  32→ *\n  33→ * 落盘保底（2026-11-05）：密钥原本只在进程里，后端一重启就换，一直开着的\n  34→ * 页面立刻 403、被踢回令牌框。现在首用时落盘 `.data/local-secret`\n  35→ * （`AGENT_LOCAL_SECRET_PATH` 可改），重启复用同一枚。安全边界没变宽：\n  36→ * 能读这个文件的本机进程本来就读得到 .env 里的 AGENT_TOKEN。\n  37→ */\n  38→const LOCAL_COOKIE = \"lifediary_local\";\n  39→\n  40→let localSecretCache: string | null = null;\n  41→\n  42→/** 只认 48 位 hex（24 字节，与 randomBytes(24) 同形）；缺失或损坏都当没有 */\n  43→function readLocalSecretFile(path: string): string | null {\n  44→\ttry {\n  45→\t\tconst value = readFileSync(path, \"utf8\").trim();\n  46→\t\treturn /^[0-9a-f]{48}$/.test(value) ? value : null;\n  47→\t} catch {\n  48→\t\treturn null;\n  49→\t}\n  50→}\n  51→\n  52→/** 惰性解析：模块加载零副作用（单测红线：不碰 .data/），首个请求才落盘。 */\n  53→function localSecret(): string {\n  54→\tif (localSecretCache) return localSecretCache;\n  55→\tconst path = process.env.AGENT_LOCAL_SECRET_PATH?.trim() || \".data/local-secret\";\n  56→\tconst existing = readLocalSecretFile(path);\n  57→\tif (existing) return (localSecretCache = existing);\n  58→\tconst fresh = randomBytes(24).toString(\"hex\");\n  59→\tlocalSecretCache = fresh;\n  60→\ttry {\n  61→\t\tmkdirSync(dirname(path), { recursive: true });\n  62→\t\t// wx = 别覆盖并发实例刚写好的那枚；EEXIST 时读回来对齐\n  63→\t\twriteFileSync(path, `${fresh}\\n`, { flag: \"wx\", mode: 0o600 });\n  64→\t} catch (error) {\n  65→\t\tif ((error as NodeJS.ErrnoException).code === \"EEXIST\") {\n  66→\t\t\tconst raced = readLocalSecretFile(path);\n  67→\t\t\tif (raced) {\n  68→\t\t\t\t// 并发实例抢先落了盘：跟它对齐，别各持一枚互相踢\n  69→\t\t\t\tlocalSecretCache = raced;\n  70→\t\t\t} else {\n  71→\t\t\t\t// 盘上是坏文件：覆盖它才算自愈（到这里没有可对齐的好值）\n  72→\t\t\t\ttry {\n  73→\t\t\t\t\twriteFileSync(path, `${fresh}\\n`, { mode: 0o600 });\n  74→\t\t\t\t} catch {\n  75→\t\t\t\t\t/* 写不回去：退回进程内随机（旧口径），下次启动再试 */\n  76→\t\t\t\t}\n  77→\t\t\t}\n  78→\t\t}\n  79→\t\t// 其余失败（只读盘等）：缓存住 fresh，同进程内始终一致 ——\n  80→\t\t// 等价旧口径（进程内随机，重启后要重填令牌），下次启动再试落盘\n  81→\t}\n  82→\treturn localSecretCache;\n  83→}\n  84→\n  85→export function isLoopback(c: Context): boolean {\n  86→\ttry {\n  87→\t\tconst address = getConnInfo(c).remote.address;\n  88→\t\treturn address ? LOCAL_ADDRESSES.has(address) : false;\n  89→\t} catch {\n  90→\t\t// 拿不到连接信息时按\"非本机\"处理 —— 宁可拒绝\n  91→\t\treturn false;\n  92→\t}\n  93→}\n  94→\n  95→/** 定长比较，避免把令牌长度泄露给计时攻击 */\n  96→function safeEqual(a: string, b: string): boolean {\n  97→\tconst bufferA = Buffer.from(a);\n  98→\tconst bufferB = Buffer.from(b);\n  99→\tif (bufferA.length !== bufferB.length) return false;\n 100→\treturn timingSafeEqual(bufferA, bufferB);\n 101→}\n 102→\n 103→export interface AuthOptions {\n 104→\t/**\n 105→\t * 设备凭据校验（2026-10-29 配对）：`Bearer` 里也可能是扫码换来的 deviceToken。\n 106→\t * 不传 = 只认共享令牌。\n 107→\t */\n 108→\tverifyDeviceToken?: (token: string) => boolean;\n 109→}\n 110→\n 111→/** 本机页面加载时发一枚进程内凭据；非本机请求不发光，避免把 cookie 扩散出去。 */\n 112→export function attachLocalCredential(c: Context): void {\n 113→\tif (!isLoopback(c)) return;\n 114→\tsetCookie(c, LOCAL_COOKIE, localSecret(), {\n 115→\t\tpath: \"/\",\n 116→\t\thttpOnly: true,\n 117→\t\tsameSite: \"Strict\",\n 118→\t});\n 119→}\n 120→\n 121→function hasLocalCredential(c: Context): boolean {\n 122→\tif (!isLoopback(c)) return false;\n 123→\tconst provided = getCookie(c, LOCAL_COOKIE);\n 124→\treturn typeof provided === \"string\" && safeEqual(provided, localSecret());\n 125→}\n 126→\n 127→export function createAuthMiddleware(expectedToken: string | null, options: AuthOptions = {}) {\n 128→\treturn async (c: Context, next: Next) => {\n 129→\t\t// 没配共享令牌：只让本机访问（但**扫码配对的设备**仍可从局域网进来）。\n 130→\t\tif (!expectedToken) {\n 131→\t\t\tif (isLoopback(c)) return next();\n 132→\t\t\tconst provided = bearerOf(c);\n 133→\t\t\tif (provided && options.verifyDeviceToken?.(provided)) return next();\n 134→\t\t\treturn c.body(null, 403);\n 135→\t\t}\n 136→\n 137→\t\t// 本机页面（桌面壳 / 本机浏览器）由 `/` 下发的 cookie 自动放行。\n 138→\t\tif (hasLocalCredential(c)) return next();\n 139→\n 140→\t\tconst provided = bearerOf(c);\n 141→\t\tif (provided) {\n 142→\t\t\tif (safeEqual(provided, expectedToken)) return next();\n 143→\t\t\tif (options.verifyDeviceToken?.(provided)) return next();\n 144→\t\t}\n 145→\t\treturn c.body(null, 403);\n 146→\t};\n 147→}\n 148→\n 149→function bearerOf(c: Context): string {\n 150→\tconst header = c.req.header(\"Authorization\") ?? \"\";\n 151→\treturn header.startsWith(\"Bearer \") ? header.slice(7).trim() : \"\";\n 152→}\n 153→"
    },
