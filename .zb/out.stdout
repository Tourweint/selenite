      "type": "text",
      "text": "1007→app.get(\"/api/v1/agent/chat/:conversationId/messages\", async (c) => {\n1008→  if (!readLlmConfig()) return c.json({ messages: [] });\n1009→\n1010→  const chat = await openChat(c.req.param(\"conversationId\"));\n1011→  if (!chat) return c.json({ error: \"unknown_conversation\" }, 404);\n1012→\n1013→  const limit = Number(c.req.query(\"limit\") ?? 50);\n1014→  const messages = await readTranscript(chat, Number.isFinite(limit) ? limit : 50);\n1015→  // 会话种类（2026-11-06 B2）：前端据此恢复\"普通 worker / 总管\"身份，不按 id 猜\n1016→  const chatKind = await chatKindOf(chat);\n1017→\n1018→  const sinceRaw = c.req.query(\"sinceSeq\");\n1019→  const eventStore = chatEventStoreOf();\n1020→  if (sinceRaw === undefined || sinceRaw === \"\" || !eventStore) {\n1021→    return c.json({ conversationId: chat.externalId, messages, chatKind });\n1022→  }\n1023→  const sinceSeq = Number(sinceRaw);\n1024→  if (!Number.isFinite(sinceSeq) || sinceSeq < 0) {\n1025→    return c.json({ error: \"bad_request\", message: \"sinceSeq 必须是非负整数\" }, 400);\n1026→  }\n1027→  const { from, events } = eventStore.replaySince(chat.internalId, Math.floor(sinceSeq));\n1028→  return c.json({ conversationId: chat.externalId, messages, chatKind, fromSeq: from, events });\n1029→});\n1030→\n1031→/**\n1032→ * 记忆摘要（导出「接续文件」用）：该**作用域**的 preference + experience，最多 20 条。\n1033→ *\n1034→ * 主对话看 `global`，执事会话看自己的 `partner:<uuid>` 键空间——与偏好落点同口径\n1035→ * （`preferenceScopeOf`）。`session:` 原始对话沉淀刻意不导：接续文件要的是\"关于这个人 /\n1036→ * 这段关系\"的长期事实，不是又抄一遍对话。\n1037→ */\n1038→function handoffMemoryOf(internalId: number): HandoffMemory {\n1039→  if (!memoryEngine) return { enabled: false, scope: \"\", items: [] };\n1040→  const scope = scopeKey(preferenceScopeOf(internalId));\n1041→  try {\n1042→    const records = memoryEngine.list({ scopes: [scope], limit: 200 });\n1043→    const items = records\n1044→      .filter((record) => record.kind === \"preference\" || record.kind === \"experience\")\n1045→      .slice(0, HANDOFF_MEMORY_LIMIT)\n1046→      .map((record) => ({ kind: record.kind, content: record.content }));\n1047→    return { enabled: true, scope, items };\n1048→  } catch {\n1049→    // 只给枚举级说明：原始错误可能带上路径 / 正文\n1050→    console.warn(\"[export] 记忆摘要读取失败（本次不带记忆）\");\n1051→    return { enabled: true, scope, items: [], note: \"服务端读取记忆失败\" };\n1052→  }\n1053→}\n1054→\n1055→/**\n1056→ * 会话导出「接续文件」（2026-11-10 批 20 §一，接口文档 §2.2.1）。\n1057→ *\n1058→ * 一份 markdown：角色说明 + 读取说明 + 记忆摘要（最多 20 条）+ 最近 N 轮原文。\n1059→ * **一次性响应体，不落服务端磁盘**（隐私口径）；`format` 只支持 `handoff`。\n1060→ * 回滚：`CHAT_EXPORT_HANDOFF=false` → 404（与其它能力端点同口径）。\n1061→ */\n1062→app.get(\"/api/v1/agent/chat/:conversationId/export\", async (c) => {\n1063→  if (!chatExportHandoffEnabled()) return c.json({ error: \"not_found\" }, 404);\n1064→\n1065→  const rawFormat = (c.req.query(\"format\") ?? \"\").trim().toLowerCase();\n1066→  if (rawFormat && rawFormat !== \"handoff\") {\n1067→    return c.json({ error: \"bad_request\", message: \"只支持 format=handoff\" }, 400);\n1068→  }\n1069→  const turns = parseHandoffLimit(c.req.query(\"limit\"));\n1070→  if (turns === null) {\n1071→    return c.json({ error: \"bad_request\", message: \"limit 必须是 1–200 的整数\" }, 400);\n1072→  }\n1073→  if (!readLlmConfig()) return c.json({ ok: false, reason: \"llm_not_configured\" }, 503);\n1074→\n1075→  const chat = await openChat(c.req.param(\"conversationId\"));\n1076→  if (!chat) return c.json({ error: \"unknown_conversation\" }, 404);\n1077→\n1078→  const [messages, chatKind] = await Promise.all([readTranscript(chat, 0), chatKindOf(chat)]);\n1079→  const document = buildHandoff({\n1080→    conversationId: chat.externalId,\n1081→    title: chatTitles()[chat.externalId],\n1082→    kind: chatKind,\n1083→    messages,\n1084→    memory: handoffMemoryOf(chat.internalId),\n1085→    turns,\n1086→  });\n1087→\n1088→  // 只作为一次性下载返回：不写盘、不进缓存。文件名只带会话 uuid 前 8 位，不含标题。\n1089→  return c.body(document.markdown, 200, {\n1090→    \"content-type\": \"text/markdown; charset=utf-8\",\n1091→    \"content-disposition\": `attachment; filename=\"${handoffFileName(chat.externalId)}\"`,\n1092→    \"cache-control\": \"no-store\",\n1093→  });\n1094→});\n1095→\n1096→/**\n1097→ * 手动停止当前这一轮。\n1098→ *\n1099→ * 跟\"客户端断开\"是两件事：这是人的明确意图。停了之后再说一句话就是新一轮。\n1100→ */\n1101→app.post(\"/api/v1/agent/chat/:conversationId/stop\", async (c) => {\n1102→  if (!readLlmConfig()) return c.json({ ok: false, reason: \"llm_not_configured\" }, 503);\n1103→\n1104→  const chat = await openChat(c.req.param(\"conversationId\"));\n1105→  if (!chat) return c.json({ error: \"unknown_conversation\" }, 404);\n1106→\n1107→  await stopChat(chat);\n1108→  return c.json({ ok: true, conversationId: chat.externalId });\n1109→});\n1110→\n1111→/**\n1112→ * 让助手**在新会话里**主动说一句（2026-11-01，回顾页钩子：「每次尽量都出一个新对话」）。\n1113→ *\n1114→ * 与下面 `:id/say` 的区别：这里不带会话 id，服务端**新建**一个会话再把话说进去，\n1115→ * 返回新会话的 id 给客户端绑定。用户没接话的话，客户端会把这段空对话清掉。\n1116→ */\n1117→app.post(\"/api/v1/agent/say\", async (c) => {\n1118→  if (!readLlmConfig()) return c.json({ ok: false, reason: \"llm_not_configured\" }, 503);\n1119→\n1120→  const body = (await c.req.json().catch(() => null)) as { text?: string } | null;\n1121→  const text = body?.text?.trim();\n1122→  if (!text) return c.json({ error: \"bad_request\", message: \"需要 text\" }, 400);\n1123→\n1124→  const chat = await openChat(undefined);\n1125→  if (!chat) return c.json({ ok: false, reason: \"conversation_not_created\" }, 503);\n1126→\n1127→  await sayInChat(chat, text);\n1128→  return c.json({ ok: true, conversationId: chat.externalId }, 201);\n1129→});\n1130→\n1131→/**\n1132→ * 让助手主动说一句话（2026-11-01，手机端回顾页钩子）。\n1133→ *\n1134→ * 与 `/chat` 的区别：**不调模型、不产生用户消息**，只把这句话以 assistant 身份写进会话，\n1135→ * 之后的回读/后续对话都能看到。手机端点回顾页的钩子卡片就走这里。\n1136→ */\n1137→app.post(\"/api/v1/agent/chat/:conversationId/say\", async (c) => {\n1138→  if (!readLlmConfig()) return c.json({ ok: false, reason: \"llm_not_configured\" }, 503);\n1139→\n1140→  const chat = await openChat(c.req.param(\"conversationId\"));\n1141→  if (!chat) return c.json({ error: \"unknown_conversation\" }, 404);\n1142→\n1143→  const body = (await c.req.json().catch(() => null)) as { text?: string } | null;\n1144→  const text = body?.text?.trim();\n1145→  if (!text) return c.json({ error: \"bad_request\", message: \"需要 text\" }, 400);\n1146→\n1147→  await sayInChat(chat, text);\n1148→  return c.json({ ok: true, conversationId: chat.externalId }, 201);\n1149→});\n1150→\n1151→/** 用量与花费：按模型累计，来自 durable 自己维护的 pi.usage */\n1152→app.get(\"/api/v1/agent/usage\", async (c) => {\n1153→  if (!readLlmConfig()) return c.json({ models: [] });\n1154→  return c.json(await usageSummary());\n1155→});\n1156→\n1157→/**\n1158→ * 全部数据导出（2026-11-05 J1，接口文档 §2.5）。\n1159→ *\n1160→ * 用户拍板：导出进设置页，单对话导出退役。这里只聚合「可见数据」——\n1161→ * 会话清单复用 listChats（已排除 hide / task-），消息走 §2.2 同一条读取路径，\n1162→ * providers 用 modelCatalog 投影（无 keyEnv，密钥永不出内）。\n1163→ * 任何一步失败就整体 503，不出半份。\n1164→ */\n1165→const EXPORT_CHAT_LIMIT = 5000;\n1166→const EXPORT_MESSAGE_LIMIT = 500;\n1167→\n1168→app.get(\"/api/v1/agent/export\", async (c) => {\n1169→  try {\n1170→    const catalog = modelCatalog();\n1171→    const chats = await listChats(EXPORT_CHAT_LIMIT);\n1172→    const conversations: {\n1173→      id: string;\n1174→      title: string;\n1175→      pinned: boolean;\n1176→      messages: {\n1177→        role: string;\n1178→        at: number;\n1179→        text: string;\n1180→        /** 用户消息的图片（2026-11-08 4a）：导出是\"全部数据\"，不能把图悄悄丢掉 */\n1181→        images?: { mimeType: string; data: string }[];\n1182→      }[];\n1183→    }[] = [];\n1184→    let messageCount = 0;\n1185→\n1186→    for (const chat of chats) {\n1187→      const resolved = await openChat(chat.conversationId);\n1188→      if (!resolved) throw new Error(`会话 ${chat.conversationId} 打不开`);\n1189→      const messages = await readTranscript(resolved, EXPORT_MESSAGE_LIMIT);\n1190→      messageCount += messages.length;\n1191→      conversations.push({\n1192→        id: chat.conversationId,\n1193→        title: chat.title || chat.firstText,\n1194→        pinned: Boolean(chat.pinned),\n1195→        messages: messages.map(({ role, at, text, images }) => ({\n1196→          role,\n1197→          at,\n1198→          text,\n1199→          ...(images ? { images } : {}),\n1200→        })),\n1201→      });\n1202→    }\n1203→\n1204→    const usage = readLlmConfig() ? await usageSummary() : { models: [] };\n1205→    const exportedAt = new Date().toISOString();\n1206→    const stamp = exportedAt.slice(0, 10);\n1207→\n1208→    // 只记条数，不含任何对话内容\n1209→    console.log(`[export] ${conversations.length} conversations / ${messageCount} messages`);\n1210→    c.header(\"Content-Disposition\", `attachment; filename=\"selenite-export-${stamp}.json\"`);\n1211→    return c.json({\n1212→      exportedAt,\n1213→      conversations,\n1214→      providers: catalog.providers,\n1215→      modelSelection: catalog.current,\n1216→      usage,\n1217→    });\n1218→  } catch (error) {\n1219→    const message = error instanceof Error ? error.message : String(error);\n1220→    console.error(`[export] 失败: ${message}`);\n1221→    return c.json({ error: \"export_failed\", message }, 503);\n1222→  }\n1223→});\n1224→\n1225→/**\n1226→ * 上下文占用（批次二）：给标题栏「已用/窗口」徽标用；mock 下两者皆 null。\n1227→ *\n1228→ * 2026-11-10 批 20 §四在同一条路径上加了**定点找回**（`?aroundIndex=<n>&radius=5`）：\n1229→ * 无 `aroundIndex` 时逐字节保持旧语义（`{used, window}`），因为早先已有客户端在用；\n1230→ * 带 `aroundIndex` 时走「旧会话定点找回」。两条语义靠参数分流，回滚开关只管新语义。\n1231→ */\n1232→app.get(\"/api/v1/agent/chat/:conversationId/context\", async (c) => {\n1233→  const rawIndex = c.req.query(\"aroundIndex\");\n1234→\n1235→  // ── 旧语义：上下文占用（无 aroundIndex 时行为不变）──\n1236→  if (rawIndex === undefined) {\n1237→    if (!readLlmConfig()) return c.json({ used: null, window: null });\n1238→    const chat = await openChat(c.req.param(\"conversationId\"));\n1239→    if (!chat) return c.json({ error: \"unknown_conversation\" }, 404);\n1240→    return c.json(await contextUsageOf(chat.conversation));\n1241→  }\n1242→\n1243→  // ── 新语义：旧会话定点找回（2026-11-10 批 20 §四，接口文档 §2.2.2）──\n1244→  if (!chatContextLookupEnabled()) return c.json({ error: \"not_found\" }, 404);\n1245→\n1246→  const aroundIndex = parseAroundIndex(rawIndex);\n1247→  if (aroundIndex === null) {\n1248→    return c.json(\n1249→      { error: \"bad_request\", message: \"aroundIndex 必须是非负整数（消息数组下标，从 0 开始）\" },\n1250→      400,\n1251→    );\n1252→  }\n1253→  const radius = parseContextRadius(c.req.query(\"radius\"));\n1254→  if (radius === null) {\n1255→    return c.json({ error: \"bad_request\", message: \"radius 必须是 0–50 的整数\" }, 400);\n1256→  }\n1257→  if (!readLlmConfig()) return c.json({ ok: false, reason: \"llm_not_configured\" }, 503);\n1258→\n1259→  const chat = await openChat(c.req.param(\"conversationId\"));\n1260→  if (!chat) return c.json({ error: \"unknown_conversation\" }, 404);\n1261→\n1262→  // transcript 没有 seq（前置勘察确认）：用消息数组下标寻址，不为这个改内核。\n1263→  const messages = await readTranscript(chat, 0);\n1264→  const total = messages.length;\n1265→  if (total === 0) {\n1266→    return c.json({\n1267→"
    },
