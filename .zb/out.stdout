      "type": "text",
      "text": "   1→import { BACKGROUND_CONTEXT } from \"@earendil-works/chord/context\";\n   2→import { contentText } from \"@earendil-works/pi-ai\";\n   3→import { defineDoc, type Conversation } from \"@earendil-works/pi-durable\";\n   4→import { currentProjectEnabled, projectsStore } from \"../projects.ts\";\n   5→\n   6→export const CTX = BACKGROUND_CONTEXT;\n   7→\n   8→export const DB_PATH = process.env.AGENT_DB_PATH?.trim() || \".data/agent.sqlite\";\n   9→/** 工具读写文件的基准目录。默认是服务进程的工作目录 */\n  10→const WORKDIR = process.env.AGENT_WORKDIR?.trim() || process.cwd();\n  11→\n  12→/**\n  13→ * 当前项目（2026-11-04 侧边栏方案 §2.2/§2.3）：**每轮现读 store，不缓存**。\n  14→ * 切换后下一轮自然生效；目录没了/移出工作区时 getCurrentProject() 返回 null，\n  15→ * cwd 与系统提示回到主工作区形态。`CURRENT_PROJECT=false` 时整体旁路。\n  16→ */\n  17→export function currentProject(): { name: string; rootPath: string } | null {\n  18→\tif (!currentProjectEnabled()) return null;\n  19→\ttry {\n  20→\t\treturn projectsStore().getCurrentProject();\n  21→\t} catch {\n  22→\t\t// 项目存储坏了不该让对话失败：退回主工作区\n  23→\t\treturn null;\n  24→\t}\n  25→}\n  26→\n  27→/** 本轮会话执行环境的 cwd（当前项目根优先，否则 WORKDIR） */\n  28→export function sessionCwd(): string {\n  29→\treturn currentProject()?.rootPath ?? WORKDIR;\n  30→}\n  31→\n  32→// ── 对外会话 id ↔ 内部会话 id ────────────────────────────\n  33→/**\n  34→ * durable 的会话 id 是存储自增的整数，猜得到。\n  35→ * 所以对外的 id 仍是服务端生成的 uuid，存在这个 session 文档里做映射 ——\n  36→ * \"id 不可猜\"这条性质必须保住，否则谁都能编一个数字去读别人的历史。\n  37→ */\n  38→/**\n  39→ * 任务会话的 id 前缀（2026-10-31，与 `openai-compat.ts` 的 `X-Task` 通道约定）。\n  40→ *\n  41→ * 定义在这里是因为 `listChats` 要用它过滤——任务会话不该出现在\"历史对话\"列表里：\n  42→ * 它们的首句是\"请整理成稿\"这种**指令**，不是用户说过的话，混进列表只会让人莫名其妙。\n  43→ * 正文照旧能按 id 回读（`GET /api/v1/agent/chat/:id/messages`），只是不露头。\n  44→ */\n  45→export const TASK_CONVERSATION_PREFIX = \"task-\";\n  46→\n  47→export const Chats = defineDoc<{ byExternal: Record<string, number> }>({\n  48→\tkind: \"lifediary.chats\",\n  49→\tversion: 1,\n  50→\tscope: \"session\",\n  51→\tinitial: () => ({ byExternal: {} }),\n  52→\tcheckpointWhen: () => false,\n  53→});\n  54→\n  55→/**\n  56→ * 会话种类表（2026-11-06 侧栏调整 B2）：durable 内部会话 id → `chief | worker`。\n  57→ *\n  58→ * 为什么放 durable 而不是前端/本地文件：身份要跨刷新、跨标签页、跨重启稳定，\n  59→ * 且不能被客户端自报（否则\"普通会话\"只是一句 UI 文案）。存在内部 id 上，\n  60→ * 与对外 uuid 解耦——id 映射换实现时这张表不用动。\n  61→ *\n  62→ * 缺项 = 这次改动之前建的旧会话 = `chief`（默认仍是总管，手机与旧调用方零改动）。\n  63→ */\n  64→export const ChatKinds = defineDoc<{ byInternal: Record<string, \"chief\" | \"worker\"> }>({\n  65→\tkind: \"lifediary.chat-kinds\",\n  66→\tversion: 1,\n  67→\tscope: \"session\",\n  68→\tinitial: () => ({ byInternal: {} }),\n  69→\tcheckpointWhen: () => false,\n  70→});\n  71→\n  72→export interface ResolvedChat {\n  73→\tconversation: Conversation;\n  74→\t/** 对外 id，客户端存的是这个 */\n  75→\texternalId: string;\n  76→\t/** 存储内部 id，记忆作用域用它（稳定，且不对客户端暴露） */\n  77→\tinternalId: number;\n  78→}\n  79→\n  80→/** 一轮里的两个可见阶段：在想 / 在动手（工具执行中） */\n  81→export type TurnPhase = \"thinking\" | \"working\";\n  82→\n  83→/** 每个会话的\"当前阶段\"订阅者（由 chatStream 注册，工具钩子往里推） */\n  84→const phaseSinks = new Map<number, Set<(phase: TurnPhase) => void>>();\n  85→\n  86→export function watchPhase(\n  87→\tconversationId: number,\n  88→\tsink: (phase: TurnPhase) => void,\n  89→): () => void {\n  90→\tlet set = phaseSinks.get(conversationId);\n  91→\tif (!set) {\n  92→\t\tset = new Set();\n  93→\t\tphaseSinks.set(conversationId, set);\n  94→\t}\n  95→\tset.add(sink);\n  96→\treturn () => {\n  97→\t\tset.delete(sink);\n  98→\t\tif (set.size === 0) phaseSinks.delete(conversationId);\n  99→\t};\n 100→}\n 101→\n 102→// ── 全局事件口（2026-11-05 批次B B3）：例行任务引擎的触发源之一 ──\n 103→export interface GlobalAgentEvent {\n 104→\tconversationId: number;\n 105→\tkind: \"phase\" | \"tool\";\n 106→\tphase?: TurnPhase;\n 107→\ttool?: ToolEvent;\n 108→}\n 109→const globalEventSinks = new Set<(event: GlobalAgentEvent) => void>();\n 110→\n 111→export function watchAllEvents(sink: (event: GlobalAgentEvent) => void): () => void {\n 112→\tglobalEventSinks.add(sink);\n 113→\treturn () => {\n 114→\t\tglobalEventSinks.delete(sink);\n 115→\t};\n 116→}\n 117→\n 118→function emitGlobalAgent(event: GlobalAgentEvent): void {\n 119→\tfor (const sink of globalEventSinks) {\n 120→\t\ttry {\n 121→\t\t\tsink(event);\n 122→\t\t} catch {\n 123→\t\t\t/* 观察方异常不影响主链路 */\n 124→\t\t}\n 125→\t}\n 126→}\n 127→\n 128→export function emitPhase(conversationId: number, phase: TurnPhase): void {\n 129→\temitGlobalAgent({ conversationId, kind: \"phase\", phase });\n 130→\tconst set = phaseSinks.get(conversationId);\n 131→\tif (!set) return;\n 132→\tfor (const sink of set) {\n 133→\t\ttry {\n 134→\t\t\tsink(phase);\n 135→\t\t} catch {\n 136→\t\t\t/* 订阅方异常不该影响工具执行 */\n 137→\t\t}\n 138→\t}\n 139→}\n 140→\n 141→/** 一次工具调用的起止（由 beforeTool / afterTool 钩子推，chatStream 取出去） */\n 142→export interface ToolEvent {\n 143→\tname: string;\n 144→\tstatus: \"start\" | \"end\";\n 145→\tlabel?: string;\n 146→\tok?: boolean;\n 147→\toutput?: string;\n 148→\targs?: string;\n 149→}\n 150→\n 151→/** 参数也截断：`write` 的 content 可能是整个文件，塞进事件里会把流撑爆 */\n 152→const TOOL_ARGS_LIMIT = 1200;\n 153→\n 154→export function toolArgs(args: unknown): { args?: string } {\n 155→\tif (!args || typeof args !== \"object\") return {};\n 156→\tconst trimmed: Record<string, unknown> = {};\n 157→\tfor (const [key, value] of Object.entries(args as Record<string, unknown>)) {\n 158→\t\tif (typeof value === \"string\" && value.length > 200) {\n 159→\t\t\ttrimmed[key] = `${value.slice(0, 200)}…（共 ${value.length} 字符）`;\n 160→\t\t} else {\n 161→\t\t\ttrimmed[key] = value;\n 162→\t\t}\n 163→\t}\n 164→\tlet text: string;\n 165→\ttry {\n 166→\t\ttext = JSON.stringify(trimmed, null, 2);\n 167→\t} catch {\n 168→\t\treturn {};\n 169→\t}\n 170→\tif (text.length > TOOL_ARGS_LIMIT) {\n 171→\t\ttext = `${text.slice(0, TOOL_ARGS_LIMIT)}\\n…`;\n 172→\t}\n 173→\treturn { args: text };\n 174→}\n 175→\n 176→/**\n 177→ * 工具结果的截断上限。\n 178→ *\n 179→ * 2000 字符 ≈ 一屏多一点，够看清「命令输出了什么 / 文件头长什么样」；\n 180→ * 再长就该去磁盘上看了，塞进事件里只会把流撑大。\n 181→ */\n 182→export const TOOL_OUTPUT_LIMIT = 2000;\n 183→\n 184→export function toolOutput(result: { output?: unknown }): { output?: string } {\n 185→\t// output 是 (TextContent | ImageContent)[]，只取文字；图片不进状态条\n 186→\tconst text = contentText((result.output ?? []) as never).trim();\n 187→\tif (!text) return {};\n 188→\treturn {\n 189→\t\toutput:\n 190→\t\t\ttext.length > TOOL_OUTPUT_LIMIT\n 191→\t\t\t\t? `${text.slice(0, TOOL_OUTPUT_LIMIT)}\\n…（还有 ${text.length - TOOL_OUTPUT_LIMIT} 字符）`\n 192→\t\t\t\t: text,\n 193→\t};\n 194→}\n 195→\n 196→const toolSinks = new Map<number, Set<(event: ToolEvent) => void>>();\n 197→\n 198→export function watchTool(conversationId: number, sink: (event: ToolEvent) => void): () => void {\n 199→\tlet set = toolSinks.get(conversationId);\n 200→\tif (!set) {\n 201→\t\tset = new Set();\n 202→\t\ttoolSinks.set(conversationId, set);\n 203→\t}\n 204→\tset.add(sink);\n 205→\treturn () => {\n 206→\t\tset.delete(sink);\n 207→\t\tif (set.size === 0) toolSinks.delete(conversationId);\n 208→\t};\n 209→}\n 210→\n 211→export function emitTool(conversationId: number, event: ToolEvent): void {\n 212→\temitGlobalAgent({ conversationId, kind: \"tool\", tool: event });\n 213→\tconst set = toolSinks.get(conversationId);\n 214→\tif (!set) return;\n 215→\tfor (const sink of set) {\n 216→\t\ttry {\n 217→\t\t\tsink(event);\n 218→\t\t} catch {\n 219→\t\t\t/* 订阅方异常不该影响工具执行 */\n 220→\t\t}\n 221→\t}\n 222→}\n 223→\n 224→/**\n 225→ * 从工具参数里挑一个最能说明\"在干什么\"的值。\n 226→ *\n 227→ * 刻意不 dump 整个 arguments：里面有正文（remember 的记忆文本、write 的文件内容），\n 228→ * 界面上一行放不下，也不该把用户正文塞进状态条。挑不到就返回 undefined，\n 229→ * 客户端退回只显示工具名。\n 230→ */\n 231→export function toolLabel(args: unknown): string | undefined {\n 232→\tif (!args || typeof args !== \"object\") return undefined;\n 233→\tconst values = args as Record<string, unknown>;\n 234→\tconst keys = [\n 235→\t\t\"path\",\n 236→\t\t\"file_path\",\n 237→\t\t\"filePath\",\n 238→\t\t\"command\",\n 239→\t\t\"query\",\n 240→\t\t\"pattern\",\n 241→\t\t\"requirement\",\n 242→\t\t\"text\",\n 243→\t\t\"url\",\n 244→\t\t\"name\",\n 245→\t];\n 246→\tfor (const key of keys) {\n 247→\t\tconst value = values[key];\n 248→\t\tif (typeof value !== \"string\") continue;\n 249→\t\tconst one = value.replace(/\\s+/g, \" \").trim();\n 250→\t\tif (one) return one.length > 72 ? `${one.slice(0, 72)}…` : one;\n 251→\t}\n 252→\treturn undefined;\n 253→}\n 254→"
    },
