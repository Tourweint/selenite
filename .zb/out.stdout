    "output": {
      "type": "text",
      "text": "   1→import { createHash, randomBytes, randomInt, timingSafeEqual } from \"node:crypto\";\n   2→import { existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from \"node:fs\";\n   3→import { networkInterfaces } from \"node:os\";\n   4→import { dirname } from \"node:path\";\n   5→\n   6→/**\n   7→ * 一次性配对码 + 设备凭据（2026-10-29）。\n   8→ *\n   9→ * 背景：App 端去掉了账号体系，但 harness 仍需要回答\"这台手机是不是被允许的\"。\n  10→ * 设计取舍（详见 App 仓库 `docs/设计方案/2026-10-29-去账号化与改连Harness改造方案.md` §4.6）：\n  11→ *\n  12→ * - **码里不放长期密钥**：二维码只含 6 位短码（默认 300 秒、单次、错 5 次作废），\n  13→ *   手机拿码换一个长期 `deviceToken`。截图泄露的是废码，不是凭据。\n  14→ * - **落库不落明文**：码与设备令牌都只存 sha256；库文件泄露 ≠ 凭据可用。\n  15→ * - **只存文件不建表**：数据量极小（一枚码 + 几台设备），不值得为它开一个 SQLite schema；\n  16→ *   也刻意不混进 pi-durable 的存储（那边的表由内核管，外部表混进去升级会痛）。\n  17→ */\n  18→\n  19→const CODE_TTL_SECONDS = Number(process.env.PAIR_CODE_TTL_SECONDS ?? 300);\n  20→const MAX_CODE_ATTEMPTS = 5;\n  21→const MAX_DEVICES = 32;\n  22→\n  23→const STORE_PATH =\n  24→\tprocess.env.PAIRING_STORE_PATH?.trim() || \".data/pairing.json\";\n  25→\n  26→interface StoredCode {\n  27→\t/** sha256(code)，不存明文 */\n  28→\thash: string;\n  29→\texpiresAt: number;\n  30→\tusedAt?: number;\n  31→\tattempts: number;\n  32→}\n  33→\n  34→interface StoredDevice {\n  35→\tid: string;\n  36→\tname: string;\n  37→\t/** sha256(deviceToken) */\n  38→\ttokenHash: string;\n  39→\tcreatedAt: number;\n  40→\tlastSeenAt?: number;\n  41→\trevokedAt?: number;\n  42→}\n  43→\n  44→interface Store {\n  45→\tcode?: StoredCode;\n  46→\tdevices: StoredDevice[];\n  47→}\n  48→\n  49→export type RedeemError =\n  50→\t| \"unknown_code\"\n  51→\t| \"code_used\"\n  52→\t| \"code_expired\"\n  53→\t| \"too_many_attempts\";\n  54→\n  55→export interface RedeemResult {\n  56→\tdeviceToken: string;\n  57→\tdeviceId: string;\n  58→}\n  59→\n  60→function sha256(value: string): string {\n  61→\treturn createHash(\"sha256\").update(value).digest(\"hex\");\n  62→}\n  63→\n  64→/** 定长比较（两个 sha256 hex 等长），避免把\"前缀对了\"泄露给计时攻击 */\n  65→function hashEquals(a: string, b: string): boolean {\n  66→\tconst bufferA = Buffer.from(a);\n  67→\tconst bufferB = Buffer.from(b);\n  68→\tif (bufferA.length !== bufferB.length) return false;\n  69→\treturn timingSafeEqual(bufferA, bufferB);\n  70→}\n  71→\n  72→function load(): Store {\n  73→\ttry {\n  74→\t\tif (!existsSync(STORE_PATH)) return { devices: [] };\n  75→\t\tconst parsed = JSON.parse(readFileSync(STORE_PATH, \"utf8\")) as Store;\n  76→\t\treturn { code: parsed.code, devices: Array.isArray(parsed.devices) ? parsed.devices : [] };\n  77→\t} catch (error) {\n  78→\t\t// 文件损坏就当作没有配对过（设备得重新扫一次），而不是让服务起不来\n  79→\t\tconsole.warn(\n  80→\t\t\t`[pairing] 读取 ${STORE_PATH} 失败，按空状态继续: ${error instanceof Error ? error.message : String(error)}`,\n  81→\t\t);\n  82→\t\treturn { devices: [] };\n  83→\t}\n  84→}\n  85→\n  86→function save(store: Store): void {\n  87→\tmkdirSync(dirname(STORE_PATH), { recursive: true });\n  88→\tconst tmp = `${STORE_PATH}.tmp`;\n  89→\twriteFileSync(tmp, JSON.stringify(store, null, 2), \"utf8\");\n  90→\trenameSync(tmp, STORE_PATH);\n  91→}\n  92→\n  93→export class PairingStore {\n  94→\tprivate store: Store = load();\n  95→\n  96→\t/** 生成一枚新码（同一时刻只保留一枚；新码顶掉旧码）。返回明文码，只在此刻存在。 */\n  97→\tissueCode(now = Date.now()): { code: string; expiresAt: number } {\n  98→\t\tconst code = String(randomInt(0, 1_000_000)).padStart(6, \"0\");\n  99→\t\tconst expiresAt = now + CODE_TTL_SECONDS * 1000;\n 100→\t\tthis.store.code = { hash: sha256(code), expiresAt, attempts: 0 };\n 101→\t\tsave(this.store);\n 102→\t\treturn { code, expiresAt };\n 103→\t}\n 104→\n 105→\t/** 当前是否还有一枚可用码（调试页据此显示\"生成/等待扫码\"） */\n 106→\thasLiveCode(now = Date.now()): boolean {\n 107→\t\tconst code = this.store.code;\n 108→\t\treturn !!code && !code.usedAt && code.expiresAt > now && code.attempts < MAX_CODE_ATTEMPTS;\n 109→\t}\n 110→\n 111→\t/** 用码换设备凭据。失败会累计尝试次数（撞上限即作废这枚码）。 */\n 112→\tredeem(code: string, deviceName: string, now = Date.now()): RedeemResult | RedeemError {\n 113→\t\tconst current = this.store.code;\n 114→\t\tif (!current) return \"unknown_code\";\n 115→\t\tif (current.usedAt) return \"code_used\";\n 116→\t\tif (current.expiresAt <= now) return \"code_expired\";\n 117→\t\tif (current.attempts >= MAX_CODE_ATTEMPTS) return \"too_many_attempts\";\n 118→\n 119→\t\tif (!hashEquals(current.hash, sha256(code.trim()))) {\n 120→\t\t\tcurrent.attempts += 1;\n 121→\t\t\tsave(this.store);\n 122→\t\t\treturn current.attempts >= MAX_CODE_ATTEMPTS ? \"too_many_attempts\" : \"unknown_code\";\n 123→\t\t}\n 124→\n 125→\t\tconst deviceToken = randomBytes(32).toString(\"base64url\");\n 126→\t\tconst device: StoredDevice = {\n 127→\t\t\tid: randomBytes(8).toString(\"hex\"),\n 128→\t\t\tname: deviceName.trim().slice(0, 40) || \"手机\",\n 129→\t\t\ttokenHash: sha256(deviceToken),\n 130→\t\t\tcreatedAt: now,\n 131→\t\t};\n 132→\t\tcurrent.usedAt = now;\n 133→\t\t// 设备上限：踢掉最久没用过的那台（防无限堆积）\n 134→\t\tthis.store.devices = [...this.store.devices, device]\n 135→\t\t\t.filter((item) => !item.revokedAt)\n 136→\t\t\t.sort((a, b) => (b.lastSeenAt ?? b.createdAt) - (a.lastSeenAt ?? a.createdAt))\n 137→\t\t\t.slice(0, MAX_DEVICES);\n 138→\t\tsave(this.store);\n 139→\t\treturn { deviceToken, deviceId: device.id };\n 140→\t}\n 141→\n 142→\t/** 设备凭据是否有效（每次请求都会走一次；命中即刷新 lastSeenAt，但最多每分钟落一次盘） */\n 143→\tverifyDeviceToken(token: string, now = Date.now()): boolean {\n 144→\t\tconst hash = sha256(token);\n 145→\t\tlet touched = false;\n 146→\t\tfor (const device of this.store.devices) {\n 147→\t\t\tif (device.revokedAt) continue;\n 148→\t\t\tif (!hashEquals(device.tokenHash, hash)) continue;\n 149→\t\t\tif (!device.lastSeenAt || now - device.lastSeenAt > 60_000) {\n 150→\t\t\t\tdevice.lastSeenAt = now;\n 151→\t\t\t\ttouched = true;\n 152→\t\t\t}\n 153→\t\t\tif (touched) save(this.store);\n 154→\t\t\treturn true;\n 155→\t\t}\n 156→\t\treturn false;\n 157→\t}\n 158→\n 159→\tlistDevices(): Array<Omit<StoredDevice, \"tokenHash\">> {\n 160→\t\treturn this.store.devices.map(({ tokenHash: _hidden, ...rest }) => rest);\n 161→\t}\n 162→\n 163→\trevokeDevice(id: string, now = Date.now()): boolean {\n 164→\t\tconst device = this.store.devices.find((item) => item.id === id && !item.revokedAt);\n 165→\t\tif (!device) return false;\n 166→\t\tdevice.revokedAt = now;\n 167→\t\tsave(this.store);\n 168→\t\treturn true;\n 169→\t}\n 170→\n 171→\t/** 调试页展示：当前码还剩多少秒（没有可用码返回 0） */\n 172→\tcodeRemainingSeconds(now = Date.now()): number {\n 173→\t\tconst code = this.store.code;\n 174→\t\tif (!code || code.usedAt || code.expiresAt <= now) return 0;\n 175→\t\treturn Math.max(0, Math.ceil((code.expiresAt - now) / 1000));\n 176→\t}\n 177→}\n 178→\n 179→/** 配对链接：手机扫出来的就是这一行（自定义 scheme，App 自己 parse） */\n 180→export function buildPairUrl(base: string, code: string): string {\n 181→\tconst url = new URL(base.startsWith(\"http\") ? base : `http://${base}`);\n 182→\treturn `lifediary-pair://v1?base=${encodeURIComponent(url.origin)}&code=${code}`;\n 183→}\n 184→\n 185→/**\n 186→ * 手机该连的地址：显式 `PAIR_BASE_URL` 优先，否则取首个非内网回环的 IPv4 + 端口。\n 187→ * 手机经 USB 反代时也可能填 127.0.0.1，所以这里只负责\"给一个大概率可用的默认值\"。\n 188→ */\n 189→export function resolvePairBase(port: number): string {\n 190→\tconst explicit = process.env.PAIR_BASE_URL?.trim();\n 191→\tif (explicit) return explicit.replace(/\\/+$/, \"\");\n 192→\tconst interfaces = networkInterfaces();\n 193→\tfor (const group of Object.values(interfaces)) {\n 194→\t\tfor (const item of group ?? []) {\n 195→\t\t\tif (item.family === \"IPv4\" && !item.internal) return `http://${item.address}:${port}`;\n 196→\t\t}\n 197→\t}\n 198→\treturn `http://127.0.0.1:${port}`;\n 199→}\n 200→"
    },
