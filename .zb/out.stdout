      "text": " 405→ * 第 4 条靠进程内 run 标记（beforeRequest 认领），不读库、不受存储抖动影响。\n 406→ */\n 407→function relayToolBlockReason(conversationId: number): string | undefined {\n 408→\tif (!COMPANIONS_ENABLED) return RELAY_CALLER_BLOCK_MESSAGE;\n 409→\tif (isAutonomyTurn(conversationId)) return RELAY_AUTONOMY_BLOCK_MESSAGE;\n 410→\tlet store: ReturnType<typeof partnersStore>;\n 411→\ttry {\n 412→\t\tstore = partnersStore();\n 413→\t} catch {\n 414→\t\treturn \"执事档案读不到，暂时不能递话。\";\n 415→\t}\n 416→\tif (store.isGroupSession(conversationId)) return RELAY_GROUP_BLOCK_MESSAGE;\n 417→\tconst partnerId = store.partnerIdOfSession(conversationId);\n 418→\tif (!partnerId) return RELAY_CALLER_BLOCK_MESSAGE;\n 419→\tif (partnerId === CHIEF_PARTNER_ID) return RELAY_CHIEF_BLOCK_MESSAGE;\n 420→\tconst runKey = currentRelayRunKey(conversationId);\n 421→\t// run 键由 beforeRequest 写；缺失说明这一轮没走过正常装配（理论上不可能），\n 422→\t// fail-closed：宁可拒一次递话，也不让\"防乒乓\"在未知形态下失守。\n 423→\tif (!runKey) return \"这一轮的状态读不出来，暂时不能递话。\";\n 424→\tif (isRelayRun(conversationId, runKey)) return RELAY_HOP_BLOCK_MESSAGE;\n 425→\treturn undefined;\n 426→}\n 427→\n 428→async function openHarness(): Promise<Harness> {\n 429→\tconst config = readLlmConfig();\n 430→\tif (!config) throw new Error(\"LLM 未配置：设 LLM_API_KEY 之后再启动\");\n 431→\n 432→\tmkdirSync(dirname(DB_PATH), { recursive: true });\n 433→\tconst storage = await openNodeSqliteStorage(DB_PATH);\n 434→\n 435→"
    },
