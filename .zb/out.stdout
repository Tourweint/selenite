    "arguments": "{\"file_path\": \"D:\\\\Projects\\\\projects\\\\lh-b26\\\\ts\\\\apps\\\\server\\\\scripts\\\\http-probe.ts\", \"new_string\": \"\\t// 多副本聚合夹具（批 26 §二）：groupId 就是 ticket.idempotencyKey。\\n\\t// 同一个库里 idempotency_key 有唯一约束，所以同组的两张必须分散在不同 runs 目录\\n\\t// （真实扇出也是按领域分目录落的）—— 这里放一张在顶层，另一张放到下面领域目录。\\n\\tstore.saveTicket(\\n\\t\\tfixture(\\\"T-group-a\\\", { idempotencyKey: \\\"probe-group-1\\\", status: \\\"done\\\" }),\\n\\t);\\n\\tstore.saveTicket(\\n\\t\\tfixture(\\\"T-group-c\\\", { idempotencyKey: \\\"probe-group-2\\\", status: \\\"done\\\" }),\\n\\t);\\n\\tstore.close();\", \"old_string\": \"\\t// 多副本聚合夹具（批 26 §二）：同 requestId 的两张，一张终态一张在办；\\n\\t// 另一组两张都终态（settled）。groupId 就是 ticket.idempotencyKey。\\n\\tstore.saveTicket(\\n\\t\\tfixture(\\\"T-group-a\\\", { idempotencyKey: \\\"probe-group-1\\\", status: \\\"done\\\" }),\\n\\t);\\n\\tstore.saveTicket(fixture(\\\"T-group-b\\\", { idempotencyKey: \\\"probe-group-1\\\" }));\\n\\tstore.saveTicket(\\n\\t\\tfixture(\\\"T-group-c\\\", { idempotencyKey: \\\"probe-group-2\\\", status: \\\"done\\\" }),\\n\\t);\\n\\tstore.saveTicket(\\n\\t\\tfixture(\\\"T-group-d\\\", { idempotencyKey: \\\"probe-group-2\\\", status: \\\"failed\\\" }),\\n\\t);\\n\\tstore.close();\"}",
