versationId: chat.externalId,\n1287→      total,\n1288→      aroundIndex,\n1289→      radius,\n1290→      from: 0,\n1291→      to: -1,\n1292→      messages: [],\n1293→    });\n1294→  }\n1295→  if (aroundIndex >= total) {\n1296→    return c.json(\n1297→      { error: \"bad_request\", message: `aroundIndex 超出范围（共 ${total} 条）`, total },\n1298→      400,\n1299→    );\n1300→  }\n1301→\n1302→  const slice = sliceAroundIndex(messages, aroundIndex, radius);\n1303→  return c.json({\n1304→    conversationId: chat.externalId,\n1305→    total,\n1306→    aroundIndex,\n1307→    radius,\n1308→    from: slice.from,\n1309→    to: slice.to,\n1310→    messages: slice.messages.map((message, offset) =>\n1311→      contextMessageOf(message, slice.from + offset),\n1312→    ),\n1313→  });\n1314→});\n1315→\n1316→/** 内容级跨会话搜索（批次二）：逐会话 LIKE，q 最少 2 字符（见接口文档 §2.5） */\n1317→app.get(\"/api/v1/agent/search\", async (c) => {\n1318→  const q = c.req.query(\"q\") ?? \"\";\n1319→  if (q.trim().length < 2) return c.json({ hits: [] });\n1320→"
