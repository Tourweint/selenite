      "text": "10135→/** 搜索从主界面挪到设置里：主页面只留说话框 */\n10136→function wireSettingsSearch() {\n10137→  const input = document.getElementById(\"settings-search\");\n10138→  const results = document.getElementById(\"search-results\");\n10139→  if (!input || !results) return;\n10140→\n10141→  let contentTimer = 0;\n10142→  const renderHits = (box, hits, emptyText) => {\n10143→    box.replaceChildren();\n10144→    if (!hits.length) {\n10145→      const row = document.createElement(\"div\");\n10146→      row.className = \"row\";\n10147→      row.innerHTML = `<div class=\"row-main\"><div class=\"row-hint\">${emptyText}</div></div>`;\n10148→      box.append(row);\n10149→      return;\n10150→    }\n10151→    for (const hit of hits) {\n10152→      const row = document.createElement(\"div\");\n10153→      row.className = \"row search-hit\";\n10154→      row.innerHTML = `<div class=\"row-main\">\n10155→        <div class=\"row-label\">${hit.label}</div>\n10156→        <div class=\"row-hint\">${esc(hit.hint)}</div>\n10157→      </div>`;\n10158→      row.addEventListener(\"click\", () => void openConversation(hit.conversationId));\n10159→      box.append(row);\n10160→    }\n10161→  };\n10162→\n10163→  input.addEventListener(\"input\", () => {\n10164→    const query = input.value.trim();\n10165→    const lower = query.toLowerCase();\n10166→    results.replaceChildren();\n10167→    const contentBox = document.getElementById(\"content-results\");\n10168→    if (contentBox) contentBox.replaceChildren();\n10169→    if (!query) return;\n10170→\n10171→    // 标题/首句：本地即时过滤（原有行为）\n10172→    const hits = state.chats\n10173→      .filter((chat) => `${chat.title || \"\"} ${chat.firstText || \"\"}`.toLowerCase().includes(lower))\n10174→      .slice(0, 8);\n10175→    renderHits(\n10176→      results,\n10177→      hits.map((chat) => ({\n10178→        conversationId: chat.conversationId,\n10179→        label: esc(chatLabel(chat)),\n10180→        hint: `${chat.turns} 轮`,\n10181→      })),\n10182→      \"没有匹配的会话\",\n10183→    );\n10184→\n10185→    // 正文内容（批次二）：≥2 字符才查服务端，300ms 防抖\n10186→    clearTimeout(contentTimer);\n10187→    if (query.length < 2 || !contentBox) return;\n10188→    contentTimer = setTimeout(async () => {\n10189→      try {\n10190→        const response = await request(`/api/v1/agent/search?q=${encodeURIComponent(query)}`, {\n10191→          cache: \"no-store\",\n10192→        });\n10193→        const data = await response.json();\n10194→        const re = new RegExp(query.replace(/[.*+?^${}()|[\\]\\\\]/g, \"\\\\$&\"), \"gi\");\n10195→        const mark = (snippet) =>\n10196→          esc(snippet).replace(re, (m) => `<mark>${m}</mark>`);\n10197→        renderHits(\n10198→          contentBox,\n10199→          (data.hits || []).map((hit) => ({\n10200→            conversationId: hit.conversationId,\n10201→            label: mark(hit.text),\n10202→            hint: `${hit.title || \"对话\"} · ${hit.role === \"user\" ? \"我\" : \"Selenite\"} · ${new Date(hit.at).toLocaleString(\"zh-CN\")}`,\n10203→          })),\n10204→          \"正文里没有命中\",\n10205→        );\n10206→      } catch (error) {\n10207→        if (error.message !== \"forbidden\") {\n10208→          renderHits(contentBox, [], `搜不到：${error.message}`);\n10209→        }\n10210→      }\n10211→    }, 300);\n10212→  });\n10213→}\n10214→\n10215→/** 一行设置 = 标签 + 控件。\n10216→ *  hint 2026-11-08 起默认**不再常驻**；2026-11-09 二改：连 ⓘ 图标也去掉——\n10217→ *  data-tip 直接挂在**标签文字**上，悬停即出全句（全局 data-tip 系统）。\n10218→ *  设置页只留\"状态/结果\"类文案占一行（inlineHint: true，如动态计数、保存反馈）。 */\n10219→function rowMarkup(label, hint, control, { inlineHint = false } = {}) {\n10220→  const tipAttr = hint && !inlineHint ? ` data-tip=\"${attr(hint)}\"` : \"\";\n10221→  return `<div class=\"row\">\n10222→    <div class=\"row-main\">\n10223→      <div class=\"row-label\"${tipAttr}>${label}</div>\n10224→      ${hint && inlineHint ? `<div class=\"row-hint\">${hint}</div>` : \"\"}\n10225→    </div>\n10226→    <div class=\"row-control\">${control}</div>\n10227→  </div>`;\n10228→}\n10229→\n10230→/** 通用开关（2026-11-05 G1）：设置页所有布尔项共用这一份结构，\n10231→ *  几何/形变对齐 CINDY components/ui/switch（36×20 轨道、16px thumb、\n10232→ *  hover 17px / 按下 18×14）。行为（写哪个 key、要不要打接口）由各自的 click 监听决定。 */\n10233→function switchMarkup(checked, { label, attrs = \"\" } = {}) {\n10234→  return `<button class=\"switch\" type=\"button\" role=\"switch\"\n10235→"
