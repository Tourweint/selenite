      "text": " 300→\tconst skills = new Map<string, { summary: string; manual: string }>();\n 301→\tconst claimed = new Set<string>();\n 302→\tfor (const dir of dirs) {\n 303→\t\tfor (const entry of scanSkillDir(dir)) {\n 304→\t\t\tif (claimed.has(entry.name)) continue; // 先到的目录优先\n 305→\t\t\tclaimed.add(entry.name);\n 306→\t\t\tif (!entry.valid) {\n 307→\t\t\t\tconsole.warn(`[skills] 跳过格式不对的技能文件: ${entry.path}`);\n 308→\t\t\t\tcontinue;\n 309→\t\t\t}\n 310→\t\t\tskills.set(entry.name, { summary: entry.summary, manual: entry.manual });\n 311→\t\t}\n 312→\t}\n 313→\tif (skills.size === 0) return null;\n 314→\n 315→\tconst frozen = new Map<number, string | undefined>();\n 316→\tconst renderIndex = (): string | undefined => {\n 317→\t\tconst lines = [...skills.keys()].filter(visible).map((name) => `- ${name}：${skills.get(name)!.summary}`);\n 318→\t\t// 一个可见的都没有：整个 section 省略（接口注释的既有口径），别渲染空标题\n 319→\t\tif (!lines.length) return undefined;\n 320→\t\treturn (\n 321→\t\t\t\"可用技能（对方的事需要按某个流程引导时，先调 skill(name) 取完整手册再开始）：\\n\" +\n 322→\t\t\tlines.join(\"\\n\")\n 323→\t\t);\n 324→\t};\n 325→\n 326→\t// 名字只记前 40 个：`.agents/skills` 可能有上百条，整串打出来日志没法看\n 327→\tconst names = [...skills.keys()];\n 328→\tconst preview = names.slice(0, 40).join(\"、\") + (names.length > 40 ? `、…（共 ${names.length} 条）` : \"\");\n 329→\tconsole.log(`[skills] 已加载 ${skills.size} 条技能：${preview}`);\n 330→\treturn {\n 331→\t\tnames: () => [...skills.keys()].filter(visible),\n 332→\t\tmanual: (name) => (visible(name) ? skills.get(name)?.manual : undefined),\n 333→\t\tindexFor(conversationId) {\n 334→\t\t\t// 全关时渲染结果是 undefined：用 has 判冻，别用 get——undefined 也算\"已冻结\"\n 335→\t\t\tif (!frozen.has(conversationId)) frozen.set(conversationId, renderIndex());\n 336→\t\t\treturn frozen.get(conversationId);\n 337→\t\t},\n 338→\t};\n 339→}\n 340→\n 341→/**\n 342→ * 技能斜杠调用（2026-11-09 用户口径：对话框输入「/技能名」就能用）。\n 343→ * 纯函数：匹配 `/name`（名字规则与 SKILL_NAME 同一条）+ 后面是空白或行尾才算，\n 344→ * `/abc/def` 这种路径样不算。生命周期钩子据此把手册整份注入本轮。\n 345→ */\n 346→export function skillSlashOf(text: string): string | null {\n 347→\tconst match = /^\\/([a-z0-9][a-z0-9-_]{0,63})(?:\\s|$)/.exec(String(text || \"\").trimStart());\n 348→\treturn match ? match[1] : null;\n 349→}\n 350→"
