        "content": "   1→import { mkdirSync, readFileSync, renameSync, rmSync, writeFileSync } from \"node:fs\";\n   2→import { dirname, resolve } from \"node:path\";\n   3→\n   4→/**\n   5→ * 技能启停位（2026-11-09 用户拍板：技能库默认**全关**，界面上逐条/批量开关）。\n   6→ *\n   7→ * 存储：`.data/skills-state.json` = `{ \"enabled\": { \"<skill-name>\": true } }`。\n   8→ * **名单外一律视为关**——文件里没有的名字不进索引、`skill` 工具也取不到（默认全关的口径）。\n   9→ * 服务端管理面写它；agent 侧注入（assist.ts 的 skillStore filter）按它过滤。\n  10→ *\n  11→ * 刻意不做：不把启停位写进技能目录本身（`.agents/skills` 可能是别的工具的家，不掺文件）；\n  12→ * 不做按执事的独立启停（技能索引本来就是全局一份，D5）。\n  13→ * 回滚：删文件 = 全关（默认态）；要回到\"全开不过滤\"的旧行为，`SKILL_STATE=false` 一行。\n  14→ */\n  15→export interface SkillState {\n  16→\tisEnabled(name: string): boolean;\n  17→\tsetEnabled(name: string, enabled: boolean): void;\n  18→\tsetAll(enabled: boolean, names: string[]): void;\n  19→\tpath(): string;\n  20→}\n  21→\n  22→let singleton: SkillState | null = null;\n  23→\n  24→export function skillStatePath(env: NodeJS.ProcessEnv = process.env): string {\n  25→\treturn resolve(env.AGENT_SKILLS_STATE_PATH?.trim() || \".data/skills-state.json\");\n  26→}\n  27→\n  28→/** 旧的\"全部进索引\"行为逃生门（正常情况不用） */\n  29→export function skillStateEnabled(env: NodeJS.ProcessEnv = process.env): boolean {\n  30→\treturn (env.SKILL_STATE ?? \"\").trim().toLowerCase() !== \"false\";\n  31→}\n  32→\n  33→function readMap(path: string): Record<string, boolean> {\n  34→\ttry {\n  35→\t\tconst parsed = JSON.parse(readFileSync(path, \"utf8\")) as unknown;\n  36→\t\tconst enabled = (parsed as { enabled?: unknown })?.enabled;\n  37→\t\tif (enabled && typeof enabled === \"object\" && !Array.isArray(enabled)) {\n  38→\t\t\tconst out: Record<string, boolean> = {};\n  39→\t\t\tfor (const [name, on] of Object.entries(enabled as Record<string, unknown>)) {\n  40→\t\t\t\tif (typeof on === \"boolean\") out[name] = on;\n  41→\t\t\t}\n  42→\t\t\treturn out;\n  43→\t\t}\n  44→\t} catch {\n  45→\t\t/* 文件不存在 / 坏 JSON：全部视为关（默认态） */\n  46→\t}\n  47→\treturn {};\n  48→}\n  49→\n  50→function writeMap(path: string, enabled: Record<string, boolean>): void {\n  51→\tmkdirSync(dirname(path), { recursive: true });\n  52→\tconst temp = `${path}.tmp-${process.pid}-${Date.now()}`;\n  53→\ttry {\n  54→\t\twriteFileSync(temp, `${JSON.stringify({ enabled }, null, \"\\t\")}\\n`, \"utf8\");\n  55→\t\trenameSync(temp, path);\n  56→\t} catch (error) {\n  57→\t\trmSync(temp, { force: true });\n  58→\t\tthrow error;\n  59→\t}\n  60→}\n  61→\n  62→export function createSkillState(path: string): SkillState {\n  63→\treturn {\n  64→\t\tisEnabled(name) {\n  65→\t\t\treturn readMap(path)[name] === true;\n  66→\t\t},\n  67→\t\tsetEnabled(name, enabled) {\n  68→\t\t\tconst map = readMap(path);\n  69→\t\t\tif (enabled) map[name] = true;\n  70→\t\t\telse delete map[name]; // 关 = 从名单里拿掉，文件只存\"开着\"的\n  71→\t\t\twriteMap(path, map);\n  72→\t\t},\n  73→\t\tsetAll(enabled, names) {\n  74→\t\t\tconst map = readMap(path);\n  75→\t\t\tif (enabled) {\n  76→\t\t\t\tfor (const name of names) map[name] = true;\n  77→\t\t\t} else {\n  78→\t\t\t\tfor (const name of names) delete map[name];\n  79→\t\t\t}\n  80→\t\t\twriteMap(path, map);\n  81→\t\t},\n  82→\t\tpath: () => path,\n  83→\t};\n  84→}\n  85→\n  86→/** 懒建单例：路径在第一次调用时才解析（.env 已由 index.ts 主体装好） */\n  87→export function getSkillState(): SkillState {\n  88→\tif (!singleton) singleton = createSkillState(skillStatePath());\n  89→\treturn singleton;\n  90→}\n  91→",
