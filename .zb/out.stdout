      "text": "2788→\tconst bgLogMissing = await fetch(`${BASE}/api/v1/agent/bg-jobs/bg-nope-xxxxxx/log`);\n2789→\tcheck(bgLogMissing.status === 404, \"未知任务日志 → 404\", String(bgLogMissing.status));\n2790→\n2791→\tconst killNotOwned = await fetch(`${BASE}/api/v1/agent/bg-jobs/bg-probe2-bbbbbb/kill`, {\n2792→\t\tmethod: \"POST\",\n2793→\t});\n2794→\tconst killNotOwnedBody = (await killNotOwned.json()) as { error?: string };\n2795→\tcheck(\n2796→\t\tkillNotOwned.status === 409 && killNotOwnedBody.error === \"not_owned_process\",\n2797→\t\t\"不是本进程起的任务 → 409 拒绝\",\n2798→\t\tString(killNotOwned.status),\n2799→\t);\n2800→\tconst killDone = await fetch(`${BASE}/api/v1/agent/bg-jobs/bg-probe1-aaaaaa/kill`, {\n2801→\t\tmethod: \"POST\",\n2802→\t});\n2803→\tcheck(killDone.status === 409, \"已结束任务 → 409\", String(killDone.status));\n2804→\tconst killUnknown = await fetch(`${BASE}/api/v1/agent/bg-jobs/bg-nope-xxxxxx/kill`, {\n2805→\t\tmethod: \"POST\",\n2806→\t});\n2807→\tcheck(killUnknown.status === 404, \"未知任务 kill → 404\", String(killUnknown.status));\n2808→\n2809→\tserver.kill();\n2810→\tawait sleep(800);\n2811→\tserver = startServer({ COMPANIONS_ENABLED: \"true\", AGENT_BASH_BG_TIMEOUT: \"\" });\n2812→\tawait waitForReady();\n2813→\tconst bgOff = await fetch(`${BASE}/api/v1/agent/bg-jobs`);\n2814→\tcheck(bgOff.status === 404, \"开关关着 → 三个端点整组 404\", String(bgOff.status));\n2815→\n2816→\t// ── 30. 配对设备指纹（2026-11-10 批 26 §四，接口文档 §5）──\n2817→\t// 真走一遍裸码配对：redeem 下发指纹 → 设备清单同一指纹 → 清单不含哈希 → 撤销。\n2818→\tconsole.log(\"\\n· 30. 配对设备指纹：redeem 下发 + 设备清单人眼可核\");\n2819→\tconst pairCode = (await (\n2820→\t\tawait fetch(`${BASE}/api/v1/pair/code`, { method: \"POST\" })\n2821→\t).json()) as { code?: string };\n2822→\tconst redeemed = await fetch(`${BASE}/api/v1/pair/redeem`, {\n2823→\t\tmethod: \"POST\",\n2824→\t\theaders: { \"content-type\": \"application/json\" },\n2825→\t\tbody: JSON.stringify({ code: pairCode.code, deviceName: \"探针手机\" }),\n2826→\t});\n2827→\tconst redeemedBody = (await redeemed.json()) as {\n2828→\t\tdeviceToken?: string;\n2829→\t\tdeviceId?: string;\n2830→\t\tfingerprint?: string;\n2831→\t};\n2832→\tcheck(\n2833→\t\tredeemed.status === 200 &&\n2834→\t\t\t/^[0-9A-F]{4}-[0-9A-F]{4}-[0-9A-F]{4}$/.test(redeemedBody.fingerprint ?? \"\"),\n2835→\t\t\"redeem 下发人眼可核指纹（4-4-4）\",\n2836→\t\tString(redeemedBody.fingerprint),\n2837→\t);\n2838→\tconst devicesBody = (await (await fetch(`${BASE}/api/v1/pair/devices`)).json()) as {\n2839→\t\tdevices?: Array<{ id: string; fingerprint?: string; keyChanged?: boolean }>;\n2840→\t};\n2841→\tconst mine = (devicesBody.devices ?? []).find((device) => device.id === redeemedBody.deviceId);\n2842→\tcheck(\n2843→\t\tmine?.fingerprint === redeemedBody.fingerprint,\n2844→\t\t\"设备清单上的指纹与 redeem 一致\",\n2845→\t\tString(mine?.fingerprint),\n2846→\t);\n2847→\tcheck(\n2848→\t\tmine !== undefined && !(\"tokenHash\" in (mine as Record<string, unknown>)),\n2849→\t\t\"设备清单不含凭据哈希\",\n2850→\t);\n2851→\tcheck(mine?.keyChanged !== true, \"正常设备不带键变更标记\");\n2852→\tif (redeemedBody.deviceId) {\n2853→\t\tawait fetch(`${BASE}/api/v1/pair/devices/${redeemedBody.deviceId}/revoke`, { method: \"POST\" });\n2854→\t}\n2855→\n2856→} finally {\n2857→\tserver.kill();\n2858→\tawait sleep(300);\n2859→\tgateUpstream.close();\n2860→"
