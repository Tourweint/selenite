    "output": {
      "type": "text",
      "text": "   1→import assert from \"node:assert/strict\";\n   2→import { existsSync, mkdtempSync, rmSync } from \"node:fs\";\n   3→import { tmpdir } from \"node:os\";\n   4→import { join } from \"node:path\";\n   5→import { test } from \"node:test\";\n   6→import { DatabaseSync } from \"node:sqlite\";\n   7→import { Store } from \"../../../../../../chancellor/src/store.ts\";\n   8→import type { Ticket } from \"../../../../../../chancellor/src/types.ts\";\n   9→import {\n  10→\tBRIEF_CARD_RULES,\n  11→\tbriefCardRulesEnabled,\n  12→\tbuildPartnerDisciplineSection,\n  13→\tbuildPartnerStatusSection,\n  14→\tbuildPartnerTurnContext,\n  15→\trenderContractSection,\n  16→\tsplitContractSections,\n  17→} from \"./partner-context.ts\";\n  18→import { ATTENTION_REPLY_GUIDANCE } from \"../delegation.ts\";\n  19→import {\n  20→\tPARTNER_CONTRACT_SECTIONS,\n  21→\tPartnersStore,\n  22→\tpartnerContractEnabled,\n  23→\tpartnerContractTemplate,\n  24→} from \"../partners.ts\";\n  25→\n  26→/**\n  27→ * 员工人格化刀一（E1 契约 / E5 状态感 / B2 受阻口径）的最小充分单测。\n  28→ *\n  29→ * 全程临时目录：不碰真实 `.data/`（AGENTS 的测试纪律）；审批用桩（ApprovalStore\n  30→ * 是进程单例，单测里不该去读真实的 approvals.json）。\n  31→ */\n  32→\n  33→function tempRoot(): { root: string; db: string; homes: string; workRoot: string } {\n  34→\tconst root = mkdtempSync(join(tmpdir(), \"lifediary-partner-context-\"));\n  35→\treturn {\n  36→\t\troot,\n  37→\t\tdb: join(root, \"partners.sqlite\"),\n  38→\t\thomes: join(root, \"homes\"),\n  39→\t\tworkRoot: join(root, \"runs\"),\n  40→\t};\n  41→}\n  42→\n  43→function ticketFixture(\n  44→\tworkRoot: string,\n  45→\tid: string,\n  46→\tstatus: string,\n  47→\textra: Record<string, unknown> = {},\n  48→): Ticket {\n  49→\tconst now = new Date().toISOString();\n  50→\treturn {\n  51→\t\tid,\n  52→\t\tprompt: `夹具 ${id}`,\n  53→\t\tstatus,\n  54→\t\tcreated_at: now,\n  55→\t\tupdated_at: now,\n  56→\t\toptions: { dry: true, maxTasks: 8, workRoot },\n  57→\t\t...extra,\n  58→\t} as Ticket;\n  59→}\n  60→\n  61→test(\"契约：新建执事播种四节标题（决策分级带调查铁律）；改契约 = 双快照 bump，SOUL / 能力延续\", () => {\n  62→\tconst { root, db, homes } = tempRoot();\n  63→\tconst store = new PartnersStore(db, homes);\n  64→\ttry {\n  65→\t\tconst partner = store.create(\"小澈\");\n  66→\t\tassert.equal(partner.currentVersion, 1);\n  67→\t\tassert.ok(existsSync(join(store.homeOf(partner.id), \"CONTRACT.md\")), \"新建执事要有 CONTRACT.md\");\n  68→\t\tconst template = store.readContractFromHome(partner.id) ?? \"\";\n  69→\t\tassert.equal(template, partnerContractTemplate());\n  70→\t\t// 2026-11-10 批 12 §一.5：四节标题逐字不动，「决策分级」带调查铁律默认正文。\n  71→\t\tfor (const section of PARTNER_CONTRACT_SECTIONS) {\n  72→\t\t\tassert.ok(template.includes(`## ${section}`), `标题逐字保留：${section}`);\n  73→\t\t}\n  74→\t\tassert.match(template, /没有调查不许改/);\n  75→\t\tassert.match(template, /同一条思路连修 3 次还不行/);\n  76→\t\tassert.match(renderContractSection(template) ?? \"\", /## 决策分级[\\s\\S]*自带验收证据/);\n  77→\n  78→\t\tconst v1Soul = store.getVersion(partner.id, 1)?.soulSource ?? \"\";\n  79→\t\tconst contract1 = [\n  80→\t\t\t\"## 职责范围\",\n  81→\t\t\t\"负责前端与桌面壳。\",\n  82→\t\t\t\"\",\n  83→\t\t\t\"## 决策分级\",\n  84→\t\t\t\"改样式自己定；改接口先申请。\",\n  85→\t\t\t\"\",\n  86→\t\t\t\"## 验收标准\",\n  87→\t\t\t\"跑通 typecheck + 探针。\",\n  88→\t\t\t\"\",\n  89→\t\t\t\"## 汇报对象\",\n  90→\t\t\t\"向总管汇报，每周一次。\",\n  91→\t\t].join(\"\\n\");\n  92→\t\tconst v2 = store.bumpContract(partner.id, contract1);\n  93→\t\tassert.equal(v2, 2);\n  94→\t\tconst current2 = store.currentVersion(partner.id);\n  95→\t\tassert.equal(current2?.contractSource, contract1);\n  96→\t\tassert.equal(current2?.soulSource, v1Soul, \"改契约不动 SOUL 正文\");\n  97→\n  98→\t\t// 冻结：v1 的契约快照仍是空模板（演化链可追溯）\n  99→\t\tassert.equal(store.getVersion(partner.id, 1)?.contractSource, partnerContractTemplate());\n 100→\n 101→\t\t// 再改 SOUL：新版本必须把当前契约一起快照过去（一个版本 = 一对）\n 102→\t\tconst v3 = store.bumpSoul(partner.id, \"你是小澈，改过的人格。\");\n 103→\t\tassert.equal(v3, 3);\n 104→\t\tassert.equal(store.currentVersion(partner.id)?.contractSource, contract1);\n 105→\n 106→\t\t// 切模型链同样不冲掉契约\n 107→\t\tconst v4 = store.setModelChain(partner.id, [\n 108→\t\t\t{ providerId: \"faux\", modelId: \"faux\", keyEnv: \"PROBE_KEY\" },\n 109→\t\t]);\n 110→\t\tassert.equal(v4, 4);\n 111→\t\tassert.equal(store.currentVersion(partner.id)?.contractSource, contract1);\n 112→\t} finally {\n 113→\t\tstore.close();\n 114→\t\trmSync(root, { recursive: true, force: true });\n 115→\t}\n 116→});\n 117→\n 118→test(\"契约：老库（partner_versions 没有 contract_source 列）打开不炸，旧行读出 null\", () => {\n 119→\tconst { root, db, homes } = tempRoot();\n 120→\ttry {\n 121→\t\t// 手工造一份改动前的库结构（没有 contract_source）\n 122→\t\tconst legacy = new DatabaseSync(db);\n 123→\t\tlegacy.exec(`\n 124→\t\t\tCREATE TABLE partners (\n 125→\t\t\t\tid TEXT PRIMARY KEY, name TEXT NOT NULL, status TEXT NOT NULL DEFAULT 'active',\n 126→\t\t\t\tcurrent_version INTEGER, created_at TEXT NOT NULL, updated_at TEXT NOT NULL\n 127→\t\t\t);\n 128→\t\t\tCREATE TABLE partner_versions (\n 129→\t\t\t\tpartner_id TEXT NOT NULL, version INTEGER NOT NULL, soul_source TEXT NOT NULL,\n 130→\t\t\t\tcapabilities TEXT, created_at TEXT NOT NULL, PRIMARY KEY (partner_id, version)\n 131→\t\t\t);\n 132→\t\t`);\n 133→\t\tconst now = new Date().toISOString();\n 134→\t\tlegacy.prepare(\n 135→\t\t\t\"INSERT INTO partners (id, name, status, current_version, created_at, updated_at) VALUES (?, ?, 'active', 1, ?, ?)\",\n 136→\t\t).run(\"legacy-id\", \"老执事\", now, now);\n 137→\t\tlegacy.prepare(\n 138→\t\t\t\"INSERT INTO partner_versions (partner_id, version, soul_source, capabilities, created_at) VALUES (?, 1, ?, NULL, ?)\",\n 139→\t\t).run(\"legacy-id\", \"老身份\", now);\n 140→\t\tlegacy.close();\n 141→\n 142→\t\tconst store = new PartnersStore(db, homes);\n 143→\t\ttry {\n 144→\t\t\tconst version = store.currentVersion(\"legacy-id\");\n 145→\t\t\tassert.ok(version, \"旧库打开后仍能读版本\");\n 146→\t\t\tassert.equal(version?.soulSource, \"老身份\");\n 147→\t\t\tassert.equal(version?.contractSource, null, \"缺列 = null（无契约快照），不补数据\");\n 148→\t\t\t// 迁移补列后新版本能正常带契约\n 149→\t\t\tconst next = store.bumpContract(\"legacy-id\", \"## 职责范围\\n新契约\");\n 150→\t\t\tassert.equal(next, 2);\n 151→\t\t\tassert.match(store.currentVersion(\"legacy-id\")?.contractSource ?? \"\", /新契约/);\n 152→\t\t} finally {\n 153→\t\t\tstore.close();\n 154→\t\t}\n 155→\t} finally {\n 156→\t\trmSync(root, { recursive: true, force: true });\n 157→\t}\n 158→});\n 159→\n 160→test(\"开关旁路：PARTNER_CONTRACT=false → 不播种文件、不渲染契约；在办段不受影响\", () => {\n 161→\tconst { root, db, homes, workRoot } = tempRoot();\n 162→\tconst previous = process.env.PARTNER_CONTRACT;\n 163→\tprocess.env.PARTNER_CONTRACT = \"false\";\n 164→\tconst store = new PartnersStore(db, homes);\n 165→\ttry {\n 166→\t\tassert.equal(partnerContractEnabled(), false);\n 167→\t\tconst partner = store.create(\"小澈\");\n 168→\t\tassert.equal(existsSync(join(store.homeOf(partner.id), \"CONTRACT.md\")), false, \"关着就不建文件\");\n 169→\t\tstore.linkSession({\n 170→\t\t\tpartnerId: partner.id,\n 171→\t\t\trole: \"canonical\",\n 172→\t\t\trouteKey: \"canonical\",\n 173→\t\t\tsessionId: 101,\n 174→\t\t});\n 175→\t\t// 即使库里有契约快照，关着也不渲染\n 176→\t\tassert.equal(renderContractSection(\"## 职责范围\\n写点什么\"), undefined);\n 177→\n 178→\t\tconst saved = new Store(workRoot);\n 179→\t\tsaved.saveTicket(ticketFixture(workRoot, \"T-off\", \"dispatching\", { originConversationId: \"101\" }));\n 180→\t\tsaved.close();\n 181→\n 182→\t\tconst context = buildPartnerTurnContext(partner.id, 101, {\n 183→\t\t\tstore,\n 184→\t\t\tworkRoot,\n 185→\t\t\tapprovals: { pendingOf: () => [] },\n 186→\t\t});\n 187→\t\tassert.equal(context.contract, null);\n 188→\t\tassert.match(context.status ?? \"\", /T-off/, \"在办段与契约开关无关\");\n 189→\t\tassert.ok(!(context.text ?? \"\").includes(\"【岗位契约】\"));\n 190→\t} finally {\n 191→\t\tstore.close();\n 192→\t\tif (previous === undefined) delete process.env.PARTNER_CONTRACT;\n 193→\t\telse process.env.PARTNER_CONTRACT = previous;\n 194→\t\trmSync(root, { recursive: true, force: true });\n 195→\t}\n 196→});\n 197→\n 198→test(\"装配：SOUL / 岗位契约 / 当前在办三段各自可见，顺序 = 契约 → 在办\", () => {\n 199→\tconst { root, db, homes, workRoot } = tempRoot();\n 200→\tconst store = new PartnersStore(db, homes);\n 201→\ttry {\n 202→\t\tconst partner = store.create(\"阿岚\", { soulSeed: \"你是阿岚，管桌面壳。\" });\n 203→\t\tstore.linkSession({\n 204→\t\t\tpartnerId: partner.id,\n 205→\t\t\trole: \"canonical\",\n 206→\t\t\trouteKey: \"canonical\",\n 207→\t\t\tsessionId: 202,\n 208→\t\t});\n 209→\t\tstore.bumpContract(\n 210→\t\t\tpartner.id,\n 211→\t\t\t[\n 212→\t\t\t\t\"## 职责范围\",\n 213→\t\t\t\t\"桌面壳与安装包。\",\n 214→\t\t\t\t\"\",\n 215→\t\t\t\t\"## 决策分级\",\n 216→\t\t\t\t\"文案自己定；动安装流程先申请。\",\n 217→\t\t\t\t\"\",\n 218→\t\t\t\t\"## 验收标准\",\n 219→\t\t\t\t\"能装能卸，探针全绿。\",\n 220→\t\t\t\t\"\",\n 221→\t\t\t\t\"## 汇报对象\",\n 222→\t\t\t\t\"向总管汇报。\",\n 223→\t\t\t].join(\"\\n\"),\n 224→\t\t);\n 225→\n 226→\t\tconst saved = new Store(workRoot);\n 227→\t\tsaved.saveTicket(\n 228→\t\t\tticketFixture(workRoot, \"T-doing\", \"dispatching\", {\n 229→\t\t\t\toriginConversationId: \"202\",\n 230→\t\t\t\tlastAction: \"在改安装脚本\",\n 231→\t\t\t}),\n 232→\t\t);\n 233→\t\tsaved.saveTicket(\n 234→\t\t\tticketFixture(workRoot, \"T-done\", \"done\", {\n 235→\t\t\t\toriginConversationId: \"202\",\n 236→\t\t\t\tlastAction: \"三个探针全绿\",\n 237→\t\t\t\tupdated_at: new Date(Date.now() + 1000).toISOString(),\n 238→\t\t\t}),\n 239→\t\t);\n 240→\t\t// 别人发起的单不该出现在他的在办里\n 241→\t\tsaved.saveTicket(\n 242→\t\t\tticketFixture(workRoot, \"T-other\", \"dispatching\", { originConversationId: \"999\" }),\n 243→\t\t);\n 244→\t\tsaved.close();\n 245→\n 246→\t\tconst context = buildPartnerTurnContext(partner.id, 202, {\n 247→\t\t\tstore,\n 248→\t\t\tworkRoot,\n 249→\t\t\tapprovals: { pendingOf: () => [{ tool: \"bash\", args: \"npm run build\" }] },\n 250→\t\t});\n 251→\n 252→\t\t// ① SOUL（身份正文）\n 253→\t\tassert.match(context.soul, /你是阿岚/, \"SOUL 段来自当前版本快照\");\n 254→\t\t// ② 岗位契约：四节全文\n 255→\t\tassert.match(context.contract ?? \"\", /【岗位契约】/);\n 256→\t\tassert.match(context.contract ?? \"\", /## 职责范围\\n桌面壳与安装包。/);\n 257→\t\tassert.match(context.contract ?? \"\", /## 决策分级/);\n 258→\t\tassert.match(context.contract ?? \"\", /## 验收标准/);\n 259→\t\tassert.match(context.contract ?? \"\", /## 汇报对象/);\n 260→\t\t// ③ 当前在办：在办单 / 待审批 / 最近一单\n 261→\t\tassert.match(context.status ?? \"\", /【当前在办】/);\n 262→\t\tassert.match(context.status ?? \"\", /T-doing（进行中）：在改安装脚本/);\n 263→\t\tassert.match(context.status ?? \"\", /bash：npm run build/);\n 264→\t\tassert.match(context.status ?? \"\", /最近一单：T-done（已完成）：三个探针全绿/);\n 265→\t\tassert.ok(!(context.status ?? \"\").includes(\"T-other\"), \"别人发起的单不进他的在办\");\n 266→\n 267→\t\t// 合并文本：契约在前、在办在后\n 268→\t\tconst text = context.text ?? \"\";\n 269→\t\tassert.ok(text.indexOf(\"【岗位契约】\") < text.indexOf(\"【当前在办】\"));\n 270→\t\tassert.ok(text.includes(\"【岗位契约】\") && text.includes(\"【当前在办】\"));\n 271→\t} finally {\n 272→\t\tstore.close();\n 273→\t\trmSync(root, { recursive: true, force: true });\n 274→\t}\n 275→});\n 276→\n 277→test(\"空态省略：空契约 + 无在办 → 契约与在办不注入；纪律段与防线照常\", () => {\n 278→\tconst { root, db, homes, workRoot } = tempRoot();\n 279→\tconst store = new PartnersStore(db, homes);\n 280→\ttry {\n 281→\t\tconst partner = store.create(\"空空\");\n 282→\t\t// 新执事的模板自 2026-11-10 起带「决策分级」默认正文；这里改回纯标题，验证空节省略。\n 283→\t\tstore.bumpContract(\n 284→\t\t\tpartner.id,\n 285→\t\t\tPARTNER_CONTRACT_SECTIONS.map((section) => `## ${section}`).join(\"\\n\\n\"),\n 286→\t\t);\n 287→\t\tstore.linkSession({\n 288→\t\t\tpartnerId: partner.id,\n 289→\t\t\trole: \"canonical\",\n 290→\t\t\trouteKey: \"canonical\",\n 291→\t\t\tsessionId: 303,\n 292→\t\t});\n 293→\t\tconst context = buildPartnerTurnContext(partner.id, 303, {\n 294→\t\t\tstore,\n 295→\t\t\tworkRoot,\n 296→\t\t\tapprovals: { pendingOf: () => [] },\n 297→\t\t});\n 298→\t\tassert.match(context.soul, /空空/, \"SOUL 永远在\");\n 299→\t\tassert.equal(context.contract, null);\n 300→\t\tassert.equal(context.status, null);\n 301→\t\t// 2026-11-10 批 12：纪律段固定注入（非总管执事含验证铁律），在办清单空不影响它。\n 302→\t\tassert.match(context.discipline, /【验证铁律】/);\n 303→\t\tassert.match(context.discipline, /【裁决纪律】/);\n 304→\t\tassert.match(context.discipline, /【干活期间】/);\n 305→\t\tassert.match(context.discipline, /【提问纪律】/);\n 306→\t\t// 2026-11-09 T2：注入防线默认开 → 前两段空时 text = 纪律 + 防线\n 307→\t\tassert.match(context.guard ?? \"\", /【材料安全】/);\n 308→\t\tassert.equal(context.text, `${context.discipline}\\n\\n${context.guard}`);\n 309→\n 310→\t\t// 开关关 → 契约与在办仍空；防线消失后 text 只剩纪律段（不再回到 undefined）\n 311→\t\tconst previous = process.env.AGENT_INJECTION_GUARD;\n 312→\t\ttry {\n 313→\t\t\tprocess.env.AGENT_INJECTION_GUARD = \"false\";\n 314→\t\t\tconst bare = buildPartnerTurnContext(partner.id, 303, {\n 315→\t\t\t\tstore,\n 316→\t\t\t\tworkRoot,\n 317→\t\t\t\tapprovals: { pendingOf: () => [] },\n 318→\t\t\t});\n 319→\t\t\tassert.equal(bare.guard, null);\n 320→\t\t\tassert.equal(bare.text, bare.discipline, \"防线关 + 两段都空 → 只剩固定纪律段\");\n 321→\t\t} finally {\n 322→\t\t\tif (previous === undefined) delete process.env.AGENT_INJECTION_GUARD;\n 323→\t\t\telse process.env.AGENT_INJECTION_GUARD = previous;\n 324→\t\t}\n 325→\t} finally {\n 326→\t\tstore.close();\n 327→\t\trmSync(root, { recursive: true, force: true });\n 328→\t}\n 329→});\n 330→\n 331→test(\"在办段：明细 ≤3 条 + 超出只报条数；attention 口径文案在段内\", () => {\n 332→\tconst { root, db, homes, workRoot } = tempRoot();\n 333→\tconst store = new PartnersStore(db, homes);\n 334→\ttry {\n 335→\t\tconst partner = store.create(\"忙人\");\n 336→\t\tstore.linkSession({\n 337→\t\t\tpartnerId: partner.id,\n 338→\t\t\trole: \"canonical\",\n 339→\t\t\trouteKey: \"canonical\",\n 340→\t\t\tsessionId: 404,\n 341→\t\t});\n 342→\t\tconst saved = new Store(workRoot);\n 343→\t\tfor (let index = 0; index < 5; index += 1) {\n 344→\t\t\tsaved.saveTicket(\n 345→\t\t\t\tticketFixture(workRoot, `T-${index}`, \"dispatching\", {\n 346→\t\t\t\t\toriginConversationId: \"404\",\n 347→\t\t\t\t\tupdated_at: new Date(Date.now() + index * 1000).toISOString(),\n 348→\t\t\t\t}),\n 349→\t\t\t);\n 350→\t\t}\n 351→\t\tsaved.close();\n 352→\n 353→\t\tconst section = buildPartnerStatusSection(partner.id, 404, {\n 354→\t\t\tstore,\n 355→\t\t\tworkRoot,\n 356→\t\t\tapprovals: {\n 357→\t\t\t\tpendingOf: () => [\n 358→\t\t\t\t\t{ tool: \"bash\", args: \"npm test\" },\n 359→\t\t\t\t\t{ tool: \"write\", args: \"a.ts\" },\n 360→\t\t\t\t\t{ tool: \"edit\", args: \"b.ts\" },\n 361→\t\t\t\t\t{ tool: \"bash\", args: \"rm -rf x\" },\n 362→\t\t\t\t],\n 363→\t\t\t},\n 364→\t\t});\n 365→\t\tassert.ok(section);\n 366→\t\tassert.equal((section.match(/^- T-/gm) ?? []).length, 3, \"在办明细最多 3 条\");\n 367→\t\tassert.match(section ?? \"\", /另有 2 单在办/);\n 368→\t\tassert.match(section ?? \"\", /另有 1 条待批/);\n 369→\t\t// 只说\"有几条\"不说全量参数正文（日志 / 提示词纪律）\n 370→\t\tassert.equal((section.match(/^- (bash|write|edit)：/gm) ?? []).length, 3);\n 371→\t\tassert.match(section ?? \"\", /先跳过，继续其余部分，这项回头再补/);\n 372→\t\tassert.equal(ATTENTION_REPLY_GUIDANCE.includes(\"答得了就直接答\"), true);\n 373→\t} finally {\n 374→\t\tstore.close();\n 375→\t\trmSync(root, { recursive: true, force: true });\n 376→\t}\n 377→});\n 378→\n 379→test(\"刀二：当前目标 + 履历摘要在同一装配点；顺序 = 契约 → 目标 → 在办；零记录不加\", () => {\n 380→\tconst { root, db, homes, workRoot } = tempRoot();\n 381→\tconst store = new PartnersStore(db, homes);\n 382→\ttry {\n 383→\t\tconst partner = store.create(\"阿岚\");\n 384→\t\tstore.linkSession({\n 385→\t\t\tpartnerId: partner.id,\n 386→\t\t\trole: \"canonical\",\n 387→\t\t\trouteKey: \"canonical\",\n 388→\t\t\tsessionId: 505,\n 389→\t\t});\n 390→\t\tstore.bumpContract(partner.id, \"## 职责范围\\n桌面壳与安装包。\");\n 391→\t\tstore.setCurrentGoal(partner.id, \"本季度把安装包做稳\");\n 392→\n 393→\t\t// 一张在办单，让【当前在办】段存在（履历摘要挂在段末尾）。\n 394→\t\tconst saved = new Store(workRoot);\n 395→\t\tsaved.saveTicket(\n 396→\t\t\tticketFixture(workRoot, \"T-505\", \"dispatching\", { originConversationId: \"505\" }),\n 397→\t\t);\n 398→\t\tsaved.close();\n 399→\n 400→\t\tconst deps = {\n 401→\t\t\tstore,\n 402→\t\t\tworkRoot,\n 403→\t\t\tapprovals: { pendingOf: () => [] },\n 404→\t\t\tworkSummary: () => ({ done: 8, failed: 1, stopped: 1, total: 10 }),\n 405→\t\t};\n 406→\t\tconst context = buildPartnerTurnContext(partner.id, 505, deps);\n 407→\n 408→\t\t// ① 目标段（不版本化、现取现用）\n 409→\t\tassert.equal(context.goal, \"【当前目标】本季度把安装包做稳\");\n 410→\t\t// ② 契约段照旧\n 411→\t\tassert.match(context.contract ?? \"\", /【岗位契约】/);\n 412→\t\t// ③ 在办段末尾的履历摘要（过去时）+ 盘点口径（不打分 / 不自动建规则）\n 413→\t\tassert.match(context.status ?? \"\", /【当前在办】/);\n 414→\t\tassert.match(context.status ?? \"\", /近 10 单：完成 8、失败 1、中止 1/);\n 415→\t\tassert.match(context.status ?? \"\", /不打分、不列 KPI 数字/);\n 416→\t\tassert.match(context.status ?? \"\", /不要自己悄悄创建回顾规则/);\n 417→\t\tconst text = context.text ?? \"\";\n 418→\t\tassert.ok(text.indexOf(\"【岗位契约】\") < text.indexOf(\"【当前目标】\"));\n 419→\t\tassert.ok(text.indexOf(\"【当前目标】\") < text.indexOf(\"【当前在办】\"));\n 420→\n 421→\t\t// 零记录：段还在（有在办单），但不加履历摘要行、不带盘点口径。\n 422→\t\tconst zero = buildPartnerTurnContext(partner.id, 505, { ...deps, workSummary: () => null });\n 423→\t\tassert.ok(!(zero.status ?? \"\").includes(\"近 10 单\"), \"零记录不加\");\n 424→\t\tassert.ok(!(zero.status ?? \"\").includes(\"不打分\"), \"零记录不带盘点口径\");\n 425→\t\tassert.match(zero.status ?? \"\", /【当前在办】/, \"在办段照常\");\n 426→\n 427→\t\t// 清除目标：目标段消失，其余不变。\n 428→\t\tstore.setCurrentGoal(partner.id, null);\n 429→\t\tconst noGoal = buildPartnerTurnContext(partner.id, 505, deps);\n 430→\t\tassert.equal(noGoal.goal, null);\n 431→\t\tassert.ok(!(noGoal.text ?? \"\").includes(\"【当前目标】\"));\n 432→\t\tassert.match(noGoal.text ?? \"\", /近 10 单：完成 8、失败 1、中止 1/, \"履历摘要不受影响\");\n 433→\t} finally {\n 434→\t\tstore.close();\n 435→\t\trmSync(root, { recursive: true, force: true });\n 436→\t}\n 437→});\n 438→\n 439→test(\"契约解析：只认四个固定标题，空节连标题一起省略\", () => {\n 440→\tconst source = [\n 441→\t\t\"# 我的契约（这行不是节标题，忽略）\",\n 442→\t\t\"\",\n 443→\t\t\"## 职责范围\",\n 444→\t\t\"只管前端。\",\n 445→\t\t\"\",\n 446→\t\t\"### 子标题保留\",\n 447→\t\t\"细节。\",\n 448→\t\t\"\",\n 449→\t\t\"## 决策分级\",\n 450→\t\t\"\",\n 451→\t\t\"## 验收标准\",\n 452→\t\t\"探针全绿。\",\n 453→\t\t\"\",\n 454→\t\t\"## 汇报对象\",\n 455→\t\t\"## 无关章节\",\n 456→\t\t\"不该出现。\",\n 457→\t].join(\"\\n\");\n 458→\tconst sections = splitContractSections(source);\n 459→\tassert.deepEqual([...sections.keys()].sort(), [...PARTNER_CONTRACT_SECTIONS].sort());\n 460→\tassert.equal(sections.get(\"职责范围\"), \"只管前端。\\n\\n### 子标题保留\\n细节。\");\n 461→\tassert.equal(sections.get(\"决策分级\"), \"\");\n 462→\tconst rendered = renderContractSection(source) ?? \"\";\n 463→\tassert.match(rendered, /## 职责范围/);\n 464→\tassert.ok(!rendered.includes(\"## 决策分级\"), \"空节省略标题\");\n 465→\tassert.ok(!rendered.includes(\"不该出现\"), \"四节之外的内容不注入\");\n 466→});\n 467→\n 468→// ── 批 15 §二：汇报卡三规则 ───────────────────────────────\n 469→\n 470→test(\"汇报卡常量：三条纪律逐字在、固定字节不含日期 / 时刻\", () => {\n 471→\tassert.match(BRIEF_CARD_RULES, /没有值得报的就不发/);\n 472→\tassert.match(BRIEF_CARD_RULES, /今天一切正常/);\n 473→\tassert.match(BRIEF_CARD_RULES, /就地编辑/);\n 474→\tassert.match(BRIEF_CARD_RULES, /不要新开一条/);\n 475→\tassert.match(BRIEF_CARD_RULES, /离开三小时以上回来/);\n 476→\tassert.match(BRIEF_CARD_RULES, /永不抢屏/);\n 477→\tassert.equal(/20\\d{2}-\\d{1,2}-\\d{1,2}/.test(BRIEF_CARD_RULES), false);\n 478→\tassert.equal(/\\d{1,2}:\\d{2}/.test(BRIEF_CARD_RULES), false);\n 479→});\n 480→\n 481→test(\"汇报卡注入：普通执事有、总管没有（总管纪律段固定字节不变）\", () => {\n 482→\tassert.ok(buildPartnerDisciplineSection(\"partner-uuid\").includes(BRIEF_CARD_RULES));\n 483→\tassert.ok(!buildPartnerDisciplineSection(\"chief\").includes(BRIEF_CARD_RULES));\n 484→});\n 485→\n 486→test(\"汇报卡开关：BRIEF_CARD_RULES=false 时纪律段回到改动前\", () => {\n 487→\tconst previous = process.env.BRIEF_CARD_RULES;\n 488→\tprocess.env.BRIEF_CARD_RULES = \"false\";\n 489→\ttry {\n 490→\t\tassert.equal(briefCardRulesEnabled(), false);\n 491→\t\tassert.ok(!buildPartnerDisciplineSection(\"partner-uuid\").includes(BRIEF_CARD_RULES));\n 492→\t} finally {\n 493→\t\tif (previous === undefined) delete process.env.BRIEF_CARD_RULES;\n 494→\t\telse process.env.BRIEF_CARD_RULES = previous;\n 495→\t}\n 496→});\n 497→"
    },
