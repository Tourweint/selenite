    "output": {
      "type": "text",
      "text": "   1→import { existsSync, readFileSync } from \"node:fs\";\n   2→import { join } from \"node:path\";\n   3→import { listManagers } from \"../../../../../../chancellor/src/manager/registry.ts\";\n   4→import { Store } from \"../../../../../../chancellor/src/store.ts\";\n   5→import type { Ticket } from \"../../../../../../chancellor/src/types.ts\";\n   6→import { approvalStore } from \"../approvals.ts\";\n   7→import { INJECTION_GUARD, injectionGuardEnabled } from \"./injection-guard.ts\";\n   8→import { RULING_DISCIPLINE, verificationIronLawFor } from \"./turn-gate.ts\";\n   9→import {\n  10→\tATTENTION_ONE_QUESTION,\n  11→\tATTENTION_REPLY_GUIDANCE,\n  12→\tGROUNDING_DISCIPLINE,\n  13→\tWORK_REVIEW_GUIDANCE,\n  14→\tWORK_SILENCE_DISCIPLINE,\n  15→\tchancellorWorkRoot,\n  16→} from \"../delegation.ts\";\n  17→import {\n  18→\tCHIEF_PARTNER_ID,\n  19→\tPARTNER_CONTRACT_SECTIONS,\n  20→\tpartnerContractEnabled,\n  21→\tpartnersStore,\n  22→\ttype PartnersStore,\n  23→} from \"../partners.ts\";\n  24→\n  25→/**\n  26→ * 执事轮上下文装配（2026-11-08 员工人格化刀一 E1 + E5）。\n  27→ *\n  28→ * 为什么单独一个模块：`lifecycle.ts` 的 beforeRequest 与 `group-runtime.ts` 的成员轮\n  29→ * 需要同一份「岗位契约 + 当前在办」。放在 agent/ 子模块是为了两边都能 import，\n  30→ * 同时保持 `partners.ts`（只做存储）不 import agent（8b 的装配方向）。\n  31→ *\n  32→ * 三段各归各的家（**别合并成一份文本存起来**）：\n  33→ *   1. **SOUL**：身份提示词（`renderPartnerIdentity` → configure instructions），\n  34→ *      按身份版本冻结，改完下一轮生效。\n  35→ *   2. **岗位契约**：同样是身份版本的一部分（`partner_versions.contract_source`），\n  36→ *      但**每轮现取**当前版本快照 —— 改契约 bump 版本，下一轮读到新的，当场不变身。\n  37→ *   3. **当前在办**：派活单 / 待审批 / 最近一单，**全部现查现拼、零新存储**。\n  38→ *      每次请求都重新算，不写进 transcript（system 消息，与记忆注入同一条通道）。\n  39→ *\n  40→ * 回滚：`PARTNER_CONTRACT=false` 只关第 2 段；第 3 段是纯装配，没有独立开关\n  41→ * （关掉执事能力时整个 hook 不跑）。\n  42→ */\n  43→\n  44→// ── 汇报卡三规则（2026-11-10 批 15 §二，全景调研 #41）────────\n  45→//\n  46→// 只在**执事的汇报 / 日报类场景**注入文案与纪律（本批不做推送通道，触发时机由宿主决定）：\n  47→//   1. 没有值得报的就不发——宁可安静，不要\"今天一切正常\"的噪声；\n  48→//   2. 同一件事有更新就改原来那条，不新开；\n  49→//   3. 只在\"今天第一次打开\"或\"离开三小时以上回来\"出现，永不抢屏。\n  50→// 固定字节，不含日期 / 时刻 / 会话 id（与批 12 的纪律段同一口径）。\n  51→\n  52→export const BRIEF_CARD_RULES = [\n  53→\t\"【汇报卡】\",\n  54→\t\"- 没有值得报的就不发：宁可安静，也不要「今天一切正常」这种噪声。\",\n  55→\t\"- 就地编辑：同一件事有更新，改原来那条，不要新开一条。\",\n  56→\t\"- 只在「今天第一次打开」或「离开三小时以上回来」时出现；永不抢屏（不弹窗、不打断）。\",\n  57→].join(\"\\n\");\n  58→\n  59→/** 回滚开关：默认开；`BRIEF_CARD_RULES=false` → 纪律段回到改动前（逐字节一致）。 */\n  60→export function briefCardRulesEnabled(env: NodeJS.ProcessEnv = process.env): boolean {\n  61→\tconst raw = (env.BRIEF_CARD_RULES ?? \"\").trim().toLowerCase();\n  62→\tif (!raw) return true;\n  63→\treturn raw !== \"false\" && raw !== \"0\" && raw !== \"off\";\n  64→}\n  65→\n  66→// ── 产物交接（2026-11-10 批 19 §三；全景调研三 §四#1）────────\n  67→//\n  68→// 多执事接力时，最大的损耗是\"上一棒口头总结了什么\"替代了\"上一棒真的留下了什么\"：\n  69→// 下一棒只能重做一遍，或者接在一个不准确的转述上。这条把\"产物优先\"钉成契约：\n  70→// 产出物必须落盘、交接必须点名路径、下一棒从产物开始读。\n  71→// 固定字节；落点：执事纪律段（总管与普通执事共用同一装配点）。\n  72→\n  73→export const ARTIFACT_HANDOFF = [\n  74→\t\"【产物交接】\",\n  75→\t\"- 多执事接力时，产出物必须落盘（文件 / 任务单附件）；下一棒从产物开始，不要从转述开始。\",\n  76→\t\"- 交接时在留言里点名产物路径（哪个文件 / 哪个目录），让下一棒能直接打开。\",\n  77→\t\"- 没有落盘的「做完了」不算交接完成：话可以少说，产物不能少。\",\n  78→].join(\"\\n\");\n  79→\n  80→/** 回滚开关：默认开；`PARTNER_ARTIFACT_HANDOFF=false` → 纪律段回到改动前（逐字节一致）。 */\n  81→export function artifactHandoffEnabled(env: NodeJS.ProcessEnv = process.env): boolean {\n  82→\tconst raw = (env.PARTNER_ARTIFACT_HANDOFF ?? \"\").trim().toLowerCase();\n  83→\tif (!raw) return true;\n  84→\treturn raw !== \"false\" && raw !== \"0\" && raw !== \"off\";\n  85→}\n  86→\n  87→// ── 主人数据红线（2026-11-10 批 21 §七；compass AGENTS.md 四条成文）────────\n  88→//\n  89→// 六 §七#5 的差半：权限分级表 / 提案制 / 引原话不打分 / 日记不可重写。\n  90→// 注入防御与\"一次批准一次改动\"此前已落地（批 11/批 12），不在此重复。\n  91→// 固定字节；落点：执事纪律段（总管与普通执事共用——总管同样面对主人的数据）。\n  92→\n  93→export const OWNER_DATA_DISCIPLINE = [\n  94→\t\"【主人数据红线】\",\n  95→\t\"- 数据域分级：主人的日记与记忆=只能追加或经提案；主人配置=只读；自己的家目录=可写。\",\n  96→\t\"- 有判断，无权力：改主人层面的文件先提案，说清改什么、为什么；一次批准只覆盖一件事。\",\n  97→\t\"- 日记域永不删除、重写、重排或「顺手清理」：只追加，或出一份只读报告。\",\n  98→\t\"- 引主人的原话：引原文并标日期；不复述成自己的话，不打分不评判。\",\n  99→].join(\"\\n\");\n 100→\n 101→/** 回滚开关：默认开；`PARTNER_OWNER_DATA_DISCIPLINE=false` → 纪律段回到改动前（逐字节一致）。 */\n 102→export function ownerDataDisciplineEnabled(env: NodeJS.ProcessEnv = process.env): boolean {\n 103→\tconst raw = (env.PARTNER_OWNER_DATA_DISCIPLINE ?? \"\").trim().toLowerCase();\n 104→\tif (!raw) return true;\n 105→\treturn raw !== \"false\" && raw !== \"0\" && raw !== \"off\";\n 106→}\n 107→\n 108→// ── 岗位契约 ─────────────────────────────────────────────\n 109→\n 110→/**\n 111→ * 把契约正文按固定四节切开。**只认四个二级标题**（`## 职责范围` …），\n 112→ * 标题之间直到下一个二级标题的内容算正文；文件里其它内容一律忽略。\n 113→ * 返回 Map 而非对象：节名就是键，缺节 = 没有键。\n 114→ */\n 115→export function splitContractSections(source: string): Map<string, string> {\n 116→\tconst sections = new Map<string, string>();\n 117→\tconst known = new Set<string>(PARTNER_CONTRACT_SECTIONS);\n 118→\tlet current: string | null = null;\n 119→\tlet buffer: string[] = [];\n 120→\tconst flush = (): void => {\n 121→\t\tif (!current) return;\n 122→\t\tsections.set(current, buffer.join(\"\\n\").trim());\n 123→\t\tbuffer = [];\n 124→\t};\n 125→\tfor (const line of source.split(/\\r?\\n/)) {\n 126→\t\tconst heading = /^##\\s+(.+?)\\s*$/.exec(line);\n 127→\t\tif (heading) {\n 128→\t\t\tflush();\n 129→\t\t\tconst name = heading[1] ?? \"\";\n 130→\t\t\tcurrent = known.has(name) ? name : null;\n 131→\t\t\tcontinue;\n 132→\t\t}\n 133→\t\tif (current) buffer.push(line);\n 134→\t}\n 135→\tflush();\n 136→\treturn sections;\n 137→}\n 138→\n 139→/**\n 140→ * 契约段：四节全文，**空节连标题一起省略**；四节全空 / 没有文件 → undefined\n 141→ * （整段消失，不留一个空壳标题）。开关关着也不渲染。\n 142→ */\n 143→export function renderContractSection(contractSource: string | null | undefined): string | undefined {\n 144→\tif (!partnerContractEnabled()) return undefined;\n 145→\tif (!contractSource?.trim()) return undefined;\n 146→\tconst sections = splitContractSections(contractSource);\n 147→\tconst blocks: string[] = [];\n 148→\tfor (const name of PARTNER_CONTRACT_SECTIONS) {\n 149→\t\tconst body = sections.get(name)?.trim();\n 150→\t\tif (body) blocks.push(`## ${name}\\n${body}`);\n 151→\t}\n 152→\tif (blocks.length === 0) return undefined;\n 153→\treturn [\"【岗位契约】\", ...blocks].join(\"\\n\\n\");\n 154→}\n 155→\n 156→// ── 当前在办 ─────────────────────────────────────────────\n 157→\n 158→/**\n 159→ * 终态口径：与 `delegation-api.ts` / `delegation-receipts.ts` 的\n 160→ * `TERMINAL_TICKET_STATUS` 同一套（done / needs_you / failed / idle / aborted）。\n 161→ * 刻意不导出成共享常量：那两处各自是接口投影与回执判定的私有语义，\n 162→ * 为一个只读展示去改它们的形状不划算；三处一致由这里的注释与测试守着。\n 163→ */\n 164→const TERMINAL_TICKET_STATUS = new Set([\"done\", \"needs_you\", \"failed\", \"idle\", \"aborted\"]);\n 165→\n 166→const STATUS_LABEL: Record<string, string> = {\n 167→\treceived: \"已受理\",\n 168→\tplanning: \"规划中\",\n 169→\tplanned: \"拆解完成\",\n 170→\tdispatching: \"进行中\",\n 171→\treviewing: \"核对中\",\n 172→\tdone: \"已完成\",\n 173→\tneeds_you: \"等你回答\",\n 174→\tidle: \"等子单\",\n 175→\tfailed: \"失败\",\n 176→\taborted: \"已中止\",\n 177→};\n 178→\n 179→/** 明细条数上限：超过就只报\"另有 N 条\"，别让一段状态吃掉半个上下文。 */\n 180→const DETAIL_LIMIT = 3;\n 181→\n 182→/** 该执事发起的一张派活单（只留展示需要的字段，不把 prompt 全文带进提示词）。 */\n 183→interface PartnerTicket {\n 184→\tid: string;\n 185→\tstatus: string;\n 186→\tupdatedAt: string;\n 187→\tlastAction: string;\n 188→\twaitingOn: string | null;\n 189→}\n 190→\n 191→/**\n 192→ * 装配用的注入缝。生产不传（走 partnersStore / approvalStore / chancellorWorkRoot）；\n 193→ * 单测注入临时库与临时 workRoot，不碰真实 `.data/`。\n 194→ */\n 195→export interface PartnerContextDeps {\n 196→\tstore?: PartnersStore;\n 197→\tapprovals?: { pendingOf(conversationId: number): Array<{ tool: string; args: string }> };\n 198→\tworkRoot?: string;\n 199→\t/** 每次扫描每类 runs 目录取多少张单（默认 200；够覆盖\"在办 + 最近一单\"）。 */\n 200→\tticketLimit?: number;\n 201→\t/**\n 202→\t * 该执事近 N 单 work 履历聚合（2026-11-08 刀二 E2）。\n 203→\t * 由装配层（lifecycle）注入 `workSummaryFor`；不传 = 不加履历摘要行\n 204→\t * （单测零副作用，也不去开真实记忆库）。结构化查询，不走语义召回。\n 205→\t */\n 206→\tworkSummary?: (partnerId: string) => {\n 207→\t\tdone: number;\n 208→\t\tfailed: number;\n 209→\t\tstopped: number;\n 210→\t\ttotal: number;\n 211→\t} | null;\n 212→}\n 213→\n 214→function readTicketJson(runsDir: string, ticketId: string): Ticket | null {\n 215→\ttry {\n 216→\t\treturn JSON.parse(\n 217→\t\t\treadFileSync(join(runsDir, ticketId, \"ticket.json\"), \"utf8\"),\n 218→\t\t) as Ticket;\n 219→\t} catch {\n 220→\t\treturn null;\n 221→\t}\n 222→}\n 223→\n 224→/**\n 225→ * 扫出\"该执事发起\"的单：`ticket.json` 的 `originConversationId` 落在他的会话 id 集合里。\n 226→ *\n 227→ * 数据源与任务中心同源（chancellor `runs/`，含各领域 `managers/<domain>/runs/`），\n 228→ * 不新增索引、不新增存储 —— 一张单原来的派单记账本来就带着发起会话。\n 229→ * 老单没有 `originConversationId` 就看不到（回执反查是任务中心为了历史单做的，\n 230→ * 这里不重复一遍：状态感只需要\"最近的、我在办的\"，不需要全量归档）。\n 231→ */\n 232→function ticketsOfPartner(\n 233→\tworkRoot: string,\n 234→\tsessionIds: Set<number>,\n 235→\tlimit: number,\n 236→): PartnerTicket[] {\n 237→\tconst dirs: string[] = [];\n 238→\ttry {\n 239→\t\t// 只扫**已经存在**的目录：没有 runs/ 时开 Store 会顺手建库，一个纯读的状态段\n 240→\t\t// 不该在磁盘上留下东西（chancellor 从未跑过的机器上尤其明显）。\n 241→\t\tif (existsSync(workRoot)) {\n 242→\t\t\tdirs.push(workRoot);\n 243→\t\t\tfor (const entry of listManagers(workRoot)) {\n 244→\t\t\t\tconst runsDir = entry.meta?.runs_dir;\n 245→\t\t\t\tif (runsDir && existsSync(runsDir)) dirs.push(runsDir);\n 246→\t\t\t}\n 247→\t\t}\n 248→\t} catch {\n 249→\t\t// 领域清单读不出来就只看顶层：状态感不能因为一个目录读失败而整段消失\n 250→\t}\n 251→\n 252→\tconst byId = new Map<string, PartnerTicket>();\n 253→\tfor (const dir of dirs) {\n 254→\t\tlet store: Store | null = null;\n 255→\t\ttry {\n 256→\t\t\tstore = new Store(dir);\n 257→\t\t\tfor (const row of store.listTickets(limit)) {\n 258→\t\t\t\tconst ticket = readTicketJson(dir, row.id);\n 259→\t\t\t\tif (!ticket) continue;\n 260→\t\t\t\tconst origin = Number(String(ticket.originConversationId ?? \"\").trim());\n 261→\t\t\t\tif (!Number.isInteger(origin) || !sessionIds.has(origin)) continue;\n 262→\t\t\t\tconst id = String(ticket.id);\n 263→\t\t\t\tif (byId.has(id)) continue;\n 264→\t\t\t\tbyId.set(id, {\n 265→\t\t\t\t\tid,\n 266→\t\t\t\t\tstatus: String(ticket.status ?? \"\"),\n 267→\t\t\t\t\tupdatedAt: String(ticket.updated_at ?? ticket.created_at ?? \"\"),\n 268→\t\t\t\t\tlastAction: String(ticket.lastAction ?? \"\").trim(),\n 269→\t\t\t\t\twaitingOn: ticket.waitingOn ? String(ticket.waitingOn) : null,\n 270→\t\t\t\t});\n 271→\t\t\t}\n 272→\t\t} catch {\n 273→\t\t\t// 单个 runs 目录坏了不挡其它目录\n 274→\t\t} finally {\n 275→\t\t\tstore?.close();\n 276→\t\t}\n 277→\t}\n 278→\treturn [...byId.values()].sort((a, b) => (a.updatedAt < b.updatedAt ? 1 : -1));\n 279→}\n 280→\n 281→function oneLine(text: string, max: number): string {\n 282→\tconst flat = text.replace(/\\s+/g, \" \").trim();\n 283→\treturn flat.length <= max ? flat : `${flat.slice(0, max - 1)}…`;\n 284→}\n 285→\n 286→function ticketDetail(ticket: PartnerTicket): string {\n 287→\tconst label = STATUS_LABEL[ticket.status] ?? ticket.status;\n 288→\tconst extra = ticket.lastAction ? `：${oneLine(ticket.lastAction, 60)}` : \"\";\n 289→\tconst waiting = ticket.waitingOn ? `（等 ${oneLine(ticket.waitingOn, 20)}）` : \"\";\n 290→\treturn `- ${ticket.id}（${label}${waiting}）${extra}`;\n 291→}\n 292→\n 293→function approvalDetail(record: { tool: string; args: string }): string {\n 294→\tconst args = oneLine(record.args, 60);\n 295→\treturn `- ${record.tool}${args ? `：${args}` : \"\"}`;\n 296→}\n 297→\n 298→/**\n 299→ * 「当前在办」段（E5）：①未终态的派活单 ②本会话待审批 ③最近一单结果。\n 300→ * 三项皆空 → undefined（整段省略）。明细 ≤3 条，超出只报条数。\n 301→ */\n 302→export function buildPartnerStatusSection(\n 303→\tpartnerId: string,\n 304→\tconversationId: number,\n 305→\tdeps: PartnerContextDeps = {},\n 306→): string | undefined {\n 307→\tconst store = deps.store ?? partnersStore();\n 308→\tconst sessionIds = new Set(store.sessionIdsOf(partnerId));\n 309→\tconst tickets = sessionIds.size\n 310→\t\t? ticketsOfPartner(deps.workRoot ?? chancellorWorkRoot(), sessionIds, deps.ticketLimit ?? 200)\n 311→\t\t: [];\n 312→\tconst active = tickets.filter((ticket) => !TERMINAL_TICKET_STATUS.has(ticket.status));\n 313→\tconst last = tickets.find((ticket) => TERMINAL_TICKET_STATUS.has(ticket.status));\n 314→\n 315→\tlet approvals: Array<{ tool: string; args: string }> = [];\n 316→\ttry {\n 317→\t\tconst sink = deps.approvals ?? approvalStore();\n 318→\t\tapprovals = sink.pendingOf(conversationId);\n 319→\t} catch {\n 320→\t\t// 审批库读不出来不影响其它两项\n 321→\t\tapprovals = [];\n 322→\t}\n 323→\n 324→\t// 履历摘要（**过去时**）与在办（**现在时**）两层互补别混：\n 325→\t// 在办来自 runs 扫描（刀一），履历来自 work 记录的结构化查询（刀二）。\n 326→\t// 零记录不加（workSummary 返回 null 或 total=0）。\n 327→\tconst summary = deps.workSummary?.(partnerId) ?? null;\n 328→\tconst workLine =\n 329→\t\tsummary && summary.total > 0\n 330→\t\t\t? `近 10 单：完成 ${summary.done}、失败 ${summary.failed}、中止 ${summary.stopped}`\n 331→\t\t\t: null;\n 332→\n 333→\tif (active.length === 0 && approvals.length === 0 && !last && !workLine) return undefined;\n 334→\n 335→\tconst lines: string[] = [\"【当前在办】\"];\n 336→\tif (active.length > 0) {\n 337→\t\tlines.push(\"在办的单：\");\n 338→\t\tfor (const ticket of active.slice(0, DETAIL_LIMIT)) lines.push(ticketDetail(ticket));\n 339→\t\tif (active.length > DETAIL_LIMIT) lines.push(`（另有 ${active.length - DETAIL_LIMIT} 单在办）`);\n 340→\t}\n 341→\tif (approvals.length > 0) {\n 342→\t\tlines.push(\"等你批的：\");\n 343→\t\tfor (const record of approvals.slice(0, DETAIL_LIMIT)) lines.push(approvalDetail(record));\n 344→\t\tif (approvals.length > DETAIL_LIMIT) {\n 345→\t\t\tlines.push(`（另有 ${approvals.length - DETAIL_LIMIT} 条待批）`);\n 346→\t\t}\n 347→\t}\n 348→\tif (last) {\n 349→\t\tconst label = STATUS_LABEL[last.status] ?? last.status;\n 350→\t\tconst detail = last.lastAction ? `：${oneLine(last.lastAction, 80)}` : \"\";\n 351→\t\tlines.push(`最近一单：${last.id}（${label}）${detail}`);\n 352→\t}\n 353→\t// 有在办/待批时把「答不了怎么办」的口径带上（B2）：模型只在真有工人等它时才需要它。\n 354→\tlines.push(\"\", ATTENTION_REPLY_GUIDANCE);\n 355→\t// 段末尾挂一行履历摘要 + 周期盘点口径（刀二 E2/E4）：有履历才出现。\n 356→\tif (workLine) {\n 357→\t\tlines.push(\"\", workLine, \"\", WORK_REVIEW_GUIDANCE);\n 358→\t}\n 359→\treturn lines.join(\"\\n\");\n 360→}\n 361→\n 362→// ── 当前目标 ─────────────────────────────────────────────\n 363→\n 364→/**\n 365→ * 【当前目标】段（2026-11-08 刀二 E4）：有目标才出现，一行。\n 366→ *\n 367→ * 目标**不版本化**（不是身份，是\"现在在奔什么\"），现取现用：改完下一轮读到新的。\n 368→ * 与契约（低频、版本化、下一轮生效）刻意分开；空 / 全空白 = 整段省略。\n 369→ */\n 370→export function buildPartnerGoalSection(\n 371→\tpartnerId: string,\n 372→\tstore: PartnersStore = partnersStore(),\n 373→): string | undefined {\n 374→\tconst goal = store.get(partnerId)?.currentGoal?.trim();\n 375→\treturn goal ? `【当前目标】${goal}` : undefined;\n 376→}\n 377→\n 378→// ── 整体装配 ─────────────────────────────────────────────\n 379→\n 380→/**\n 381→ * 纪律段（2026-11-10 批 12 + 批 16）：执事轮常量口径，全部固定字节、不含动态内容。\n 382→ *\n 383→ * 为什么集中在这里：任务的七件里有四件是提示词纪律，它们与契约 / 状态一样\n 384→ * 「每轮现渲染、不写进 transcript」。**总管（chief）的验证铁律由 lifecycle 的\n 385→ * persona 段注入**，这里跳过，避免同一段进两遍；普通执事没有 persona 段，在这里补。\n 386→ * 答案接地（批 16 §五）不按身份分：谁汇报谁负责。\n 387→ */\n 388→export function buildPartnerDisciplineSection(partnerId: string): string {\n 389→\tconst blocks = [\n 390→\t\tverificationIronLawFor(partnerId),\n 391→\t\tRULING_DISCIPLINE,\n 392→\t\tWORK_SILENCE_DISCIPLINE,\n 393→\t\t// 答案接地（批 16 §五）：总管与执事都要——它管的是\"说出口的事实\"，\n 394→\t\t// 谁汇报谁负责，不按身份分。\n 395→\t\tGROUNDING_DISCIPLINE,\n 396→\t\t// 产物交接（批 19 §三）：接力时产物优先；同样不按身份分，谁交接谁负责。\n 397→\t\tartifactHandoffEnabled() ? ARTIFACT_HANDOFF : undefined,\n 398→\t\t// 主人数据红线（批 21 §七）：数据域分级/提案制/日记不可重写/引原话不打分；\n 399→\t\t// 不按身份分——总管与执事同样面对主人的数据。\n 400→\t\townerDataDisciplineEnabled() ? OWNER_DATA_DISCIPLINE : undefined,\n 401→\t\t// 汇报卡三规则（批 15 §二）：只给普通执事；总管那条时间线由界面承载，\n 402→\t\t// 加进来会改变总管纪律段的固定字节，故跳过。\n 403→\t\tpartnerId === CHIEF_PARTNER_ID || !briefCardRulesEnabled() ? undefined : BRIEF_CARD_RULES,\n 404→\t\tATTENTION_ONE_QUESTION,\n 405→\t];\n 406→\treturn blocks.filter((part): part is string => Boolean(part)).join(\"\\n\\n\");\n 407→}\n 408→\n 409→export interface PartnerTurnContext {\n 410→\t/** 身份正文（当前版本快照）。调用方放进 instructions；这里带出来是为了整体断言。 */\n 411→\tsoul: string;\n 412→\t/** 岗位契约段（开关关 / 空 → null） */\n 413→\tcontract: string | null;\n 414→\t/** 当前目标段（E4，无目标 → null） */\n 415→\tgoal: string | null;\n 416→\t/** 纪律段（批 12：验证 / 裁决 / 干活期间 / 提问；批 16：答案接地；固定字节，永远非空） */\n 417→\tdiscipline: string;\n 418→\t/** 当前在办段（三项皆空 + 无履历 → null） */\n 419→\tstatus: string | null;\n 420→\t/** 注入防线段（开关关 → null；固定字节，不随轮次变化） */\n 421→\tguard: string | null;\n 422→\t/** 注入模型请求的附加段：契约 + 目标 + 纪律 + 在办 + 防线（都空 → undefined） */\n 423→\ttext: string | undefined;\n 424→}\n 425→\n 426→/**\n 427→ * 执事轮输入的单一装配点（E1 + E5）。\n 428→ *\n 429→ * 顺序固定：**SOUL（身份）→ 岗位契约 → 当前目标 → 纪律 → 当前在办**。前两段来自同一个身份版本，\n 430→ * 后三段现查现拼。`text` 只含后四段：SOUL 在 instructions 里，重复一遍等于每轮\n 431→ * 白付一份 token，还会让模型看到两个版本的身份。\n 432→ *\n 433→ * 刀二只在同一装配点加两段（目标 / 履历摘要），批 12 再加一段固定纪律，\n 434→ * **没有第二条注入通道**。\n 435→ */\n 436→export function buildPartnerTurnContext(\n 437→\tpartnerId: string,\n 438→\tconversationId: number,\n 439→\tdeps: PartnerContextDeps = {},\n 440→): PartnerTurnContext {\n 441→\tconst store = deps.store ?? partnersStore();\n 442→\tconst current = store.currentVersion(partnerId);\n 443→\tconst soul = current?.soulSource ?? store.readSoulFromHome(partnerId) ?? \"\";\n 444→\t// 契约取\"当前版本快照\"；老库/手工放了文件但没快照的，退磁盘当前值。\n 445→\tconst contract = renderContractSection(\n 446→\t\tcurrent?.contractSource ?? store.readContractFromHome(partnerId),\n 447→\t) ?? null;\n 448→\tconst goal = buildPartnerGoalSection(partnerId, store) ?? null;\n 449→\t// 纪律段（批 12）放在动态状态之前：固定字节先落，在办清单每轮变。\n 450→\tconst discipline = buildPartnerDisciplineSection(partnerId);\n 451→\tconst status = buildPartnerStatusSection(partnerId, conversationId, { ...deps, store }) ?? null;\n 452→\t// 注入防线（2026-11-09 T2）：放在执事轮输入尾部；固定字节，开关只决定注不注。\n 453→\tconst guard = injectionGuardEnabled() ? INJECTION_GUARD : null;\n 454→\tconst text = [contract, goal, discipline, status, guard]\n 455→\t\t.filter((part): part is string => Boolean(part))\n 456→\t\t.join(\"\\n\\n\");\n 457→\treturn { soul, contract, goal, discipline, status, guard, text: text || undefined };\n 458→}\n 459→"
    },
