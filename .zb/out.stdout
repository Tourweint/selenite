      "text": " 120→} from \"./provider.ts\";\n 121→import { injectProviderKeys } from \"./provider-secrets.ts\";\n 122→// 会话导出「接续文件」（2026-11-10 批 20 §一）：拼接是纯函数，正文只在响应体里出现。\n 123→import {\n 124→  buildHandoff,\n 125→  chatExportHandoffEnabled,\n 126→  HANDOFF_MEMORY_LIMIT,\n 127→  handoffFileName,\n 128→  parseHandoffLimit,\n 129→  type HandoffMemory,\n 130→} from \"./chat-handoff.ts\";\n 131→// 旧会话定点找回（2026-11-10 批 20 §四）：按消息下标取窗口，不改内核加 seq。\n 132→import {\n 133→  chatContextLookupEnabled,\n 134→  contextMessageOf,\n 135→  parseAroundIndex,\n 136→  parseContextRadius,\n 137→  sliceAroundIndex,\n 138→} from \"./chat-context.ts\";\n 139→import { chancellorWorkRoot } from \"./delegation.ts\";\n 140→import { DelegationReceipts } from \"./delegation-receipts.ts\";\n 141→import {\n 142→\tcollectDeadLetters,\n 143→\trecoverReportEnabled,\n 144→\treportRecoveredTickets,\n 145→\ttype DeadLetterChild,\n 146→} from \"./recovery-report.ts\";\n 147→import { recoverDelegations, type RecoveredTicket } from \"../../../../../chancellor/src/index.ts\";\n 148→// 恢复注记（2026-11-09 任务书 T3 §5）：只有进程内记账，无存储依赖。\n 149→import { markRecoverResume, recoverNoteEnabled } from \"./agent/recover-note.ts\";\n 150→import { Store } from \"../../../../../chancellor/src/store.ts\";\n 151→import { listManagers } from \"../../../../../chancellor/src/manager/registry.ts\";\n 152→\n 153→// Node 20.12+ 自带 .env 加载；文件不存在时静默跳过，不让本地启动被环境文件卡住。\n 154→try {\n 155→  (process as unknown as { loadEnvFile?: (path?: string) => void }).loadEnvFile?.();\n 156→} catch {\n 157→  /* no .env, that's fine */\n 158→}\n 159→\n 160→// 2026-11-05 密钥直填：启动时把 .data/provider-keys.json 注入进程 env。\n 161→// 必须放在 loadEnvFile 之后、任何模型配置读取之前——手写 .env / 部署 env 的已有值优先。\n 162→injectProviderKeys();\n 163→\n 164→// 界面高级开关（2026-11-09）：.data/agent-flags.json 里用户改过的开关覆盖 env。\n 165→// 必须放在路由挂载之前——挂载期的开关（执事/群组/课题/技能管理）要吃到覆盖值。\n 166→loadFlagOverrides();\n 167→\n 168→const app = new Hono();\n 169→\n 170→/** 服务端错误日志落点：桌面壳拉起进程时没有终端，文件是唯一能回看的地方。 */\n 171→const SERVER_ERROR_LOG = process.env.AGENT_ERROR_LOG?.trim() || \".data/server-errors.log\";\n 172→\n 173→/** 追加一行错误（尽力而为：写不进去只 warn，绝不能因为记日志再把请求搞挂）。 */\n 174→function appendServerError(line: string): void {\n 175→  try {\n 176→    mkdirSync(dirname(SERVER_ERROR_LOG), { recursive: true });\n 177→    appendFileSync(SERVER_ERROR_LOG, line);\n 178→  } catch (error) {\n 179→    console.warn(`[error] 写 ${SERVER_ERROR_LOG} 失败: ${error instanceof Error ? error.message : error}`);\n 180→  }\n 181→}\n 182→\n 183→/**\n 184→ * 未捕获错误的统一出口（2026-11-07）。\n 185→ *\n 186→ * 两个理由：\n 187→ * 1. **看得见**：Hono 默认只 `console.error` 一行，而桌面壳是 `cmd.Start()` 起的、\n 188→ *    没有重定向 stdout/stderr，服务端日志根本没人收——\"页面 500\"于是变成无头案。\n 189→ *    这里把错误追加到 `.data/server-errors.log`（只记时间/方法/路径/错误与栈，\n 190→ *    不记请求体与对话内容），出问题时能直接查。\n 191→ * 2. **说得清**：500 空体让前端只能显示\"读历史失败：500\"。这里回一个 `internal_error`\n 192→ *    加一句稳定的说明，前端能把它当\"服务端内部错误\"处理，而不是当成历史丢了。\n 193→ *    错误细节（message/stack）只进服务端日志，不下发客户端——它可能带上游地址或路径。\n 194→ */\n 195→app.onError((error, c) => {\n 196→  const message = error instanceof Error ? error.message : String(error);\n 197→  const at = new Date().toISOString();\n 198→  const line = `${at} ${c.req.method} ${c.req.path} :: ${message}\\n${\n 199→    error instanceof Error && error.stack ? `${error.stack}\\n` : \"\"\n 200→  }`;\n 201→  console.error(`[error] ${c.req.method} ${c.req.path}: ${message}`);\n 202→  appendServerError(line);\n 203→  return c.json({ error: \"internal_error\", message: \"服务端内部错误，详见服务端日志\" }, 500);\n 204→});\n 205→\n 206→// M0 只在本机/局域网跑，放开来源方便真机调试。\n 207→// 上公网前必须收紧成具体来源，否则等于把私人 Agent 敞开。\n 208→app.use(\n 209→  \"*\",\n 210→  cors({\n 211→    origin: \"*\",\n 212→    allowMethods: [\"GET\", \"POST\", \"PUT\", \"DELETE\", \"OPTIONS\"],\n 213→    // X-Conversation-Id 是兼容层的会话绑定头，X-Task 是任务通道的任务名（原生客户端不发预检，但浏览器/WebView 会）\n 214→    allowHeaders: [\"Content-Type\", \"Authorization\", \"X-Conversation-Id\", \"X-Task\", \"Accept\"],\n 215→  }),\n 216→);\n 217→\n 218→// 鉴权只作用于 API；调试页是静态 UI，真正的数据都要过 /api/v1\n 219→//\n 220→// 凭据两档（2026-10-29 配对）：共享令牌 `AGENT_TOKEN`（命令行/调试）+ 扫码换来的设备凭据。\n 221→// **配对的两个端点必须免鉴权**——手机在配对之前手里还没有任何凭据。\n 222→const pairing = new PairingStore();\n 223→const auth = createAuthMiddleware(process.env.AGENT_TOKEN?.trim() || null, {\n 224→  verifyDeviceToken: (token) => pairing.verifyDeviceToken(token),\n 225→});\n 226→\n 227→// SSE 事件重放库（2026-11-04 seq 方案）。惰性建：回滚开关关着就永远不建库。\n 228→// 库路径可用 AGENT_SSE_SEQ_DB_PATH 覆盖（探针用），默认 .data/chat-events.sqlite。\n 229→let chatEventStore: ChatEventStore | undefined;\n 230→const chatEventStoreOf = (): ChatEventStore | undefined => {\n 231→  if (!sseSeqEnabled()) return undefined;\n 232→  chatEventStore ??= new ChatEventStore();\n 233→  return chatEventStore;\n 234→};\n 235→const PAIR_OPEN_PATHS = new Set([\"/api/v1/pair/info\", \"/api/v1/pair/redeem\"]);\n 236→app.use(\"/api/v1/*\", async (c, next) => {\n 237→  if (PAIR_OPEN_PATHS.has(c.req.path)) return next();\n 238→  return auth(c, next);\n 239→});\n 240→\n 241→// redeem 限流：每 IP 每分钟 10 次（防有人对着 6 位码暴力枚举）\n 242→const redeemHits = new Map<string, { count: number; resetAt: number }>();\n 243→const REDEEM_PER_MINUTE = 10;\n 244→function redeemRateLimited(ip: string, now = Date.now()): boolean {\n 245→  const hit = redeemHits.get(ip);\n 246→  if (!hit || hit.resetAt <= now) {\n 247→    redeemHits.set(ip, { count: 1, resetAt: now + 60_000 });\n 248→    return false;\n 249→  }\n 250→  hit.count += 1;\n 251→  return hit.count > REDEEM_PER_MINUTE;\n 252→}\n 253→\n 254→// OpenAI 兼容端点：手机 App 已经在按这个协议说话，服务端适配比改客户端便宜\n 255→mountOpenAiCompat(app);\n 256→\n 257→// 日记成稿镜像（2026-10-29）：独立库 .data/diary.sqlite，只收手机的推送，没有\"在这里改日记\"的入口\n 258→mountDiary(app);\n 259→\n 260→// 手机 worker 通道（2026-11-02）：poll / model / result，鉴权沿用上面的 /api/v1/* 中间件\n 261→mountPhoneWorker(app);\n 262→\n 263→// 受限 shell（2026-11-02 第四个接口）：只放行虚拟屏需要的那几种 adb shell 形状\n 264→mountWorkerShell(app);\n 265→\n 266→// 项目与工作区（2026-11-03 方案 §5.5）：派单前置。新建项目根目录只提交待确认请求，\n 267→// 用户在设置页确认后才建目录、登记。界面上线前用 HTTP 也能完成同一流程。\n 268→mountProjects(app);\n 269→// 默认工作区（2026-11-08 用户拍板）：首次使用不再要引导，没设过就静默落 <主目录>/lifediary。\n 270→// LIFEDIARY_DEFAULT_WORKSPACE=off 退回旧行为（不播种）；已设置过的一律不动。\n 271→seedDefaultWorkspace();\n 272→\n 273→// 文件浏览入口（2026-11-06）：open-explorer + files 只读浏览。回滚开关\n 274→// EXPLORER_OPEN=false / FILE_BROWSE=false（方案：docs/设计方案/2026-11-06-文件浏览入口（桌面资源管理器与手机端）.md）。\n 275→mountFiles(app);\n 276→\n 277→// 任务中心只读接口（2026-11-03 方案 §5.9）：领域列表 + 单 ticket 明细。\n 278→mountDelegationApi(app);\n 279→\n 280→// 执事管理（2026-11-05 批次B B2）：档案 CRUD + 手动跑一轮。开关关着一个路由都不挂（404 = 未启用）。\n 281→mountCompanions(app);\n 282→\n 283→// 群组（2026-11-06 群组方案）：执事群聊 + 共享时间线 + 确定性调度。\n 284→// GROUPS_ENABLED / COMPANIONS_ENABLED 任一关着一个路由都不挂（404 = 未启用）。\n 285→mountGroups(app);\n 286→\n 287→// 长期课题（2026-11-07 长期课题跟进）：课题户口本 + 提议确认 + 研究回合。\n 288→// 开关关着一个路由都不挂（404 = 未启用）；研究闹钟由 agent 里注册的 TopicTask 负责。\n 289→mountTopics(app);\n 290→\n 291→// 搜索配置：课题研究的硬前提（没 key 时 propose_topic / 研究回合都会拒绝）。\n 292→mountSearch(app);\n 293→\n 294→// 审批答复（2026-11-04 批次二）：待批列表 + 幂等答复。开关关着时列表恒为空。\n 295→mountApprovalApi(app);\n 296→// bash 后台任务管理面（2026-11-10 批 21 §二）：转后台之后要能看见、能收尾。\n 297→mountBgJobs(app);\n 298→// 高级开关（2026-11-09）：界面读写运行时开关（.data/agent-flags.json）。AGENT_FLAGS_UI=false 整组不挂。\n 299→mountFlags(app);\n 300→"
    },
