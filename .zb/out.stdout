      "type": "text",
      "text": "  40→}\n  41→\n  42→/**\n  43→ * 应用自带的技能目录（`apps/server/skills/`，两条内置手册）。\n  44→ *\n  45→ * 落点跟着代码走：源码 `src/skills.ts` → `../skills`；dist 里 `dist/src/skills.js` →\n  46→ * `dist/skills`（build.mjs 会把 skills/ 抄过去），与 `agent/assist.ts` 的老口径同址。\n  47→ */\n  48→export const APP_SKILLS_DIR = fileURLToPath(new URL(\"../skills\", import.meta.url));\n  49→\n  50→export type SkillsDirOrigin = \"env\" | \"user\" | \"agents\" | \"app\";\n  51→\n  52→export interface SkillSource {\n  53→\t/** 目录绝对（或部署给的）路径 */\n  54→\tdir: string;\n  55→\t/** env = AGENT_SKILLS_DIR 显式；user = 用户目录；agents = `~/.agents/skills`；app = 应用目录兜底 */\n  56→\torigin: SkillsDirOrigin;\n  57→\t/**\n  58→\t * 管理端点能否在这个目录里写/删。\n  59→\t * 只有主目录为 true；`~/.agents/skills` 是别的工具的家，只读；应用目录是内置手册，只读。\n  60→\t */\n  61→\twritable: boolean;\n  62→\t/** 目录当前是否存在（不存在时加载器跳过，管理列表也如实标出来） */\n  63→\texists: boolean;\n  64→}\n  65→\n  66→export interface ResolvedSkillsDir {\n  67→\t/** 主目录（管理端点写目标）；读取链里的第一个 */\n  68→\tdir: string;\n  69→\t/** 主目录来源（`agents` 永远不会是主目录） */\n  70→\torigin: Exclude<SkillsDirOrigin, \"agents\">;\n  71→\t/** 完整读取链，按优先级从高到低排列 */\n  72→\tdirs: SkillSource[];\n  73→}\n  74→\n  75→export interface ResolveSkillsDirOptions {\n  76→\tenv?: NodeJS.ProcessEnv;\n  77→\t/** 覆盖用户主目录（单测/探针用）；不传 = env 的 USERPROFILE/HOME → os.homedir() */\n  78→\thome?: string;\n  79→\t/** 覆盖应用目录（单测用）；不传 = APP_SKILLS_DIR */\n  80→\tappDir?: string;\n  81→}\n  82→\n  83→function userHomeOf(env: NodeJS.ProcessEnv): string {\n  84→\treturn env.USERPROFILE?.trim() || env.HOME?.trim() || homedir();\n  85→}\n  86→\n  87→/** 路径去重键：Windows 大小写不敏感，同一个目录写两种大小写不该算两个来源。 */\n  88→function pathKey(dir: string): string {\n  89→\tconst absolute = resolvePath(dir);\n  90→\treturn process.platform === \"win32\" ? absolute.toLowerCase() : absolute;\n  91→}\n  92→\n  93→/**\n  94→ * 技能读取链解析（2026-11-08 批 10-A，上位计划 §一；取代 9-S 的单目录版本）。\n  95→ *\n  96→ * 优先级（**先到先得**，同名技能只有第一个来源生效）：\n  97→ *   1. `AGENT_SKILLS_DIR` 显式指定（部署自选目录，不替用户建）——显式时它取代主目录槽位，\n  98→ *      不再额外创建 `.lifediary\\skills`；\n  99→ *   2. 用户目录 `%USERPROFILE%\\.lifediary\\skills`——**不存在则首次访问自动 mkdir**，\n 100→ *      这样设置页打开就能立刻增删，不用先手工建目录；\n 101→ *   3. 标准用户技能目录 `%USERPROFILE%\\.agents\\skills`（跨工具共享，只读；不存在就跳过）；\n 102→ *   4. 应用目录 `apps/server/skills/` 兜底（内置手册）。\n 103→ *\n 104→ * 主目录 = 管理端点（GET/PUT/DELETE）的写目标：有显式 env 就是 env 目录，否则用户目录，\n 105→ * 用户目录建不出来才回落应用目录（沿用 9-S 的兜底）。`dirs` 是**读取链**：主目录永远第一，\n 106→ * 后面跟着 .agents 与应用目录（同一路径只留一次）。\n 107→ */\n 108→export function resolveSkillsDir(options: ResolveSkillsDirOptions = {}): ResolvedSkillsDir {\n 109→\tconst env = options.env ?? process.env;\n 110→\tconst appDir = options.appDir ?? APP_SKILLS_DIR;\n 111→\tconst home = options.home?.trim() || userHomeOf(env);\n 112→\tconst agentsDir = join(home, \".agents\", \"skills\");\n 113→\n 114→\tconst explicit = env.AGENT_SKILLS_DIR?.trim();\n 115→\tlet main: { dir: string; origin: Exclude<SkillsDirOrigin, \"agents\"> };\n 116→\tif (explicit) {\n 117→\t\tmain = { dir: explicit, origin: \"env\" };\n 118→\t} else {\n 119→\t\tconst userDir = join(home, \".lifediary\", \"skills\");\n 120→\t\ttry {\n 121→\t\t\tmkdirSync(userDir, { recursive: true });\n 122→\t\t\tmain = { dir: userDir, origin: \"user\" };\n 123→\t\t} catch (error) {\n 124→\t\t\tconst detail = error instanceof Error ? error.message : String(error);\n 125→\t\t\tconsole.warn(`[skills] 用户技能目录不可用（${detail}），回落应用目录`);\n 126→\t\t\tmain = { dir: appDir, origin: \"app\" };\n 127→\t\t}\n 128→\t}\n 129→\n 130→\tconst dirs: SkillSource[] = [];\n 131→\tconst seen = new Set<string>();\n 132→\tconst push = (dir: string, origin: SkillsDirOrigin, writable: boolean) => {\n 133→\t\tconst key = pathKey(dir);\n 134→\t\tif (seen.has(key)) return;\n 135→\t\tseen.add(key);\n 136→\t\tdirs.push({ dir, origin, writable, exists: existsSync(dir) });\n 137→\t};\n 138→\tpush(main.dir, main.origin, true);\n 139→\tpush(agentsDir, \"agents\", false);\n 140→\tpush(appDir, \"app\", false);\n 141→\n 142→\treturn { dir: main.dir, origin: main.origin, dirs };\n 143→}\n 144→\n 145→/**\n 146→ * 一个目录里扫出来的技能（含格式不对的条目）。\n 147→ *\n 148→ * `valid=false` 的条目**仍然占名**：合并链靠它挡住低优先级目录里的同名技能——\n 149→ * 否则一份坏掉的总管技能会被全局同名手册顶掉，行为和\"没有这份技能\"完全不一样。\n 150→ */\n 151→export interface ScannedSkill {\n 152→\tname: string;\n 153→\t/** flat = `<名>.md`；dir = `<名>/SKILL.md` */\n 154→\tform: \"flat\" | \"dir\";\n 155→\t/** 实际读取的文件路径（列表要 stat 它） */\n 156→\tpath: string;\n 157→\tsummary: string;\n 158→\tmanual: string;\n 159→\tvalid: boolean;\n 160→"
    },
