      "type": "text",
      "text": "   1→import assert from \"node:assert/strict\";\n   2→import { mkdtempSync, rmSync } from \"node:fs\";\n   3→import { tmpdir } from \"node:os\";\n   4→import { join } from \"node:path\";\n   5→import { test } from \"node:test\";\n   6→import type { MemoryScope } from \"@lifediary/memory\";\n   7→import type { ChancellorEvent, ChancellorRequest, TicketResult } from \"../../../../../chancellor/src/index.ts\";\n   8→import type { SkillStore } from \"./skills.ts\";\n   9→import { createTools } from \"./tools.ts\";\n  10→import {\n  11→\tATTENTION_ONE_QUESTION,\n  12→\tCLARIFY_CONTRACT,\n  13→\tGROUNDING_DISCIPLINE,\n  14→\tREPORT_FOUR_LINES,\n  15→\tWORK_SILENCE_DISCIPLINE,\n  16→\tclarifyContractEnabled,\n  17→\tclarifyContractFor,\n  18→\tformatReport,\n  19→\tstartDelegation,\n  20→\ttype DelegationEvent,\n  21→\ttype DelegationReport,\n  22→} from \"./delegation.ts\";\n  23→import {\n  24→\tRULING_DISCIPLINE,\n  25→\tTAKEOVER_HINT,\n  26→\tVERIFICATION_IRON_LAW,\n  27→\tlifecycleOwnsVerification,\n  28→\tverificationIronLawFor,\n  29→} from \"./agent/turn-gate.ts\";\n  30→import {\n  31→\tARTIFACT_HANDOFF,\n  32→\tOWNER_DATA_DISCIPLINE,\n  33→\tbuildPartnerDisciplineSection,\n  34→\tbuildPartnerTurnContext,\n  35→\townerDataDisciplineEnabled,\n  36→} from \"./agent/partner-context.ts\";\n  37→import { PARTNER_CONTRACT_SECTIONS, PartnersStore, partnerContractTemplate } from \"./partners.ts\";\n  38→import { failureStreak } from \"./failure-streak.ts\";\n  39→\n  40→/**\n  41→ * 批 12（保证实现提示词七件）的口径断言：常量实文、装配点、四行回报、\n  42→ * 失败连击的接管提示。全部临时目录，不碰真实 `.data/`。\n  43→ */\n  44→\n  45→const FIXED_TEXTS: Array<[string, string]> = [\n  46→\t[\"VERIFICATION_IRON_LAW\", VERIFICATION_IRON_LAW],\n  47→\t[\"RULING_DISCIPLINE\", RULING_DISCIPLINE],\n  48→\t[\"WORK_SILENCE_DISCIPLINE\", WORK_SILENCE_DISCIPLINE],\n  49→\t[\"GROUNDING_DISCIPLINE\", GROUNDING_DISCIPLINE],\n  50→\t[\"ATTENTION_ONE_QUESTION\", ATTENTION_ONE_QUESTION],\n  51→\t[\"REPORT_FOUR_LINES\", REPORT_FOUR_LINES],\n  52→\t[\"TAKEOVER_HINT\", TAKEOVER_HINT],\n  53→\t[\"CLARIFY_CONTRACT\", CLARIFY_CONTRACT],\n  54→\t[\"ARTIFACT_HANDOFF\", ARTIFACT_HANDOFF],\n  55→\t[\"OWNER_DATA_DISCIPLINE\", OWNER_DATA_DISCIPLINE],\n  56→];\n  57→\n  58→test(\"固定字节：八段口径都不含日期 / 时刻 / 会话 id\", () => {\n  59→\tfor (const [name, text] of FIXED_TEXTS) {\n  60→\t\tassert.ok(text.length > 0, `${name} 不能为空`);\n  61→\t\tassert.equal(/20\\d{2}-\\d{1,2}-\\d{1,2}/.test(text), false, `${name} 不含日期`);\n  62→\t\tassert.equal(/\\d{1,2}:\\d{2}/.test(text), false, `${name} 不含时刻`);\n  63→\t}\n  64→});\n  65→\n  66→test(\"开工前先问清：三件事 + 一次一问 + 小活不问；只给总管\", () => {\n  67→\tassert.match(CLARIFY_CONTRACT, /大活（要改 3 个以上文件 \\/ 要跑命令 \\/ 涉及不可逆操作）/);\n  68→\tassert.match(CLARIFY_CONTRACT, /对象是什么/);\n  69→\tassert.match(CLARIFY_CONTRACT, /期望的结果长什么样/);\n  70→\tassert.match(CLARIFY_CONTRACT, /怎么算做好了/);\n  71→\tassert.match(CLARIFY_CONTRACT, /一次只问一个/);\n  72→\tassert.match(CLARIFY_CONTRACT, /小活不问/);\n  73→\t// 只给总管 / 主对话：普通执事走 partner-context 的提问纪律。\n  74→\tassert.equal(clarifyContractFor(null), CLARIFY_CONTRACT);\n  75→\tassert.equal(clarifyContractFor(\"chief\"), CLARIFY_CONTRACT);\n  76→\tassert.equal(clarifyContractFor(\"partner-uuid\"), undefined);\n  77→\t// 开关旁路（缺省开；显式 false 关）。\n  78→\tassert.equal(clarifyContractEnabled({} as NodeJS.ProcessEnv), true);\n  79→\tassert.equal(clarifyContractEnabled({ AGENT_CLARIFY_CONTRACT: \"false\" } as NodeJS.ProcessEnv), false);\n  80→\tconst saved = process.env.AGENT_CLARIFY_CONTRACT;\n  81→\tprocess.env.AGENT_CLARIFY_CONTRACT = \"false\";\n  82→\ttry {\n  83→\t\tassert.equal(clarifyContractFor(null), undefined);\n  84→\t} finally {\n  85→\t\tif (saved === undefined) delete process.env.AGENT_CLARIFY_CONTRACT;\n  86→\t\telse process.env.AGENT_CLARIFY_CONTRACT = saved;\n  87→\t}\n  88→});\n  89→\n  90→test(\"产物交接：产物落盘、点名路径、下一棒从产物开始\", () => {\n  91→\tassert.match(ARTIFACT_HANDOFF, /产出物必须落盘/);\n  92→\tassert.match(ARTIFACT_HANDOFF, /下一棒从产物开始，不要从转述开始/);\n  93→\tassert.match(ARTIFACT_HANDOFF, /点名产物路径/);\n  94→\tassert.match(ARTIFACT_HANDOFF, /没有落盘的「做完了」不算交接完成/);\n  95→\tassert.ok(buildPartnerDisciplineSection(\"partner-uuid\").includes(ARTIFACT_HANDOFF), \"执事纪律段包含产物交接\");\n  96→\tassert.ok(buildPartnerDisciplineSection(\"chief\").includes(ARTIFACT_HANDOFF), \"总管纪律段同样包含\");\n  97→\tconst saved = process.env.PARTNER_ARTIFACT_HANDOFF;\n  98→\tprocess.env.PARTNER_ARTIFACT_HANDOFF = \"false\";\n  99→\ttry {\n 100→\t\tassert.ok(!buildPartnerDisciplineSection(\"partner-uuid\").includes(ARTIFACT_HANDOFF), \"开关关掉整段不注入\");\n 101→\t} finally {\n 102→\t\tif (saved === undefined) delete process.env.PARTNER_ARTIFACT_HANDOFF;\n 103→\t\telse process.env.PARTNER_ARTIFACT_HANDOFF = saved;\n 104→\t}\n 105→});\n 106→\n 107→test(\"主人数据红线（批 21 §七）：分级 / 提案制 / 日记不可重写 / 引原话不打分\", () => {\n 108→\tassert.match(OWNER_DATA_DISCIPLINE, /数据域分级/);\n 109→\tassert.match(OWNER_DATA_DISCIPLINE, /只能追加或经提案/);\n 110→\tassert.match(OWNER_DATA_DISCIPLINE, /主人配置=只读/);\n 111→\tassert.match(OWNER_DATA_DISCIPLINE, /有判断，无权力/);\n 112→\tassert.match(OWNER_DATA_DISCIPLINE, /一次批准只覆盖一件事/);\n 113→\tassert.match(OWNER_DATA_DISCIPLINE, /日记域永不删除、重写、重排/);\n 114→\tassert.match(OWNER_DATA_DISCIPLINE, /引原文并标日期/);\n 115→\tassert.match(OWNER_DATA_DISCIPLINE, /不打分不评判/);\n 116→\tassert.ok(\n 117→\t\tbuildPartnerDisciplineSection(\"partner-uuid\").includes(OWNER_DATA_DISCIPLINE),\n 118→\t\t\"执事纪律段包含主人数据红线\",\n 119→\t);\n 120→\tassert.ok(buildPartnerDisciplineSection(\"chief\").includes(OWNER_DATA_DISCIPLINE), \"总管纪律段同样包含\");\n 121→\tconst saved = process.env.PARTNER_OWNER_DATA_DISCIPLINE;\n 122→\tprocess.env.PARTNER_OWNER_DATA_DISCIPLINE = \"false\";\n 123→\ttry {\n 124→\t\tassert.ok(\n 125→\t\t\t!buildPartnerDisciplineSection(\"partner-uuid\").includes(OWNER_DATA_DISCIPLINE),\n 126→\t\t\t\"开关关掉整段不注入\",\n 127→\t\t);\n 128→\t\tassert.equal(ownerDataDisciplineEnabled({} as NodeJS.ProcessEnv), true, \"缺省开\");\n 129→\t} finally {\n 130→\t\tif (saved === undefined) delete process.env.PARTNER_OWNER_DATA_DISCIPLINE;\n 131→\t\telse process.env.PARTNER_OWNER_DATA_DISCIPLINE = saved;\n 132→\t}\n 133→});\n 134→\n 135→test(\"验证铁律：五步门 + 对照表 + 红旗，≤500 字\", () => {\n 136→\tassert.equal(VERIFICATION_IRON_LAW.length <= 500, true, `实际 ${VERIFICATION_IRON_LAW.length} 字`);\n 137→\tassert.match(VERIFICATION_IRON_LAW, /这一轮里没有真的跑过验证/);\n 138→\tassert.match(VERIFICATION_IRON_LAW, /五步门/);\n 139→\tassert.match(VERIFICATION_IRON_LAW, /说「测试通过」→ 要有 0 失败的输出/);\n 140→\tassert.match(VERIFICATION_IRON_LAW, /说「做完了」→ 要有落盘的改动/);\n 141→\tassert.match(VERIFICATION_IRON_LAW, /应该 \\/ 大概 \\/ 看起来没问题/);\n 142→});\n 143→\n 144→test(\"裁决纪律：继续干 + 四停 + 一行账\", () => {\n 145→\tassert.match(RULING_DISCIPLINE, /要不要我继续/);\n 146→\tassert.match(RULING_DISCIPLINE, /只有四种情况停下问人/);\n 147→\tassert.match(RULING_DISCIPLINE, /不可逆或破坏性的操作/);\n 148→\tassert.match(RULING_DISCIPLINE, /裁决：<决定了什么>/);\n 149→});\n 150→\n 151→test(\"答案接地：数值 / 日期 / 引文要查得到，查不到就说记不清\", () => {\n 152→\tassert.match(GROUNDING_DISCIPLINE, /必须真的能在记忆 \\/ transcript \\/ 文件里查到/);\n 153→\tassert.match(GROUNDING_DISCIPLINE, /recall_sessions/);\n 154→\tassert.match(GROUNDING_DISCIPLINE, /我记不清了/);\n 155→\tassert.match(GROUNDING_DISCIPLINE, /不要编/);\n 156→});\n 157→\n 158→test(\"四行回报：状态 / 结果 / 证据 / 解锁 逐行\", () => {\n 159→\tconst lines = REPORT_FOUR_LINES.split(\"\\n\");\n 160→\tassert.equal(lines.length, 4);\n 161→\tassert.match(lines[0] ?? \"\", /^状态：完成 \\/ 部分完成 \\/ 卡住$/);\n 162→\tassert.match(lines[1] ?? \"\", /^结果：/);\n 163→\tassert.match(lines[2] ?? \"\", /^证据：/);\n 164→\tassert.match(lines[3] ?? \"\", /^解锁：/);\n 165→});\n 166→\n 167→test(\"归属：总管与普通会话归 lifecycle，普通执事归 partner-context\", () => {\n 168→\tassert.equal(verificationIronLawFor(\"partner-uuid\"), VERIFICATION_IRON_LAW);\n 169→\tassert.equal(verificationIronLawFor(\"chief\"), undefined);\n 170→\tassert.equal(verificationIronLawFor(null), undefined);\n 171→\tassert.equal(lifecycleOwnsVerification(null), true);\n 172→\tassert.equal(lifecycleOwnsVerification(\"chief\"), true);\n 173→\tassert.equal(lifecycleOwnsVerification(\"partner-uuid\"), false);\n 174→});\n 175→\n 176→test(\"装配：执事轮输入含四段纪律；总管轮不重复验证铁律\", () => {\n 177→\tconst root = mkdtempSync(join(tmpdir(), \"lifediary-batch12-\"));\n 178→\tconst store = new PartnersStore(join(root, \"partners.sqlite\"), join(root, \"homes\"));\n 179→\ttry {\n 180→\t\tconst partner = store.create(\"阿岚\");\n 181→\t\tstore.linkSession({ partnerId: partner.id, role: \"canonical\", routeKey: \"canonical\", sessionId: 606 });\n 182→\t\tconst context = buildPartnerTurnContext(partner.id, 606, {\n 183→\t\t\tstore,\n 184→\t\t\tworkRoot: join(root, \"runs\"),\n 185→\t\t\tapprovals: { pendingOf: () => [] },\n 186→\t\t});\n 187→\t\tconst text = context.text ?? \"\";\n 188→\t\tassert.match(text, /【验证铁律】/);\n 189→\t\tassert.match(text, /【裁决纪律】/);\n 190→\t\tassert.match(text, /【干活期间】/);\n 191→\t\tassert.match(text, /【提问纪律】/);\n 192→\t\tassert.ok(text.indexOf(\"【验证铁律】\") < text.indexOf(\"【裁决纪律】\"));\n 193→\n 194→\t\tstore.ensureChief(\"你是总管。\");\n 195→\t\tstore.linkSession({ partnerId: \"chief\", role: \"canonical\", routeKey: \"canonical\", sessionId: 607 });\n 196→\t\tconst chief = buildPartnerTurnContext(\"chief\", 607, {\n 197→\t\t\tstore,\n 198→\t\t\tworkRoot: join(root, \"runs\"),\n 199→\t\t\tapprovals: { pendingOf: () => [] },\n 200→\t\t});\n 201→\t\tassert.ok(!(chief.discipline.includes(\"【验证铁律】\")), \"总管的验证铁律由 lifecycle 注入，这里不重复\");\n 202→\t\tassert.match(chief.discipline, /【裁决纪律】/);\n 203→\t\tassert.equal(\n 204→\t\t\tbuildPartnerDisciplineSection(\"chief\"),\n 205→\t\t\t[\n 206→\t\t\t\tRULING_DISCIPLINE,\n 207→\t\t\t\tWORK_SILENCE_DISCIPLINE,\n 208→\t\t\t\tGROUNDING_DISCIPLINE,\n 209→\t\t\t\tARTIFACT_HANDOFF,\n 210→\t\t\t\tOWNER_DATA_DISCIPLINE,\n 211→\t\t\t\tATTENTION_ONE_QUESTION,\n 212→\t\t\t].join(\"\\n\\n\"),\n 213→\t\t);\n 214→\t} finally {\n 215→\t\tstore.close();\n 216→\t\trmSync(root, { recursive: true, force: true });\n 217→\t}\n 218→});\n 219→\n 220→test(\"delegate 描述：尾部带四行回报与裁决纪律\", () => {\n 221→\tconst scope: MemoryScope = { type: \"global\" };\n 222→\tconst skills: SkillStore = { names: () => [], manual: () => undefined, indexFor: () => undefined };\n 223→\tconst tool = createTools({ memory: null, scopeOf: () => scope, delegate: true, skills }).find(\n 224→\t\t(entry) => entry.name === \"delegate\",\n 225→\t);\n 226→\tassert.ok(tool, \"delegate 应注册\");\n 227→\tconst description = String(tool.description ?? \"\");\n 228→\tassert.ok(description.includes(REPORT_FOUR_LINES), \"四行格式原文被注入\");\n 229→\tassert.ok(description.includes(RULING_DISCIPLINE), \"裁决纪律原文被注入\");\n 230→\tassert.match(description, /给<你的名字>：/);\n 231→});\n 232→\n 233→test(\"formatReport：needs_you 带接管建议时追加；不带时逐字节不变\", () => {\n 234→\tconst result: TicketResult = {\n 235→\t\tticketId: \"T-1\",\n 236→\t\tstatus: \"needs_you\",\n 237→\t\tline: \"等你\",\n 238→\t\ttasks: [],\n 239→\t\tattention: { kind: \"need_decision\", question: \"选哪个？\" },\n 240→\t};\n 241→\tconst plain = formatReport(result, \"frontend\");\n 242→\tassert.ok(!plain.text.includes(\"建议你来接手\"));\n 243→\tconst hinted = formatReport(result, \"frontend\", { takeover: true });\n 244→\tassert.match(hinted.text, /建议你来接手/);\n 245→\tassert.match(hinted.text, /选哪个？/);\n 246→});\n 247→\n 248→/** 跑一张 needs_you 单：同步发单号，settle 在后台完成。 */\n 249→async function runNeedsYou(domain: string, ticketId: string, conversationId: number) {\n 250→\tconst events: DelegationEvent[] = [];\n 251→\tconst reports: DelegationReport[] = [];\n 252→\tconst { outcome } = startDelegation(\n 253→\t\t{ conversationId, domain, requirement: \"随便一件活\" },\n 254→\t\t{\n 255→\t\t\trun: (_request: ChancellorRequest, options: { onEvent?: (event: ChancellorEvent) => void }) => {\n 256→\t\t\t\toptions.onEvent?.({ type: \"ticket\", ticketId, message: \"已受理\" });\n 257→\t\t\t\treturn Promise.resolve({\n 258→\t\t\t\t\tticketId,\n 259→\t\t\t\t\tstatus: \"needs_you\",\n 260→\t\t\t\t\tline: \"等你回答\",\n 261→\t\t\t\t\ttasks: [],\n 262→\t\t\t\t\tattention: { kind: \"need_decision\", question: \"选哪个？\" },\n 263→\t\t\t\t} as TicketResult);\n 264→\t\t\t},\n 265→\t\t\temit: (_conversationId, event) => events.push(event),\n 266→\t\t\treport: (_conversationId, report) => reports.push(report),\n 267→\t\t\tautoReport: true,\n 268→\t\t},\n 269→\t);\n 270→\tawait outcome;\n 271→\treturn {\n 272→\t\tquestions: events.filter((event) => event.type === \"attention\").map((event) => event.question),\n 273→\t\treports,\n 274→\t};\n 275→}\n 276→\n 277→test(\"三次同类失败：第 3 次在 attention 卡片与汇报行都追加接管建议\", async () => {\n 278→\tconst domain = \"batch12-streak-hint\";\n 279→\tfailureStreak().recordSuccess(domain);\n 280→\tconst first = await runNeedsYou(domain, \"T-s1\", 701);\n 281→\tconst second = await runNeedsYou(domain, \"T-s2\", 701);\n 282→\tconst third = await runNeedsYou(domain, \"T-s3\", 701);\n 283→\tassert.ok(!first.questions[0]?.includes(TAKEOVER_HINT), \"第 1 次不提示\");\n 284→\tassert.ok(!second.questions[0]?.includes(TAKEOVER_HINT), \"第 2 次不提示\");\n 285→\tassert.match(third.questions[0] ?? \"\", /建议你来接手/);\n 286→\tassert.ok(!first.reports[0]?.text.includes(\"建议你来接手\"));\n 287→\tassert.match(third.reports[0]?.text ?? \"\", /建议你来接手/);\n 288→});\n 289→\n 290→test(\"连击开关关闭：记录照常、卡片不追加\", async () => {\n 291→\tconst domain = \"batch12-streak-off\";\n 292→\tfailureStreak().recordSuccess(domain);\n 293→\tconst previous = process.env.AGENT_TAKEOVER_HINT;\n 294→\tprocess.env.AGENT_TAKEOVER_HINT = \"false\";\n 295→\ttry {\n 296→\t\tawait runNeedsYou(domain, \"T-o1\", 702);\n 297→\t\tawait runNeedsYou(domain, \"T-o2\", 702);\n 298→\t\tconst third = await runNeedsYou(domain, \"T-o3\", 702);\n 299→\t\tassert.ok(!third.questions[0]?.includes(TAKEOVER_HINT));\n 300→\t\tassert.ok(!third.reports[0]?.text.includes(\"建议你来接手\"));\n 301→\t} finally {\n 302→\t\tif (previous === undefined) delete process.env.AGENT_TAKEOVER_HINT;\n 303→\t\telse process.env.AGENT_TAKEOVER_HINT = previous;\n 304→\t}\n 305→});\n 306→\n 307→test(\"中间成功一次：连击清零，后面两次失败不触发\", async () => {\n 308→\tconst domain = \"batch12-streak-reset\";\n 309→\tfailureStreak().recordSuccess(domain);\n 310→\tawait runNeedsYou(domain, \"T-r1\", 703);\n 311→\tawait runNeedsYou(domain, \"T-r2\", 703);\n 312→\tfailureStreak().recordSuccess(domain); // 相当于同一来源成功了一单\n 313→\tawait runNeedsYou(domain, \"T-r3\", 703);\n 314→\tconst last = await runNeedsYou(domain, \"T-r4\", 703);\n 315→\tassert.ok(!last.questions[0]?.includes(TAKEOVER_HINT));\n 316→});\n 317→\n 318→test(\"契约模板：四节标题逐字，决策分级带调查铁律\", () => {\n 319→\tassert.deepEqual([...PARTNER_CONTRACT_SECTIONS], [\"职责范围\", \"决策分级\", \"验收标准\", \"汇报对象\"]);\n 320→\tconst template = partnerContractTemplate();\n 321→\tfor (const section of PARTNER_CONTRACT_SECTIONS) {\n 322→\t\tassert.ok(template.includes(`## ${section}`));\n 323→\t}\n 324→\tassert.match(template, /没有调查不许改/);\n 325→});\n 326→"
    },
