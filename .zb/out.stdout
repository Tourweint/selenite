    "output": {
      "type": "text",
      "text": "  18→ */\n  19→\n  20→const DEFAULT_POLL_SECONDS = 30;\n  21→const MAX_POLL_SECONDS = 60;\n  22→const UPSTREAM_TIMEOUT_MS = 300_000;\n  23→\n  24→/** 取消墓碑留多久：够手机把「已经拿到但还没交」的结果回传一次，够判\"丢弃\"而不是\"未知单\"。 */\n  25→const CANCELED_TTL_MS = 10 * 60_000;\n  26→const CANCELED_CAP = 200;\n  27→\n  28→/**\n  29→ * 执行前重验开关（2026-11-10 批 26 §一）：默认开。\n  30→ * `PHONE_ENSURE_ACTIVE=false` → 交付前 / 收结果前都不再复核，回到本批之前的形态（一行回滚）。\n  31→ *\n  32→ * \"执行\"在手机上，服务端能保证的只有两件事：\n  33→ * ① **不再把已失效的单交出去**（取消 / 超时 / 已被别的 poll 认领）；\n  34→ * ② **已取消的单交回结果时不写回**（不 resolve，由 chancellor 侧按中止收口）。\n  35→ */\n  36→export function phoneEnsureActive(env: NodeJS.ProcessEnv = process.env): boolean {\n  37→  const raw = (env.PHONE_ENSURE_ACTIVE ?? \"\").trim().toLowerCase();\n  38→  if (!raw) return true;\n  39→  return raw !== \"false\" && raw !== \"0\" && raw !== \"off\";\n  40→}\n  41→\n  42→interface PendingEntry {\n  43→  task: PhoneTask;\n  44→  /** 到期时刻：交付前再判一次，比\"等 setTimeout 真的触发\"更早挡住已超时的单。 */\n  45→  deadlineAt: number;\n  46→  /** 派活方给的信号：取消即 abort，交付前据此判\"已取消\"。 */\n  47→  signal?: AbortSignal;\n  48→  resolve(result: PhoneResult): void;\n  49→}\n  50→\n  51→interface WaitingPoll {\n  52→  timer: NodeJS.Timeout;\n  53→  resolve(task: PhoneTask | null): void;\n  54→}\n  55→\n  56→/** taskId → 等手机交结果的 Promise；没落库，重启即丢。 */\n  57→const pending = new Map<string, PendingEntry>();\n  58→/** 还没人 poll 走的任务，按派活顺序排队。 */\n  59→const ready: string[] = [];\n  60→/** 设备 → 当前挂着的 poll；同设备新 poll 会顶掉旧的。 */\n  61→const polls = new Map<string, WaitingPoll>();\n  62→/** 最近被取消的 taskId → 取消时刻：结果迟到时能回\"已丢弃\"而不是\"未知单\"。 */\n  63→const canceled = new Map<string, number>();\n  64→\n  65→/** 判定一张已登记的单还能不能交付。取消优先于超时（事实更具体）。 */\n  66→export function inactiveReason(\n  67→  entry: { deadlineAt: number; signal?: AbortSignal },\n  68→  now = Date.now(),\n  69→): \"canceled\" | \"expired\" | null {\n  70→  if (entry.signal?.aborted) return \"canceled\";\n  71→  if (now >= entry.deadlineAt) return \"expired\";\n  72→  return null;\n  73→}\n  74→\n  75→function markCanceled(taskId: string, now = Date.now()): void {\n  76→  canceled.set(taskId, now);\n  77→  if (canceled.size <= CANCELED_CAP) return;\n  78→  for (const [id, at] of canceled) {\n  79→    if (canceled.size <= CANCELED_CAP) break;\n  80→    if (now - at > CANCELED_TTL_MS) canceled.delete(id);\n  81→  }\n  82→  // 还是超限：按插入顺序丢最旧的（Map 保序），墓碑只用于回一句\"已丢弃\"，丢了不影响结果。\n  83→  while (canceled.size > CANCELED_CAP) {\n  84→    const oldest = canceled.keys().next().value;\n  85→    if (oldest === undefined) break;\n  86→    canceled.delete(oldest);\n  87→  }\n  88→}\n  89→\n  90→function isRecentlyCanceled(taskId: string, now = Date.now()): boolean {\n  91→  const at = canceled.get(taskId);\n  92→  if (at === undefined) return false;\n  93→  if (now - at > CANCELED_TTL_MS) {\n  94→    canceled.delete(taskId);\n  95→    return false;\n  96→  }\n  97→  return true;\n  98→}\n  99→\n 100→const transport: PhoneTransport = {\n 101→  dispatch(task, signal) {\n 102→    if (signal?.aborted) return Promise.reject(abortReason(signal));\n 103→\n 104→    return new Promise<PhoneResult>((resolve, reject) => {\n 105→      let settled = false;\n 106→\n 107→      const entry: PendingEntry = {\n 108→        task,\n 109→        deadlineAt: Date.now() + Math.max(1, task.budgetMs),\n 110→        signal,\n 111→        resolve: (result) => finish(() => resolve(result)),\n 112→      };\n 113→\n 114→      const finish = (apply: () => void): void => {\n 115→        if (settled) return;\n 116→        settled = true;\n 117→        clearTimeout(timer);\n 118→        signal?.removeEventListener(\"abort\", onAbort);\n 119→        // 同 taskId 重派时，旧单收尾不能连坐删掉新单的登记（否则新单永远交付不出去）。\n 120→        if (pending.get(task.taskId) === entry) pending.delete(task.taskId);\n 121→        const queued = ready.indexOf(task.taskId);\n 122→        if (queued >= 0) ready.splice(queued, 1);\n 123→        apply();\n 124→      };\n 125→\n 126→      const timer = setTimeout(() => {\n 127→        finish(() => reject(new PhoneTaskTimeoutError(task.taskId, task.budgetMs)));\n 128→      }, Math.max(1, task.budgetMs));\n 129→\n 130→      const onAbort = (): void => {\n 131→        // 墓碑：手机可能已经拿着这张单在跑了；它交回结果时按\"已取消、已丢弃\"回。\n 132→        markCanceled(task.taskId);\n 133→        finish(() => reject(abortReason(signal)));\n 134→      };\n 135→      signal?.addEventListener(\"abort\", onAbort, { once: true });\n 136→\n 137→      pending.set(task.taskId, entry);\n 138→\n 139→      if (!flushPoll(task)) ready.push(task.taskId);\n 140→    });\n 141→  },\n 142→};\n 143→\n 144→registerPhoneTransport(transport);\n 145→\n 146→function flushPoll(task: PhoneTask): boolean {\n 147→  const first = polls.entries().next();\n 148→"
    },
