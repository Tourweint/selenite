    "output": {
      "type": "text",
      "text": "   1→import { createMemoryEngine, scopeKey, type MemoryEngine, type MemoryScope } from \"@lifediary/memory\";\n   2→import { diaryStore } from \"../diary.ts\";\n   3→import { recentDiaryMemories, syncDiaryToMemory } from \"../memory-ingest.ts\";\n   4→import { preferenceExtractor } from \"../memory-extract.ts\";\n   5→import {\n   6→\tCOMPANIONS_ENABLED,\n   7→\tchiefPartnerEnabled,\n   8→\tchiefSkillsDir,\n   9→\tensureChiefPartner,\n  10→\tpartnersStore,\n  11→\tresolvePartnerScope,\n  12→} from \"../partners.ts\";\n  13→import { createSkillStore, resolveSkillsDir, type SkillStore } from \"../skills.ts\";\n  14→import { getSkillState, skillStateEnabled } from \"../skill-state.ts\";\n  15→import { proactiveForTurn } from \"../memory-proactive.ts\";\n  16→\n  17→/**\n  18→ * 派活能力（chancellor）是否装。\n  19→ *\n  20→ * 默认装。关掉（`CHANCELLOR_ENABLED=false`）时工具清单回到 8 个，行为与改动前完全一致\n  21→ * ——这是回滚开关，不是功能开关：出问题时不用改代码，改一行环境变量就退回去。\n  22→ */\n  23→export const CHANCELLOR_ENABLED = (process.env.CHANCELLOR_ENABLED?.trim() || \"true\").toLowerCase() !== \"false\";\n  24→\n  25→export const PERSONA = [\n  26→\t\"你是一个个人助手，和一个具体的人长期相处。记录生活是你们最常一起做的事，\",\n  27→\t\"但对方提出别的要求（查东西、整理、动手做事）时也要正常帮忙。\",\n  28→\t// 2026-11-01 需求方：原来\"有温度\"读起来太软——像客服和哄人。\n  29→\t// 口径改成\"直接、克制、就事论事\"：不撒娇、不堆情绪词、不和稀泥，也不说教。\n  30→\t\"说话直接、克制、就事论事，像个熟悉的朋友，不像客服。\",\n  31→\t\"不撒娇、不堆情绪词、不为了安慰而安慰；对方情绪低时接住一句就够，不追问、不铺开。\",\n  32→\t\"不说教、不打气、不总结人生道理。\",\n  33→\t// 2026-10-29 需求方定的硬约束：这条同时是\"该动手时一定动手\"的兜底 ——\n  34→\t// 快档模型若为了省事直接编，用户会拿到假信息，比慢一点更糟。\n  35→\t\"凡是涉及真实文件、真实数据、真实日程或当前时间的事，必须先用工具去看，不许凭印象回答或编造；\",\n  36→\t\"看不到就说看不到，并说明缺什么。闲聊和感受不需要调工具。\",\n  37→\t\"记忆只在确有必要时检索（对方提到过去的事、需要接上以前的话），别每句都查。\",\n  38→\t\"需要长期记住的事用 remember；想不起对方说过什么用 recall；要定时提醒用 set_reminder。\",\n  39→].join(\"\");\n  40→\n  41→/**\n  42→ * 普通 worker 的人格（2026-11-06 侧栏调整 B2）。\n  43→ *\n  44→ * 为什么要单独一段：新建会话以前也走总管 persona——前端只是没把\"总管\"写进按钮，\n  45→ * 模型那边照样自称总管、默认维护执事档案。worker 是**普通任务助手**：\n  46→ * 不读总管 SOUL、不冒称总管、不建立执事身份，但工具闸门 / 工作区边界 / 审批一条不少。\n  47→ */\n  48→export const WORKER_PERSONA = [\n  49→\t\"你是一个普通任务助手，负责把交到你手上的具体事情办完。\",\n  50→\t\"说话直接、克制、就事论事，给结论也给依据；不冒充总管，也不代表任何执事。\",\n  51→\t\"涉及真实文件、真实数据、真实日程或当前时间的事，必须先用工具去看，不许凭印象回答或编造；看不到就说明缺什么。\",\n  52→\t\"没有预设的私人档案，也不主动建立执事身份。\",\n  53→\t\"需要长期记住的事用 remember；想不起对方说过什么用 recall；要定时提醒用 set_reminder。\",\n  54→].join(\"\");\n  55→\n  56→/**\n  57→ * 新会话能不能开成 worker（2026-11-06 B2 回滚开关）：`WORKER_CHAT_ENABLED=false` 只拦**新建**，\n  58→ * 已经落盘的 worker 保持原身份（不把旧 worker 重解释成总管）。默认启用。\n  59→ */\n  60→export function workerChatEnabled(): boolean {\n  61→\tconst raw = process.env.WORKER_CHAT_ENABLED?.trim().toLowerCase();\n  62→\tif (!raw) return true;\n  63→\treturn raw !== \"false\" && raw !== \"0\";\n  64→}\n  65→\n  66→// ── 记忆 ─────────────────────────────────────────────────\n  67→/** 召回候选窗口下限（2026-11-04 批次一 A2-S）：不配 = 200；设 50 = 旧行为。 */\n  68→function memoryCandidateFloor(): number | undefined {\n  69→\tconst raw = Number(process.env.MEMORY_CANDIDATE_FLOOR);\n  70→\treturn Number.isInteger(raw) && raw > 0 ? raw : undefined;\n  71→}\n  72→\n  73→/**\n  74→ * 召回检索器（2026-11-04 批次三 A2-F）：`auto`（默认，FTS5 trigram 候选集） / `js`（批次一窗口路径）。\n  75→ * 只在装配处读 env —— memory 包本身不碰环境变量。\n  76→ */\n  77→function memoryFtsEnabled(): boolean {\n  78→\treturn (process.env.MEMORY_RETRIEVER ?? \"\").trim().toLowerCase() !== \"js\";\n  79→}\n  80→\n  81→/**\n  82→ * 记忆时间衰减（2026-11-08 扫尾批 6 §一）：日衰减系数，默认 0.99；`0` = 关（回滚）。\n  83→ * 空串 / 非数字 / 越界一律回落默认值——衰减是后台机制，不该被一个坏 env 卡死。\n  84→ */\n  85→function memoryDecayDaily(): number {\n  86→\tconst raw = (process.env.MEMORY_DECAY_DAILY ?? \"\").trim();\n  87→\tif (!raw) return 0.99;\n  88→\tconst value = Number(raw);\n  89→\tif (!Number.isFinite(value) || value < 0 || value > 1) return 0.99;\n  90→\treturn value;\n  91→}\n  92→\n  93→export const memoryEngine: MemoryEngine | null = (() => {\n  94→\tif (process.env.MEMORY_ENABLED === \"false\") return null;\n  95→\ttry {\n  96→\t\tconst extractor = preferenceExtractor();\n  97→\t\treturn createMemoryEngine({\n  98→\t\t\tdbPath: process.env.MEMORY_DB_PATH,\n  99→\t\t\tcandidateFloor: memoryCandidateFloor(),\n 100→\t\t\tfts: memoryFtsEnabled(),\n 101→\t\t\tdecayDaily: memoryDecayDaily(),\n 102→\t\t\t// 2026-11-06：不传 = 保持 memory 包的默认（HeuristicExtractor），\n 103→\t\t\t// 即 `MEMORY_EXTRACT=rule` 与\"模型不可用\"这两种情况**逐字节回到旧行为**。\n 104→\t\t\t...(extractor ? { extractor } : {}),\n 105→\t\t});\n 106→\t} catch (error) {\n 107→\t\tconst detail = error instanceof Error ? error.message : String(error);\n 108→\t\tconsole.warn(`记忆库初始化失败，本次以无记忆运行: ${detail}`);\n 109→\t\treturn null;\n 110→\t}\n 111→})();\n 112→\n 113→// ── 技能 ─────────────────────────────────────────────────\n 114→/**\n 115→ * 技能读取链（2026-11-08 批 10-A）：`resolveSkillsDir().dirs` 已经是完整的合并链——\n 116→ * AGENT_SKILLS_DIR 显式 / 用户目录（首访自动建）→ `%USERPROFILE%\\.agents\\skills`（只读）\n 117→ * → 应用目录兜底。主目录排第一，用户目录为空时内置手册仍然可见；同名先到先得。\n 118→ */\n 119→const resolvedSkills = resolveSkillsDir();\n 120→const SKILLS_DIRS: string[] = resolvedSkills.dirs.map((source) => source.dir);\n 121→\n 122→// 技能启停位（2026-11-09 用户拍板：默认全关，界面上开）。SKILL_STATE=false 逃生门 = 回到全进索引。\n 123→// 注意 getSkillState() 在闭包里懒取（别在模块顶层解构）——首次调用发生在请求期，.env 已就绪。\n 124→const skillVisible = (name: string): boolean =>\n 125→\tskillStateEnabled() && getSkillState().isEnabled(name);\n 126→\n 127→export const skillStore: SkillStore | null = (() => {\n 128→\t// 主对话（总管）技能（批次D D1）：总管技能目录优先、全局 skills/ 兜底，同名时总管覆盖全局\n 129→\t// （createSkillStore 对目录数组按先到先得合并）。CHIEF_PARTNER=false 时只留全局目录 = 改动前。\n 130→\tif (chiefPartnerEnabled()) {\n 131→\t\ttry {\n 132→\t\t\treturn createSkillStore([chiefSkillsDir(), ...SKILLS_DIRS], { visible: skillVisible });\n 133→\t\t} catch (error) {\n 134→\t\t\tconst detail = error instanceof Error ? error.message : String(error);\n 135→\t\t\tconsole.warn(`总管技能目录加载失败，回落全局技能: ${detail}`);\n 136→\t\t}\n 137→\t}\n 138→\ttry {\n 139→\t\treturn createSkillStore(SKILLS_DIRS, { visible: skillVisible });\n 140→\t} catch (error) {\n 141→\t\tconst detail = error instanceof Error ? error.message : String(error);\n 142→\t\tconsole.warn(`技能目录加载失败，本次无技能可用: ${detail}`);\n 143→\t\treturn null;\n 144→\t}\n 145→})();\n 146→\n 147→/**\n 148→ * 总管播种（服务启动时调一次）。CHIEF_PARTNER=false / 执事能力关闭时 ensureChiefPartner 内部旁路。\n 149→ * 播种失败只 warn：主对话的 persona 会回落 PERSONA 常量，绝不会被弄哑。\n 150→ */\n 151→export function seedChiefPartner(): void {\n 152→\ttry {\n 153→\t\tensureChiefPartner(PERSONA);\n 154→\t} catch (error) {\n 155→\t\tconst detail = error instanceof Error ? error.message : String(error);\n 156→\t\tconsole.warn(`[chief] 总管播种失败（主对话回落 PERSONA）: ${detail}`);\n 157→\t}\n 158→}\n 159→\n 160→/**\n 161→ * 记忆作用域跟着**内部会话 id** 走。\n 162→ *\n 163→ * 它是存储自己发的、重开进程也不变，所以作用域稳定。\n 164→ * 对外暴露的 conversationId 是另一个东西（下面 Chats 里的 uuid），\n 165→ * 用它会把\"客户端标识\"和\"存储主键\"绑在一起，以后换实现就麻烦了。\n 166→ */\n 167→/**\n 168→ * 执事会话的执事 scope（批次B B1/B2）：会话挂在链接表上 → 它属于某个执事，\n 169→ * 记忆读写落到 `partner:<uuid>` 键空间（与主人记忆隔离）。查失败一律当普通会话，\n 170→ * 记忆永远不能把对话卡住。\n 171→ */\n 172→function partnerScopeOf(conversationId: number): MemoryScope | null {\n 173→\tif (!COMPANIONS_ENABLED) return null;\n 174→\ttry {\n 175→\t\t// D15 刻意差异：主对话就是总管，他继续读写 global + session，不吃 partner: 键空间。\n 176→\t\t// partnerId === \"chief\" → null 的判定在 partners.ts 的 resolvePartnerScope（同名纯函数也供单测），\n 177→\t\t// 别把它\"修\"成和普通执事一致；除总管外的执事会话行为完全不变。\n 178→\t\treturn resolvePartnerScope(partnersStore(), conversationId);\n 179→\t} catch {\n 180→\t\treturn null;\n 181→\t}\n 182→}\n 183→\n 184→export function scopeOf(conversationId: number): MemoryScope {\n 185→\treturn partnerScopeOf(conversationId) ?? { type: \"session\", id: String(conversationId) };\n 186→}\n 187→\n 188→/**\n 189→ * 偏好该落哪个 scope（2026-11-06）。\n 190→ *\n 191→ * - 主对话（总管 / 普通会话 / worker）→ `global`：偏好是**关于这个人**的，\n 192→ *   换个会话照样该生效；\n 193→ * - 执事会话 → `partner:<id>`：执事的记忆键空间与主人隔离（D15），\n 194→ *   偏好也该留在它自己的地盘里，不能写进主人的 global。\n 195→ */\n 196→export function preferenceScopeOf(conversationId: number): MemoryScope {\n 197→\treturn partnerScopeOf(conversationId) ?? { type: \"global\" };\n 198→}\n 199→\n 200→/** 召回失败绝不能让对话失败，所以一律吞掉并降级为空上下文。 */\n 201→export function recallContext(conversationId: number, text: string): string {\n 202→\tif (!memoryEngine || !text.trim()) return \"\";\n 203→\ttry {\n 204→\t\t// 群会话不参与记忆引擎（2026-11-06 群组方案 §2.2）：召回整个跳过，\n 205→\t\t// 群聊不写不读个人记忆防串台；群内连续性靠会话历史 + 群时间线本身。\n 206→\t\tif (partnersStore().isGroupSession(conversationId)) return \"\";\n 207→\t\t// 执事会话（批次B B1）：global + 执事键空间 + 本会话三条都进候选；\n 208→\t\t// 键空间过滤是 store 的硬过滤（scope IN），执事键空间外的记录不会被召回。\n 209→\t\tconst partner = partnerScopeOf(conversationId);\n 210→\t\treturn memoryEngine.buildContext(\n 211→\t\t\t{\n 212→\t\t\t\ttext,\n 213→\t\t\t\tscopes: [\n 214→\t\t\t\t\t\"global\",\n 215→\t\t\t\t\t...(partner ? [scopeKey(partner)] : []),\n 216→\t\t\t\t\tscopeKey({ type: \"session\", id: String(conversationId) }),\n 217→\t\t\t\t],\n 218→\t\t\t},\n 219→\t\t\t// 「也许值得提起」（2026-11-10 批 17 §二）：默认关；执事轮不注入，\n 220→\t\t\t// 免得执事在干活时被旧事带走（总开关与执事判断都在 memory-proactive.ts）。\n 221→\t\t\t{ proactive: proactiveForTurn(partner !== null) },\n 222→\t\t);\n 223→\t} catch (error) {\n 224→\t\tconst detail = error instanceof Error ? error.message : String(error);\n 225→\t\tconsole.warn(`记忆召回失败，本轮不使用记忆: ${detail}`);\n 226→\t\treturn \"\";\n 227→\t}\n 228→}\n 229→\n 230→/**\n 231→ * 任务会话的\"近况记忆\"块（2026-10-31，记忆方案 §3 的 B 路 + §4 注入例外）。\n 232→ *\n 233→ * 给**需要知道最近记了什么**的任务用（目前只有 `question` / `diary_review`）：\n 234→ * 数据源是日记镜像（`diary.sqlite` 近 N 天 `CONFIRMED`），不经过 App——\n 235→ * App 不再拼画像/近况（它是两处真相的源头，见方案 D7）。\n 236→ *\n 237→ * 位置：**拼在 instructions 的尾部**。这样模板那一大段前缀不变，缓存照旧命中，\n 238→ * 只有\"近况\"这一小段是新的（§2.3 实测：尾部追加不破坏前缀）。\n 239→ */\n 240→export function taskMemoryBlock(days = 3, limit = 12): string {\n 241→\ttry {\n 242→\t\t// 2026-10-31 二次收口：**先把镜像里的成稿摄入记忆，再从记忆取**。\n 243→\t\t// 之前这里直接读 diary.sqlite，等于在记忆系统旁边开了条捷径——聊天走记忆、任务读镜像，\n 244→\t\t// 两套并存，才会出现\"记忆库是空的\"这种怪事。现在两边同一个源。\n 245→\t\tsyncDiaryToMemory(days);\n 246→\t\tlet items = recentDiaryMemories(days, limit);\n 247→\t\tif (items.length === 0) {\n 248→\t\t\t// 兜底：记忆库还没就绪（例如 MEMORY_ENABLED=false）时，至少别让提问瞎问\n 249→\t\t\tconst since = new Date(Date.now() - days * 86_400_000).toISOString().slice(0, 10);\n 250→\t\t\titems = diaryStore()\n 251→\t\t\t\t.recent(since, limit)\n 252→\t\t\t\t.filter((entry) => (entry.finalText ?? \"\").trim().length > 0)\n 253→\t\t\t\t.map((entry) => ({\n 254→\t\t\t\t\tdate: entry.entryDate ?? \"\",\n 255→\t\t\t\t\ttext: String(entry.finalText).replace(/\\s+/g, \" \").trim(),\n 256→\t\t\t\t}));\n 257→\t\t}\n 258→\t\tif (items.length === 0) return \"\";\n 259→\t\tconst lines = items.map((item) => `- ${item.date || \"（无日期）\"}：${item.text.slice(0, 120)}`);\n 260→\t\treturn [\n 261→\t\t\t\"<memory>\",\n 262→\t\t\t`最近 ${days} 天你自己记下的（只作参考：可以呼应，不要逐条复述，也不要评价记多记少）：`,\n 263→\t\t\t...lines,\n 264→\t\t\t\"</memory>\",\n 265→\t\t].join(\"\\n\");\n 266→\t} catch (error) {\n 267→\t\t// 记忆读失败绝不能让任务失败（镜像/记忆库可能都还没建）\n 268→\t\tconst detail = error instanceof Error ? error.message : String(error);\n 269→\t\tconsole.warn(`[memory] 近况读取失败，本次不注入: ${detail}`);\n 270→\t\treturn \"\";\n 271→\t}\n 272→}\n 273→"
    },
