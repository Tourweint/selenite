      "text": " 300→// 记忆管理（2026-11-06）：看 / 删 / 标过时。只读列表不碰 durable，删改直接落记忆库。\n 301→mountMemoryApi(app, { enabled: memoryEngine !== null });\n 302→// 技能管理（2026-11-08 扫尾批 9-S）：目录解析 = AGENT_SKILLS_DIR → 用户目录 → 应用目录兜底。\n 303→// 技能增删只影响下一个会话（D5 既有取舍），UI 文案已如实说明。\n 304→mountSkills(app);\n 305→\n 306→// 界面（2026-11-03）：原来那张 M0 调试页换成了真界面，仍然是同源静态文件。\n 307→// 桌面壳和浏览器打开的都是这个 `/`。\n 308→mountWeb(app);\n 309→\n 310→// ── 配对（2026-10-29）：手机扫这一屏换设备凭据 ────────────────\n 311→const SERVER_VERSION = \"0.1.0\";\n 312→\n 313→function currentPort(): number {\n 314→  return Number(process.env.PORT ?? 39847);\n 315→}\n 316→\n 317→/**\n 318→ * 配对码的 JSON 版（2026-11-03）：桌面端要在自己的设置页里显示二维码，\n 319→ * 而 `/pair` 返回的是一整张 HTML。同一个码、同一个来源，只是换个格式。\n 320→ */\n 321→app.get(\"/api/v1/pair/qr\", async (c) => {\n 322→  const { code, expiresAt } = pairing.issueCode();\n 323→  const url = buildPairUrl(resolvePairBase(currentPort()), code);\n 324→  const dataUrl = await QRCode.toDataURL(url, { margin: 1, width: 320 });\n 325→  c.header(\"Cache-Control\", \"no-store\");\n 326→  return c.json({\n 327→    url,\n 328→    dataUrl,\n 329→    machineName: hostname(),\n 330→    expiresInSeconds: Math.max(1, Math.round((expiresAt - Date.now()) / 1000)),\n 331→  });\n 332→});\n 333→\n 334→/** 已配对的设备（桌面设置页要看「有哪些手机连着」）。凭据哈希不外泄。 */\n 335→app.get(\"/api/v1/pair/devices\", (c) => {\n 336→  const devices = pairing.listDevices().map((device) => ({\n 337→    id: device.id,\n 338→    name: device.name,\n 339→    createdAt: device.createdAt,\n 340→    lastSeenAt: device.lastSeenAt ?? null,\n 341→    revoked: Boolean(device.revokedAt),\n 342→  }));\n 343→  return c.json({ devices });\n 344→});\n 345→\n 346→/** 撤掉一台设备（CORS 只放 GET/POST，所以用 POST 而不是 DELETE） */\n 347→app.post(\"/api/v1/pair/devices/:id/revoke\", (c) => {\n 348→  const ok = pairing.revokeDevice(c.req.param(\"id\"));\n 349→  return ok ? c.json({ ok: true }) : c.json({ ok: false }, 404);\n 350→});\n 351→\n 352→/** 配对页每次打开都换一枚新码（旧码立即作废，符合\"一次性\"语义） */\n 353→app.get(\"/pair\", async (c) => {\n 354→  const { code, expiresAt } = pairing.issueCode();\n 355→  const url = buildPairUrl(resolvePairBase(currentPort()), code);\n 356→  const dataUrl = await QRCode.toDataURL(url, { margin: 1, width: 320 });\n 357→  c.header(\"Cache-Control\", \"no-store\");\n 358→  return c.html(\n 359→    pairPage({\n 360→      url,\n 361→      dataUrl,\n 362→      machineName: hostname(),\n 363→      expiresInSeconds: Math.max(1, Math.round((expiresAt - Date.now()) / 1000)),\n 364→    }),\n 365→  );\n 366→});\n 367→\n 368→/** 探活：手机在兑换前先确认\"这台机器在不在\"（不含任何密钥） */\n 369→app.get(\"/api/v1/pair/info\", (c) =>\n 370→  c.json({ name: hostname(), version: SERVER_VERSION, pairing: true }),\n 371→);\n 372→\n 373→/** 出一枚新码（命令行/别的客户端用；调试页走 /pair 页面） */\n 374→app.post(\"/api/v1/pair/code\", (c) => {\n 375→  const { code, expiresAt } = pairing.issueCode();\n 376→  return c.json({ code, expiresAt, url: buildPairUrl(resolvePairBase(currentPort()), code) });\n 377→});\n 378→\n 379→/** 用码换设备凭据（免鉴权：手机此刻还没有任何凭据） */\n 380→app.post(\"/api/v1/pair/redeem\", async (c) => {\n 381→  const ip = (() => {\n 382→    try {\n 383→      return getConnInfo(c).remote.address ?? \"local\";\n 384→    } catch {\n 385→      return \"local\";\n 386→    }\n 387→  })();\n 388→  if (redeemRateLimited(ip)) return c.json({ error: \"too_many_attempts\" }, 429);\n 389→\n 390→  const body = (await c.req.json().catch(() => null)) as\n 391→    | { code?: string; deviceName?: string }\n 392→    | null;\n 393→  const code = body?.code?.trim();\n 394→  if (!code) return c.json({ error: \"bad_request\" }, 400);\n 395→\n 396→  const result = pairing.redeem(code, body?.deviceName?.trim() || \"手机\");\n 397→  if (typeof result === \"string\") {\n 398→    const status =\n 399→      result === \"unknown_code\"\n 400→        ? 404\n 401→        : result === \"code_used\"\n 402→          ? 409\n 403→          : result === \"code_expired\"\n 404→            ? 410\n 405→            : 429;\n 406→    return c.json({ error: result }, status);\n 407→  }\n 408→  console.log(`[pair] 新设备已配对（${ip}），当前共 ${pairing.listDevices().length} 台`);\n 409→  return c.json({ deviceToken: result.deviceToken, name: hostname(), version: SERVER_VERSION });\n 410→});\n 411→\n 412→app.get(\"/api/v1/pair/devices\", (c) => c.json(pairing.listDevices()));\n 413→\n 414→app.post(\"/api/v1/pair/devices/:id/revoke\", (c) =>\n 415→  pairing.revokeDevice(c.req.param(\"id\"))\n 416→    ? c.json({ ok: true })\n 417→    : c.json({ error: \"unknown_device\" }, 404),\n 418→);\n 419→\n 420→/** 会话索引（只元数据，供手机重装后重建历史列表） */\n 421→app.get(\"/api/v1/agent/chats\", async (c) => {\n 422→  const limit = Number(c.req.query(\"limit\") ?? 50);\n 423→  const chats = await listChats(Number.isFinite(limit) ? limit : 50);\n 424→  return c.json({ chats, removed: chatMetaSummary().hidden });\n 425→});\n 426→\n 427→/**\n 428→ * 会话改名 / 从列表移除（2026-11-03）。\n 429→ *\n 430→"
