      "type": "text",
      "text": " 150→\t\tif (messages.length === 0) {\n 151→\t\t\treturn c.json(\n 152→\t\t\t\t{ error: { message: \"messages 里没有可用内容\", type: \"invalid_request_error\" } },\n 153→\t\t\t\t400,\n 154→\t\t\t);\n 155→\t\t}\n 156→\n 157→\t\tif (!readLlmConfig()) {\n 158→\t\t\treturn c.json(\n 159→\t\t\t\t{ error: { message: \"服务端未配置 LLM_API_KEY\", type: \"invalid_request_error\" } },\n 160→\t\t\t\t503,\n 161→\t\t\t);\n 162→\t\t}\n 163→\n 164→\t\t// 分流点（三路，2026-10-30 起）：\n 165→\t\t// A. 带 `X-Task` → 任务通道：按任务名在**服务端**渲染模板，走 Agent 会话（建会话、落库、可回读）；\n 166→\t\t// B. 带非空 `system` → 直通上游（不建会话，老客户端/纯 OpenAI 端点仍走这条）；\n 167→\t\t// C. 都没有 → 通用聊天 Agent。\n 168→\t\tconst rawTask = c.req.header(\"X-Task\")?.trim().toLowerCase();\n 169→\t\tif (rawTask) {\n 170→\t\t\tconst task = resolveTask(rawTask);\n 171→\t\t\tif (!task) {\n 172→\t\t\t\treturn c.json(\n 173→\t\t\t\t\t{\n 174→\t\t\t\t\t\terror: {\n 175→\t\t\t\t\t\t\tcode: \"unknown_task\",\n 176→\t\t\t\t\t\t\tmessage: `未知任务 ${rawTask}；可用：${taskNames().join(\" / \")}`,\n 177→\t\t\t\t\t\t\ttype: \"invalid_request_error\",\n 178→\t\t\t\t\t\t},\n 179→\t\t\t\t\t},\n 180→\t\t\t\t\t400,\n 181→\t\t\t\t);\n 182→\t\t\t}\n 183→\t\t\t// 先渲染再开会话：模板炸了就回 500，绝不留半条空会话（写库前失败才干净）\n 184→\t\t\tlet prompt: string;\n 185→\t\t\ttry {\n 186→\t\t\t\tprompt = renderTask(task, body.task_vars ?? {});\n 187→\t\t\t} catch (error) {\n 188→\t\t\t\tconst detail = error instanceof TaskRenderError ? error.reason : String(error);\n 189→\t\t\t\tconsole.error(`[compat task ${rawTask}] 渲染失败: ${detail}`);\n 190→\t\t\t\treturn c.json(\n 191→\t\t\t\t\t{\n 192→\t\t\t\t\t\terror: {\n 193→\t\t\t\t\t\t\tcode: \"task_render_failed\",\n 194→\t\t\t\t\t\t\tmessage: `任务 ${rawTask} 渲染失败`,\n 195→\t\t\t\t\t\t\ttype: \"server_error\",\n 196→\t\t\t\t\t\t},\n 197→\t\t\t\t\t},\n 198→\t\t\t\t\t500,\n 199→\t\t\t\t);\n 200→\t\t\t}\n 201→\t\t\t// 近况记忆（2026-10-31，记忆方案 §4）：只有声明了 `memory` 的任务才注入，\n 202→\t\t\t// 且**拼在 instructions 尾部**——模板前缀不变，缓存照旧命中（方案 §2.3 实测）。\n 203→\t\t\tconst memory = task.memory === \"diary\" ? taskMemoryBlock() : \"\";\n 204→\t\t\tconst promptWithMemory = memory ? `${prompt}\\n\\n${memory}` : prompt;\n 205→\t\t\tif (memory) {\n 206→\t\t\t\tconsole.log(`[compat task ${taskLabel(task)}] 注入近况记忆 ${memory.length} 字符`);\n 207→\t\t\t}\n 208→\t\t\treturn agentChat(c, body, messages, { label: taskLabel(task), prompt: promptWithMemory });\n 209→\t\t}\n 210→\n 211→\t// 2026-10-31（方案 D10 步骤 5）：**直通分支已删除**。\n 212→\t// 生产端已无调用方（12 个任务全走 X-Task，聊天从不带 system）。\n 213→\t// 带 system 一律 400：宁可让旧客户端立刻报错，也不要静默降级成\"聊天轨迹\"——\n 214→\t// 那样它的模板会被当普通消息丢掉，产出看着像成功、其实是残废（比报错更糟）。\n 215→\tif (messages.some((m) => m.role === \"system\")) {\n 216→\t\treturn c.json(\n 217→\t\t\t{\n 218→\t\t\t\terror: {\n 219→\t\t\t\t\ttype: \"invalid_request_error\",\n 220→\t\t\t\t\tcode: \"system_prompt_not_supported\",\n 221→\t\t\t\t\tmessage: \"不再接受 system 提示词：任务请用 X-Task + task_vars（模板在服务端），聊天不要带 system。\",\n 222→\t\t\t\t},\n 223→\t\t\t},\n 224→\t\t\t400,\n 225→\t\t);\n 226→\t}\n 227→\n 228→\t// 剩下的都是聊天轨迹（无 task、无 system）\n 229→\treturn agentChat(c, body, messages);\n 230→"
