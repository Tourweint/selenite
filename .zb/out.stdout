        "content": " 150→\t\t\tif (device.fingerprint !== expected && device.keyChangedAt === undefined) {\n 151→\t\t\t\tdevice.keyChangedAt = now;\n 152→\t\t\t\tdirty = true;\n 153→\t\t\t\tconsole.warn(\n 154→\t\t\t\t\t`[pairing] 设备 ${device.id.slice(0, 8)} 的凭据指纹不匹配，已按 fail-closed 停用`,\n 155→\t\t\t\t);\n 156→\t\t\t}\n 157→\t\t}\n 158→\t\tif (dirty) this.persist();\n 159→\t}\n 160→\n 161→\t/** 落盘失败只 warn：配对库写不进去不该让服务起不来（与 load 同口径）。 */\n 162→\tprivate persist(): void {\n 163→\t\ttry {\n 164→\t\t\tsave(this.storePath, this.store);\n 165→\t\t} catch (error) {\n 166→\t\t\tconsole.warn(\n 167→\t\t\t\t`[pairing] 写入 ${this.storePath} 失败: ${error instanceof Error ? error.message : String(error)}`,\n 168→\t\t\t);\n 169→\t\t}\n 170→\t}\n 171→\n 172→\t/** 生成一枚新码（同一时刻只保留一枚；新码顶掉旧码）。返回明文码，只在此刻存在。 */\n 173→\tissueCode(now = Date.now()): { code: string; expiresAt: number } {\n 174→\t\tconst code = String(randomInt(0, 1_000_000)).padStart(6, \"0\");\n 175→\t\tconst expiresAt = now + CODE_TTL_SECONDS * 1000;\n 176→\t\tthis.store.code = { hash: sha256(code), expiresAt, attempts: 0 };\n 177→\t\tsave(this.store);\n 178→\t\treturn { code, expiresAt };\n 179→\t}\n 180→\n 181→\t/** 当前是否还有一枚可用码（调试页据此显示\"生成/等待扫码\"） */\n 182→\thasLiveCode(now = Date.now()): boolean {\n 183→\t\tconst code = this.store.code;\n 184→\t\treturn !!code && !code.usedAt && code.expiresAt > now && code.attempts < MAX_CODE_ATTEMPTS;\n 185→\t}\n 186→\n 187→\t/** 用码换设备凭据。失败会累计尝试次数（撞上限即作废这枚码）。 */\n 188→\tredeem(code: string, deviceName: string, now = Date.now()): RedeemResult | RedeemError {\n 189→\t\tconst current = this.store.code;\n 190→\t\tif (!current) return \"unknown_code\";\n 191→\t\tif (current.usedAt) return \"code_used\";\n 192→\t\tif (current.expiresAt <= now) return \"code_expired\";\n 193→\t\tif (current.attempts >= MAX_CODE_ATTEMPTS) return \"too_many_attempts\";\n 194→\n 195→\t\tif (!hashEquals(current.hash, sha256(code.trim()))) {\n 196→\t\t\tcurrent.attempts += 1;\n 197→\t\t\tsave(this.store);\n 198→\t\t\treturn current.attempts >= MAX_CODE_ATTEMPTS ? \"too_many_attempts\" : \"unknown_code\";\n 199→\t\t}\n 200→\n 201→\t\tconst deviceToken = randomBytes(32).toString(\"base64url\");\n 202→\t\tconst device: StoredDevice = {\n 203→\t\t\tid: randomBytes(8).toString(\"hex\"),\n 204→\t\t\tname: deviceName.trim().slice(0, 40) || \"手机\",\n 205→\t\t\ttokenHash: sha256(deviceToken),\n 206→\t\t\tcreatedAt: now,\n 207→\t\t};\n 208→\t\tcurrent.usedAt = now;\n 209→\t\t// 设备上限：踢掉最久没用过的那台（防无限堆积）\n 210→\t\tthis.store.devices = [...this.store.devices, device]\n 211→\t\t\t.filter((item) => !item.revokedAt)\n 212→\t\t\t.sort((a, b) => (b.lastSeenAt ?? b.createdAt) - (a.lastSeenAt ?? a.createdAt))\n 213→\t\t\t.slice(0, MAX_DEVICES);\n 214→\t\tsave(this.store);\n 215→\t\treturn { deviceToken, deviceId: device.id };\n 216→\t}\n 217→\n 218→\t/** 设备凭据是否有效（每次请求都会走一次；命中即刷新 lastSeenAt，但最多每分钟落一次盘） */\n 219→\tverifyDeviceToken(token: string, now = Date.now()): boolean {\n 220→\t\tconst hash = sha256(token);\n 221→\t\tlet touched = false;\n 222→\t\tfor (const device of this.store.devices) {\n 223→\t\t\tif (device.revokedAt) continue;\n 224→\t\t\tif (!hashEquals(device.tokenHash, hash)) continue;\n 225→\t\t\tif (!device.lastSeenAt || now - device.lastSeenAt > 60_000) {\n 226→\t\t\t\tdevice.lastSeenAt = now;\n 227→\t\t\t\ttouched = true;\n 228→\t\t\t}\n 229→\t\t\tif (touched) save(this.store);\n 230→\t\t\treturn true;\n 231→\t\t}\n 232→\t\treturn false;\n 233→\t}\n 234→\n 235→\tlistDevices(): Array<Omit<StoredDevice, \"tokenHash\">> {\n 236→\t\treturn this.store.devices.map(({ tokenHash: _hidden, ...rest }) => rest);\n 237→\t}\n 238→\n 239→\trevokeDevice(id: string, now = Date.now()): boolean {\n 240→\t\tconst device = this.store.devices.find((item) => item.id === id && !item.revokedAt);\n 241→\t\tif (!device) return false;\n 242→\t\tdevice.revokedAt = now;\n 243→\t\tsave(this.store);\n 244→\t\treturn true;\n 245→\t}\n 246→\n 247→\t/** 调试页展示：当前码还剩多少秒（没有可用码返回 0） */\n 248→\tcodeRemainingSeconds(now = Date.now()): number {\n 249→\t\tconst code = this.store.code;\n 250→\t\tif (!code || code.usedAt || code.expiresAt <= now) return 0;\n 251→\t\treturn Math.max(0, Math.ceil((code.expiresAt - now) / 1000));\n 252→\t}\n 253→}\n 254→\n 255→/** 配对链接：手机扫出来的就是这一行（自定义 scheme，App 自己 parse） */\n 256→export function buildPairUrl(base: string, code: string): string {\n 257→\tconst url = new URL(base.startsWith(\"http\") ? base : `http://${base}`);\n 258→\treturn `lifediary-pair://v1?base=${encodeURIComponent(url.origin)}&code=${code}`;\n 259→}\n 260→",
        "renderer": {
