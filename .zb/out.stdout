      "type": "text",
      "text": "   1→import type { Hono, Context } from \"hono\";\n   2→import {\n   3→  PhoneTaskTimeoutError,\n   4→  registerPhoneTransport,\n   5→  type PhoneResult,\n   6→  type PhoneTask,\n   7→  type PhoneTransport,\n   8→} from \"../../../../../chancellor/src/index.ts\";\n   9→\n  10→/**\n  11→ * 手机 worker 的电脑侧（2026-11-02 契约）。\n  12→ *\n  13→ * 三个接口，手机全部主动发起：poll 要活、model 代理 key、result 交结果。\n  14→ * 队列只在内存里：重启就丢，丢了的单子由 chancellor 判 idle。\n  15→ *\n  16→ * 鉴权由 `index.ts` 的 `/api/v1/*` 中间件统一兜住（设备凭据 ∪ 共享令牌），\n  17→ * 这里不再自己判 —— 失败 403 空体那条口径只写在一处。\n  18→ */\n  19→\n  20→const DEFAULT_POLL_SECONDS = 30;\n  21→const MAX_POLL_SECONDS = 60;\n  22→const UPSTREAM_TIMEOUT_MS = 300_000;\n  23→\n  24→interface PendingEntry {\n  25→  task: PhoneTask;\n  26→  resolve(result: PhoneResult): void;\n  27→}\n  28→\n  29→interface WaitingPoll {\n  30→  timer: NodeJS.Timeout;\n  31→  resolve(task: PhoneTask | null): void;\n  32→}\n  33→\n  34→/** taskId → 等手机交结果的 Promise；没落库，重启即丢。 */\n  35→const pending = new Map<string, PendingEntry>();\n  36→/** 还没人 poll 走的任务，按派活顺序排队。 */\n  37→const ready: string[] = [];\n  38→/** 设备 → 当前挂着的 poll；同设备新 poll 会顶掉旧的。 */\n  39→const polls = new Map<string, WaitingPoll>();\n  40→\n  41→const transport: PhoneTransport = {\n  42→  dispatch(task, signal) {\n  43→    if (signal?.aborted) return Promise.reject(abortReason(signal));\n  44→\n  45→    return new Promise<PhoneResult>((resolve, reject) => {\n  46→      let settled = false;\n  47→\n  48→      const finish = (apply: () => void): void => {\n  49→        if (settled) return;\n  50→        settled = true;\n  51→        clearTimeout(timer);\n  52→        signal?.removeEventListener(\"abort\", onAbort);\n  53→        pending.delete(task.taskId);\n  54→        const queued = ready.indexOf(task.taskId);\n  55→        if (queued >= 0) ready.splice(queued, 1);\n  56→        apply();\n  57→      };\n  58→\n  59→      const timer = setTimeout(() => {\n  60→        finish(() => reject(new PhoneTaskTimeoutError(task.taskId, task.budgetMs)));\n  61→      }, Math.max(1, task.budgetMs));\n  62→\n  63→      const onAbort = (): void => {\n  64→        finish(() => reject(abortReason(signal)));\n  65→      };\n  66→      signal?.addEventListener(\"abort\", onAbort, { once: true });\n  67→\n  68→      pending.set(task.taskId, {\n  69→        task,\n  70→        resolve: (result) => finish(() => resolve(result)),\n  71→      });\n  72→\n  73→      if (!flushPoll(task)) ready.push(task.taskId);\n  74→    });\n  75→  },\n  76→};\n  77→\n  78→registerPhoneTransport(transport);\n  79→\n  80→function flushPoll(task: PhoneTask): boolean {\n  81→  const first = polls.entries().next();\n  82→  if (first.done) return false;\n  83→  const [device, poll] = first.value;\n  84→  polls.delete(device);\n  85→  clearTimeout(poll.timer);\n  86→  poll.resolve(task);\n  87→  return true;\n  88→}\n  89→\n  90→function nextQueuedTask(): PhoneTask | null {\n  91→  while (ready.length > 0) {\n  92→    const taskId = ready.shift();\n  93→    if (taskId === undefined) break;\n  94→    const entry = pending.get(taskId);\n  95→    if (entry) return entry.task;\n  96→  }\n  97→  return null;\n  98→}\n  99→\n 100→export function mountPhoneWorker(app: Hono): void {\n 101→  /** 要活：有活立刻给，没活挂起 timeoutS 秒（默认 30，上限 60）后 204。 */\n 102→  app.post(\"/api/v1/worker/poll\", async (c) => {\n 103→    const body = (await c.req.json().catch(() => null)) as { timeoutS?: unknown } | null;\n 104→    const requested =\n 105→      typeof body?.timeoutS === \"number\" && Number.isFinite(body.timeoutS)\n 106→        ? body.timeoutS\n 107→        : DEFAULT_POLL_SECONDS;\n 108→    const timeoutS = Math.min(MAX_POLL_SECONDS, Math.max(1, Math.round(requested)));\n 109→    const device = bearerOf(c) || \"anonymous\";\n 110→\n 111→    const immediate = nextQueuedTask();\n 112→    if (immediate) return c.json(toWireTask(immediate));\n 113→\n 114→    // 同一设备只留一个 poll：新的顶掉旧的，旧的按超时收 204。\n 115→    const previous = polls.get(device);\n 116→    if (previous) {\n 117→      polls.delete(device);\n 118→      clearTimeout(previous.timer);\n 119→      previous.resolve(null);\n 120→    }\n 121→\n 122→    let received: PhoneTask | null = null;\n 123→    let poll: WaitingPoll | null = null;\n 124→    const signal = c.req.raw.signal;\n 125→\n 126→    await new Promise<void>((resolve) => {\n 127→      const done = (): void => {\n 128→        signal.removeEventListener(\"abort\", onAbort);\n 129→        resolve();\n 130→      };\n 131→      const onAbort = (): void => {\n 132→        if (poll && polls.get(device) === poll) {\n 133→          polls.delete(device);\n 134→          clearTimeout(poll.timer);\n 135→        }\n 136→        done();\n 137→      };\n 138→      poll = {\n 139→        timer: setTimeout(() => {\n 140→          if (poll && polls.get(device) === poll) polls.delete(device);\n 141→          done();\n 142→        }, timeoutS * 1000),\n 143→        resolve: (task) => {\n 144→          received = task;\n 145→          done();\n 146→        },\n 147→      };\n 148→      polls.set(device, poll);\n 149→      signal.addEventListener(\"abort\", onAbort, { once: true });\n 150→    });\n 151→\n 152→    if (!received) return c.body(null, 204);\n 153→    return c.json(toWireTask(received));\n 154→  });\n 155→\n 156→  /**\n 157→   * 调模型：拿 harness 自己的 key 转发，响应原样回去。\n 158→   * 流式原样透传流，非流式原样返回字节；失败只回 502 + 脱敏后的说明。\n 159→   */\n 160→  app.post(\"/api/v1/worker/model\", async (c) => {\n 161→    const body = (await c.req.json().catch(() => null)) as\n 162→      | {\n 163→          taskId?: unknown;\n 164→          messages?: unknown;\n 165→          tools?: unknown;\n 166→          tool_choice?: unknown;\n 167→          stream?: unknown;\n 168→        }\n 169→      | null;\n 170→\n 171→    if (!body || !Array.isArray(body.messages)) {\n 172→      return c.json({ error: \"bad_request\" }, 400);\n 173→    }\n 174→\n 175→    const apiKey = process.env.LLM_API_KEY?.trim() || \"\";\n 176→    if (apiKey === \"\") {\n 177→      return c.json({ error: \"upstream_failed\", detail: \"LLM 未配置\" }, 502);\n 178→    }\n 179→\n 180→    const baseUrl = (\n 181→      process.env.LLM_BASE_URL?.trim() ||\n 182→      \"https://dashscope.aliyuncs.com/compatible-mode/v1\"\n 183→    ).replace(/\\/+$/, \"\");\n 184→    const model = process.env.LLM_MODEL?.trim() || \"deepseek-v4.1-flash\";\n 185→    const stream = body.stream === true;\n 186→\n 187→    const payload: Record<string, unknown> = { model, messages: body.messages };\n 188→    if (Array.isArray(body.tools)) payload.tools = body.tools;\n 189→    if (body.tool_choice !== undefined) payload.tool_choice = body.tool_choice;\n 190→    if (stream) payload.stream = true;\n 191→\n 192→    let upstream: Response;\n 193→    try {\n 194→      upstream = await fetch(`${baseUrl}/chat/completions`, {\n 195→        method: \"POST\",\n 196→        headers: {\n 197→          \"content-type\": \"application/json\",\n 198→          authorization: `Bearer ${apiKey}`,\n 199→        },\n 200→        body: JSON.stringify(payload),\n 201→        signal: AbortSignal.timeout(UPSTREAM_TIMEOUT_MS),\n 202→      });\n 203→    } catch {\n 204→      // 连接失败的原始错误里可能带 URL；只给一句能定位方向的话。\n 205→      return c.json({ error: \"upstream_failed\", detail: \"连不上模型商\" }, 502);\n 206→    }\n 207→\n 208→    const contentType = upstream.headers.get(\"content-type\") ?? \"\";\n 209→    if (!upstream.ok) {\n 210→      const text = await upstream.text().catch(() => \"\");\n 211→      return c.json(\n 212→        { error: \"upstream_failed\", detail: redact(text, apiKey) },\n 213→        502,\n 214→      );\n 215→    }\n 216→\n 217→    if (stream || contentType.includes(\"text/event-stream\")) {\n 218→      return c.newResponse(upstream.body, 200, {\n 219→        \"content-type\": contentType || \"text/event-stream\",\n 220→        \"cache-control\": \"no-cache\",\n 221→        \"x-accel-buffering\": \"no\",\n 222→      });\n 223→    }\n 224→\n 225→    const text = await upstream.text();\n 226→    return c.body(text, 200, {\n 227→      \"content-type\": contentType || \"application/json\",\n 228→    });\n 229→  });\n 230→\n 231→  /** 交结果：按 taskId 唤醒挂着的 Promise；找不到（比如电脑重启过）就 404。 */\n 232→  app.post(\"/api/v1/worker/result\", async (c) => {\n 233→    const body = (await c.req.json().catch(() => null)) as\n 234→      | {\n 235→          taskId?: unknown;\n 236→          status?: unknown;\n 237→          summary?: unknown;\n 238→          attention?: unknown;\n 239→        }\n 240→      | null;\n 241→\n 242→    if (!body || typeof body.taskId !== \"string\" || typeof body.summary !== \"string\") {\n 243→      return c.json({ error: \"bad_request\" }, 400);\n 244→    }\n 245→    if (\n 246→      body.status !== \"done\" &&\n 247→      body.status !== \"blocked\" &&\n 248→      body.status !== \"failed\"\n 249→    ) {\n 250→      return c.json({ error: \"bad_request\" }, 400);\n 251→    }\n 252→\n 253→    const entry = pending.get(body.taskId);\n 254→    if (!entry) return c.json({ error: \"unknown_task\" }, 404);\n 255→\n 256→    const attention = parseAttention(body.attention);\n 257→    entry.resolve({\n 258→      status: body.status,\n 259→      summary: body.summary,\n 260→      ...(body.status === \"blocked\" && attention ? { attention } : {}),\n 261→    });\n 262→    return c.json({ ok: true });\n 263→  });\n 264→}\n 265→\n 266→function toWireTask(task: PhoneTask): PhoneTask {\n 267→  return {\n 268→    taskId: task.taskId,\n 269→    goal: task.goal,\n 270→    doneWhen: task.doneWhen,\n 271→    budgetMs: task.budgetMs,\n 272→  };\n 273→}\n 274→\n 275→function parseAttention(raw: unknown): { kind: \"need_action\"; question: string } | null {\n 276→  if (raw === null || typeof raw !== \"object\") return null;\n 277→  const obj = raw as Record<string, unknown>;\n 278→  if (obj.kind !== \"need_action\") return null;\n 279→  if (typeof obj.question !== \"string\" || obj.question.trim() === \"\") return null;\n 280→  return { kind: \"need_action\", question: obj.question.trim() };\n 281→}\n 282→\n 283→function bearerOf(c: Context): string {\n 284→  const header = c.req.header(\"Authorization\") ?? \"\";\n 285→  return header.startsWith(\"Bearer \") ? header.slice(7).trim() : \"\";\n 286→}\n 287→\n 288→function abortReason(signal?: AbortSignal): Error {\n 289→  const reason = signal?.reason;\n 290→  if (reason instanceof Error) return reason;\n 291→  const error = new Error(\"已停止\");\n 292→  error.name = \"AbortError\";\n 293→  return error;\n 294→}\n 295→\n 296→/** 上游报错只留一句：截断并抹掉 key（哪怕上游把它回显了）。 */\n 297→function redact(text: string, apiKey: string): string {\n 298→  const trimmed = text.trim();\n 299→  const redacted = apiKey === \"\" ? trimmed : trimmed.split(apiKey).join(\"[redacted]\");\n 300→  return redacted.length <= 500 ? redacted : `${redacted.slice(0, 500)}…`;\n 301→}\n 302→"
    },
