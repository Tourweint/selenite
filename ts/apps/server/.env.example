# 复制为 .env 后填写；不填也能跑，走 mock 流。
# 冷门端口，防撞车（避开常见开发端口与 Windows 动态端口区 49152+）；仍可用 PORT 覆盖。
PORT=39847

# 访问令牌：手机等其他设备连进来必须配；不配则只允许本机回环访问。
# 生成示例：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AGENT_TOKEN=

# OpenAI 兼容端点。百炼 / DeepSeek / 本地 Ollama 都行，换一行配置即可。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# magpie 本地网关（127.0.0.1:3425，OpenAI 兼容）：providers.json 的 magpie 供应商引用这个变量名。
# 密钥值只存环境变量（不入库不入仓）；本机用户级已设 MAGPIE_API_KEY=magpie（2026-11-04）。
MAGPIE_API_KEY=
# 2026-10-31 方案 D1：快/深同款模型（换模型 = 上游缓存清零），快慢只靠 enable_thinking。
LLM_MODEL=deepseek-v4.1-flash
# 部署别名（D1 后不再承载快慢语义）；**不写入 providers.json**，仍从 env 读
LLM_MODEL_FAST=deepseek-v4.1-flash

# ── 多供应商（2026-11-04 批次五，接口文档 §2.10）──────────────────────────
# 首启播种：.data/providers.json 不存在时，上面这些 env 写成默认供应商；
# 之后以文件为准，再改 env 不会覆盖文件（启动日志会说明）。
# LLM_MODELS 只是播种时并入默认供应商的模型清单（逗号分隔）。
# LLM_MODELS=deepseek-v4.1-flash,qwen-plus
# 供应商配置路径 / 回滚开关（false = 忽略文件、不播种、回到纯 env）
# PROVIDERS_PATH=.data/providers.json
# PROVIDERS_CONFIG=true
# 密钥直填（2026-11-05）：界面填 API Key → 服务端写密钥文件并热注入 env。
# PROVIDER_SECRETS=true
# PROVIDER_KEYS_PATH=.data/provider-keys.json
# 运行时选择落点（只存 {model:{providerId,modelId}}，无密钥）
# MODEL_RUNTIME_PATH=.data/runtime.json
# 回滚开关：false = 关闭运行时切模型（接口一律 400，启动忽略已存选择）。
# MODEL_RUNTIME_OVERRIDE=true

# 假模型：走真实 durable 链路（会话落库/工具/压缩都在跑），只是模型回固定内容。
# 用来不花钱验整条 HTTP 链路；设了它就忽略 LLM_API_KEY。
# LLM_PROVIDER=faux
# 假模型只会调工具、永远不收尾 —— 专门用来验工具回合上限
# LLM_FAUX_TOOL=recall

# 一次提问里最多来回几次工具回合，撞上限会把这一轮收尾并提示用户重新发。0 = 不限。
# 30 偏紧（整理一整个目录会半路截断），100 是权衡后的默认；再高就属于"跑十几分钟没人管"了。
AGENT_MAX_TURNS=100

# ── 伙伴与例行任务（2026-11-05 批次B）────────────────────────────────────
# 伙伴能力总开关：false = 端点不挂载（404）、partner_skill_write 不上架、例行引擎不订事件。
# PARTNERS_DB_PATH=.data/partners.sqlite
# PARTNER_HOMES_ROOT=.data/partner-homes
# ROUTINES_STATE_PATH=.data/routines.json
# 定时任务执行历史（2026-11-17 定时任务重做）：坏文件当空、全局最多 500 条、不存原始错误。
# REMINDER_RUNS_STATE_PATH=.data/reminder-runs.json
# COMPANIONS_ENABLED=true

# 副会话（一人多聊，2026-11-17）：每个执事/总管可另开多条副会话，人设/记忆/项目共用，
# 但派活唤醒、定时提醒、人格结算仍只落主对话。默认开、即时生效（插件页可关）。
# false = 不列/不建副会话；已存在的仍可按 id 打开（不丢数据）。
# PARTNER_SIDE_SESSIONS=true

# 员工人格模块（2026-11-14 批1，方案 docs/设计方案/2026-11-14-员工人格模块（开关化拟人）.md）
# false = 整体退回旧行为：不读 personaModules（契约 / 目标 / 纪律 / 履历 / 在办谁都不裁）、
# 静态模块（口吻 / 里子 / 处境）不进 instructions、GET /partners/:id/persona 只回默认值
# （enabled=false，前端整块隐藏）、PUT 该端点 400。缺省开。内容文件留在家目录不删。
# PARTNER_PERSONA_MODULES=true

# 纪律覆盖（2026-11-16）：每执事家目录 DISCIPLINE.md 按固定标题替换行为纪律；
# 缺节 = 宿主默认，空节 = 删这一条；## 主人数据红线固定注入、不可覆盖。
# false = 不读不写覆盖文件，GET/PUT/DELETE /partners/:id/discipline 全部 400。
# PARTNER_DISCIPLINE_EDIT=true

# 记忆召回总闸（2026-11-16，父子关系的父）：false = 所有会话每轮都不再自动带记忆
# （只留 recall 工具主动查）。子开关 = 每位执事/总管人设页「按相关度召回 → 记忆 + 项目记忆」
# （persona_switches.memoryRecallEnabled，默认开）。缺省开；界面在 设置 → 服务 → 行为开关。
# PARTNER_MEMORY_RECALL=true

# 人设页工具勾选 / 运行时过滤的回滚开关（2026-11-16 工具裁剪 B）：缺省开；
# 0 / false / off = 整组关闭：GET /partners/:id/tools 回 enabled:false 空形状（页面隐藏那张卡）、
# PUT 该端点 400、chatStream 不动会话 modelTools、默认开销页不过滤工具面。
# PARTNER_TOOLS_ENABLED=true

# Worker（普通任务助手）人设（2026-11-16）：全局一份，设置 → 人设 → 普通助手 可改。
# WORKER_PERSONA_EDIT=true
# WORKER_PERSONA_PATH=.data/worker-persona.md

# 低频工具索引（2026-11-16 C 段）：8 个管理型工具注册成 deferred（初始不进请求），
# 系统提示词末尾给一段「按需工具」清单，模型调 tool_search 才加载（下一轮生效）。
# false / 0 / off = 全部工具照旧常驻、不注册 tool_search、不渲染清单。
# AGENT_TOOL_INDEX=true

# 工具用量账（2026-11-17）：记每个工具真实执行次数（成败分桶）+ tool_search 加载次数，
# 落 .data/tool-usage.json，GET /agent/tool-usage 查。false / 0 / off = 停记 + 端点 404。
# TOOL_USAGE=true

# 一轮对话时间线（2026-11-17）：按 /chat 的 SSE 单号把工具/闸门/回合/token/收尾
# 聚合成一条账，落 .data/turn-timeline.jsonl，GET /agent/turn-timeline?turnId=<uuid> 查。
# 只记枚举/计数/字数/耗时，不含对话内容。false / 0 / off = 停记 + 端点 404。
# TURN_TIMELINE=true
# 测试隔离用（生产不设）：AGENT_TURN_TIMELINE_PATH=.data/turn-timeline.jsonl

# ── 总管身份（2026-11-05 批次D D1）────────────────────────────────────────
# 主对话 = 总管：首次启动播种固定 id "chief" 的伙伴（家目录 partner-homes/chief/，
# SOUL.md 初始正文 = 旧 PERSONA 原文），persona 段改从 SOUL 当前版本快照读；
# 总管仍走 global + session 记忆；技能目录 chief/ 优先、全局 skills/ 兜底。
# false/0 = 不播种、persona 常量直读，行为与改动前完全一致（回滚开关）。
# CHIEF_PARTNER=true

# ── 主动性与自主审批（2026-11-05 批次C）────────────────────────────────────
# 任务观察层 + 自主轮高危审批总开关。**默认关**（不配 = 关）——这决定它是惊喜还是惊吓。
# 开启后：卡住/等你/出错/用量受限四类提醒写会话行；例行轮（autonomous）的写/派/定时
# 一律强制手机审批且禁"记住"。AUTONOMY_ENABLED=false（或环境里没有它）= 全部行为为零。
# 2026-11-09 T2 起三档：false（缺省）/ observe（只记 .data/autonomy-observe.jsonl，
# 不写会话、不起模型调用）/ true（完整行为）。
# AUTONOMY_ENABLED=true
# AUTONOMY_ENABLED=observe
# 卡住判据：working 持续多少秒无新进展（前台工具在途放宽到 45 分钟）。默认 600。
# AUTONOMY_STUCK_MIN_S=600
# AUTONOMY_STATE_PATH=.data/autonomy-state.json
# 观察记录落点（append-only JSONL，只存枚举与 ≤140 字文案，不存对话内容）。
# AUTONOMY_OBSERVE_PATH=.data/autonomy-observe.jsonl

# ── 主动性与例行 T2（2026-11-09）─────────────────────────────────────────
# 例行轮安静契约：模型回 [[no-update]]、或产出 < 40 字且无数字/链接/日期 → 不写摘要。
# ROUTINE_QUIET=false 回到"模型说啥都算内容"。阈值可调。
# ROUTINE_QUIET=true
# ROUTINE_QUIET_MIN_CHARS=40
# 注入防线（三条纪律的固定实文，挂总管 persona 后与执事轮输入尾部）。
# AGENT_INJECTION_GUARD=false
# 自动化永不扩权：自主轮里 routine_manage / partner_manage / group_manage /
# send_to_agent 结构性拒绝；delegate 不得带 targetDevice、新派必须带 project。
# AUTONOMY_NO_ESCALATION=false

# ── 防打转守卫（2026-11-05 批次A A1）──────────────────────────────────────
# 模型连续重复完全相同的工具调用（同参数同结果）到铁证线时，执行前直接拦下并要求用已有信息回答。
# 疑似（未到铁证）只进服务端日志。false/0 = 关（行为与改动前完全一致，回滚开关）。
# TOOL_LOOP_GUARD=true

# ── 可靠性（2026-11-04 批次一）────────────────────────────────────────────
# 模型请求超时（毫秒）。不设 = OpenAI SDK 默认 10 分钟；主要约束连接/响应头等待，不约束整段生成时长。
# AGENT_STREAM_TIMEOUT_MS=
# 失败的 run 之后排队输入的处置：keep / continue / withdraw；不设 = 内核默认 keep。
# AGENT_AFTER_FAILED_RUN=keep
# bash 工具默认超时（秒）。模型显式传 timeout 不覆盖；0 = 不设默认超时。
# AGENT_BASH_TIMEOUT_S=900

# 思考档（2026-11-04 档位化）：聊天默认 off（思考关变体）；首次调工具时按上一轮 prompt
# 规模判定 —— 低于阈值（默认 4000 token）切一次目标档并保持，长会话不切
# （切一次 = 前缀整段重算）。
# AGENT_THINK_TOKEN_LIMIT=4000
# 首次工具调用自动切档的目标档：off / low / medium / high，默认 low。
# 旧语义是固定 deep（= 今天的 high），所以想恢复老行为填 high；填 off 等于不切。
# 目标档不在当前模型支持域时会落回支持域内 ≤ 它的最高档。
# AGENT_THINK_TOOL_LEVEL=low
# AGENT_THINK_ON_TOOL=on   # off = 彻底不切（旧名 AGENT_TOOL_UPGRADE 兼容保留）

# 思考档自动探活（2026-11-04 D1）：切到从未声明过档位的模型时，后台对 low/medium/high
# 各发一个 8s 超时的迷你请求（≤16 tokens、串行），实测支持域写进 providers.json 的
# modelThinkingLevels；已声明模型永不重探。探活失败只记日志，不影响聊天。
# false = 完全关闭（不探不写，UI 走缺省域 off/low/high）。
# MODEL_PROBE_LEVELS=true

# 技能目录（2026-10-31 方案步骤 2）：*.md 文件，文件名=技能名，第 1 行=索引摘要，其余=手册。
# 缺省用 apps/server/skills/；目录不存在或为空则不渲染索引、不上 skill 工具。
# AGENT_SKILLS_DIR=

# 存储位置
# AGENT_DB_PATH=.data/agent.sqlite
# MEMORY_DB_PATH=.data/memory.db
# 召回候选窗口下限（2026-11-04 批次一 A2-S）。不设 = 200；50 = 改版前的行为。
# MEMORY_CANDIDATE_FLOOR=200
# 召回检索器（2026-11-04 批次三 A2-F）：auto（默认，FTS5 trigram 3-gram 候选集） /
# js（回到批次一的窗口路径）。回滚开关，不设 = auto。
# MEMORY_RETRIEVER=auto
# 记忆页 A 版（2026-11-13）：false = 回到旧版记忆列表（旧 DOM/逻辑整套保留）。不设 = 开。
# MEMORY_PAGE_A=true
# 整理后台任务（2026-11-13）：false = 整理回到同步等待（旧行为）。不设 = 开。
# MEMORY_CONSOLIDATE_JOB=true
# 每晚自动对账（2026-11-14）：每天 03:30（本地时区）像手动点一次「对账」，
# 我的记忆 + 每个在职执事各跑一遍，串行、只写建议、绝不自动应用/删除；
# 昨天没应用的建议会被当晚的新建议替换（与手动重新对账同口径）。
# false = 不挂定时器。不设 = 开。
# MEMORY_NIGHTLY_REVIEW=true
# 每晚机械拆分（2026-11-16）：开 = 对账前先把 ≥200 字的长记忆拆成原子、原文进档案；
# false = 当晚只对账、不拆。拆分不需要模型，没有可用模型时它照跑。不设 = 开。
# MEMORY_NIGHTLY_SPLIT=true
# 触发时刻 HH:MM，非法值回落到 03:30。
# MEMORY_NIGHTLY_AT=03:30
# 规则抽取噪声过滤（2026-11-13）：false = 审批续跑等合成指令/命令句/问句也写成经历。
# MEMORY_EXTRACT=rule 不受影响。不设 = 开。
# MEMORY_EXTRACT_NOISE=true
# 外接记忆库页脚（2026-11-13）：false = 设置→记忆 不显示「一生记忆库」一行。
# MEMORY_EXTERNAL=true
# 记忆导入的本机来源（2026-11-15）：false = 导入弹窗只留文件导入（来源两端点 404）。
# 白名单（Qoder CLI / Qoder awareness / CodeBuddy）与刻意不接的来源见
# docs/设计方案/2026-11-15-记忆导入（接入别家AI的记忆）.md。不设 = 开。
# MEMORY_IMPORT_SOURCES=true
# 导入原子化（2026-11-16）：开 = 有 frontmatter description 的文件只收摘要当原子，
# 完整文件进「原文档案」；false = 回到旧行为（正文整篇当一条记忆）。不设 = 开。
# MEMORY_IMPORT_ATOMIC=true
# 长记忆拆分（2026-11-16）：false = 拆分预览/应用端点 404、记忆页不显示「拆分记忆」。
# 不设 = 开。注意：拆分出来的原子和原文档案不会因为关开关而消失。
# MEMORY_SPLIT=true
# persona-metric 记忆库检索（读，2026-11-09）：配 ask.py 绝对路径才上架 persona_recall；
# 只读子进程，不碰 persona.db。未配 = 不上架（默认态）。
# PERSONA_MEMORY_ASK=<persona-metric>/analysis/ask.py
# PERSONA_PYTHON=python
# 主对话原文导出（写，默认关；开了才往 voicevault/persona 方向送数据）
# PERSONA_EXPORT_ENABLED=false

# 工具闸门：full（默认，全放行） / no-shell（只改工作区与项目里的文件）
#          / read-only（只看不改）
# 2026-11-14：read-only 与 no-shell 两档都放行 ls / cat / grep 这类只读命令
# （词表窄 + 看旗标 + 路径限根）。写 0 / false / off 回到"这两档一条命令都不跑"。
# AGENT_TOOL_POLICY=full
# AGENT_READ_VIEW_COMMANDS=1
# AGENT_BLOCKED_TOOLS=bash,powershell

# ── 审批 ask 流（2026-11-04 批次二 A1）────────────────────────────────────
# 写类工具执行前逐次确认（独立于三档；桌面 / 网页专属，手机没有答复通道，会等到超时被拒）。
# 不设 = 关，行为与改动前完全一致（回滚开关）。
# AGENT_CONFIRM_WRITES=false
# 审批等待秒数；超时按拒绝处理（fail-closed）。非法值或 0 一律回落 120。
# AGENT_APPROVAL_TIMEOUT_S=120
# 审批状态文件：含工具参数摘要（敏感度同对话正文，永不进日志）
# AGENT_APPROVALS_PATH=.data/approvals.json

# ── 派活能力（chancellor，2026-11-02）──────────────────────────────────────
# 主 agent 手上的 delegate 工具：它自己不动手，把活派给外面的工人，只拿回一句话。
# false = 工具不上，工具清单回到 8 个，行为与改动前完全一致（回滚开关，不是功能开关）。
# CHANCELLOR_ENABLED=true

# 派出去的活落在哪。缺省 = 服务进程 cwd 下的 runs/（从 ts/apps/server 启动即 ts/apps/server/runs/）。
# CHANCELLOR_WORK_ROOT=

# 项目与工作区登记表（2026-11-03 方案 §5.5）。派新活必须先有已登记项目。
# 缺省 .data/projects.sqlite；工作区根目录用 POST /api/v1/workspaces 设置。
# PROJECTS_DB_PATH=
# 当前项目（2026-11-04 侧边栏方案）：侧边栏高频切换，决定会话 cwd / 系统提示 / 任务归属；
# 不改变审批与物理边界。false = 整体旁路（PUT 一律 400 current_project_disabled，
# GET 的 currentProjectId 恒 null，cwd 回到 AGENT_WORKDIR）。
# 注意：最大工作区物理边界（write/edit 越界拒绝）**不受此开关影响**。
# CURRENT_PROJECT=true
# 受理回执里的 ticketId → 会话映射（2026-11-04 批次一 A3a）。false = 不写会话列（回滚开关）。
# DELEGATION_MAP_PERSIST=true
# 启动恢复回灌（2026-11-04 批次四 A3b）：终态单查回执、写一行状态回原会话。
# false = 不查回执也不回灌（回滚开关；恢复汇总计数照旧）。
# DELEGATION_RECOVER_REPORT=true
# 回滚开关：false = 不再要求 delegate 的 project（回到 2026-11-02 的无项目行为）。
# DELEGATION_PROJECT_REQUIRED=true

# 用哪种雇员：native（pi-durable 实例，需 LLM_API_KEY）/ mercenary 或 qoder-intl（Qoder 国际版）
# / qoder-cn（Qoder 国内版，登录态独立）/ codebuddy（CodeBuddy CLI）/
# claude-code / codex / opencode（2026-11-16 多 CLI，非交互模式）。
# 回滚 = 改回 native。界面「设置 → 派活」写 .data/executor.json，优先于这一行。
# CHANCELLOR_EMPLOYEE=native

# 原生 worker 的模型（复用上面的 LLM_API_KEY / LLM_BASE_URL）
# CHANCELLOR_MODEL=deepseek-v4.1-flash
# Qoder 国际版 / 国内版的二进制与模型（0 字节壳会自动回退到带版本号真身）
# CHANCELLOR_QODER_BIN=C:/Users/<user>/.qoder/bin/qodercli/qodercli.exe
# CHANCELLOR_QODER_CN_BIN=C:/Users/<user>/.qoder-cn/bin/qoderclicn/qoderclicn.exe
# CHANCELLOR_QODER_CN_MODEL=deepseek-v4.1-flash
# CodeBuddy 的二进制与模型（模型 ID 与 Qoder 写法不同；CLI 必须用 --model 全拼）
# CHANCELLOR_CODEBUDDY_BIN=codebuddy
# CHANCELLOR_CODEBUDDY_MODEL=deepseek-v4.1-flash

# 2026-11-16 多 CLI：Claude Code / Codex / OpenCode（都是非交互模式）。
# 模型留空 = 不传参数，跟随该 CLI 自己的配置（~/.claude/settings.json / ~/.codex/config.toml /
# ~/.config/opencode/opencode.json）；权限档 read / edit / full 只对这三档生效。
# 界面「设置 → 派活」写 .data/executor.json，文件里的值优先于这里的缺省。
# CHANCELLOR_CLAUDE_BIN=claude
# CHANCELLOR_CLAUDE_MODEL=
# CHANCELLOR_CLAUDE_PERMISSION=full
# CHANCELLOR_CODEX_BIN=codex
# CHANCELLOR_CODEX_MODEL=
# CHANCELLOR_CODEX_PERMISSION=full
# CHANCELLOR_OPENCODE_BIN=opencode
# CHANCELLOR_OPENCODE_MODEL=
# CHANCELLOR_OPENCODE_PERMISSION=full
# 回滚开关：false/0/off = 不读 .data/executor.json，执行器与模型/权限一律按本文件 env。
# EXECUTOR_CONFIG=true
# EXECUTOR_CONFIG_PATH=.data/executor.json
# 内部质检（拆单 / 验收 / 目标核对）用哪个模型（2026-11-16）：
# core（缺省）= 主对话当前运行时模型，走核心 PI；qoder = 回滚到旧 Qoder CLI 调用。
# 注意：内部质检不再依赖 Qoder；Qoder 只作为工人选项保留。
# CHANCELLOR_INTERNAL=core
# 设置 → 派活 的「检测」按钮（2026-11-16）：false/0/off = 端点返回 400，不 spawn 任何 CLI。
# EXECUTOR_PROBE=true

# ── 手机 worker 的受限 shell（2026-11-02 第四个接口）──────────────────────
# 只放行虚拟屏需要的几种 adb shell 形状（见 docs 契约），不是通用 shell。
# adb 路径（缺省 Android SDK 的 platform-tools/adb.exe）
# ADB_PATH=C:/Users/<user>/AppData/Local/Android/Sdk/platform-tools/adb.exe
# 设备序列号；不配则取 adb devices 里唯一那台，多台会报错（不猜）
# ADB_SERIAL=


# ── 中继与多端（2026-11-05 多端同步三阶段，详见 接口文档.md §2.13）────────
# harness 的中继客户端；默认关 = 完全不装，回局域网直连形态
# RELAY_ENABLED=1
# RELAY_URL=ws://127.0.0.1:8084
# RELAY_TOKEN=<中继签发的 deviceToken>
# RELAY_DEVICE_NAME=我的电脑
# 设备矩阵派活（依赖中继；delegate 的 targetDevice 由此开关）
# DEVICE_MATRIX_ENABLED=1
# 伙伴认主机底座（依赖中继；档案/记忆归批次B 伙伴系统）
# COMPANION_HOME_ENABLED=1

# ── 中继进程自身（ts/apps/relay）──────────────────────────────────────
# RELAY_PORT=8084
# RELAY_STORE_PATH=.data/relay-state.json
# 公网部署必须配（空 = 仅 loopback 可签发加入码/撤销设备）
# RELAY_OWNER_TOKEN=

# ── 设备矩阵自动分发（2026-11-05，详见 接口文档.md §2.13）──────────────
# delegate 的 targetDevice="auto" 总开关；关着时 "auto" 按非法参数拒绝
# DEVICE_AUTO_DISPATCH=1
# 单机在跑单数达到该值视为满载（auto 挑机剔除；非法值回落 3）
# DEVICE_MAX_ACTIVE_PER_DEVICE=3
# ── 外观：壁纸（2026-11-14 外观页扩展）──────────────────────────────────
# 壁纸整组端点的回滚开关：0 / false / off 时 /api/v1/appearance/wallpaper* 全不挂，
# 外观页那一节也自己藏掉；缺省 = 开。
# AGENT_APPEARANCE_WALLPAPER=1
# 壁纸图的落盘目录（单张覆盖写：wallpaper.<ext> + wallpaper.json），缺省 .data/appearance
# AGENT_WALLPAPER_DIR=.data/appearance

# ── 会话画板（2026-11-17 画板批，方案 docs/设计方案/2026-11-17-会话画板（单会话回合卡）.md）
# 回滚开关：false / 0 / off = /api/v1/agent/chat/:id/map 与 /messages/:messageId 一律 404，
# 会话顶栏的「会话地图」按钮按 /agent/policy 的 chatMap 收起；缺省 = 开。
# CHAT_MAP_ENABLED=true