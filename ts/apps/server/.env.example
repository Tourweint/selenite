# 复制为 .env 后填写；不填也能跑，走 mock 流。
PORT=8082

# 访问令牌：手机等其他设备连进来必须配；不配则只允许本机回环访问。
# 生成示例：node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
AGENT_TOKEN=

# OpenAI 兼容端点。百炼 / DeepSeek / 本地 Ollama 都行，换一行配置即可。
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
# 2026-10-31 方案 D1：快/深同款模型（换模型 = 上游缓存清零），快慢只靠 enable_thinking。
LLM_MODEL=deepseek-v4.1-flash
# 部署别名（D1 后不再承载快慢语义）；保持与 LLM_MODEL 一致即可
LLM_MODEL_FAST=deepseek-v4.1-flash

# 假模型：走真实 durable 链路（会话落库/工具/压缩都在跑），只是模型回固定内容。
# 用来不花钱验整条 HTTP 链路；设了它就忽略 LLM_API_KEY。
# LLM_PROVIDER=faux
# 假模型只会调工具、永远不收尾 —— 专门用来验工具回合上限
# LLM_FAUX_TOOL=recall

# 一次提问里最多来回几次工具回合，撞上限会把这一轮收尾并提示用户重新发。0 = 不限。
# 30 偏紧（整理一整个目录会半路截断），100 是权衡后的默认；再高就属于"跑十几分钟没人管"了。
AGENT_MAX_TURNS=100

# 思考档（2026-10-31 方案 D2/D3）：聊天默认思考关；首次调工具时按上一轮 prompt 规模判定——
# 低于阈值（默认 4000 token）切一次思考开并保持，长会话不切（切一次 = 前缀整段重算）。
# AGENT_THINK_TOKEN_LIMIT=4000
# AGENT_TOOL_UPGRADE=on   # off = 彻底不切

# 存储位置
# AGENT_DB_PATH=.data/agent.sqlite
# MEMORY_DB_PATH=.data/memory.db

# 工具闸门：full（默认，全放行） / read-only（拦住写文件和跑命令）
# AGENT_TOOL_POLICY=full
# AGENT_BLOCKED_TOOLS=bash,powershell
